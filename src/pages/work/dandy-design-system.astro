---
import DandyScroll from '../../layouts/DandyScroll.astro';
import type { Beat } from '../../data/dandy-scroll-types';

const WALK = '/journey/storybook-ds.mp4';
const scenes: { id: string; label: string; nav: string; beats: Beat[] }[] = [
	{
		id: 'gap',
		label: '01 · The gap',
		nav: 'The gap',
		beats: [
			{
				title: 'Chairside had a design system.',
				text: 'Its system, Floss UI, was fully built in Figma and live in code, for the dentist-facing product.',
				media: { kind: 'clip', src: '/journey/floss-ui-preview.mp4', poster: '/journey/floss-ui-poster.jpg', alt: 'A walkthrough of Floss UI, the design system for the dentist-facing product' },
			},
			{
				title: 'Dandy Design Center had none.',
				text: 'Software for designing 3D restorations, essentially Figma for teeth. A very different product, with a very different architecture and front end.',
				viz: 'empty',
			},
			{
				title: 'So I built one, reusing what already worked.',
				text: 'With Cursor, I started from the chairside design system our dentist software already used, reused every component I could, and designed the net-new ones the editor needed. It all lives in Storybook, where engineering already tests components.',
				media: { kind: 'clip', src: '/journey/storybook-ds-preview.mp4', poster: WALK.replace('.mp4', '-cover.jpg'), alt: 'Building the design system in Storybook' },
			},
		],
	},
	{
		id: 'users',
		label: '02 · The users',
		nav: 'The users',
		beats: [
			{
				title: 'Engineers, PMs, and designers were my end users.',
				text: 'Each needed something different from the same system.',
				viz: 'users',
			},
		],
	},
	{
		id: 'build',
		label: '03 · The build',
		nav: 'The build',
		beats: [
			{
				title: 'Reuse what exists, build what is new.',
				text: 'I reused Floss UI components wherever I could and created many net new ones, using Cursor, referencing our production code, and hosting it all in Storybook.',
				media: { kind: 'slice', src: WALK, poster: '/journey/storybook-ds-cover.jpg', start: 0, end: 4, alt: 'Browsing the component catalog' },
			},
			{
				title: 'Tag every component.',
				text: 'New, existing, or exploring. A status on everything makes reuse the default.',
				media: { kind: 'clip', src: '/journey/storybook-ds-status.mp4', poster: '/journey/storybook-ds-status-poster.jpg', alt: 'Filtering components by status' },
			},
			{
				title: 'One taxonomy.',
				text: 'IA rules decide where each component lives, so the whole system can be browsed in one place.',
				media: { kind: 'slice', src: WALK, poster: '/journey/storybook-ds-cover.jpg', start: 4, end: 8, alt: 'Browsing by category' },
			},
			{
				title: 'Every state, with code to copy.',
				text: 'Each component page has all of its states and a ready-to-paste snippet.',
				media: { kind: 'clip', src: '/journey/storybook-ds-components.mp4', poster: '/journey/storybook-ds-components-poster.jpg', alt: 'Flipping through a component’s states and code' },
			},
			{
				title: 'A page, not a meeting.',
				text: 'A handoff guide and Jira templates cover where the source lives, how it ships, and how to measure success.',
				media: { kind: 'image', src: '/journey/storybook-handoff.jpg', alt: 'The engineering handoff page' },
			},
		],
	},
	{
		id: 'impact',
		label: '04 · The impact',
		nav: 'The impact',
		beats: [
			{ title: '5–10 minutes.', text: 'Per component iteration, down from 30–45 minutes in Figma.', metric: { text: '5–10 min', unit: 'per iteration, down from 30–45' } },
			{ title: 'Faster to ship.', text: 'Milestone 4 shipped about 29% faster, at about 25% higher quality.', metric: { to: 29, prefix: '~', suffix: '%', unit: 'faster, Milestone 4' } },
			{ title: 'More efficient on Bridges.', text: 'About 30% more efficient on the Bridges redesign, with 15%+ quality gains.', metric: { to: 30, prefix: '~', suffix: '%', unit: 'more efficient, Bridges' } },
			{
				title: 'Now used across all of DDE.',
				text: 'The Cursor and Storybook setup became how the whole team works.',
				quote: ['“The Cursor and Storybook environment you built is now used across all of DDE, and it has made a real, measurable difference.”', 'Lizzie, my manager'],
			},
			{
				title: 'What the team said.',
				text: 'From engineering and design, in their words.',
				quote: ['“Very neat! It is kind of pleasant not seeing the MUI artifacts all over everything.”', 'Michael, Dandy engineering'],
			},
		],
	},
	{
		id: 'reflect',
		label: '05 · Reflection',
		nav: 'Reflection',
		beats: [
			{ title: 'Not smooth at first.', text: 'Getting Storybook, the build pipeline, and 3D scan rendering working took real time. Engineers on the team helped me get it right.' },
			{
				title: 'Then it unlocked more.',
				text: 'With real components, I build full interactive flows, and I teach the team to do the same.',
				links: [
					{ href: '/work/dandy-prototype', label: 'Clickable prototypes →' },
					{ href: '/work/dandy-product-design-hub', label: 'The Product Design Hub →' },
				],
			},
		],
	},
];

---

<DandyScroll
	title="Design system in Storybook · Dandy"
	description="How I built Dandy's design system in Storybook with Cursor, on real production code."
	eyebrow="Design system · 2025 – now · Sole product designer"
	heroTitle="I built the design system for the tool that makes every restoration possible."
	lede="Dandy Design Center had no design system. With Cursor, I extended our chairside system, added the net-new components the editor needed, and put it all in Storybook, where engineering already works."
	tools="Storybook · Cursor · Claude"
	hero={{ src: '/journey/storybook-ds-preview.mp4', poster: '/journey/storybook-ds-cover.jpg' }}
	scenes={scenes}
	endTitle="One source of truth, shared by the team."
	endText="Designers, engineers, and PMs now work from the same components, in the same place, in minutes instead of meetings."
/>
