---
import Base from '../../layouts/Base.astro';
import CompanyBanner from '../../components/CompanyBanner.astro';
import { companies } from '../../data/companies';
---

<Base
	title="Work"
	description="Product design work by Casey Flood, grouped by company: Dandy, Amwell, and earlier projects."
>
	<section class="page-intro">
		<div class="shell">
			<p class="eyebrow eyebrow--sky">Work</p>
			<h1>Where I've done the work.</h1>
			<p class="lede">Start with a company for the context, or jump straight into a project.</p>
		</div>
	</section>

	<section class="section" style="padding-top: 1.5rem" aria-label="Companies">
		<div class="shell cb-stack">
			{companies.map((c) => <CompanyBanner company={c} mode="index" />)}
		</div>
	</section>
</Base>
