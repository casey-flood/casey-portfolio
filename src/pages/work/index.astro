---
import Base from '../../layouts/Base.astro';
import { companies } from '../../data/companies';

// One entry per project. Lead with the result, then a clear title.
type P = { co: string; title: string; line: string; d?: string; metric?: { v: string; l: string }; note?: string; tags: string[]; img?: string; ph?: string; href?: string };
const projects: P[] = [
	{ co: 'dandy', title: 'Dandy Design Editor', line: 'Designed the in-house crown design tool, cutting hands-on designer time per order <b>11.5%</b> as crown volume grew 57%.', d: 'One end-to-end tool for designing the whole restoration in house.', metric: { v: '−11.5%', l: 'hands-on designer time per order' }, tags: ['designer experience', 'dental', 'in-house design', 'machine learning', 'sole designer'], img: '/scan-to-smile/04-design.webp', href: '/work/dandy-design-editor' },
	{ co: 'dandy', title: 'Instant Design Preview', line: 'Dentists approve the generated crown before it’s made, so fewer get remade.', d: 'Dentists approve the generated crown before it is made.', note: 'Chairside · case study coming soon', tags: ['dentist experience', 'dental', 'crown'], img: '/scan-to-smile/extra-ml-crown.webp' },
	{ co: 'dandy', title: 'Perfect Fit (Goldilocks)', line: 'Three crown fits in one order: quicker turnaround and fewer seating appointments.', d: 'Three crown fits in one order, one right fit.', note: 'Three fits, one right crown · coming soon', tags: ['dentist experience', 'patient', 'crown'], img: '/scan-to-smile/06-place.webp' },
	{ co: 'dandy', title: 'Design Editor design system', line: 'Built its first design system, cutting each iteration from 30–45 to <b>5–10 minutes</b>.', d: 'Built from scratch in Storybook, on real production code.', metric: { v: '5–10 min', l: 'per iteration, down from 30–45' }, tags: ['systems design', 'design system', 'storybook', 'cursor'], img: '/journey/storybook-ds-cover.jpg', href: '/work/dandy-design-system' },
	{ co: 'dandy', title: 'Clickable prototypes', line: 'Prototyped real flows from production components for early feedback.', d: 'Real components, full flows, early feedback.', note: 'Systems', tags: ['systems design', 'prototype', 'code'], img: '/work/behind/proto.jpg', href: '/work/dandy-prototype' },
	{ co: 'dandy', title: 'Product Design Hub', line: 'A guided path that teaches the whole team to prototype in code.', d: 'A guided path that teaches the team to prototype in code.', note: 'Systems', tags: ['systems design', 'education', 'hub'], img: '/work/behind/hub.jpg', href: '/work/dandy-product-design-hub' },
	{ co: 'amwell', title: 'Admin portal redesign', line: 'Redesigned the admin portal around each role, lifting task completion from <b>45% to 82%</b>.', d: 'One role-based system for a fragmented enterprise portal.', metric: { v: '45% → 82%', l: 'admin task completion' }, tags: ['admin', 'navigation', 'information architecture', 'healthcare', 'enterprise', 'design system'], img: '/amwell/admin-dashboard.webp', href: '/work/amwell-admin-portal' },
	{ co: 'amwell', title: 'Research library', line: '15 studies I ran, and what each one changed.', d: 'Amwell user research library.', metric: { v: '86%', l: 'of the team’s research, led by me' }, tags: ['research', 'usability', 'interviews', 'healthcare'], img: '/amwell-research/choosing-care/screens/final-care.webp', href: '/work/amwell-research' },
	{ co: 'amwell', title: 'AI While You Wait', line: 'ML-assisted pre-visit triage that cut perceived wait time by <b>45%</b>.', d: 'ML-assisted pre-visit triage for patients.', metric: { v: '45%', l: 'lower perceived wait time' }, tags: ['patient experience', 'triage', 'machine learning', 'healthcare'], img: '/amwell/triage.webp' },
	{ co: 'amwell', title: 'Patient onboarding', line: 'Streamlined enrollment, lifting onboarding conversion by <b>20%</b>.', d: 'Enrollment and intake, reused across white-label clients.', metric: { v: '+20%', l: 'onboarding conversion' }, tags: ['patient experience', 'onboarding', 'mobile', 'healthcare'], img: '/amwell/onboarding.webp' },
	{ co: 'earlier', title: 'Paper Airplane', line: 'Made in-person dating approachable, from first survey to a tested prototype.', d: 'A dating app for meeting in the same room.', metric: { v: '13', l: 'tested screens' }, tags: ['startup', 'mobile', 'dating', 'research'], img: '/paper-airplane/story-trio.webp', href: '/work/paper-airplane' },
	{ co: 'earlier', title: 'MyTrips', line: 'My first app, built from scratch at Pratt.', d: 'An itinerary app built around sharing a trip fast.', metric: { v: '−94%', l: 'time to share a trip, in testing' }, tags: ['mobile', 'travel', 'pratt', 'capstone'], img: '/mytrips/hero-phones.webp', href: '/work/mytrips' },
];

const short: Record<string, string> = {
	'Dandy Design Editor': 'dental designer time per order',
	'Design Editor design system': 'per product design iteration, was 30–45',
	'Admin portal redesign': 'task completion',
	'Research library': 'of research, led by me',
	'AI While You Wait': 'lower perceived wait',
	'Patient onboarding': 'onboarding conversion',
	'Paper Airplane': 'tested screens',
	'MyTrips': 'time to share a trip',
};
const co = companies.map((c) => ({
	...c,
	live: projects.filter((p) => p.co === c.id && p.href),
	soon: projects.filter((p) => p.co === c.id && !p.href),
}));
---

<Base
	title="Work"
	description="Product design work by Casey Flood, grouped by company: Dandy, Amwell, and earlier projects."
>
	<div class="wk2" data-view="list">
		<div class="shell wk2__in">
			<header class="wk2__head">
				<div class="wk2__top">
					<h1>Work.</h1>
					<div class="wk2__view" role="group" aria-label="View">
						<button type="button" data-set="list" aria-pressed="true"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12" /></svg>List</button>
						<button type="button" data-set="grid" aria-pressed="false"><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="2" width="5" height="5" rx="1" /><rect x="9" y="2" width="5" height="5" rx="1" /><rect x="2" y="9" width="5" height="5" rx="1" /><rect x="9" y="9" width="5" height="5" rx="1" /></svg>Grid</button>
					</div>
				</div>
				<p>Healthcare products I researched, designed and shipped, from dentists and lab designers to patients, providers and admins.</p>
			</header>

			<div class="gv" aria-label="Work, grouped by company">
				{co.map((c) => (
					<div class="gv__deck" style={`--n:${c.live.length + (c.cta ? 1 : 0)}`}>
						<div class="gv__stage">
							{c.cta && (
								<a class={`gv__card gv__card--co gv__card--${c.id}`} href={c.cta.href} style="--i:0">
									<video class="gv__ov" src={`/work/ov-${c.id}.mp4`} poster={`/work/ov-${c.id}.jpg`} muted loop playsinline preload="none" aria-hidden="true"></video>
									{c.id === 'earlier' ? <span class="gv__coword">Earlier work</span> : <img class="gv__colog" src={c.id === 'dandy' ? '/brand/dandy-wordmark.svg' : '/brand/amwell-white.svg'} alt="" />}
									<span class="gv__cap gv__cap--co"><b>Company overview →</b><small>{c.role} · {c.when}</small></span>
								</a>
							)}
							{c.live.map((p, i) => (
								<a class="gv__card" href={p.href} style={`--i:${i + (c.cta ? 1 : 0)}`}>
									<img src={p.img} alt="" loading="lazy" />
									<span class="gv__cap"><b>{p.title}</b>{p.metric && <small>{p.metric.v} {short[p.title] ?? p.metric.l}</small>}</span>
								</a>
							))}
						</div>
						<p class="gv__label">
							{c.id === 'dandy' && <img class="wk2__logo" src="/brand/dandy-wordmark.svg" alt="Dandy" />}
							{c.id === 'amwell' && <img class="wk2__logo" src="/brand/amwell-white.svg" alt="Amwell" />}
							{c.id === 'earlier' && <b>Earlier</b>}
							<span>{c.cta ? `Overview + ${c.live.length} projects` : `${c.live.length} projects`}</span>
						</p>
					</div>
				))}
			</div>

			{co.map((c) => (
				<section class="wk2__co" aria-labelledby={`wk-${c.id}`}>
					<div class="wk2__cohead">
						{c.id === 'dandy' && <img class="wk2__logo" src="/brand/dandy-wordmark.svg" alt="" />}
						{c.id === 'amwell' && <img class="wk2__logo" src="/brand/amwell-white.svg" alt="" />}
						<h2 id={`wk-${c.id}`} class:list={['wk2__coh', { 'sr-only': c.id !== 'earlier' }]}>{c.id === 'earlier' ? 'Earlier' : c.name}</h2>
						<p class="wk2__meta">{c.role}<span> · {c.when}</span></p>
						{c.cta && <a class="wk2__over" href={c.cta.href}>Overview<span aria-hidden="true"> →</span></a>}
					</div>
					<ul class="wk2__list">
						{c.live.map((p) => (
							<li>
								<a class="wk2__row" href={p.href} data-img={p.img}>
									{p.img && <img class="wk2__thumb" src={p.img} alt="" loading="lazy" />}
									<span class="wk2__t"><b>{p.title}</b><span>{p.d}</span></span>
									{p.metric && <span class="wk2__m"><strong>{p.metric.v}</strong><small>{short[p.title] ?? p.metric.l}</small></span>}
								</a>
							</li>
						))}
					</ul>
					{c.soon.length > 0 && <p class="wk2__soon">Coming soon: {c.soon.map((p) => p.title).join(' · ')}</p>}
				</section>
			))}
		</div>
		<div class="wk2__peek" aria-hidden="true"><img alt="" /></div>
	</div>
</Base>

<script>
	// List or grid, remembered per visitor.
	const wk = document.querySelector<HTMLElement>('.wk2')!;
	const setView = (v: string) => {
		wk.dataset.view = v;
		wk.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.set === v)));
		try { localStorage.setItem('work-view', v); } catch {}
	};
	wk.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((b) => b.addEventListener('click', () => setView(b.dataset.set!)));
	try { const v = localStorage.getItem('work-view'); if (v === 'grid' || v === 'list') setView(v); } catch {}
	// Grid: a deck fans out on hover or focus; on touch, the first tap opens it.
	document.querySelectorAll<HTMLElement>('.gv__deck').forEach((d) => {
		d.addEventListener('click', (e) => {
			if (matchMedia('(hover: hover)').matches || matchMedia('(max-width: 720px)').matches || d.classList.contains('open')) return;
			e.preventDefault();
			document.querySelectorAll('.gv__deck.open').forEach((o) => o.classList.remove('open'));
			d.classList.add('open');
		});
	});

	// Overview cards preview their page while the deck is open.
	document.querySelectorAll<HTMLElement>('.gv__deck').forEach((d) => {
		const v = d.querySelector<HTMLVideoElement>('.gv__ov');
		if (!v || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		const play = () => { v.play().catch(() => {}); };
		const stop = () => { if (!d.matches(':hover, :focus-within, .open')) v.pause(); };
		d.addEventListener('pointerenter', play);
		d.addEventListener('focusin', play);
		d.addEventListener('pointerleave', stop);
		d.addEventListener('focusout', () => setTimeout(stop));
		d.addEventListener('click', play);
	});

	// Desktop only: a small preview follows the cursor over a row, so the list stays clean.
	const peek = document.querySelector<HTMLElement>('.wk2__peek');
	const img = peek?.querySelector('img');
	if (peek && img && matchMedia('(hover: hover) and (min-width: 900px)').matches) {
		document.querySelectorAll<HTMLElement>('.wk2__row[data-img]').forEach((r) => {
			r.addEventListener('pointerenter', () => { img.src = r.dataset.img!; peek.classList.add('on'); });
			r.addEventListener('pointerleave', () => peek.classList.remove('on'));
			r.addEventListener('pointermove', (e) => { peek.style.transform = `translate(${e.clientX + 24}px, ${e.clientY - 70}px)`; });
		});
		addEventListener('scroll', () => peek.classList.remove('on'), { passive: true });
	}
</script>

<style>
	.wk2 { padding: clamp(3rem, 9vw, 6rem) 0 6rem; }
	.wk2__in { max-width: 46rem; }
	.wk2__top { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; }
	.wk2__view { display: inline-flex; padding: 0.2rem; border: 1px solid var(--line); border-radius: 99px; flex: none; }
	.wk2__view button { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.75rem; border: 0; border-radius: 99px; background: none; color: var(--muted); font: inherit; font-size: 0.8rem; cursor: pointer; transition: background 0.2s, color 0.2s; }
	.wk2__view svg { width: 0.85rem; height: 0.85rem; fill: none; stroke: currentColor; stroke-width: 1.5; }
	.wk2__view button[aria-pressed='true'] { background: var(--ink); color: var(--bg); }
	.wk2[data-view='list'] .gv, .wk2[data-view='grid'] .wk2__co { display: none; }
	.wk2[data-view='grid'] .wk2__in { max-width: 74rem; }
	.wk2[data-view='grid'] .wk2__peek { display: none; }

	/* Grid: one stacked deck per company. Hover a deck and it widens while its cards spread into a row. */
	.gv { display: flex; gap: 1.5rem; height: clamp(18rem, 32vw, 24rem); margin-top: clamp(3rem, 7vw, 4.5rem); }
	.gv__deck { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; outline: none; transition: flex-grow 0.55s cubic-bezier(0.2, 0.8, 0.2, 1); }
	.gv:hover .gv__deck, .gv:focus-within .gv__deck { flex-grow: 0.7; }
	.gv .gv__deck:hover, .gv .gv__deck:focus-within, .gv .gv__deck.open { flex-grow: 3.2; }
	.gv__stage { position: relative; flex: 1; }
	.gv__card { --w: 78%; --gap: 0.75rem; position: absolute; top: 8%; left: calc((100% - var(--w)) / 2); width: var(--w); height: 80%; border-radius: 1rem; overflow: hidden; background: var(--paper); border: 1px solid var(--line); box-shadow: 0 18px 40px -22px rgba(0, 0, 0, 0.5); z-index: calc(10 - var(--i)); transform: rotate(calc((var(--i) - 0.5) * 3.5deg)) translateY(calc(var(--i) * 6px)); transition: left 0.55s cubic-bezier(0.2, 0.8, 0.2, 1), width 0.55s cubic-bezier(0.2, 0.8, 0.2, 1), top 0.55s, height 0.55s, transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1); color: inherit; text-decoration: none; }
	.gv__card img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
	.gv__cap { position: absolute; inset: auto 0 0 0; padding: 2.5rem 0.9rem 0.8rem; display: flex; flex-direction: column; gap: 0.15rem; background: linear-gradient(to top, rgba(0, 0, 0, 0.78), transparent); color: #fff; opacity: 0; transform: translateY(6px); transition: opacity 0.3s, transform 0.3s; }
	.gv__cap b { font-size: 0.9rem; line-height: 1.25; }
	.gv__cap small { font-size: 0.72rem; opacity: 0.8; }
	.gv__deck:is(:hover, :focus-within, .open) .gv__card { --w: calc((100% - (var(--n) - 1) * var(--gap)) / var(--n)); left: calc(var(--i) * (var(--w) + var(--gap))); top: 0; height: 100%; transform: none; }
	.gv__deck:is(:hover, :focus-within, .open) .gv__cap { opacity: 1; transform: none; transition-delay: 0.25s; }
	.gv__deck:is(:hover, :focus-within, .open) .gv__card { pointer-events: auto; }
	.gv__card:hover { border-color: var(--accent); }
	.gv__card--co { display: grid; place-items: center; border-color: transparent; }
	.gv__card--dandy { background: #17372a; }
	.gv__card--amwell { background: #1d2f6f; }
	.gv__colog { width: auto !important; height: 2.1rem !important; max-width: 70%; object-fit: contain !important; filter: brightness(0) invert(1); transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1); }
	.gv__deck:is(:hover, :focus-within, .open) .gv__colog { transform: translateY(-0.9rem) scale(0.8); }
	.gv__cap--co { background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent); }
	.gv__ov { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 15% 50%; opacity: 0; transition: opacity 0.4s; }
	.gv__card--co .gv__colog, .gv__card--co .gv__coword { position: relative; z-index: 1; }
	.gv__deck:is(:hover, :focus-within, .open) .gv__ov { opacity: 1; transition-delay: 0.3s; }
	.gv__deck:is(:hover, :focus-within, .open) :is(.gv__colog, .gv__coword) { opacity: 0; transition: opacity 0.3s 0.3s, transform 0.55s; }
	.gv__cap { z-index: 2; }
	.gv__card--earlier { background: #2b2622; }
	.gv__coword { white-space: nowrap; font-family: var(--display); font-size: clamp(1rem, 2vw, 1.6rem); letter-spacing: -0.03em; color: #fff; transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1); }
	.gv__deck:is(:hover, :focus-within, .open) .gv__coword { transform: translateY(-0.9rem) scale(0.8); }
	.gv__label { display: flex; align-items: center; justify-content: center; gap: 0.6rem; margin: 1rem 0 0; color: var(--muted); font-size: 0.82rem; white-space: nowrap; }
	.gv__label b { color: var(--ink); font-size: 1rem; }
	.gv__deck { min-width: 8.5rem; }
	.gv:is(:hover, :focus-within) .gv__deck:not(:hover, :focus-within) .gv__label span { display: none; }
	.gv__card { container-type: inline-size; }
	@container (max-width: 150px) { .gv__cap small { display: none; } .gv__cap b { font-size: 0.8rem; } }

	.wk2__head h1 { margin: 0; font-size: clamp(2.6rem, 7vw, 4rem); letter-spacing: -0.04em; line-height: 1; }
	.wk2__head p { margin: 1rem 0 0; max-width: 34rem; color: var(--muted); font-size: 1.05rem; line-height: 1.55; }

	.wk2__co { margin-top: clamp(3.5rem, 9vw, 5.5rem); }
	.wk2__cohead { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; padding-bottom: 0.9rem; }
	.wk2__logo { height: 1.15rem; width: auto; align-self: center; filter: brightness(0); opacity: 0.85; }
	:global([data-theme='dark']) .wk2__logo { filter: brightness(0) invert(1); }
	.wk2__coh { margin: 0; font-size: 1.15rem; letter-spacing: -0.02em; }
	.wk2__meta { margin: 0; color: var(--muted); font-size: 0.85rem; }
	.wk2__over { margin-left: auto; color: var(--muted); font-size: 0.85rem; text-decoration: none; }
	.wk2__over:hover { color: var(--accent); }

	.wk2__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
	.wk2__list li { border-bottom: 1px solid var(--line); }
	.wk2__row { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.05rem 0; color: inherit; text-decoration: none; }
	.wk2__thumb { display: none; }
	.wk2__t { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
	.wk2__t b { font-weight: 600; font-size: 1.02rem; transition: color 0.2s; }
	.wk2__t span { color: var(--muted); font-size: 0.88rem; line-height: 1.4; }
	.wk2__m { display: flex; flex-direction: column; align-items: flex-end; text-align: right; flex: none; }
	.wk2__m strong { font-family: var(--display); font-size: 1.15rem; letter-spacing: -0.02em; line-height: 1.1; white-space: nowrap; }
	.wk2__m small { color: var(--muted); font-size: 0.74rem; white-space: nowrap; }
	.wk2__row:hover b { color: var(--accent); }
	.wk2__soon { margin: 0.9rem 0 0; color: var(--muted); font-size: 0.82rem; opacity: 0.8; }

	.wk2__peek { position: fixed; left: 0; top: 0; z-index: 30; width: 13rem; aspect-ratio: 4 / 3; border-radius: 0.75rem; overflow: hidden; pointer-events: none; opacity: 0; transition: opacity 0.18s; box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.6); background: var(--paper); }
	.wk2__peek.on { opacity: 1; }
	.wk2__peek img { width: 100%; height: 100%; object-fit: cover; display: block; }

	@media (max-width: 720px) {
		.gv { flex-direction: column; height: auto; gap: 2.5rem; }
		.gv__stage { display: flex; gap: 0.75rem; overflow-x: auto; scroll-snap-type: x mandatory; margin: 0 -1rem; padding: 0 1rem 0.25rem; }
		.gv__card { position: relative; flex: 0 0 72%; left: auto !important; top: auto !important; width: auto !important; height: auto !important; aspect-ratio: 4 / 3; transform: none !important; scroll-snap-align: start; }
		.gv__cap { opacity: 1; transform: none; }
		.gv__label { justify-content: flex-start; margin-top: 0.75rem; }
	}
	@media (max-width: 640px) {
		.wk2__cohead { display: grid; grid-template-columns: auto 1fr; row-gap: 0.4rem; }
		.wk2__meta { grid-column: 1 / -1; grid-row: 2; font-size: 0.8rem; }
		.wk2__over { grid-column: 2; grid-row: 1; justify-self: end; }
		.wk2__coh:not(.sr-only) { grid-column: 1; grid-row: 1; }
		.wk2__row { gap: 0.85rem; padding: 0.8rem 0; }
		.wk2__thumb { display: block; flex: none; width: 3.6rem; height: 3.6rem; border-radius: 0.7rem; object-fit: cover; object-position: top; background: var(--paper); border: 1px solid var(--line); }
		.wk2__t { flex: 1; }
		.wk2__t b { font-size: 0.95rem; line-height: 1.25; }
		.wk2__t span { display: none; }
		.wk2__m strong { font-size: 1rem; }
		.wk2__m small { white-space: normal; max-width: 6.5rem; line-height: 1.25; }
	}
	@media (prefers-reduced-motion: reduce) { .wk2__peek { display: none; } .gv__deck, .gv__card, .gv__cap { transition: none; } }
</style>
