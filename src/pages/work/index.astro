---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<Base
	title="Work"
	description="Selected product design case studies by Casey Flood: Amwell Admin Portal and My Trips."
>
	<section class="page-intro">
		<div class="shell">
			<p class="eyebrow eyebrow--sky">Work</p>
			<h1>Case studies</h1>
			<p class="lede">
				Complex products, honest process, measured results. New Dandy stories are on the way.
			</p>
		</div>
	</section>

	<section class="section" aria-label="Project grid" style="padding-top: 2rem">
		<div class="shell">
			<div class="grid">
				{
					projects.map((p) => (
						<ProjectCard
							title={p.data.title}
							summary={p.data.summary}
							kicker={p.data.industry}
							tags={p.data.status === 'published' ? p.data.tags : []}
							comingSoon={p.data.status === 'coming-soon'}
							lead={p.data.status === 'published'}
							href={p.data.status === 'published' ? `/work/${p.id}` : undefined}
							metric={p.data.status === 'published' ? p.data.metrics[0] : undefined}
							accent={p.data.accent}
						/>
					))
				}
			</div>
		</div>
	</section>
</Base>
