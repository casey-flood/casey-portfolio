---
import DandyScroll from '../../layouts/DandyScroll.astro';
import type { Beat } from '../../data/dandy-scroll-types';

const A = '/amwell/cs';
const eco = `
<div class="eco" role="group" aria-label="Patients and providers meet in virtual visits; the admin portal sits behind both and configures what each side sees">
	<svg class="eco__lines" viewBox="0 0 100 62" preserveAspectRatio="none" aria-hidden="true">
		<path class="eco__visit" d="M27 20 L73 20" />
		<path class="eco__cfg eco__cfg--l" d="M50 40 L22 28" />
		<path class="eco__cfg eco__cfg--r" d="M50 40 L78 28" />
	</svg>
	<span class="eco__tag eco__tag--visit">Virtual visit</span>
	<div class="eco__side eco__side--pat" data-part="pat" tabindex="0" role="button" aria-label="Bring the patient portal into focus">
		<img class="eco__face" src="/amwell/cs/pat-persona.webp" alt="" />
		<b>Patient</b><small>Patient portal</small>
		<span class="eco__shot"><img class="eco__ui" src="/amwell/cs/pat-portal.webp" alt="Patient portal" /><button type="button" class="eco__zoom" aria-label="See the patient portal full size">⤢</button></span>
	</div>
	<div class="eco__side eco__side--prov" data-part="prov" tabindex="0" role="button" aria-label="Bring the provider portal into focus">
		<img class="eco__face" src="/amwell/cs/prov-persona.webp" alt="" />
		<b>Provider</b><small>Provider portal</small>
		<span class="eco__shot"><img class="eco__ui" src="/amwell/cs/prov-portal.webp" alt="Provider portal" /><button type="button" class="eco__zoom" aria-label="See the provider portal full size">⤢</button></span>
	</div>
	<div class="eco__admin" data-part="admin" tabindex="0" role="button" aria-label="Bring the admin portal into focus">
		<div class="eco__ahead"><img class="eco__face" src="/amwell/cs/admin-persona.webp" alt="" /><span><b>Health system admin</b><small>Admin portal · configures both sides</small></span></div>
		<span class="eco__shot"><img class="eco__ui" src="/amwell/cs/admin-portal.webp" alt="Admin portal" /><button type="button" class="eco__zoom" aria-label="See the admin portal full size">⤢</button></span>
		<ul class="eco__needs">
			<li><svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="10" rx="5"/><circle cx="16" cy="12" r="3"/></svg><span>Turn on service lines</span></li>
			<li><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M3 19c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"/><circle cx="17" cy="9" r="2.4"/><path d="M16 13.6c2.8.2 5 2 5 4.9"/></svg><span>Manage provider networks</span></li>
			<li><svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3h6v1M8.5 12.5l2.2 2.2 4.8-4.8"/></svg><span>Set clinical rules</span></li>
			<li><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><span>Control patient access</span></li>
		</ul>
	</div>
	<p class="eco__hint">Click a portal to bring it forward, then ⤢ to see it full size.</p>
</div>`;

const who = `
<div class="who" role="group" aria-label="Two groups use the admin portal: Amwell's internal team (implementation managers and NOC agents) and external clients (client healthcare admins and client IT teams)">
	<div class="who__portal"><span class="eco__shot"><img class="eco__ui" src="/amwell/cs/legacy-sysadmin.webp" alt="The legacy admin portal" /><button type="button" class="eco__zoom" aria-label="See the legacy admin portal full size">⤢</button></span><span>One admin portal</span></div>
	<svg class="who__lines" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true"><path d="M50 0 L50 8 M50 8 L25 8 L25 20 M50 8 L75 8 L75 20" /></svg>
	<div class="who__grp who__grp--in" data-part="in" tabindex="0" role="button" aria-label="Focus on the internal Amwell team">
		<p class="who__h">Internal · <b>Amwell team</b></p>
		<div class="who__p"><img src="/amwell/cs/av-impl.webp" alt="" /><b>Implementation managers</b><small>Set up and tailor the platform for each healthcare organization.</small></div>
		<div class="who__p"><img src="/amwell/cs/av-noc.webp" alt="" /><b>NOC agents</b><small>Monitor platform health and address performance issues.</small></div>
	</div>
	<div class="who__grp who__grp--out" data-part="out" tabindex="0" role="button" aria-label="Focus on external client organizations">
		<p class="who__h">External · <b>Amwell’s partner organizations</b></p>
		<div class="who__p"><img src="/amwell/cs/av-client.webp" alt="" /><b>Client healthcare admins</b><small>e.g. CVS Health. Configure and maintain their own instance.</small></div>
		<div class="who__p"><img src="/amwell/cs/av-it.webp" alt="" /><b>Client IT teams</b><small>e.g. CVS Health IT. Integrate Amwell with their existing systems.</small></div>
	</div>
	<p class="eco__hint">Click a group to focus on it, or ⤢ to see the portal full size.</p>
</div>`;

const tix = `
<div class="tix" role="img" aria-label="A support queue of admin tickets keeps scrolling: can’t find permissions, logged out when switching, searching for a tenant is hard. Callout: 400+ users, and 30% of support tickets tied to navigation and workflow, high priority.">
	<div class="tix__win">
		<div class="tix__bar"><span class="tix__dots"><i></i><i></i><i></i></span><b>Admin support · Open incidents</b></div>
		<div class="tix__head"><span>Key</span><span>Summary</span><span>Status</span></div>
		<div class="tix__view"><ul class="tix__list"><li><span class="tix__k">RD-121</span><span class="tix__s">Can’t find right permissions<i>Navigation</i></span><span class="tix__st tix__st--open">Open</span></li><li><span class="tix__k">RD-113</span><span class="tix__s">Logged out when switching between provider management and scheduling<i>Navigation</i></span><span class="tix__st tix__st--open">Open</span></li><li><span class="tix__k">RD-111</span><span class="tix__s">Slow tenant admin onboarding</span><span class="tix__st tix__st--in">In progress</span></li><li><span class="tix__k">RD-123</span><span class="tix__s">Wrong permissions for admin user<i>Navigation</i></span><span class="tix__st tix__st--in">In progress</span></li><li><span class="tix__k">RD-124</span><span class="tix__s">Need a separate view for urgent care</span><span class="tix__st tix__st--in">In progress</span></li><li><span class="tix__k">RD-127</span><span class="tix__s">Important alerts get lost among notifications</span><span class="tix__st tix__st--waiting">Waiting</span></li><li><span class="tix__k">RD-130</span><span class="tix__s">Searching for a specific tenant is hard<i>Navigation</i></span><span class="tix__st tix__st--waiting">Waiting</span></li><li><span class="tix__k">RD-131</span><span class="tix__s">Where is access to the all-tenants view?<i>Navigation</i></span><span class="tix__st tix__st--waiting">Waiting</span></li><li><span class="tix__k">RD-133</span><span class="tix__s">Tenant configurations are blocked</span><span class="tix__st tix__st--waiting">Waiting</span></li><li><span class="tix__k">RD-136</span><span class="tix__s">Can’t customize the dashboard</span><span class="tix__st tix__st--waiting">Waiting</span></li><li><span class="tix__k">RD-140</span><span class="tix__s">Hard to keep settings consistent across tenants<i>Navigation</i></span><span class="tix__st tix__st--waiting">Waiting</span></li><li><span class="tix__k">RD-145</span><span class="tix__s">Complex issue prioritization</span><span class="tix__st tix__st--waiting">Waiting</span></li><li><span class="tix__k">RD-151</span><span class="tix__s">Why do I see mental health settings when I only work with urgent care?<i>Navigation</i></span><span class="tix__st tix__st--waiting">Waiting</span></li></ul><ul class="tix__list" aria-hidden="true"><li><span class="tix__k">RD-121</span><span class="tix__s">Can’t find right permissions<i>Navigation</i></span><span class="tix__st tix__st--open">Open</span></li><li><span class="tix__k">RD-113</span><span class="tix__s">Logged out when switching between provider management and scheduling<i>Navigation</i></span><span class="tix__st tix__st--open">Open</span></li><li><span class="tix__k">RD-111</span><span class="tix__s">Slow tenant admin onboarding</span><span class="tix__st tix__st--in">In progress</span></li><li><span class="tix__k">RD-123</span><span class="tix__s">Wrong permissions for admin user<i>Navigation</i></span><span class="tix__st tix__st--in">In progress</span></li><li><span class="tix__k">RD-124</span><span class="tix__s">Need a separate view for urgent care</span><span class="tix__st tix__st--in">In progress</span></li><li><span class="tix__k">RD-127</span><span class="tix__s">Important alerts get lost among notifications</span><span class="tix__st tix__st--waiting">Waiting</span></li><li><span class="tix__k">RD-130</span><span class="tix__s">Searching for a specific tenant is hard<i>Navigation</i></span><span class="tix__st tix__st--waiting">Waiting</span></li><li><span class="tix__k">RD-131</span><span class="tix__s">Where is access to the all-tenants view?<i>Navigation</i></span><span class="tix__st tix__st--waiting">Waiting</span></li><li><span class="tix__k">RD-133</span><span class="tix__s">Tenant configurations are blocked</span><span class="tix__st tix__st--waiting">Waiting</span></li><li><span class="tix__k">RD-136</span><span class="tix__s">Can’t customize the dashboard</span><span class="tix__st tix__st--waiting">Waiting</span></li><li><span class="tix__k">RD-140</span><span class="tix__s">Hard to keep settings consistent across tenants<i>Navigation</i></span><span class="tix__st tix__st--waiting">Waiting</span></li><li><span class="tix__k">RD-145</span><span class="tix__s">Complex issue prioritization</span><span class="tix__st tix__st--waiting">Waiting</span></li><li><span class="tix__k">RD-151</span><span class="tix__s">Why do I see mental health settings when I only work with urgent care?<i>Navigation</i></span><span class="tix__st tix__st--waiting">Waiting</span></li></ul></div>
	</div>
	<div class="tix__call"><p><b>400+ users</b> and <b>30%</b> of support tickets tied to navigation and workflow</p><span class="tix__pri">▲ High priority</span></div>
</div>`;

const res = `
<div class="res">
	<ul class="res__stats">
		<li><b>3 mo</b><span>of tickets</span></li>
		<li><b>5</b><span>shadow sessions</span></li>
		<li><b>8</b><span>interviews</span></li>
		<li><b>400+</b><span>admin users</span></li>
	</ul>
	<figure class="res__map"><span class="eco__shot"><img class="eco__ui" src="/amwell/cs/sitemaps.webp" alt="The legacy portal’s information architecture, mapped screen by screen" /><button type="button" class="eco__zoom" aria-label="See the IA map full size">⤢</button></span><figcaption>Mapping the legacy IA, screen by screen</figcaption></figure>
</div>`;

const pains = `
<ol class="pains" aria-label="Three pain points">
	<li data-full="/amwell/cs/sitemaps.webp" tabindex="0" role="button" aria-label="Navigation confusion: see the full legacy sitemap"><figure><img src="/amwell/cs/pp-nav.webp" alt="One branch of the legacy sitemap, nested several levels deep" /></figure><b><i>1</i>Navigation confusion</b><span>Settings buried several levels deep, with no organization context to steer by.</span></li>
	<li data-full="/amwell/cs/matrix.webp" tabindex="0" role="button" aria-label="Unclear role-based access: see the full permissions matrix"><figure><img src="/amwell/cs/pp-roles.webp" alt="A matrix of what each admin tier can do" /></figure><b><i>2</i>Unclear role-based access</b><span>Every tier saw the same sprawling system, so admins ran into things they couldn’t, or shouldn’t, change.</span></li>
	<li data-full="/amwell/cs/before.jpg" tabindex="0" role="button" aria-label="Task completion barriers: see the full screen"><figure><img src="/amwell/cs/pp-task.webp" alt="The legacy System Admin page stuck on Loading" /></figure><b><i>3</i>Task completion barriers</b><span>Lost sessions, near-duplicate org names, and numeric IDs turned small tasks into long ones.</span></li>
</ol>`;

const deck = `
<div class="pdeck" data-focus="0">
	<figure class="pdeck__card" data-part="0" data-tag="internal" tabindex="0" role="button" aria-label="Sarah, senior implementation manager, internal Amwell user"><img src="/amwell/cs/pc1.webp" alt="Persona: Sarah, senior implementation manager, super admin" /></figure>
	<figure class="pdeck__card" data-part="1" data-tag="internal" tabindex="0" role="button" aria-label="David, NOC specialist, internal Amwell user"><img src="/amwell/cs/pc2.webp" alt="Persona: David, NOC specialist, tenant admin" /></figure>
	<figure class="pdeck__card" data-part="2" data-tag="client" tabindex="0" role="button" aria-label="Jennifer, health system admin, client"><img src="/amwell/cs/pc3.webp" alt="Persona: Jennifer, health system admin" /></figure>
	<figure class="pdeck__card pdeck__card--lite" data-part="3" data-tag="client" tabindex="0" role="button" aria-label="Client IT teams, client"><div class="pdeck__lite"><img src="/amwell/cs/av-it.webp" alt="" /><b>Client IT teams</b><small>ex. CVS Health IT team</small></div></figure>
	<p class="pdeck__call" data-for="0"><span class="ptag ptag--in"><img src="/brand/amwell-white.svg" alt="Amwell" />Internal user</span><small>Implementation manager</small>Builds and configures client instances across many tenants. Needs every configuration, and teaches clients the platform.</p>
	<p class="pdeck__call" data-for="1"><span class="ptag ptag--in"><img src="/brand/amwell-white.svg" alt="Amwell" />Internal user</span><small>NOC specialist</small>Supports the whole platform across clients. Troubleshoots anything, so needs broad access and the full architecture.</p>
	<p class="pdeck__call" data-for="2"><span class="ptag ptag--out">Client</span><small>Health system admin</small>Runs one organization: its service lines, provider network, and patient workflows. Only cares about hers.</p>
	<p class="pdeck__call" data-for="3"><span class="ptag ptag--out">Client</span><small>Client IT team</small>Ensures seamless integration between the Amwell platform and their organization’s existing IT systems.</p>
	<p class="eco__hint">Click a card to bring it forward.</p>
</div>`;

const inspo = `
<div class="insp">
	<figure><img src="/amwell/cs/in-shortcut.webp" alt="Shortcut’s side menu, expanded and then collapsed to an icon rail" /><figcaption><b>Shortcut</b>Collapses to an icon rail, so the work gets the room.</figcaption></figure>
	<figure><img src="/amwell/cs/in-bitbucket.webp" alt="Bitbucket’s side menu, a rail of icons with labels beside it" /><figcaption><b>Bitbucket</b>A slim rail stays put while the labeled menu opens beside it.</figcaption></figure>
	<figure><img src="/amwell/cs/in-sidebars.webp" alt="Side menu patterns in light and dark themes" /><figcaption><b>Light and dark sidebars</b>How grouping and active states hold up in both themes.</figcaption></figure>
</div>`;

const crz = `
<div class="crz" data-state="open">
	<div class="crz__stage">
		<img class="crz__img crz__img--open" src="/amwell/cs/cr-open.webp" alt="Expanded: the left menu with Tenants, Patients, Practitioners and Carepoint Devices beside the page" />
		<img class="crz__img crz__img--closed" src="/amwell/cs/cr-closed.webp" alt="Collapsed: the menu tucked into one tab, and the practitioner table gets the full width" />
		<span class="crz__note crz__note--open">Accordion sub-pages for multi-step setup</span>
		<span class="crz__note crz__note--closed">One tab stays behind. The table gets the width.</span>
	</div>
	<div class="crz__ctl" role="group" aria-label="Menu state">
		<button type="button" data-set="open" aria-pressed="true">Expanded</button>
		<button type="button" data-set="closed" aria-pressed="false">Collapsed</button>
	</div>
</div>`;

const spec = `
<div class="spec">
	<ul class="spec__sw">
		<li style="--c:#141414"><i></i><b>Header</b><span>#141414</span></li>
		<li style="--c:#1b1f23"><i></i><b>Page</b><span>#1B1F23</span></li>
		<li style="--c:#232a34"><i></i><b>Panel</b><span>#232A34</span></li>
		<li style="--c:#1b74d2"><i></i><b>Action</b><span>#1B74D2</span></li>
		<li style="--c:#b0d6ff"><i></i><b>Focus</b><span>#B0D6FF</span></li>
	</ul>
	<div class="spec__bar" aria-hidden="true"></div>
	<p class="spec__cap">The brand gradient, kept to one thin bar</p>
	<div class="spec__type">
		<img src="/amwell/cs/ty-title.webp" alt="Page title: Abundant Health (ABHL), large and semibold" />
		<img src="/amwell/cs/ty-table.webp" alt="Table text: medium headers, regular rows, zebra striping" />
		<p class="spec__cap">Open Sans: a large semibold title for orientation, small even table text for scanning</p>
	</div>
</div>`;

const wire = `
<div class="wf">
	<p class="wf__call wf__call--1"><b>1</b><span>A global nav for Amwell super admins, searching every patient, provider and device across all tenants. Each tier gets its own version.</span></p>
	<div class="wf__frames">
		<figure class="wf__a"><img src="/amwell/cs/wf-a.webp" alt="Wireframe: super admin home with recent activity, totals and a tenant table" /></figure>
		<figure class="wf__b"><img src="/amwell/cs/wf-b.webp" alt="Wireframe: the same home as a dashboard with tenant charts" /><i class="wf__pin wf__pin--1" style="--x:70%;--y:5.4%"><b>1</b></i><i class="wf__pin wf__pin--2" style="--x:79%;--y:71%"><b>2</b></i></figure>
	</div>
	<p class="wf__call wf__call--2"><b>2</b><span>I built this as a customizable dashboard. As I iterated, I learned admins don’t ordinarily open this data, so I cut it back.</span></p>
	<p class="wf__note">Made fast in brainstorming sessions, without existing components or a design system. Click a frame to expand.</p>
</div>`;

const dsx = `
<div class="dsb">
	<figure class="dsb__main"><img src="/amwell/cs/ds-comp.webp" alt="A sliding panel built from existing components: a header, a list of items and a content area" /><figcaption>Built from existing components</figcaption></figure>
	<figure><img src="/amwell/cs/ds-grid.webp" alt="The same panels with 24px spacing marked in pink" /><figcaption>Spaced on a 24px grid</figcaption></figure>
	<figure><img src="/amwell/cs/ds-modes.webp" alt="The panel at 1600px and 992px widths" /><figcaption>Checked at 1600 and 992 px</figcaption></figure>
</div>`;

const fws = `
<div class="fws" data-k="0">
	<div class="fws__stage">
		<figure data-i="0"><span class="fws__img"><img src="/amwell/cs/fw-1.webp" alt="The default page: a header and one content area" /><i class="fws__pin" style="--x:50%;--y:52%"></i></span></figure>
		<figure data-i="1"><span class="fws__img"><img src="/amwell/cs/fw-2.webp" alt="The collapse-rator expanded beside a tenant page" /><i class="fws__pin" style="--x:14%;--y:55%"></i></span></figure>
		<figure data-i="2"><span class="fws__img"><img src="/amwell/cs/fw-3.webp" alt="Three states of the menu with accordion sub-pages open" /><i class="fws__pin" style="--x:14%;--y:36%"></i></span></figure>
	</div>
	<div class="fws__tabs" role="tablist" aria-label="How the menu scales">
		<button type="button" data-k="0" aria-pressed="true"><b>1</b>Default page</button>
		<button type="button" data-k="1" aria-pressed="false"><b>2</b>The collapse-rator</button>
		<button type="button" data-k="2" aria-pressed="false"><b>3</b>Sub-pages</button>
	</div>
	<div class="fws__txt">
		<p data-i="0">I started from existing design system parts: one default page every admin screen is built on.</p>
		<p data-i="1">Then a side menu that expands and collapses. 65% of admins found the old static sidebar overwhelming.</p>
		<p data-i="2">Accordion sub-pages hold multi-step setup. Sections collapse to cut cognitive load and give data-heavy tasks the room.</p>
	</div>
</div>`;

const dkm = `
<div class="dkm">
	<div class="dkm__deck">
		<figure style="--i:0"><img src="/amwell/cs/dk-1.webp" alt="Dark mode: a tenant’s service lines" /></figure>
		<figure style="--i:1"><img src="/amwell/cs/dk-2.webp" alt="Dark mode: the tenant list across all tenants" /></figure>
		<figure style="--i:2"><img src="/amwell/cs/dk-3.webp" alt="Dark mode: the carepoint device list, with battery status in green, amber and red" /></figure>
	</div>
	<p class="dkm__set" aria-label="Appearance setting: dark by default, light available"><span>Appearance</span><b class="on">Dark · default</b><b>Light</b></p>
</div>`;

const gnv = `
<div class="gnv" data-s="1">
	<p class="gnv__who"><span aria-hidden="true">→</span>Amwell super admin · signed in with access to every tenant</p>
	<div class="gnv__slot gnv__slot--top">
		<p class="gnv__call gnv__call--1" data-s="1"><b>1</b><span><strong>Global nav, for this tier only.</strong> One bar to every tenant’s patients, practitioners and devices, so supporting a client never means switching tools.</span></p>
		<p class="gnv__call gnv__call--4" data-s="2"><b>4</b><span><strong>Switch clients without backing out.</strong> Search for another tenant from inside this one.</span></p>
	</div>
	<div class="gnv__frame">
		<figure data-s="1"><img src="/amwell/cs/gn-screen.webp" alt="All Tenants: the global nav across the top and a searchable tenant list" /><i class="gnv__hl" style="left:34%;top:0.6%;width:56%;height:6.6%"></i><i class="gnv__hl" style="left:3.5%;top:21.5%;width:59%;height:10%"></i><i class="gnv__pin gnv__pin--1" style="--x:62%;--y:3.5%"><b>1</b></i><i class="gnv__pin gnv__pin--2" style="--x:27%;--y:27%"><b>2</b></i></figure>
		<figure data-s="2"><img src="/amwell/cs/gn-tenant.webp" alt="Inside Abundant Health: breadcrumbs back to Tenants and a Search to Change Tenant box" /><i class="gnv__hl" style="left:2.5%;top:8.4%;width:18.5%;height:5%"></i><i class="gnv__hl" style="left:74.5%;top:13.6%;width:23%;height:6.6%"></i><i class="gnv__pin gnv__pin--3" style="--x:11.5%;--y:10.8%"><b>3</b></i><i class="gnv__pin gnv__pin--4" style="--x:86%;--y:17%"><b>4</b></i></figure>
	</div>
	<div class="gnv__slot gnv__slot--bot">
		<p class="gnv__call gnv__call--2" data-s="1"><b>2</b><span><strong>Every client in one list.</strong> Search tenants by name or ID, then open one to work inside it.</span></p>
		<p class="gnv__call gnv__call--3" data-s="2"><b>3</b><span><strong>Always know where you are.</strong> Breadcrumbs show the path back to every tenant.</span></p>
	</div>
	<div class="gnv__tabs" role="group" aria-label="Where the super admin is">
		<button type="button" data-s="1" aria-pressed="true">All tenants</button>
		<button type="button" data-s="2" aria-pressed="false">Inside a tenant</button>
	</div>
</div>`;

const gcl = `
<div class="gnv gnv--cl" data-s="1">
	<p class="gnv__who gnv__who--av"><img src="/amwell/cs/av-client.webp" alt="" />Client super admin · Abundant Health telehealth program director</p>
	<div class="gnv__slot gnv__slot--top">
		<p class="gnv__call gnv__call--5" data-s="1"><b>1</b><span><strong>No global nav.</strong> Just Home, their own tenant, admin management and products. They only work in one organization, so that’s all they see.</span></p>
