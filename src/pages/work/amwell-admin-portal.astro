---
import DandyScroll from '../../layouts/DandyScroll.astro';
import type { Beat } from '../../data/dandy-scroll-types';

const A = '/amwell/cs';
const scenes: { id: string; label: string; nav: string; beats: Beat[] }[] = [
	{
		id: 'context',
		label: '01 · The context',
		nav: 'The context',
		beats: [
			{
				title: 'The admin portal is the control hub.',
				text: 'Amwell connects patients and providers for virtual visits. The admin portal is where healthcare organizations configure the experience both sides see: service lines, provider networks, clinical rules, and patient access.',
				media: { kind: 'image', src: `${A}/how.webp`, alt: 'The admin portal sits between the patient portal and the provider portal' },
			},
			{
				title: 'Two kinds of admins, four roles.',
				text: 'Amwell’s own implementation managers and NOC agents build and support the platform. Clients like CVS Health, through their health system admins and IT teams, manage their own instance.',
				media: { kind: 'image', src: `${A}/users.webp`, alt: 'Internal and external users of the Amwell admin portal' },
			},
			{
				title: 'My role: Senior Product Designer.',
				text: 'I led design, with a couple of other designers, alongside PM, engineering, and architecture. In a design sprint, our goal was everything needed to plan, size, and build the first release of Converge Admin: MVP scope, a sitemap, the navigation system, and a prototype.',
			},
		],
	},
	{
		id: 'problem',
		label: '02 · The problem',
		nav: 'The problem',
		beats: [
			{
				title: 'Leadership asked to “make it faster.”',
				text: 'The portal had become a major pain point, used by internal teams and clients like CVS Health and Cleveland Clinic. The real problem was a complex, outdated structure that made even small tasks cumbersome.',
				media: { kind: 'image', src: `${A}/context.webp`, alt: 'The legacy admin portal, with a callout about navigation inefficiencies' },
			},
			{
				title: 'Navigation was behind a third of support tickets.',
				text: 'Across 400+ users, support tickets tied to navigation and workflow inefficiencies were piling up.',
				metric: { to: 30, suffix: '%', unit: 'of support tickets tied to navigation and workflow' },
			},
			{
				title: 'Tickets, shadowing, and interviews.',
				text: 'We analyzed 3 months of support tickets, ran 5 shadowing sessions and 8 contextual interviews, and mapped workflows across the departments that touch the portal. Three pain points surfaced: navigation confusion, unclear role-based access, and task completion barriers.',
				quote: ['“I spend more time figuring out how to do things than actually doing them.”', 'Admin, contextual interview'],
			},
			{
				title: 'Three roles, three very different needs.',
				text: 'Implementation managers configure everything across many clients. NOC specialists troubleshoot the whole platform. Health system admins only care about their own organization.',
				quote: ['“When looking for something specific, I need to ask if someone else knows or search random words in the platform. There is no documentation.”', 'Senior implementation manager, interview'],
				media: { kind: 'image', src: `${A}/persona1.webp`, alt: 'The implementation manager persona' },
			},
			{
				title: 'Three tiers of access.',
				text: 'Amwell super admins, tenant super admins, and tenant basic admins each need a different slice of the same system.',
				media: { kind: 'image', src: `${A}/tiers.webp`, alt: 'Access, role, responsibilities and configurations for each admin tier' },
			},
		],
	},
	{
		id: 'findings',
		label: '03 · What we found',
		nav: 'What we found',
		beats: [
			{
				title: 'Admins lost 40% of their time switching tools.',
				text: 'Different roles needed different information hierarchies, but everyone got the same sprawling structure.',
				metric: { to: 40, suffix: '%', unit: 'of admin time spent switching between tools' },
			},
			{
				title: 'No clear paths meant 2+ weeks of training.',
				text: 'And the jargon was inconsistent: doctor, provider, and clinician; tenant, instance, and client. Same thing, different words.',
				media: { kind: 'image', src: `${A}/jargon.webp`, alt: 'A board of technical jargon and definitions' },
			},
			{
				title: 'Two focus areas.',
				text: 'A dashboard that is a snapshot of the most important features. And a navigation framework that is intuitive, scalable, and gets people to features, configurations, and tools quickly.',
			},
			{
				title: 'Who can do what, mapped.',
				text: 'A permissions matrix made every capability explicit, so the interface could show each admin only what applies to them.',
				media: { kind: 'image', src: `${A}/matrix.webp`, alt: 'A matrix of features by admin tier' },
			},
		],
	},
	{
		id: 'options',
		label: '04 · The options',
		nav: 'The options',
		beats: [
			{
				title: 'Align on language first.',
				text: 'UX audit and terminology workshops across 8 departments produced a standard enterprise dictionary, then a refined sitemap.',
				media: { kind: 'image', src: `${A}/sitemaps.webp`, alt: 'Sitemaps for the redesigned admin portal' },
			},
			{
				title: 'Option 1: separate interfaces.',
				text: 'Different entry points per admin type. Clear separation of concerns, but users with multiple roles would need multiple logins, and engineering would maintain multiple codebases.',
				media: { kind: 'image', src: `${A}/sketches.webp`, alt: 'Sketches and trade-offs for the separate interface approach' },
			},
			{
				title: 'Option 2: permission toggles.',
				text: 'One interface with switches. Simpler to maintain, but users found switching context confusing, and it was inefficient for super admins.',
			},
			{
				title: 'Option 3: a contextual interface. Selected.',
				text: 'Dynamic global navigation for super admins, context-aware components by user type, and progressive disclosure by role. One codebase, built from reusable components, that scales to new roles and features.',
				media: { kind: 'image', src: `${A}/final.webp`, alt: 'The contextual interface solution, with key features and why it won' },
			},
		],
	},
	{
		id: 'build',
		label: '05 · The build',
		nav: 'The build',
		beats: [
			{
				title: 'Feedback every day, from every side.',
				text: 'Daily check-ins with engineering, rapid prototype testing, feasibility reviews, stakeholder email threads, and unmoderated testing kept the design honest.',
				quote: ['“I find it intuitive to access my global nav settings and I like the clear distinction between those settings and settings for tenant level.”', 'Admin, usability test'],
				media: { kind: 'image', src: `${A}/feedback.webp`, alt: 'Feedback threads and review meetings' },
			},
			{
				title: 'Wireframes first, then cut what didn’t matter.',
				text: 'The first dashboard was a customizable home for super admins. As we iterated, we learned admins don’t ordinarily open that data, so the dashboard got lighter.',
				media: { kind: 'image', src: `${A}/wires.webp`, alt: 'Early wireframes of the global nav and dashboard' },
			},
			{
				title: 'Built on the existing design system.',
				text: 'We moved from rough wireframes to Amwell’s provider and patient components for consistency. Desktop first, since 99.8% of admins use desktop.',
				media: { kind: 'image', src: `${A}/dsys.webp`, alt: 'Layout explorations using the Amwell design system' },
			},
			{
				title: 'Introducing the “collapse-rator.”',
				text: 'A scalable side menu that expands and collapses with accordion sub-pages for multi-step processes. 65% of admins found the old static sidebar overwhelming.',
				media: { kind: 'image', src: `${A}/framework.webp`, alt: 'The default view, the collapse-rator, and the scalable accordion menu' },
			},
			{
				title: 'One tray for every outside tool.',
				text: 'Admins were juggling Looker, Jira, Salesforce, the provisioning server and more. I designed a My Tools tray: their own quick links to deep pages, plus every external tool one click away.',
				media: { kind: 'image', src: `${A}/fig-tools.webp`, alt: 'The My Tools tray with quick links and external tools' },
			},
			{
				title: 'Leadership pushed back. The design got sharper.',
				text: 'Reviews flagged the same items in the top and side navigation. So the tenant became a switcher at the top of every page, with one left nav beneath it. “Home” became “Dashboard,” and patient search never preloads results, so no one sees patient data they didn’t search for.',
				media: { kind: 'image', src: `${A}/fig-tenant.webp`, alt: 'A tenant summary page with the tenant switcher at the top' },
			},
			{
				title: 'Built to scale in code.',
				text: 'Context management, dynamic component rendering, permission management, and feature flags, so one codebase serves every role.',
				media: { kind: 'image', src: `${A}/tech.webp`, alt: 'The technical architecture for the contextual interface' },
			},
			{
				title: 'A dark mode for long sessions.',
				text: 'Admins live in this tool all day. The final system shipped with a dark mode designed to the same standards.',
				media: { kind: 'image', src: `${A}/dark.webp`, alt: 'Dark mode screens' },
			},
		],
	},
	{
		id: 'final',
		label: '06 · The final designs',
		nav: 'Final designs',
		beats: [
			{
				title: 'A dashboard that starts the day.',
				text: 'Recent activity for me, my team, or everyone. Platform totals at a glance, with visit charts that open in Looker. Hide the menu for more room without losing your place.',
				media: { kind: 'image', src: `${A}/fig-collapsed.webp`, alt: 'The All Tenants dashboard with the side menu collapsed' },
			},
			{
				title: 'For the Amwell super admin: a global view.',
				text: 'A tenant list with search and add. Global navigation to every tenant, patient, provider, and device.',
				media: { kind: 'image', src: `${A}/hifi1.webp`, alt: 'The global nav and tenant list for Amwell super admins' },
			},
			{
				title: 'Never lose your place.',
				text: 'Global search stays available inside a tenant, and breadcrumbs show how you got there.',
				media: { kind: 'image', src: `${A}/hifi2.webp`, alt: 'Global search and breadcrumbs inside a tenant' },
			},
			{
				title: 'For the client super admin: just their tenant.',
				text: 'No global nav, because they don’t need it. Client-specific navigation and an audit trail show when information last changed.',
				media: { kind: 'image', src: `${A}/client.webp`, alt: 'The client-specific navigation and audit trail' },
			},
			{
				title: 'Add and configure service lines.',
				text: 'Super admins add service lines within their organization and change their configuration.',
				media: { kind: 'image', src: `${A}/addsl.webp`, alt: 'Adding a service line and configuration access' },
			},
			{
				title: 'The same system, more screens.',
				text: 'Service line details, a guided add flow, patients, and practitioners, all from the same components.',
				media: { kind: 'image', src: `${A}/screens.webp`, alt: 'Service line, patient, and practitioner screens' },
			},
			{
				title: 'For tenant admins: manage, not add.',
				text: 'Department managers manage service lines, configure workflow and branding, and see only what applies to them. Help desk staff get view-only access.',
				media: { kind: 'image', src: `${A}/tenant.webp`, alt: 'The tenant basic admin view' },
			},
		],
	},
	{
		id: 'impact',
		label: '07 · The impact',
		nav: 'The impact',
		beats: [
			{ title: 'Admins finished their tasks.', text: 'Task completion rose with role-based access controls and a navigation framework built for each admin.', metric: { text: '45% → 82%', unit: 'task completion rate, user testing' } },
			{ title: 'New admins ramped faster.', text: 'Clear pathways for common tasks cut the onboarding time for new admins.', metric: { to: 30, suffix: '%', unit: 'faster admin onboarding' } },
			{ title: 'Fewer mistakes.', text: 'Role-based access meant admins only saw what applied to them.', metric: { to: 34, suffix: '%', unit: 'fewer configuration errors' } },
			{ title: 'Clients went live sooner.', text: 'A predictable system made client setup quicker for implementation teams.', metric: { to: 25, suffix: '%', unit: 'faster client implementations' } },
			{ title: 'Eight teams, one vocabulary.', text: 'The terminology workshops aligned eight internal teams on the same words for the same things.', metric: { to: 8, unit: 'internal teams on unified terminology' } },
		],
	},
	{
		id: 'reflect',
		label: '08 · Reflection',
		nav: 'Reflection',
		beats: [
			{
				title: 'Enterprise UX runs on shared words.',
				text: 'As project lead, I learned that aligning cross-functional teams on basic definitions unlocks faster development and adoption.',
			},
			{
				title: 'One framework, many users.',
				text: 'Thoughtful information architecture can serve very different needs while still scaling. The navigation framework proved it, from basic support views to complex multi-tenant configurations.',
			},
			{
				title: 'What I recommended after the MVP.',
				text: 'Smart search on every list instead of separate fields. One Practitioners area instead of two overlapping ones. Launch status and a point person in the tenant list. And testing the final prototype with a panel of admin stakeholders.',
				links: [{ href: '/work/amwell', label: '← Amwell overview' }],
			},
		],
	},
];
---

<DandyScroll
	title="Amwell Admin Portal"
	description="Redesigning Amwell's admin portal into one scalable, role-based platform. Task completion rose from 45% to 82% in usability testing."
	eyebrow="Amwell · Senior Product Designer"
	heroTitle="From “make it faster” to a platform that scales."
	lede="Amwell’s admin portal was fragmented and hard to navigate. I redesigned it as one role-based system, and task completion rose from 45% to 82% in usability testing."
	tools="Figma · User testing · Converge design system"
	hero={{ src: '/amwell/cs/hero.webp', image: true, alt: 'The redesigned Amwell admin dashboard on a laptop' }}
	scenes={scenes}
	endTitle="One platform for every kind of admin."
	endText="Healthcare organizations now configure the patient and provider experience from a single, role-aware system."
	endLinks={[{ href: '/work/amwell', label: '← Amwell overview' }, { href: '/work', label: 'All work', ghost: true }]}
	brand={{ logo: '/brand/amwell-white.svg', alt: 'Amwell', backHref: '/work/amwell', backLabel: '← Amwell overview', cls: 'amw' }}
/>
