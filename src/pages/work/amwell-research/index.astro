---
import Base from '../../../layouts/Base.astro';
import { studies } from '../../../data/amwell-research';
const areas = [...new Set(studies.map((s) => s.area))];
---

<Base title="Amwell research" description="Fifteen research studies I ran at Amwell, and what changed because of each.">
	<section class="ar">
		<div class="shell ar__in">
			<a class="ar__back" href="/work/amwell">← Amwell</a>
			<p class="ar__k">Amwell · 2019 – 2024</p>
			<h1>Fifteen studies, and what changed.</h1>
			<p class="ar__lede">I led about 86% of our team’s research: interviews, usability tests, competitor analyses and needs assessments across patients, providers and admins. Each study ends with what actually shipped.</p>
			{areas.map((a) => (
				<div class="ar__group">
					<p class="ar__label">{a}</p>
					<ul>
						{studies.filter((s) => s.area === a).map((s) => (
							<li><a href={`/work/amwell-research/${s.slug}`}><b>{s.t}</b><span>{s.finding}</span><small>{s.method}</small></a></li>
						))}
					</ul>
				</div>
			))}
		</div>
	</section>
</Base>

<style>
	.ar { padding: clamp(2rem, 6vw, 4rem) 0 5rem; }
	.ar__in { max-width: 44rem; }
	.ar__back { color: var(--muted); text-decoration: none; font-size: 0.88rem; }
	.ar__k { margin: 2.5rem 0 0.75rem; font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
	.ar h1 { font-size: clamp(2.2rem, 5vw, 3.3rem); line-height: 1.04; letter-spacing: -0.035em; margin: 0; max-width: 16ch; }
	.ar__lede { margin: 1rem 0 0; font-size: 1.08rem; line-height: 1.6; color: var(--muted); }
	.ar__group { margin-top: 2.5rem; }
	.ar__label { margin: 0 0 0.5rem; font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
	.ar ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
	.ar li { border-bottom: 1px solid var(--line); }
	.ar li a { display: grid; grid-template-columns: 1fr auto; gap: 0.2rem 1rem; padding: 0.9rem 0; color: inherit; text-decoration: none; }
	.ar li b { font-weight: 600; }
	.ar li small { font-family: var(--mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); grid-row: 1; grid-column: 2; }
	.ar li span { grid-column: 1 / -1; color: var(--muted); font-size: 0.92rem; line-height: 1.45; }
	.ar li a:hover b { color: var(--accent); }
</style>
