---
import Base from '../../../layouts/Base.astro';
import { studies } from '../../../data/amwell-research';

const featured = [
	{ s: studies.find((x) => x.slug === 'choosing-care')!, img: '/amwell-research/choosing-care/screens/final-care.webp', impact: [{ v: '−18%', l: 'cancellations' }, { v: '+12%', l: 'patient satisfaction' }], line: 'I traced rising cancellations to how patients choose care, then led the redesign.' },
	{ s: studies.find((x) => x.slug === 'dependent-care')!, img: '/amwell-research/dependent-care/scr-who.webp', impact: [{ v: '~40%', l: 'of canceled visits tied to it, per providers' }, { v: '14', l: 'interviews' }], line: 'I found why visits for children kept getting canceled, on a single screen.' },
];
const rest = studies.filter((x) => !featured.some((f) => f.s.slug === x.slug));
const areas = ['All', ...new Set(rest.map((s) => s.area))];
---

<Base title="Amwell research" description="I led about 86% of Amwell’s user research. Here’s what it changed.">
	<section class="ar">
		<div class="shell ar__in">
			<a class="ar__back" href="/work/amwell">← Amwell</a>

			<header class="ar__head">
				<p class="ar__k">Amwell research · 2019 – 2024</p>
				<h1>I led 86% of our research. Here’s what it changed.</h1>
				<ul class="ar__impact">
					<li><b>−18%</b><span>canceled visits</span></li>
					<li><b>65% → 92%</b><span>task completion</span></li>
					<li><b>15</b><span>studies, each tied to a shipped change</span></li>
				</ul>
			</header>

			<h2 class="ar__h2">Start with these</h2>
			<div class="feat">
				{featured.map((f) => (
					<a class="feat__card" href={`/work/amwell-research/${f.s.slug}`}>
						<span class="feat__img"><img src={f.img} alt="" loading="lazy" /></span>
						<span class="feat__body">
							<small>{f.s.area} · {f.s.method}</small>
							<b>{f.s.t}</b>
							<span class="feat__line">{f.line}</span>
							<span class="feat__nums">{f.impact.map((n) => <span><strong>{n.v}</strong>{n.l}</span>)}</span>
							<span class="feat__go">Read the study →</span>
						</span>
					</a>
				))}
			</div>

			<h2 class="ar__h2">More studies</h2>
			<div class="filter" role="group" aria-label="Filter by area">
				{areas.map((a, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-a={a}>{a}</button>)}
			</div>
			<ul class="list">
				{rest.map((s) => (
					<li data-a={s.area}>
						<a href={`/work/amwell-research/${s.slug}`}>
							<span class="list__main"><b>{s.t}</b><span>{s.result ?? `Shipped: ${s.changed[0]}`}</span></span>
							<small>{s.method}</small>
							<i aria-hidden="true">→</i>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>
</Base>

<script>
	const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter button'));
	const rows = Array.from(document.querySelectorAll<HTMLElement>('.list li'));
	const apply = (a: string) => {
		btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.a === a)));
		rows.forEach((r) => (r.hidden = a !== 'All' && r.dataset.a !== a));
		try { sessionStorage.setItem('ar-filter', a); } catch {}
	};
	btns.forEach((b) => b.addEventListener('click', () => apply(b.dataset.a!)));
	try { const saved = sessionStorage.getItem('ar-filter'); if (saved && btns.some((b) => b.dataset.a === saved)) apply(saved); } catch {}
</script>

<style>
	.ar { padding: clamp(2rem, 6vw, 4rem) 0 5rem; }
	.ar__in { max-width: 54rem; }
	.ar__back { color: var(--muted); text-decoration: none; font-size: 0.88rem; }
	.ar__back:hover { color: var(--ink); }
	.ar__head { margin: 2rem 0 3.5rem; }
	.ar__k { margin: 0 0 0.75rem; font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
	.ar h1 { font-size: clamp(2.1rem, 5vw, 3.2rem); line-height: 1.05; letter-spacing: -0.035em; margin: 0; max-width: 17ch; }
	.ar__impact { list-style: none; margin: 1.75rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 1rem; overflow: hidden; }
	.ar__impact li { background: var(--bg); padding: 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.3rem; }
	.ar__impact b { font-family: var(--display); font-size: clamp(1.4rem, 3vw, 1.9rem); letter-spacing: -0.03em; line-height: 1; }
	.ar__impact span { color: var(--muted); font-size: 0.85rem; }
	.ar__h2 { margin: 0 0 1rem; font-family: var(--mono); font-size: 0.74rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }

	.feat { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 3.5rem; }
	.feat__card { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1.1rem; padding: 1.1rem; border-radius: 1.2rem; border: 1px solid var(--line); background: var(--paper); color: inherit; text-decoration: none; transition: border-color 0.2s, transform 0.2s; }
	.feat__card:hover { border-color: var(--accent); transform: translateY(-2px); }
	.feat__img { align-self: start; aspect-ratio: 9 / 19; padding: 0.22rem; border-radius: 1rem; background: #111; overflow: hidden; }
	.feat__img img { width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 0.8rem; display: block; background: #fff; }
	.feat__body { display: flex; flex-direction: column; gap: 0.45rem; }
	.feat__body small { font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
	.feat__body b { font-size: 1.15rem; line-height: 1.2; }
	.feat__line { color: var(--muted); font-size: 0.9rem; line-height: 1.45; }
	.feat__nums { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; margin-top: 0.2rem; font-size: 0.8rem; color: var(--muted); }
	.feat__nums strong { display: block; font-family: var(--display); font-size: 1.35rem; color: var(--ink); letter-spacing: -0.02em; }
	.feat__go { margin-top: auto; padding-top: 0.4rem; font-weight: 600; font-size: 0.88rem; color: var(--accent); }

	.filter { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.75rem; }
	.filter button { padding: 0.4rem 0.8rem; border-radius: 99px; border: 1px solid var(--line); background: none; color: var(--muted); font: inherit; font-size: 0.82rem; cursor: pointer; }
	.filter button:hover { color: var(--ink); }
	.filter button[aria-pressed='true'] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
	.list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
	.list li { border-bottom: 1px solid var(--line); }
	.list li[hidden] { display: none; }
	.list a { display: grid; grid-template-columns: 1fr auto 1.2rem; gap: 1rem; align-items: center; padding: 0.95rem 0.25rem; color: inherit; text-decoration: none; }
	.list__main { display: flex; flex-direction: column; gap: 0.15rem; }
	.list__main b { font-weight: 600; }
	.list__main span { color: var(--muted); font-size: 0.88rem; }
	.list small { font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
	.list i { font-style: normal; color: var(--muted); transition: transform 0.2s, color 0.2s; }
	.list a:hover b { color: var(--accent); }
	.list a:hover i { transform: translateX(3px); color: var(--accent); }
	@media (max-width: 720px) {
		.feat, .ar__impact { grid-template-columns: 1fr; }
		.list a { grid-template-columns: 1fr 1.2rem; }
		.list small { display: none; }
	}
</style>
