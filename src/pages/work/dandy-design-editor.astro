<script>
	import { natTop, railLabels, tocPreview } from '../../scripts/takeover';
	const root = document.querySelector<HTMLElement>('[data-cx]');
	if (root && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
		const mob = window.matchMedia('(max-width: 899px)').matches;
		root.classList.add('is-live', 'cx--live');
		// phones: no pinned scroll scenes. Hero stays animated; everything else is a calm vertical read.
		if (mob) root.classList.add('cx--mob');
		// The layout is chosen once, at load. Crossing the phone breakpoint (resizing a window, rotating a device) reloads so nothing is left half-applied.
		{
			const mq = window.matchMedia('(max-width: 899px)');
			let t = 0;
			mq.addEventListener('change', () => { clearTimeout(t); t = window.setTimeout(() => location.reload(), 150); });
		}

		// fade-up for the simple chapters
		const io = new IntersectionObserver(
			(es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
			{ rootMargin: '0px 0px -12% 0px', threshold: 0.1 },
		);
		root.querySelectorAll('[data-fade]').forEach((el) => io.observe(el));

		// scenes: scrolling steps through small beats, one at a time
		const scenes = Array.from(root.querySelectorAll<HTMLElement>('[data-scene]')).map((el) => ({
			el,
			rows: Array.from(el.querySelectorAll<HTMLElement>('.sc__row')),
			dots: Array.from(el.querySelectorAll<HTMLElement>('.sc__dots li')),
			last: -1,
		}));
		const tick = () => {
			for (const s of scenes) {
				const r = s.el.getBoundingClientRect();
				const p = Math.max(0, Math.min(0.9999, -r.top / Math.max(1, r.height - window.innerHeight)));
				const i = Math.min(s.rows.length - 1, Math.floor(p * s.rows.length));
				if (i === s.last) continue;
				s.last = i;
				s.rows.forEach((row, k) => {
					row.classList.toggle('on', k === i);
					const v = row.querySelector('video');
					if (v) { if (k === i) v.play().catch(() => {}); else v.pause(); }
					if (k === i) countUp(row);
				});
				s.dots.forEach((d, k) => d.classList.toggle('on', k === i));
			}
		};
		const countUp = (row: HTMLElement) => {
			const el = row.querySelector<HTMLElement>('[data-count]');
			if (!el) return;
			const to = Number(el.dataset.count), pre = el.dataset.prefix ?? '', suf = el.dataset.suffix ?? '';
			const t0 = performance.now();
			const step = (t: number) => {
				const k = Math.min(1, (t - t0) / 1100);
				const e = 1 - Math.pow(1 - k, 3);
				el.textContent = pre + Math.round(to * e).toLocaleString('en-US') + suf;
				if (k < 1) requestAnimationFrame(step);
			};
			requestAnimationFrame(step);
		};
		let raf = 0;
		if (mob) {
				scenes.forEach((s) => s.rows.forEach((row) => {
					const v = row.querySelector('video');
					const react = () => {
						if (row.classList.contains('on')) { if (!row.dataset.counted) { row.dataset.counted = '1'; countUp(row); } v?.play().catch(() => {}); }
						else v?.pause();
					};
					new MutationObserver(react).observe(row, { attributes: true, attributeFilter: ['class'] });
					react();
				}));
			document.querySelectorAll<HTMLVideoElement>('video[data-mvid]').forEach((v) => {
				new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) v.play().catch(() => {}); else v.pause(); }), { threshold: 0.3 }).observe(v);
			});
		} else {
			addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(tick); }, { passive: true });
			addEventListener('resize', tick);
			tick();
		}
	} else {
		document.querySelectorAll('.sc video').forEach((v) => { (v as HTMLVideoElement).autoplay = true; });
	}

	// Which phase of a tall pinned section is on screen (the journey has weighted phases, scenes are even).
	const jrPhase = (sec: HTMLElement) => {
		const w: number[] = JSON.parse(sec.dataset.w || '[1]');
		const total = w.reduce((a, b) => a + b, 0);
		const r = sec.getBoundingClientRect();
		const p = Math.max(0, Math.min(0.9999, -r.top / Math.max(1, r.height - window.innerHeight))) * total;
		let acc = 0;
		for (let i = 0; i < w.length; i++) { acc += w[i]; if (p < acc) return i; }
		return w.length - 1;
	};
	// The journey: one pinned section. Progress picks a phase; cards come in, dim, and the designer step zooms in.
	const clamp01 = (n: number) => Math.max(0, Math.min(1, n));
	document.querySelectorAll<HTMLElement>('[data-journey]').forEach((sec) => {
		if (!sec.closest('.cx--live') || sec.closest('.cx--mob')) return;
		const items = Array.from(sec.querySelectorAll<HTMLElement>('[data-p]'));
		const total = Number(getComputedStyle(sec).getPropertyValue('--n')) || 1;
		const zoomAt = items.filter((e) => e.classList.contains('lc__card')).length + 1; // first phase after the six cards
		let last = -1;
		const tick = () => {
			const r = sec.getBoundingClientRect();
			const p = jrPhase(sec);
			if (p === last) return;
			last = p;
			items.forEach((e) => {
				const k = Number(e.dataset.p);
				e.classList.toggle('on', k === p);
				e.classList.toggle('seen', k <= p);
			});
			sec.classList.toggle('z7', p === zoomAt);
			sec.classList.toggle('z8', p > zoomAt);
		};
		addEventListener('scroll', () => requestAnimationFrame(tick), { passive: true });
		addEventListener('resize', tick);
		tick();
	});

	// Expand a designer sub-step: bigger media plus the same explanation.
	const modal = document.querySelector<HTMLDialogElement>('[data-modal]');
	if (modal) {
		const cards = Array.from(document.querySelectorAll<HTMLElement>('.jr__subcard'));
		const mm = modal.querySelector<HTMLElement>('[data-mmedia]')!;
		const mt = modal.querySelector<HTMLElement>('[data-mtext]')!;
		const count = modal.querySelector<HTMLElement>('[data-mcount]')!;
		let cur = 0;
		const open = (i: number) => {
			cur = (i + cards.length) % cards.length;
			const card = cards[cur];
			const src = card.querySelector<HTMLElement>('[data-media]');
			mm.textContent = '';
			if (src instanceof HTMLVideoElement) {
				const v = document.createElement('video');
				v.src = src.currentSrc || src.src; v.poster = src.poster; v.muted = true; v.loop = true; v.autoplay = true; v.controls = true; v.playsInline = true;
				mm.append(v);
				v.play().catch(() => {});
			} else if (src instanceof HTMLImageElement) {
				const im = document.createElement('img'); im.src = src.src; im.alt = ''; mm.append(im);
			}
			mm.hidden = !src;
			const text = document.querySelector<HTMLElement>(`.lc__t[data-p="${card.dataset.p}"]`);
			mt.textContent = '';
			const tag = document.createElement('span'); tag.className = 'jr__tag jr__tag--m'; tag.textContent = card.querySelector('.jr__tag')?.textContent ?? '';
			mt.append(tag);
			if (text) for (const n of Array.from(text.children)) mt.append(n.cloneNode(true));
			count.textContent = `${cur + 1} of ${cards.length}`;
			if (!modal.open) modal.showModal();
		};
		cards.forEach((c, i) => {
			c.addEventListener('click', () => open(i));
			c.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(i); } });
		});
		modal.querySelector('[data-close]')!.addEventListener('click', () => modal.close());
		modal.querySelector('[data-prev]')!.addEventListener('click', () => open(cur - 1));
		modal.querySelector('[data-next]')!.addEventListener('click', () => open(cur + 1));
		modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
		modal.addEventListener('close', () => { mm.textContent = ''; });
	}

	// Page navigator: highlights where you are, jumps to sections and sub-sections.
	const toc = document.querySelector<HTMLElement>('[data-toc]');
	if (toc) {
		const live = !!document.querySelector('.cx--live') && !document.querySelector('.cx--mob');
		const items = Array.from(toc.querySelectorAll<HTMLElement>('.toc__item'));
		const rail = Array.from(toc.querySelectorAll<HTMLElement>('[data-rail]'));
		railLabels(items, rail);
		tocPreview(toc);
		const secOf = (id: string) => document.getElementById(id)!;
		const phases = (sec: HTMLElement) => (sec.hasAttribute('data-journey') ? (JSON.parse(sec.dataset.w || '[1]') as number[]) : Array.from(sec.querySelectorAll('.sc__row')).map(() => 1));
		const phaseNow = (sec: HTMLElement) => {
			if (sec.hasAttribute('data-journey')) return jrPhase(sec);
			const n = sec.querySelectorAll('.sc__row').length || 1;
			const r = sec.getBoundingClientRect();
			return Math.min(n - 1, Math.floor(Math.max(0, Math.min(0.9999, -r.top / Math.max(1, r.height - innerHeight))) * n));
		};
		const goTo = (id: string, i?: number) => {
			const sec = secOf(id);
			if (!sec) return;
			const top = natTop(sec) + scrollY;
			if (i == null || !sec.matches('[data-journey], [data-scene]')) { scrollTo({ top: id === 'cx-top' ? 0 : top - 70, behavior: 'smooth' }); return; }
			if (live) {
				const w = phases(sec);
				const total = w.reduce((a, b) => a + b, 0);
				const start = w.slice(0, i).reduce((a, b) => a + b, 0) + w[i] * 0.5;
				scrollTo({ top: top + (start / total) * (sec.offsetHeight - innerHeight), behavior: 'smooth' });
			} else {
				const target = sec.hasAttribute('data-journey') ? sec.querySelector(`.lc__t[data-p="${i}"]`) : sec.querySelectorAll('.sc__row')[i];
				(target as HTMLElement | null)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		};
		toc.querySelectorAll<HTMLAnchorElement>('a[data-go]').forEach((a) =>
			a.addEventListener('click', (e) => {
				e.preventDefault();
				goTo(a.dataset.go!, a.dataset.i != null ? Number(a.dataset.i) : undefined);
			}),
		);
		let tocRaf = 0;
		const tocTick = () => {
			let cur = 0;
			items.forEach((it, k) => { if (natTop(secOf(it.dataset.sec!)) <= innerHeight * 0.35) cur = k; });
			items.forEach((it, k) => it.classList.toggle('on', k === cur));
			rail.forEach((r, k) => r.classList.toggle('on', k === cur));
			const sec = secOf(items[cur].dataset.sec!);
			const subs = Array.from(items[cur].querySelectorAll('.toc__sub a'));
			if (subs.length && sec.matches('[data-journey], [data-scene]')) {
				const pi = phaseNow(sec);
				subs.forEach((a) => a.classList.toggle('on', pi >= Number((a as HTMLElement).dataset.i) && pi <= Number((a as HTMLElement).dataset.to)));
			}
		};
		addEventListener('scroll', () => { cancelAnimationFrame(tocRaf); tocRaf = requestAnimationFrame(tocTick); }, { passive: true });
		addEventListener('resize', tocTick);
		tocTick();
	}

	// 3D cover: loads once the stage is near the screen, falls back to the video if WebGL or the files fail.
	const h3 = document.querySelector<HTMLElement>('[data-hero3d]');
	// the video stays hidden until we know the 3D scan isn't coming
	const showVideo = () => h3?.querySelector('.h3d__stage')?.classList.add('is-fb');
	if (!h3 || matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) showVideo();
	if (h3 && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
		const stage = h3.querySelector<HTMLElement>('.h3d__stage')!;
		const pin = h3.querySelector<HTMLElement>('.h3d__pin')!;
		const heroCardEls = Array.from(h3.querySelectorAll<HTMLElement>('.h3d__card'));
		const progress = () => {
			const r = h3.getBoundingClientRect();
			const stick = parseFloat(getComputedStyle(pin).top) || 0;
			return clamp01((stick - r.top) / Math.max(1, r.height - pin.offsetHeight));
		};
		// metric cards slide in one by one as the animation plays (works with or without WebGL)
		const cardAt = [0.1, 0.36, 0.6, 0.8];
		const showCards = () => { const p = progress(); heroCardEls.forEach((c, i) => c.classList.toggle('in', p >= cardAt[i])); };
		addEventListener('scroll', () => requestAnimationFrame(showCards), { passive: true });
		addEventListener('resize', showCards);
		showCards();
		const hio = new IntersectionObserver(async (es) => {
			if (!es.some((e) => e.isIntersecting)) return;
			hio.disconnect();
			try {
				const probe = document.createElement('canvas');
				if (!(probe.getContext('webgl2') || probe.getContext('webgl'))) { showVideo(); return; }
				const heroUrl = '/work/dde/hero3d.js';
				const mod = await (new Function('u', 'return import(u)') as (u: string) => Promise<any>)(heroUrl);
				const hero = await mod.mountHero(stage, progress);
				stage.classList.add('is-3d');
				(window as any).__hero = hero;
			} catch (err) {
				console.warn('3D cover unavailable, keeping the video', err);
				showVideo();
			}
		}, { rootMargin: '300px' });
		hio.observe(h3);
	}
</script>

<script>
	import { stackSections, wireDots } from '../../scripts/takeover';
	// each section takes over the screen and replaces the previous one
	const root = document.querySelector<HTMLElement>('[data-cx]');
	if (root) {
		const els = Array.from(root.querySelectorAll<HTMLElement>(':scope > header.cx__hero, :scope > section, :scope > .lc')).filter((e) => !e.matches('dialog'));
		stackSections(root, els);
		wireDots(root);
	}
</script>

<script>
	// closing cards: the preview plays while you hover or focus a card
	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		document.querySelectorAll<HTMLElement>('[data-hovervid]').forEach((card) => {
			const v = card.querySelector<HTMLVideoElement>('video');
			if (!v) return;
			const on = () => { card.classList.add('is-playing'); v.play().catch(() => {}); };
			const off = () => { card.classList.remove('is-playing'); v.pause(); };
			card.addEventListener('mouseenter', on); card.addEventListener('mouseleave', off);
			card.addEventListener('focus', on); card.addEventListener('blur', off);
		});
	}
</script>

<script>
	// Phones: the journey and each scene become swipeable cards, with a step tracker for the journey.
	// Runs after the page's main script (which adds .cx--mob), so wait for DOMContentLoaded.
	const setupMobile = () => {
	const mobRoot = document.querySelector<HTMLElement>('.cx--mob');
	if (mobRoot) {
		const rail = (box: HTMLElement, slides: HTMLElement[], addOn: boolean, onChange: (i: number) => void) => {
			let cur = -1;
			const set = (i: number) => {
				if (i === cur || i < 0) return;
				cur = i;
				slides.forEach((s, k) => { if (k !== i) s.classList.remove('on'); });
				if (addOn) slides[i].classList.add('on');
				onChange(i);
			};
			const io = new IntersectionObserver((es) => {
				es.forEach((e) => { if (e.isIntersecting && e.intersectionRatio >= 0.6) set(slides.indexOf(e.target as HTMLElement)); });
			}, { root: box, threshold: [0.6, 0.85] });
			slides.forEach((s) => io.observe(s));
			set(0);
			return { go: (i: number) => { const s = slides[i]; if (s) box.scrollTo({ left: s.offsetLeft - (box.clientWidth - s.offsetWidth) / 2, behavior: 'smooth' }); } };
		};

		// phones: make sure every visual actually paints (no lazy-loading inside side-scrolling rows, first frame for videos)
		mobRoot.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((im) => { im.loading = 'eager'; });
		mobRoot.querySelectorAll<HTMLVideoElement>('.sc__row video, .lc__t video').forEach((v) => {
			if (v.poster) return;
			v.preload = 'auto';
			const u = v.getAttribute('src');
			if (u && !u.includes('#')) v.setAttribute('src', `${u}#t=0.001`);
		});
		// shrink each non-photo visual (charts, stage thumbs, slider studies, compare) to fit the card's visual area
		const fitAll = () => {
			mobRoot.querySelectorAll<HTMLElement>('.sc__row .sc__viz').forEach((viz) => {
				const bw = viz.clientWidth, bh = viz.clientHeight;
				if (!bw || !bh) return;
				viz.querySelectorAll<HTMLElement>(':scope > :not(img):not(video):not(.dz-metric):not(.imp)').forEach((k) => {
					k.style.setProperty('--fs', '1'); k.style.setProperty('--fx', '0px'); k.style.setProperty('--fy', '0px');
					const cw = Math.max(k.offsetWidth, k.scrollWidth), ch = Math.max(k.offsetHeight, k.scrollHeight);
					if (!cw || !ch) return;
					const sc = Math.min(1, bw / cw, bh / ch);
					k.style.setProperty('--fs', String(sc));
					k.style.setProperty('--fx', `${(bw - cw * sc) / 2}px`);
					k.style.setProperty('--fy', `${(bh - ch * sc) / 2}px`);
				});
			});
		};
		fitAll();
		addEventListener('load', fitAll);
		addEventListener('resize', fitAll);
		document.fonts?.ready.then(fitAll);
		setTimeout(fitAll, 900);

		// scroll-driven stages: a tall section with a sticky stage; scrolling swaps which step is showing.
		const stepper = (sec: HTMLElement, pin: HTMLElement | null, steps: number, dots: HTMLElement[], apply: (i: number) => void) => {
			let cur = -1;
			const travelOf = () => sec.offsetHeight - (pin?.offsetHeight ?? innerHeight);
			const upd = () => {
				const travel = travelOf();
				const p = travel > 0 ? Math.min(0.999, Math.max(0, -sec.getBoundingClientRect().top / travel)) : 0;
				const i = Math.floor(p * steps);
				if (i === cur) return;
				cur = i;
				apply(i);
				dots.forEach((d, k) => d.classList.toggle('on', k === i));
			};
			upd();
			addEventListener('scroll', upd, { passive: true });
			addEventListener('resize', upd);
			dots.forEach((d, k) => d.addEventListener('click', () => {
				scrollTo({ top: sec.getBoundingClientRect().top + scrollY + ((k + 0.5) / steps) * travelOf(), behavior: 'smooth' });
			}));
		};

		// short version: problem, what I owned, slider + metrics, button
		const shortSec = mobRoot.querySelector<HTMLElement>('.cx__short');
		if (shortSec) {
			stepper(shortSec, shortSec.querySelector<HTMLElement>('.cx__shortpin'), 4, Array.from(shortSec.querySelectorAll<HTMLElement>('.cx__sdots li')), (i) => { shortSec.dataset.step = String(i); });
		}

		// journey: cards in focus one at a time, then a zoom into step 4 (its card rises to the top, the other steps fold away)
		const jmSec = mobRoot.querySelector<HTMLElement>('.jr');
		const jm = jmSec?.querySelector<HTMLElement>('[data-jm]');
		if (jmSec && jm) {
			const mains = Array.from(jm.querySelectorAll<HTMLElement>('[data-main]'));
			const subsEls = Array.from(jm.querySelectorAll<HTMLElement>('[data-sub]'));
			const view = jm.querySelector<HTMLElement>('[data-view]')!;
			const track = jm.querySelector<HTMLElement>('[data-track]')!;
			const count = jm.querySelector<HTMLElement>('[data-jmcount]')!;
			const designer = mains.findIndex((m) => m.classList.contains('is-parent'));
			const total = mains.length + subsEls.length;
			let focusEl: HTMLElement | null = null;
			const place = () => {
				if (!focusEl) return;
				const room = Math.max(0, track.scrollHeight - view.clientHeight);
				// offsetTop is relative to the nearest positioned ancestor; walk up to the track
				let y = 0, el: HTMLElement | null = focusEl;
				while (el && el !== track) { y += el.offsetTop; el = el.offsetParent as HTMLElement | null; }
				const target = Math.min(room, Math.max(0, y - view.clientHeight * 0.3));
				track.style.transform = `translateY(${-target}px)`;
				view.dataset.scrolled = target > 2 ? '1' : '0';
			};
			new ResizeObserver(place).observe(track);
			stepper(jmSec, jm.querySelector<HTMLElement>('.jm__pin'), total, [], (i) => {
				const zoom = i >= mains.length;
				jm.dataset.phase = zoom ? 'b' : 'a';
				mains.forEach((m, k) => {
					m.classList.toggle('is-gone', zoom && k !== designer);
					m.classList.toggle('is-focus', !zoom && k === i);
					m.classList.toggle('is-past', !zoom && k < i);
				});
				subsEls.forEach((u, k) => {
					const at = i - mains.length;
					u.classList.toggle('is-focus', zoom && k === at);
					u.classList.toggle('is-past', zoom && k < at);
				});
				focusEl = zoom ? subsEls[i - mains.length] : mains[i];
				count.textContent = zoom ? `Step 4${'abcde'[i - mains.length] ?? ''} of 4e` : `Step ${i + 1} of ${mains.length}`;
				place();
				setTimeout(place, 700);
			});
		}

		// every scene: one beat at a time, replaced in place as you scroll
		mobRoot.querySelectorAll<HTMLElement>('[data-scene]').forEach((sc) => {
			const rows = Array.from(sc.querySelectorAll<HTMLElement>('.sc__row:not(.m-skip)'));
			if (rows.length < 2) return;
			stepper(sc, sc.querySelector<HTMLElement>('.sc__pin'), rows.length, Array.from(sc.querySelectorAll<HTMLElement>('.sc__dots li:not(.m-skip)')), (i) => {
				rows.forEach((r, k) => r.classList.toggle('on', k === i));
			});
		});

		// journey: stage chips 1-6, then the zoom into the designer step
		mobRoot.querySelectorAll<HTMLElement>('[data-journey]').forEach((sec) => {
			const box = sec.querySelector<HTMLElement>('.lc__texts');
			const top = sec.querySelector<HTMLElement>('.jr__top');
			if (!box || !top) return;
			const slides = Array.from(box.querySelectorAll<HTMLElement>('.lc__t'));
			const nums = Array.from(sec.querySelectorAll<HTMLElement>('.lc__cards .lc__no')).map((n) => n.textContent?.trim() ?? '');
			const subTags = Array.from(sec.querySelectorAll<HTMLElement>('.jr__subcard .jr__tag')).map((n) => n.textContent?.trim() ?? '');
			const zoomAt = nums.length + 1;
			const designer = Math.max(0, nums.indexOf('4'));
			const el = document.createElement('div');
			el.className = 'jr__mstep';
			el.innerHTML = '<div class="jr__mlabel"><span data-l1></span><span data-l2></span></div><ol class="jr__mchips jr__mchips--main"></ol><div class="jr__msub"><span>Inside step 4</span><ol class="jr__mchips jr__mchips--sub"></ol></div>';
			top.prepend(el);
			const main = el.querySelector<HTMLElement>('.jr__mchips--main')!;
			const sub = el.querySelector<HTMLElement>('.jr__mchips--sub')!;
			const chip = (label: string, to: () => void) => {
				const li = document.createElement('li');
				const b = document.createElement('button');
				b.type = 'button'; b.textContent = label; b.setAttribute('aria-label', `Go to ${label}`);
				b.addEventListener('click', to);
				li.append(b);
				return b;
			};
			let r: { go: (i: number) => void };
			const mainBtns = nums.map((n, k) => { const b = chip(n, () => r.go(k + 1)); main.append(b.parentElement!); return b; });
			const subBtns = subTags.map((t, k) => { const b = chip(t, () => r.go(zoomAt + 1 + k)); sub.append(b.parentElement!); return b; });
			const l1 = el.querySelector<HTMLElement>('[data-l1]')!;
			const l2 = el.querySelector<HTMLElement>('[data-l2]')!;
			r = rail(box, slides, true, (i) => {
				const zoom = i >= zoomAt;
				el.classList.toggle('is-zoom', zoom);
				mainBtns.forEach((b, k) => {
					const on = zoom ? k === designer : i === k + 1;
					b.classList.toggle('on', on);
					b.classList.toggle('past', !on && (zoom ? k < designer : k + 1 < i));
				});
				subBtns.forEach((b, k) => {
					const p = zoomAt + 1 + k;
					b.classList.toggle('on', i === p);
					b.classList.toggle('past', i > p);
				});
				l1.textContent = i === 0 ? 'The journey' : zoom ? 'Step 4, zoomed in' : `Step ${nums[i - 1] ?? i} of ${nums.length}`;
				l2.textContent = `${i + 1} / ${slides.length}`;
			});
		});
	}
	};
	if (document.readyState === 'complete') setupMobile();
	else document.addEventListener('DOMContentLoaded', setupMobile);
</script>
