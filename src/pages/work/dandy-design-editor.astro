									<article class:list={['sc__row', { 'sc__row--solo': !m && !kind && !b.metric }]} data-i={i} data-beat={b.id}>
										<div class="sc__text">
											<h3><span set:html={b.titleHtml ?? b.title} /></h3>
											{mtexts[b.id] ? <p><span class="tx-d">{b.text}</span><span class="tx-m">{mtexts[b.id]}</span></p> : <p>{b.text}</p>}
												{b.measures && (
													<div class="sc__measure">
														<p class="sc__mlabel">{b.mlabel ?? 'Measured by'}</p>
														<ul>{b.measures.map((m: string) => <li>{m}</li>)}</ul>
