							<span class="cx__cardm">
								<img src={c.poster} alt="" loading="lazy" decoding="async" />
								<video src={c.src} muted loop playsinline preload="none" aria-hidden="true"></video>
							</span>
							<span class="cx__cardt"><small>{c.tag}</small><b>{c.title}</b><em>{c.note}</em></span>
							<span class="cx__cardgo" aria-hidden="true">→</span>
						</a>
