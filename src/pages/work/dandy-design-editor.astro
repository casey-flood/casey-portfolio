---
import fs from 'node:fs';
import Base from '../../layouts/Base.astro';
import ScanToSmile from '../../components/ScanToSmile.astro';
import PrototypeEmbed from '../../components/PrototypeEmbed.astro';
import DdeViz from '../../components/DdeViz.astro';
import PvText from '../../components/PvText.astro';
import { ddeMedia } from '../../data/dde-media';
import { stages, groups } from '../../data/scan-to-smile';
import { stageImages } from '../../data/scan-to-smile-images';

// Save one still of the editor (scan in the mouth, crown seated) as public/work/dde-editor.png (or .webp, .jpg)
// and it appears in the hero. Until then the hero shows no image.
const stillName = ['dde-editor.webp', 'dde-editor.png', 'dde-editor.jpg'].find((f) => fs.existsSync(`./public/work/${f}`));
const still = stillName ? `/work/${stillName}` : null;

const heroCards: { dir: 'up' | 'down'; lead: string; word: string; note?: string }[] = [
	{ dir: 'up', lead: 'Crown orders finished in Dandy’s own editor', word: '70% → 88%' },
	{ dir: 'down', lead: 'Order turnaround', word: '−20%', note: '7.4 to 5.9 days, while crown volume grew 57%.' },
	{ dir: 'down', lead: 'Crown orders finished in competitor software (3Shape)', word: '29% → 12%' },
	{ dir: 'up', lead: 'Orders with an ML-generated crown', word: '0% → 80%' },
];
const heroTitle = 'Reimagining how dental designers design restorations.';
const meta = [
	['Role', 'Sole product designer'],
	['Product', 'Fixed crowns and bridges'],
	['Team', 'Two engineering teams'],
	['Status', 'In production, still shipping'],
];

import { extra, icons, preview } from '../../data/journey-extra';
type Part = import('../../data/journey-extra').Part;

// Zooming in on the designer step: what happened to a case before the redesign (until summer 2025).
const subs: { tag: string; icon: string; who: string; title: string; text: Part[]; media?: { type: 'video' | 'image'; src: string; poster?: string; wide?: boolean } }[] = [
	{ tag: '4a', icon: 'portal', who: 'Dandy Ops portal', title: 'The case arrives', text: ['The order comes through the Dandy Ops portal.'], media: { type: 'video', src: '/work/dde/4a-ops-portal.mp4', poster: '/work/dde/4a-ops-portal.jpg' } },
	{ tag: '4b', icon: 'prep', who: 'Prepper', title: 'Prepped first', text: ['A “prepper” prepares the scans for the designer, in software called “Prep in Browser”.'], media: { type: 'video', src: '/work/dde/4b-prep.mp4', poster: '/work/dde/4b-prep.jpg' } },
	{
		tag: '4c', icon: 'designer', who: 'Dental designer', title: 'Download, upload, design',
		text: [
			'The order goes to a specific designer through a queue. They download the files, upload them to ',
			{ t: '3Shape', href: 'https://www.3shape.com', title: '3Shape', desc: 'Dental CAD design software from 3Shape.', slug: '3shape' },
			' or ',
			{ t: 'exocad', href: 'https://exocad.com', title: 'exocad', desc: 'Dental CAD software from exocad.', slug: 'exocad' },
			', and start designing.',
		],
		media: { type: 'image', src: '/work/dde/4c-3shape.webp' },
	},
	{ tag: '4d', icon: 'designer', who: 'Dental designer', title: 'Back to the portal', text: ['When the design is done, the designer uploads it back to the Dandy Ops portal and the order goes to QA.'], media: { type: 'image', src: '/work/dde/4d-review.webp' } },
	{ tag: '4e', icon: 'audit', who: 'Auditor', title: 'Audited, by hand', text: ['An auditor reviews the design in the auditor portal, separate software from Prep in Browser and the Design Editor. Their notes, observations, and scores go into spreadsheets they keep by hand, so it meant constant switching between tools and a lot of manual tracking.'], media: { type: 'image', src: '/work/dde/4e-audit-sheet.webp', wide: true } },
];

// Shorter copy for phones only (same facts and the same "I", fewer words). Desktop keeps the full text.
const mtexts: Record<string, string> = {
	handoff: 'Prep in the browser, design in 3Shape, exocad or our editor, audit in another portal with scores in a spreadsheet. The file moved more than the tooth did, and that transfer is the waste.',
	survey: 'Designers scored our editor 6.9 out of 10, against 9.1 for 3Shape. The usual complaints: nested menus, too many clicks, and hotkeys that didn’t match 3Shape.',
	finding: 'Tools were grouped by category, not by how designers work, so they hunted for the next step. ML and automated prep wouldn’t fix that, so navigation needed its own redesign. Nothing warned when a design broke the Rx.',
	system: 'The editor had none, so I built one in Storybook from production components and tested every control, down to the sliders, as it would ship.',
	feedback: 'I built interactive prototypes from the system, from single components to full workflows. Dental designers tested them weekly, and I measured success with user testing and task analysis.',
	northstar: 'With no scope limits, I pulled the best ideas from that feedback into one flow: automated prep, ML crowns and navigation. The team measured every feature against it.',
	release: 'With PMs and engineers, I scoped the MVP and sliced the rest into releases. I set the release cycle: a coded prototype per sprint, every change tied to a Jira ticket.',
	adoption: 'From Q1 2025 to Q2 2026 the redesigned editor went from under 1% to 88% of crown orders, and the old one was retired by Q4 2025. 3Shape fell from about 29% to about 12%, mostly model design, which the editor doesn’t cover.',
	speed: 'Placed to shipped fell from 7.4 to 5.9 days, mostly less waiting: design process time, including waits between steps, fell from 14.5 to 11.8 minutes.',
	scale: 'Crown volume grew from about 153,000 to about 240,000 a quarter, while hands-on designer time per order fell from 6.4 to 5.6 minutes. Total designer hours grew about 39%, well below the 57% volume growth.',
	mlprep: 'The crown model touched about 2% of crown orders in Q3 2025, 38% in Q1 2026 and 80% in Q2 2026. Crowns with a model-generated start had a 5.8% refab rate, against 6.6% for the rest. Automated prep went from 4% at launch to about 34% in Q3.',
	challenges: 'Shipping ML crowns, prep and navigation together makes it hard to credit any one change. Trust in automation has to be earned: designers kept the generated crown about 35% of the time and redid it about 45%. Hard stops are only for Rx and doctor-note violations; everything else stays advisory.',
	watching: 'Quality: the refab rate held at 6.3–6.5% every quarter as volume grew, so speed hasn’t cost quality, but I can’t yet show it improved. I’m re-running the designer survey and timing each step as releases roll out. Several changes shipped at once, so isolating each is the hard part.',
	next: 'I’ll keep releasing the ideal version in chunks, then bring the same architecture to bridges, implants and other case types.',
};
const subM: Record<string, string> = {
	'4e': 'An auditor reviews the design in a separate portal and keeps notes and scores by hand in spreadsheets, switching tools constantly.',
};

// Each scene scrolls one small beat at a time. `viz` picks the built-in illustration; media from dde-media.ts replaces it.
const scenes = [
	{
		id: 'before',
		label: '02 · What that chain cost. Summer 2025, before the redesign',
		beats: [
			{ id: 'handoff', title: '3+ programs, and a different person at each one.', text: 'Prep in the browser. Design in 3Shape, exocad, or the Dandy Design Editor. Audit in another portal, with scores in a spreadsheet. The case was handed off every time, and the file moved more than the tooth did: download, upload, hunt for the right tool, upload back. That transfer is the waste.', metric: { text: '14.5 min', unit: 'average crown design process time, including waits between steps, Q1 2025, before the Design Editor redesign' } },
			{ id: 'scatter', title: 'Inside the Dandy Design Editor, the tools were buried.', text: 'Nested menus meant designers hunted for the next click instead of designing.', quote: ['“I wish it could be, like, going stages or maybe have it on the top… group related tools together.”', 'Dental designer, DDE designer interviews'] },
			{ id: 'survey', title: 'Satisfaction was low next to the competition.', text: 'Before the redesign, designers scored the Dandy Design Editor 6.9 out of 10, against 9.1 for 3Shape. The usual complaints: nested menus and too many clicks, hotkeys that didn’t match 3Shape, and tools they had to leave for, like the cut plane.' },
			{ id: 'usage', title: 'Fewer than half of designers used the Dandy Design Editor.', text: 'About 46% of designers did their crown design in it, 43% in Q4 2024 and 49% in Q1 2025. The goal was 100%.' },
		],
	},
	{
		id: 'research',
		label: '03 · Field research',
		beats: [
			{ id: 'miles', title: 'I went to where the work happens.', text: 'San Diego to Cairo, to learn from hundreds of designers at their own desks. I set up the research sessions myself.', metric: { to: 7600, prefix: '', suffix: '+', unit: 'miles, San Diego to Cairo, one way' } },
			{ id: 'leads', title: 'I had in-depth conversations with the leads.', text: 'One-on-one, with the design leads running the labs in Egypt.', metric: { to: 8, prefix: '', suffix: '', unit: 'design leads in Egypt' } },
			{ id: 'shadow', title: 'I shadowed designers at every level.', text: 'I watched designers finish real cases, from newer designers to the most experienced.', metric: { to: 20, prefix: '', suffix: '+', unit: 'virtual shadow sessions' } },
			{ id: 'reviews', title: 'I ran design reviews every week, in the open.', text: 'I led design reviews of the UX improvements with the designers who would use them.', metric: { to: 2, prefix: '', suffix: '+ hrs', unit: 'every week' } },
			{ id: 'competitors', title: 'I studied the competition and the data.', text: 'I studied 3Shape and exocad closely, along with the editor’s own metrics in dashboards and Sentry replays.', metric: { to: 10, prefix: '', suffix: '+ hrs', unit: 'of competitor research and data analysis' } },
			{ id: 'finding', title: 'I found that navigation was a problem on its own.', text: 'Tools were grouped by category, not by how designers work, so they hunted through nested menus for the next step. ML and automated prep wouldn’t fix that, so navigation needed its own redesign. There was also no warning when a design broke the Rx.' },
		],
	},
	{
		id: 'work',
		label: '04 · The hypotheses',
		beats: [
			{ id: 'focus', title: 'I framed three hypotheses to bring design time down and quality up.', titleHtml: 'I framed three hypotheses to bring design time <span class="hl hl--dn">down</span> and quality <span class="hl hl--up">up</span>.', text: 'Each is testable, and I proposed how to measure it.' },
			{ id: 'crown', title: 'If ML generates a bio-mimetic starting crown, time drops and quality rises.', titleHtml: '<small class="hyp">Hypothesis 1</small>If ML generates a bio-mimetic starting crown, time drops and quality rises.', text: 'I designed how designers start and regenerate a crown: from the ML crown, the tooth library, or a mimic tooth.', measures: ['Design time', 'Refab rate', 'Review rejections'], mnote: 'ML-touched vs. untouched crowns' },
			{ id: 'autoprep', title: 'If prep lives in the editor and runs itself, handoffs and waits drop.', titleHtml: '<small class="hyp">Hypothesis 2</small>If prep lives in the editor and runs itself, handoffs and waits drop.', text: 'I brought prep into the editor so Dandy could automate it. Designers audit it instead, saving time in one ecosystem.', measures: ['Scan-to-submit time', 'Programs and people per case'] },
			{ id: 'stages', title: 'If navigation follows how designers think, cognitive load drops.', titleHtml: '<small class="hyp">Hypothesis 3</small>If navigation follows how designers think, cognitive load drops.', text: 'I rebuilt navigation around the stages designers work through: Prep, Front, Crown, Design, Submit.', measures: ['Satisfaction (6.9 vs. 3Shape’s 9.1)', 'Time hunting for tools', 'Designer adoption (~46% at baseline)'] },
		],
	},
	{
		id: 'process',
		label: '05 · The process',
		beats: [
			{ id: 'system', title: 'First, I built a branded design system.', text: 'The editor had no design system. I built one in Storybook from the production components, so every control, down to the sliders, was tested as it would ship.', link: { href: '/work/dandy-design-system', label: 'Read the design system case study →' }, quote: ['“The old sliders were too short and super sensitive. The new ones are fantastic.”', 'Tom, dental designer'] },
				{ id: 'feedback', title: 'Then I prototyped with it and tested weekly with dental designers.', text: 'I built interactive prototypes from the system, from single components to whole workflows. Each week the dental designers played with them, we iterated together, and I measured success with user testing and task analysis.' },
				{ id: 'northstar', title: 'Then I designed the ideal version.', text: 'With no scope limits, I pulled the best ideas from that feedback into one flow: automated prep, ML crown generation and choices, and navigation. It became the benchmark the team measured every feature against.', link: { id: 'proto', label: 'Try the ideal-version prototype ↓' } },
				{ id: 'tagging', title: 'It included a tagging system I designed: detect, flag, fix.', text: 'It detects a problem, flags it as the designer works, and helps fix it. Guidance stays advisory, with hard stops only for Rx and doctor-note violations.' },
				{ id: 'release', title: 'Then I scaled it back to releasable chunks.', text: 'With PMs and engineers, I worked out the MVP and sliced the rest of the ideal version into releases. I set how the release cycle runs: a coded prototype for each sprint, and every change tied to a Jira ticket.' },
				{ id: 'hub', title: 'I built a hub to share my process.', text: 'A customized Product Design Hub where teammates learn how to work the way I do on the editor.', mlabel: 'Inside the hub', measures: ['Set up Cursor and GitHub', 'Prototype in code', 'See DDE sprint cycles and each sprint’s prototypes', 'Access the DDE design system'], link: { href: '/work/dandy-product-design-hub', label: 'See the Product Design Hub →' } },
		],
	},
	{
		id: 'impact',
		label: '07 · The impact',
		beats: [
			{ id: 'adoption', title: 'Dandy’s own editor went from 70% to 88% of crown orders.', text: 'From Q1 2025 to Q2 2026, the redesigned editor went from under 1% to 88% as it replaced the old one, which was retired by Q4 2025. 3Shape fell from about 29% to about 12% of crown orders, and what’s left is model design, which the editor doesn’t cover.' },
			{ id: 'speed', title: 'Orders ship about 20% faster.', text: 'Turnaround, placed to shipped, fell from 7.4 to 5.9 days. Most of it is less waiting: design process time, including waits between steps, fell from 14.5 to 11.8 minutes.', metric: { text: '−20%', unit: 'order turnaround, 7.4 to 5.9 days' } },
			{ id: 'scale', title: '57% more orders, 11.5% less designer time on each.', text: 'Crown volume grew from about 153,000 to about 240,000 a quarter. Hands-on designer time per order fell from 6.4 to 5.6 minutes, so total designer hours grew about 39%, well below the 57% volume growth.', metric: { text: '+57%', unit: 'crown orders a quarter, with 11.5% less designer time per order' } },
			{ id: 'mlprep', title: 'ML crowns and automated prep, scaling fast.', text: 'The crown model touched about 2% of crown orders in Q3 2025, about 38% in Q1 2026, and about 80% in Q2 2026. Designers kept the generated crown as their starting point about 35% of the time and redid it about 45%. Crowns where the model generated a starting crown had a 5.8% refab rate, against 6.6% for the rest. Automated prep launched in Q2 2026 at about 4% and reached about 34% in Q3.', metric: { to: 80, prefix: '~', suffix: '%', unit: 'of crown orders touched by the ML crown, Q2 2026' } },
						// TODO(designer quotes): when Caitlyn and Maneesh send written feedback, add a beat here:
			//   { id: 'voice', title: 'What designers say.', text: '…', quote: ['“…”', 'Name, role'] }
			// Held back until verified: front view / crown selection timings (source unconfirmed),
			// Milestone 4 (+29% faster, +25% quality) and Bridges (+30% efficiency) project numbers.
		],
	},
	{
		id: 'reflections',
		label: '08 · Reflections',
		beats: [
			{ id: 'challenges', title: 'What was hard.', text: 'Shipping ML crowns, prep and the new navigation at the same time makes it hard to attribute a result to any one change. Designers kept the generated crown about 35% of the time and redid it about 45%, so trust in automation has to be earned. And guidance has to stay out of the way: designers worried about intrusive blockers, so hard stops are for Rx and doctor-note violations, and everything else is advisory.' },
			{ id: 'watching', title: 'What I’m still tracking.', text: 'Quality. The refab rate has held at 6.3–6.5% every quarter while crown volume grew, so speed hasn’t cost quality, but I can’t yet show it improved. Design review rejection records have gaps, so I’m not relying on them yet. I’m also re-running the designer survey and measuring time per step as automated prep and the next releases roll out. Several changes shipped at once, so isolating what each one did is the hard part.' },
			{ id: 'next', title: 'What’s next.', text: 'I’ll keep releasing the ideal version in chunks: more of the guided flow and navigation, then the same architecture for bridges, implants and other case types.' },
		],
	},
];
// The journey scrolls in phases; the intro phase is short so the first card shows up quickly.
const jrCount = 1 + stages.length + 1 + subs.length;
const jrWeights = Array.from({ length: jrCount }, (_, i) => (i === 0 ? 0.45 : 1));
const jrTotal = jrWeights.reduce((a, b) => a + b, 0);

// Page navigator: sections and their sub-sections.
const sceneLabel: Record<string, string> = { before: 'What the chain cost', research: 'Field research', work: 'The hypotheses', process: 'The process', impact: 'The impact', reflections: 'Reflections' };
const toc: { id: string; label: string; subs?: { label: string; from: number; to: number }[] }[] = [
	{ id: 'cx-top', label: 'Overview' },
	{ id: 'cx-short', label: 'The short version' },
	{
		id: 'journey',
		label: 'The journey',
		subs: [
			{ label: 'From scan to smile', from: 0, to: stages.length },
			{ label: 'Zooming in on the designer', from: stages.length + 1, to: jrCount - 1 },
		],
	},
	...scenes.flatMap((sc) => [
		{ id: `sc-${sc.id}`, label: sceneLabel[sc.id] },
		...(sc.id === 'process' ? [{ id: 'proto', label: 'Try the prototype' }] : []),
	]),
	{ id: 'phone', label: 'Forward thinking' },
	{ id: 'end', label: 'Closing' },
];
// Short names shown when hovering a progress dash under each scene.
const shortNames: Record<string, string> = {
	handoff: 'The handoff', scatter: 'The old editor', survey: 'Survey', usage: 'Usage',
	miles: 'Cairo', leads: 'Team leads', shadow: 'Shadowing', reviews: 'Design reviews', competitors: 'Competitors', finding: 'Navigation',
	focus: 'Focus', crown: 'ML crown', autoprep: 'Automated prep', stages: 'Stages',
	system: 'Design system', feedback: 'Prototype and test', northstar: 'Ideal version', tagging: 'Tagging', release: 'Releases', hub: 'Design hub',
	adoption: 'Adoption', speed: 'Speed', scale: 'Scale', mlprep: 'ML and prep',
	challenges: 'Challenges', watching: 'Still tracking', next: 'What’s next',
};
const vizFor: Record<string, string> = {
	scatter: 'scatter', focus: 'focus', survey: 'survey', usage: 'usage', stages: 'stages', system: 'sliders', release: 'releases', northstar: 'compare', adoption: 'shift',
	finding: 'lost', prep: 'prep', frontview: 'frontview', crown: 'crown', autoprep: 'autoprep',
};
---

<Base
	title="Dandy Design Editor"
	description="How I designed one place for dental designers to design the crown: Dandy's Design Editor, from prep to send."
>
	<div class="hv cx" data-cx>
		<nav class="toc" data-toc aria-label="Page contents">
			<ul class="toc__rail" aria-hidden="true">{toc.map((s) => <li data-rail={s.id}></li>)}</ul>
			<div class="toc__panel">
				<p class="toc__title">On this page</p>
				<ol class="toc__list">
					{toc.map((s) => (
						<li class="toc__item" data-sec={s.id} data-prev={`/toc/dde/${s.id}.webp`}>
							<a href={`#${s.id}`} data-go={s.id}>{s.label}</a>
							{s.subs && (
								<ol class="toc__sub">
									{s.subs.map((u) => <li><a href={`#${s.id}`} data-go={s.id} data-i={u.from} data-to={u.to}>{u.label}</a></li>)}
								</ol>
							)}
						</li>
					))}
				</ol>
			</div>
		</nav>

		<header class="cx__hero" id="cx-top" aria-labelledby="cx-h">
			<div class="cx__top">
				<img class="hv__logo" src="/brand/dandy-wordmark.svg" alt="Dandy" width="96" height="34" />
				<a class="cx__back" href="/work/dandy">← Dandy overview</a>
			</div>
			<div class="cx__stagewrap" data-hero3d>
				<div class="h3d__pin">
					<div class="h3d__copy">
					<div class="h3d__intro">
						<p class="hv__eyebrow">Design Editor · Sole product designer <span class="cx__status"><i></i>Still shipping, since 2025</span></p>
						<h1 id="cx-h" aria-label={heroTitle}>
							{heroTitle.split(' ').map((w, i) => (<><span class="hv-w" aria-hidden="true" style={`--i:${i}`}>{w}</span>{' '}</>))}
						</h1>
						<p class="cx__lede">One editor for the whole restoration, replacing a chain of legacy and third-party tools.</p>
					</div>
						
					</div>
					<div class="h3d__stage">
						<video src="/work/dde/hero.mp4" poster="/work/dde/hero.jpg" muted loop autoplay playsinline preload="metadata" aria-label="A looping walkthrough of the Design Editor concept: a generated crown, then design tools"></video>
						<canvas aria-hidden="true"></canvas>
						<div class="h3d__flag" data-flag aria-hidden="true">
							<p><b>Automated</b> · Trim</p>
							<span>Dandy trimmed away loose tissue around the edge of the scan, outlined in purple.</span>
							<em>Revert</em>
						</div>
						<div class="h3d__flag h3d__flag--warn" data-flag aria-hidden="true">
							<p><b>Blocking</b> · Transform</p>
							<span>Wider than +12% pushes the mesial and distal contacts into #12 and #14. Contacts have to stay at −0.04 mm.</span>
						</div>
						<p class="h3d__hint" aria-hidden="true">Scroll <i>↓</i></p>
					</div>

				</div>
			</div>
		</header>

		<!-- The short version: problem, three bets, impact. The full story follows. -->
		<section class="cx__short" id="cx-short" aria-labelledby="cx-short-h">
			<div class="cx__shortpin">
			<p class="hv__eyebrow">The short version</p>
			<div class="cx__shortgrid">
				<div class="cx__shortcol">
					<h2 id="cx-short-h" class="cx__shorth">Turning a slow, siloed crown design process into one intelligent editor.</h2>
					<dl class="cx__story">
						<div><dt>The problem</dt><dd><span class="tx-d">Dandy’s original Design Editor was built fast, by devs, to get out the door. Designing a crown took 3+ handoffs between 3 personas (prepper, designer, auditor), and more time went to moving the file between tools than to designing the tooth. Designers rated it 6.9 out of 10 (3Shape: 9.1), and fewer than half used it.</span><span class="tx-m">Built fast by devs, the original editor took 3+ handoffs between 3 personas per crown, and more time went to moving files than designing the tooth. Designers rated it 6.9/10 (3Shape: 9.1), and fewer than half used it.</span></dd></div>
						<div><dt>What I owned</dt><dd><span class="tx-d">The goals: design time down without lowering quality, and designers choosing our own editor over 3Shape. As the sole product designer, I set the direction, ran the research, built the design system, and prototyped in code to test real cases with designers. It releases in chunks, and it’s still shipping.</span><span class="tx-m">The goals: less design time without lower quality, and designers choosing our editor over 3Shape. As the sole product designer, I set the direction, ran the research, built the design system, and prototyped in code with designers.</span></dd></div>

					</dl>
					<a class="cx__more" href="#journey" data-go="journey">Read how I did it <span aria-hidden="true">↓</span></a>
				</div>
				<div class="cx__shortviz">
					<DdeViz kind="compare" />
					<ul class="cx__glass" aria-label="Impact, Q1 2025 to Q2 2026">
							<li><b>−11.5%</b><span>designer time per order</span></li>
							<li><b>−20%</b><span>order to shipped, 7.4 to 5.9 days</span></li>
							<li><b>+26%</b><span>crown orders in Dandy’s editor vs 3Shape, 70% to 88%</span></li>
							<li><b>6.3–6.5%</b><span>refab rate, steady as volume grew</span></li>
						</ul>
				</div>
			</div>
			<ol class="cx__sdots" aria-hidden="true"><li></li><li></li><li></li><li></li></ol>
			</div>
		</section>

		<!-- 01: the lifecycle, one step at a time. Cards dim around the active one. -->
		<section class="lc jr" id="journey" data-journey data-w={JSON.stringify(jrWeights)} style={`--n:${jrCount};--w:${jrTotal}`} aria-label="From scan to smile, and the designer’s step in detail">
			<div class="jm" data-jm aria-label="The journey in three steps: a crown’s six steps, the designer’s step in detail, and the step I redesigned">
				<div class="jm__pin">
					<p class="hv__eyebrow jm__eyebrow">01 · The journey</p>
					<div class="jm__stage">
						<ol class="jm__chain">
							{stages.map((st, i) => (
								<li class:list={['jm__node', { 'is-designer': st.n === 4 }]} style={`--i:${i}`}>
									<span class="jm__ic"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[st.group]} /></span>
									<span class="jm__n">{st.n}</span>
									<small>{st.title}</small>
								</li>
							))}
						</ol>
						<p class="jm__you" aria-hidden="true">This case study</p>
