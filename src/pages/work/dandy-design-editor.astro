---
import fs from 'node:fs';
import Base from '../../layouts/Base.astro';
import ScanToSmile from '../../components/ScanToSmile.astro';
import PrototypeEmbed from '../../components/PrototypeEmbed.astro';
import DdeViz from '../../components/DdeViz.astro';
import PvText from '../../components/PvText.astro';
import { ddeMedia } from '../../data/dde-media';
import { stages, groups } from '../../data/scan-to-smile';
import { stageImages } from '../../data/scan-to-smile-images';

// Save one still of the editor (scan in the mouth, crown seated) as public/work/dde-editor.png (or .webp, .jpg)
// and it appears in the hero. Until then the hero shows no image.
const stillName = ['dde-editor.webp', 'dde-editor.png', 'dde-editor.jpg'].find((f) => fs.existsSync(`./public/work/${f}`));
const still = stillName ? `/work/${stillName}` : null;

const heroCards: { dir: 'up' | 'down'; lead: string; word: string; note?: string }[] = [
	{ dir: 'down', lead: 'Business costs', word: 'down', note: 'Designing in house instead of relying on third-party software.' },
	{ dir: 'down', lead: 'Time to design a restoration', word: 'down', note: 'Time spent in the front view and crown selection steps more than halved.' },
	{ dir: 'up', lead: 'Restoration design quality', word: 'up' },
	{ dir: 'up', lead: 'Designer satisfaction', word: 'up' },
];
const heroTitle = 'Reimagining how dental designers design restorations.';
const meta = [
	['Role', 'Sole product designer'],
	['Product', 'Fixed crowns and bridges'],
	['Team', 'Two engineering teams'],
	['Status', 'In production, still shipping'],
];

import { extra, icons, preview } from '../../data/journey-extra';
type Part = import('../../data/journey-extra').Part;

// Zooming in on the designer step: what happened to a case before the redesign (until summer 2025).
const subs: { tag: string; icon: string; who: string; title: string; text: Part[]; media?: { type: 'video' | 'image'; src: string; poster?: string; wide?: boolean } }[] = [
	{ tag: '4a', icon: 'portal', who: 'Dandy Ops portal', title: 'The case arrives', text: ['The order comes through the Dandy Ops portal.'], media: { type: 'video', src: '/work/dde/4a-ops-portal.mp4', poster: '/work/dde/4a-ops-portal.jpg' } },
	{ tag: '4b', icon: 'prep', who: 'Prepper', title: 'Prepped first', text: ['A “prepper” prepares the scans for the designer, in software called “Prep in Browser”.'], media: { type: 'video', src: '/work/dde/4b-prep.mp4', poster: '/work/dde/4b-prep.jpg' } },
	{
		tag: '4c', icon: 'designer', who: 'Dental designer', title: 'Download, upload, design',
		text: [
			'The order goes to a specific designer through a queue. They download the files, upload them to ',
			{ t: '3Shape', href: 'https://www.3shape.com', title: '3Shape', desc: 'Dental CAD design software from 3Shape.', slug: '3shape' },
			' or ',
			{ t: 'exocad', href: 'https://exocad.com', title: 'exocad', desc: 'Dental CAD software from exocad.', slug: 'exocad' },
			', and start designing.',
		],
		media: { type: 'image', src: '/work/dde/4c-3shape.webp' },
	},
	{ tag: '4d', icon: 'designer', who: 'Dental designer', title: 'Back to the portal', text: ['When the design is done, the designer uploads it back to the Dandy Ops portal and the order goes to QA.'], media: { type: 'image', src: '/work/dde/4d-review.webp' } },
	{ tag: '4e', icon: 'audit', who: 'Auditor', title: 'Audited, by hand', text: ['An auditor reviews the design in the auditor portal, separate software from Prep in Browser and the Design Editor. Their notes, observations, and scores go into spreadsheets they keep by hand, so it meant constant switching between tools and a lot of manual tracking.'], media: { type: 'image', src: '/work/dde/4e-audit-sheet.webp', wide: true } },
];

// Each scene scrolls one small beat at a time. `viz` picks the built-in illustration; media from dde-media.ts replaces it.
const scenes = [
	{
		id: 'before',
		label: '02 · The baseline, summer 2025',
		beats: [
			{ id: 'handoff', title: 'Three programs for one tooth.', text: 'Prep in Browser, then an upload, then 3Shape or our editor. Designers switched tools mid-tooth.' },
			{ id: 'scatter', title: 'The tools were real. The path wasn’t.', text: 'Related tools were scattered, so designers spent the time finding the next click.' },
			{ id: 'survey', title: '6.9 vs 9.1.', text: 'Nine designers rated the editor 6.9 and 3Shape 9.1 out of 10. A small survey, and a before: measured before I joined.' },
			{ id: 'usage', title: 'About 46%.', text: 'In June 2025, designers used the editor for about 46% of the cases it was meant to cover. The goal was 100%.' },
		],
	},
	{
		id: 'research',
		label: '03 · Field research',
		beats: [
			{ id: 'miles', title: 'I went to where the work happens.', text: 'San Diego to Cairo, to learn from hundreds of designers at their own desks.', metric: { to: 7600, prefix: '', suffix: '+', unit: 'miles, San Diego to Cairo, one way' } },
			{ id: 'leads', title: 'In-depth conversations with the leads.', text: 'One-on-one, with the design leads running the labs in Egypt.', metric: { to: 8, prefix: '', suffix: '', unit: 'design leads in Egypt' } },
			{ id: 'shadow', title: 'Shadowing, at every level.', text: 'Watching designers finish real cases, from newer designers to the most experienced.', metric: { to: 20, prefix: '', suffix: '+', unit: 'virtual shadow sessions' } },
			{ id: 'reviews', title: 'Every week, in the open.', text: 'I led design reviews of the UX improvements with the designers who would use them.', metric: { to: 2, prefix: '', suffix: '+ hrs', unit: 'every week' } },
			{ id: 'competitors', title: 'Competitors and data.', text: 'A close study of 3Shape and exocad, and the editor’s own metrics in dashboards and Sentry replays.', metric: { to: 10, prefix: '', suffix: '+ hrs', unit: 'of competitor research and data analysis' } },
			{ id: 'finding', title: 'The structure was the problem.', text: 'The original UI heavily relied on nested menus, forcing designers to “hunt” for tools and slowing down their design process.', quote: ['“I wish it could be, like, going stages or maybe have it on the top… group related tools together.”', 'Dental designer, DDE designer interviews'] },
		],
	},
	{
		id: 'work',
		label: '04 · The work',
		beats: [
			{ id: 'system', title: 'A design system, in Storybook.', text: 'Built on the production components, so a design change could ship.' },
			{ id: 'stages', title: 'Five stages, one path.', text: 'Set the view. Choose the crown. Sculpt. Check. Send. Each stage keeps its own tools.' },
			{ id: 'sliders', title: 'Longer sliders.', text: 'The short ones were too sensitive to land a contact.', quote: ['“Making the left side wider was a great move. The old sliders were too short and super sensitive. The new ones are fantastic.”', 'Tom, dental designer'] },
			{ id: 'prep', title: 'Prep moved in.', text: 'One program from prep to send. The base tooth can come from a copy, a mirror, or a neighbor, and later a model can suggest it.' },
			{ id: 'frontview', title: 'Front view: 134 s to 20 s.', text: 'Mean active seconds per visit, April to August 2026. Visits also fell, from about 48,000 to about 31,000. Choosing the crown went from 39 s to 19 s.' },
			{ id: 'm4', title: 'Milestone 4 shipped faster.', text: 'Milestone 4 of the redesign shipped about 29% faster, at about 25% higher quality.', metric: { to: 29, prefix: '~', suffix: '%', unit: 'faster, at ~25% higher quality' } },
			{ id: 'bridges', title: 'Bridges, more efficient.', text: 'About 30% more efficient on the Bridges redesign, with 15%+ quality gains.', metric: { to: 30, prefix: '~', suffix: '%', unit: 'more efficient, with 15%+ quality gains' } },
		],
	},
	{
		id: 'alongside',
		label: '05 · Alongside the redesign',
		beats: [
			{ id: 'crown', title: 'A generated crown.', text: 'For the simple case, one back tooth in zirconia, a model proposes the crown. I designed the moment it shows up, so a designer can start from it and still throw it out.' },
			{ id: 'autoprep', title: 'Prep that runs ahead.', text: 'Repetitive cleanup can run before anyone opens the case. The designer sees what changed and can redo it.' },
		],
	},
];
// The journey scrolls in phases; the intro phase is short so the first card shows up quickly.
const jrCount = 1 + stages.length + 1 + subs.length;
const jrWeights = Array.from({ length: jrCount }, (_, i) => (i === 0 ? 0.45 : 1));
const jrTotal = jrWeights.reduce((a, b) => a + b, 0);

// Page navigator: sections and their sub-sections.
const sceneLabel: Record<string, string> = { before: 'The baseline', research: 'Field research', work: 'The work', alongside: 'Alongside the redesign' };
const toc: { id: string; label: string; subs?: { label: string; from: number; to: number }[] }[] = [
	{ id: 'cx-top', label: 'Overview' },
	{
		id: 'journey',
		label: 'The journey',
		subs: [
			{ label: 'From scan to smile', from: 0, to: stages.length },
			{ label: 'Zooming in on the designer', from: stages.length + 1, to: jrCount - 1 },
		],
	},
	...scenes.map((sc) => ({ id: `sc-${sc.id}`, label: sceneLabel[sc.id] })),
	{ id: 'proto', label: 'Try the prototype' },
	{ id: 'phone', label: 'Phone concept' },
	{ id: 'end', label: 'Closing' },
];
const vizFor: Record<string, string> = {
	handoff: 'handoff', scatter: 'scatter', survey: 'survey', usage: 'usage', stages: 'stages', sliders: 'sliders',
	finding: 'lost', prep: 'prep', frontview: 'frontview', crown: 'crown', autoprep: 'autoprep',
};
---

<Base
	title="Dandy Design Editor"
	description="How I designed one place for dental designers to design the crown: Dandy's Design Editor, from prep to send."
>
	<div class="hv cx" data-cx>
		<nav class="toc" data-toc aria-label="Page contents">
			<ul class="toc__rail" aria-hidden="true">{toc.map((s) => <li data-rail={s.id}></li>)}</ul>
			<div class="toc__panel">
				<p class="toc__title">On this page</p>
				<ol class="toc__list">
					{toc.map((s) => (
						<li class="toc__item" data-sec={s.id}>
							<a href={`#${s.id}`} data-go={s.id}>{s.label}</a>
							{s.subs && (
								<ol class="toc__sub">
									{s.subs.map((u) => <li><a href={`#${s.id}`} data-go={s.id} data-i={u.from} data-to={u.to}>{u.label}</a></li>)}
								</ol>
							)}
						</li>
					))}
				</ol>
			</div>
		</nav>

		<header class="cx__hero" id="cx-top" aria-labelledby="cx-h">
			<div class="cx__top">
				<img class="hv__logo" src="/brand/dandy-wordmark.svg" alt="Dandy" width="96" height="34" />
				<a class="cx__back" href="/work/dandy">← Dandy overview</a>
			</div>
			<div class="cx__stagewrap" data-hero3d>
				<div class="h3d__pin">
					<div class="h3d__copy">
					<div class="h3d__intro">
						<p class="hv__eyebrow">Design Editor · Sole product designer <span class="cx__status"><i></i>In progress since 2025</span></p>
						<h1 id="cx-h" aria-label={heroTitle}>
							{heroTitle.split(' ').map((w, i) => (<><span class="hv-w" aria-hidden="true" style={`--i:${i}`}>{w}</span>{' '}</>))}
						</h1>
						<p class="cx__lede">One platform to create the whole restoration. Designing in house lowers costs, improves quality, and gives Dandy end-to-end ownership.</p>
					</div>
						<ul class="h3d__cards">
							{heroCards.map((c) => (
								<li class="h3d__card">
									<svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										{c.dir === 'down' ? <path d="M12 4v16M6 14l6 6 6-6" /> : <path d="M12 20V4M6 10l6-6 6 6" />}
									</svg>
									<div>
										<p>{c.lead} <b>{c.word}</b></p>
										{c.note && <small>{c.note}</small>}
									</div>
								</li>
							))}
						</ul>
					</div>
					<div class="h3d__stage">
						<video src="/work/dde/hero.mp4" poster="/work/dde/hero.jpg" muted loop autoplay playsinline preload="metadata" aria-label="A looping walkthrough of the Design Editor concept: a generated crown, then design tools"></video>
						<canvas aria-hidden="true"></canvas>
						<div class="h3d__flag" data-flag aria-hidden="true">
							<p><b>Automated</b> · Trim</p>
							<span>Dandy trimmed away loose tissue around the edge of the scan, outlined in purple.</span>
							<em>Revert</em>
						</div>
						<div class="h3d__flag h3d__flag--warn" data-flag aria-hidden="true">
							<p><b>Blocking</b> · Transform</p>
							<span>Wider than +12% pushes the mesial and distal contacts into #12 and #14. Contacts have to stay at −0.04 mm.</span>
						</div>
						<p class="h3d__hint" aria-hidden="true">Scroll <i>↓</i></p>
					</div>

				</div>
			</div>
		</header>

		<!-- 01: the lifecycle, one step at a time. Cards dim around the active one. -->
		<section class="lc jr" id="journey" data-journey data-w={JSON.stringify(jrWeights)} style={`--n:${jrCount};--w:${jrTotal}`} aria-label="From scan to smile, and the designer’s step in detail">
			<div class="lc__pin jr__pin">
				<p class="hv__eyebrow lc__eyebrow">01 · The journey</p>
				<div class="jr__top">
					<div class="lc__texts">
						<div class="lc__t" data-p="0">
							<h2>From Scan to Smile</h2>
							<p>How a dental restoration gets from the dentist’s chair to the lab and back to the patient.</p>
							<span class="jr__cue" aria-hidden="true">Scroll <i>↓</i></span>
						</div>
						{stages.map((s, i) => (
							<div class="lc__t" data-p={i + 1}>
								<p class="lc__who">
									<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.group]} />
									{groups[s.group].label}
								</p>
								<h2>{s.title}</h2>
								{stageImages[s.n].src && <img class="lc__tm" src={stageImages[s.n].src} alt="" loading="lazy" decoding="async" />}
								<p>{extra[s.n]?.teaser ?? s.teaser}</p>
								{extra[s.n]?.more.length > 0 && (
									<p class="lc__more">
										{extra[s.n].more.map((part) =>
											typeof part === 'string' ? part : (
												<span class="pv">
													<a href={part.href} target="_blank" rel="noopener">{part.t}</a>
													<span class="pv__card" role="tooltip">
														{preview(part.slug) && <img src={preview(part.slug)!} alt="" loading="lazy" />}
														<b>{part.title}</b>
														<small>{part.desc}</small>
														<em>{new URL(part.href).hostname.replace('www.', '')} ↗</em>
													</span>
												</span>
											),
										)}
									</p>
								)}
							</div>
						))}
						<div class="lc__t" data-p={stages.length + 1}>
							<p class="lc__who">
								<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.designer} />
								Lab tech (designer) experience
							</p>
							<h2>Zooming in on step 4.</h2>
							<p>What it took to get one order designed, historically. <em>Until summer 2025.</em></p>
						</div>
						{subs.map((s, i) => (
							<div class="lc__t" data-p={stages.length + 2 + i}>
								<p class="lc__who">
									<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.icon]} />
									{s.who}
								</p>
								<h2>{s.title}</h2>
								{s.media?.type === 'video' && <video class="lc__tm" src={s.media.src} poster={s.media.poster} muted loop playsinline preload="none" data-mvid></video>}
								{s.media?.type === 'image' && <img class="lc__tm" src={s.media.src} alt="" loading="lazy" decoding="async" />}
								<p><PvText parts={s.text} /></p>
							</div>
						))}
					</div>
					<div class="lc__card jr__focus">
							<span class="lc__no">4</span>
							{stageImages[4].src && <img src={stageImages[4].src} alt="" />}
						</div>
					<svg class="jr__arrow" viewBox="0 0 80 70" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M70 4C36 0 10 20 8 56" /><path d="M0 46l8 12 10-10" /></svg>
				</div>
				<div class="jr__row">
					<ol class="lc__cards" aria-hidden="true">
							{stages.map((s, i) => (
								<li class="lc__card" data-p={i + 1} style={`--i:${i}`}>
									<span class="lc__no">{s.n}</span>
									{stageImages[s.n].src && <img src={stageImages[s.n].src} alt="" loading="lazy" decoding="async" />}
								</li>
							))}
						</ol>
					<ol class="jr__sub">
						{subs.map((s, i) => (
							<li class="jr__subcard" data-p={stages.length + 2 + i} tabindex="0" role="button" aria-label={`Expand ${s.tag}: ${s.title}`}>
								<span class="jr__tag">{s.tag}</span>
								{s.media?.type === 'video' && <video src={s.media.src} poster={s.media.poster} muted loop autoplay playsinline preload="metadata" data-media></video>}
								{s.media?.type === 'image' && <img class:list={{ 'is-wide': s.media.wide }} src={s.media.src} alt="" loading="lazy" decoding="async" data-media />}
								<b>{s.title}</b>
								<small>{s.who}</small>
								<span class="jr__expand" aria-hidden="true">⤢</span>
							</li>
						))}
					</ol>
				</div>
			</div>
		</section>

		<dialog class="jr__modal" data-modal aria-label="Designer step detail">
			<button type="button" class="jr__x" data-close aria-label="Close">✕</button>
			<div class="jr__mbody">
				<div class="jr__mmedia" data-mmedia></div>
				<div class="jr__mtext" data-mtext></div>
			</div>
			<div class="jr__mnav">
				<button type="button" data-prev>← Previous</button>
				<span data-mcount></span>
				<button type="button" data-next>Next →</button>
			</div>
		</dialog>

		{
			scenes.map((sc) => (
				<section class="sc" id={`sc-${sc.id}`} data-scene style={`--n:${sc.beats.length}`} aria-label={sc.label}>
					<div class="sc__pin">
						<p class="hv__eyebrow sc__label">{sc.label}</p>
						<div class="sc__rows">
							{sc.beats.map((b: any, i: number) => {
								const m = ddeMedia[b.id];
								const kind = vizFor[b.id];
								return (
									<article class:list={['sc__row', { 'sc__row--solo': !m && !kind && !b.metric }]} data-i={i}>
										<div class="sc__text">
											<h3>{b.title}</h3>
											<p>{b.text}</p>
											{b.quote && (
												<blockquote class="sc__quote">
													<p>{b.quote[0]}</p>
													<footer>{b.quote[1]}</footer>
												</blockquote>
											)}
										</div>
										{(m || kind || b.metric) && (
											<div class:list={['sc__viz', { 'sc__viz--metric': b.metric && !m, 'sc__viz--shots': m?.fit === 'contain' }]}>
												{m ? (
													m.type === 'gallery' ? (
														<div class="sc__gal" style={`--n:${(m.srcs ?? [m.src]).length}`} role="img" aria-label={m.alt}>
															{(m.srcs ?? [m.src]).map((u, gi) => <img src={u} alt="" loading="lazy" decoding="async" style={`--i:${gi}`} />)}
														</div>
													) : m.type === 'video' ? (
														<video src={m.src} poster={m.poster} muted loop playsinline controls preload="metadata" aria-label={m.alt}></video>
													) : (
														<img src={m.src} alt={m.alt} loading="lazy" decoding="async" />
													)
												) : kind ? (
													<DdeViz kind={kind} />
												) : null}
												{b.metric && (
													<div class="dz-metric">
														<b
															data-count={b.metric.to ?? undefined}
															data-prefix={b.metric.prefix ?? ''}
															data-suffix={b.metric.suffix ?? ''}
														>{b.metric.text ?? `${b.metric.prefix ?? ''}${(b.metric.to as number).toLocaleString('en-US')}${b.metric.suffix ?? ''}`}</b>
														<span>{b.metric.unit}</span>
													</div>
												)}
											</div>
										)}
									</article>
								);
							})}
						</div>
						<ol class="sc__dots" aria-hidden="true">{sc.beats.map((_: any, i: number) => <li data-i={i}></li>)}</ol>
					</div>
				</section>
			))
		}

		<section class="cx__ch" id="proto" data-fade aria-labelledby="c7">
			<div class="cx__head">
				<p class="hv__eyebrow">Concept · not in production</p>
				<h2 id="c7">Try the blue sky version.</h2>
			</div>
			<div class="cx__copy">
				<p>An early interactive prototype of the designer flow, with sample scans and fictional case data.</p>
			</div>
			<div class="cx__proto">
				<PrototypeEmbed src="/prototypes/dde/index.html" title="Designer flow, blue sky prototype" status="Concept · in progress" />
			</div>
		</section>

		<section class="cx__ch cx__ch--phone" id="phone" data-fade aria-labelledby="c8">
			<div>
				<div class="cx__head">
					<p class="hv__eyebrow">Further out · Concept</p>
					<h2 id="c8">What if designers could check in from a phone?</h2>
				</div>
				<div class="cx__copy">
					<p>There is no mobile version of the Design Editor today. This is a more futuristic concept: a lightweight companion for the queue and case briefs. Sample data only.</p>
				</div>
			</div>
			<div class="cx__proto cx__proto--phone">
				<PrototypeEmbed src="/prototypes/dde/lite.html?embed=1" title="Phone concept" width={414} height={868} bare />
				<a class="cx__open" href="/prototypes/dde/lite.html" target="_blank" rel="noopener">Open full screen ↗</a>
			</div>
		</section>

		<section class="cx__end" id="end" data-fade aria-labelledby="c9">
			<h2 id="c9" class="hv__big">The designer still decides.</h2>
			<div class="cx__copy cx__copy--end">
				<p>One program for the crown, from prep through send, with a generated starting point the designer can reject. I built the design system, the path through the case, and the screens where the model hands the work to a person.</p>
			</div>
			<a class="hv__btn" href="/work/dandy">← Dandy overview</a>
		</section>
	</div>
</Base>

<script>
	const root = document.querySelector<HTMLElement>('[data-cx]');
	if (root && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
		const mob = window.matchMedia('(max-width: 899px)').matches;
		root.classList.add('is-live', 'cx--live');
		// phones: no pinned scroll scenes. Hero stays animated; everything else is a calm vertical read.
		if (mob) root.classList.add('cx--mob');

		// fade-up for the simple chapters
		const io = new IntersectionObserver(
			(es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
			{ rootMargin: '0px 0px -12% 0px', threshold: 0.1 },
		);
		root.querySelectorAll('[data-fade]').forEach((el) => io.observe(el));

		// scenes: scrolling steps through small beats, one at a time
		const scenes = Array.from(root.querySelectorAll<HTMLElement>('[data-scene]')).map((el) => ({
			el,
			rows: Array.from(el.querySelectorAll<HTMLElement>('.sc__row')),
			dots: Array.from(el.querySelectorAll<HTMLElement>('.sc__dots li')),
			last: -1,
		}));
		const tick = () => {
			for (const s of scenes) {
				const r = s.el.getBoundingClientRect();
				const p = Math.max(0, Math.min(0.9999, -r.top / Math.max(1, r.height - window.innerHeight)));
				const i = Math.min(s.rows.length - 1, Math.floor(p * s.rows.length));
				if (i === s.last) continue;
				s.last = i;
				s.rows.forEach((row, k) => {
					row.classList.toggle('on', k === i);
					const v = row.querySelector('video');
					if (v) { if (k === i) v.play().catch(() => {}); else v.pause(); }
					if (k === i) countUp(row);
				});
				s.dots.forEach((d, k) => d.classList.toggle('on', k === i));
			}
		};
		const countUp = (row: HTMLElement) => {
			const el = row.querySelector<HTMLElement>('[data-count]');
			if (!el) return;
			const to = Number(el.dataset.count), pre = el.dataset.prefix ?? '', suf = el.dataset.suffix ?? '';
			const t0 = performance.now();
			const step = (t: number) => {
				const k = Math.min(1, (t - t0) / 1100);
				const e = 1 - Math.pow(1 - k, 3);
				el.textContent = pre + Math.round(to * e).toLocaleString('en-US') + suf;
				if (k < 1) requestAnimationFrame(step);
			};
			requestAnimationFrame(step);
		};
		let raf = 0;
		if (mob) {
			scenes.forEach((s) => s.rows.forEach((row) => {
				const v = row.querySelector('video');
				const vio = new IntersectionObserver((es) => es.forEach((e) => {
					if (e.isIntersecting) { row.classList.add('on'); if (!row.dataset.counted) { row.dataset.counted = '1'; countUp(row); } v?.play().catch(() => {}); }
					else v?.pause();
				}), { threshold: 0.35 });
				vio.observe(row);
			}));
			document.querySelectorAll<HTMLVideoElement>('video[data-mvid]').forEach((v) => {
				new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) v.play().catch(() => {}); else v.pause(); }), { threshold: 0.3 }).observe(v);
			});
		} else {
			addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(tick); }, { passive: true });
			addEventListener('resize', tick);
			tick();
		}
	} else {
		document.querySelectorAll('.sc video').forEach((v) => { (v as HTMLVideoElement).autoplay = true; });
	}

	// Which phase of a tall pinned section is on screen (the journey has weighted phases, scenes are even).
	const jrPhase = (sec: HTMLElement) => {
		const w: number[] = JSON.parse(sec.dataset.w || '[1]');
		const total = w.reduce((a, b) => a + b, 0);
		const r = sec.getBoundingClientRect();
		const p = Math.max(0, Math.min(0.9999, -r.top / Math.max(1, r.height - window.innerHeight))) * total;
		let acc = 0;
		for (let i = 0; i < w.length; i++) { acc += w[i]; if (p < acc) return i; }
		return w.length - 1;
	};
	// The journey: one pinned section. Progress picks a phase; cards come in, dim, and the designer step zooms in.
	const clamp01 = (n: number) => Math.max(0, Math.min(1, n));
	document.querySelectorAll<HTMLElement>('[data-journey]').forEach((sec) => {
		if (!sec.closest('.cx--live') || sec.closest('.cx--mob')) return;
		const items = Array.from(sec.querySelectorAll<HTMLElement>('[data-p]'));
		const total = Number(getComputedStyle(sec).getPropertyValue('--n')) || 1;
		const zoomAt = items.filter((e) => e.classList.contains('lc__card')).length + 1; // first phase after the six cards
		let last = -1;
		const tick = () => {
			const r = sec.getBoundingClientRect();
			const p = jrPhase(sec);
			if (p === last) return;
			last = p;
			items.forEach((e) => {
				const k = Number(e.dataset.p);
				e.classList.toggle('on', k === p);
				e.classList.toggle('seen', k <= p);
			});
			sec.classList.toggle('z7', p === zoomAt);
			sec.classList.toggle('z8', p > zoomAt);
		};
		addEventListener('scroll', () => requestAnimationFrame(tick), { passive: true });
		addEventListener('resize', tick);
		tick();
	});

	// Expand a designer sub-step: bigger media plus the same explanation.
	const modal = document.querySelector<HTMLDialogElement>('[data-modal]');
	if (modal) {
		const cards = Array.from(document.querySelectorAll<HTMLElement>('.jr__subcard'));
		const mm = modal.querySelector<HTMLElement>('[data-mmedia]')!;
		const mt = modal.querySelector<HTMLElement>('[data-mtext]')!;
		const count = modal.querySelector<HTMLElement>('[data-mcount]')!;
		let cur = 0;
		const open = (i: number) => {
			cur = (i + cards.length) % cards.length;
			const card = cards[cur];
			const src = card.querySelector<HTMLElement>('[data-media]');
			mm.textContent = '';
			if (src instanceof HTMLVideoElement) {
				const v = document.createElement('video');
				v.src = src.currentSrc || src.src; v.poster = src.poster; v.muted = true; v.loop = true; v.autoplay = true; v.controls = true; v.playsInline = true;
				mm.append(v);
				v.play().catch(() => {});
			} else if (src instanceof HTMLImageElement) {
				const im = document.createElement('img'); im.src = src.src; im.alt = ''; mm.append(im);
			}
			mm.hidden = !src;
			const text = document.querySelector<HTMLElement>(`.lc__t[data-p="${card.dataset.p}"]`);
			mt.textContent = '';
			const tag = document.createElement('span'); tag.className = 'jr__tag jr__tag--m'; tag.textContent = card.querySelector('.jr__tag')?.textContent ?? '';
			mt.append(tag);
			if (text) for (const n of Array.from(text.children)) mt.append(n.cloneNode(true));
			count.textContent = `${cur + 1} of ${cards.length}`;
			if (!modal.open) modal.showModal();
		};
		cards.forEach((c, i) => {
			c.addEventListener('click', () => open(i));
			c.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(i); } });
		});
		modal.querySelector('[data-close]')!.addEventListener('click', () => modal.close());
		modal.querySelector('[data-prev]')!.addEventListener('click', () => open(cur - 1));
		modal.querySelector('[data-next]')!.addEventListener('click', () => open(cur + 1));
		modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
		modal.addEventListener('close', () => { mm.textContent = ''; });
	}

	// Page navigator: highlights where you are, jumps to sections and sub-sections.
	const toc = document.querySelector<HTMLElement>('[data-toc]');
	if (toc) {
		const live = !!document.querySelector('.cx--live') && !document.querySelector('.cx--mob');
		const items = Array.from(toc.querySelectorAll<HTMLElement>('.toc__item'));
		const rail = Array.from(toc.querySelectorAll<HTMLElement>('[data-rail]'));
		const secOf = (id: string) => document.getElementById(id)!;
		const phases = (sec: HTMLElement) => (sec.hasAttribute('data-journey') ? (JSON.parse(sec.dataset.w || '[1]') as number[]) : Array.from(sec.querySelectorAll('.sc__row')).map(() => 1));
		const phaseNow = (sec: HTMLElement) => {
			if (sec.hasAttribute('data-journey')) return jrPhase(sec);
			const n = sec.querySelectorAll('.sc__row').length || 1;
			const r = sec.getBoundingClientRect();
			return Math.min(n - 1, Math.floor(Math.max(0, Math.min(0.9999, -r.top / Math.max(1, r.height - innerHeight))) * n));
		};
		const goTo = (id: string, i?: number) => {
			const sec = secOf(id);
			if (!sec) return;
			const top = sec.getBoundingClientRect().top + scrollY;
			if (i == null || !sec.matches('[data-journey], [data-scene]')) { scrollTo({ top: id === 'cx-top' ? 0 : top - 70, behavior: 'smooth' }); return; }
			if (live) {
				const w = phases(sec);
				const total = w.reduce((a, b) => a + b, 0);
				const start = w.slice(0, i).reduce((a, b) => a + b, 0) + w[i] * 0.5;
				scrollTo({ top: top + (start / total) * (sec.offsetHeight - innerHeight), behavior: 'smooth' });
			} else {
				const target = sec.hasAttribute('data-journey') ? sec.querySelector(`.lc__t[data-p="${i}"]`) : sec.querySelectorAll('.sc__row')[i];
				(target as HTMLElement | null)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		};
		toc.querySelectorAll<HTMLAnchorElement>('a[data-go]').forEach((a) =>
			a.addEventListener('click', (e) => {
				e.preventDefault();
				goTo(a.dataset.go!, a.dataset.i != null ? Number(a.dataset.i) : undefined);
			}),
		);
		let tocRaf = 0;
		const tocTick = () => {
			let cur = 0;
			items.forEach((it, k) => { if (secOf(it.dataset.sec!).getBoundingClientRect().top <= innerHeight * 0.35) cur = k; });
			items.forEach((it, k) => it.classList.toggle('on', k === cur));
			rail.forEach((r, k) => r.classList.toggle('on', k === cur));
			const sec = secOf(items[cur].dataset.sec!);
			const subs = Array.from(items[cur].querySelectorAll('.toc__sub a'));
			if (subs.length && sec.matches('[data-journey], [data-scene]')) {
				const pi = phaseNow(sec);
				subs.forEach((a) => a.classList.toggle('on', pi >= Number((a as HTMLElement).dataset.i) && pi <= Number((a as HTMLElement).dataset.to)));
			}
		};
		addEventListener('scroll', () => { cancelAnimationFrame(tocRaf); tocRaf = requestAnimationFrame(tocTick); }, { passive: true });
		addEventListener('resize', tocTick);
		tocTick();
	}

	// 3D cover: loads once the stage is near the screen, falls back to the video if WebGL or the files fail.
	const h3 = document.querySelector<HTMLElement>('[data-hero3d]');
	if (h3 && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
		const stage = h3.querySelector<HTMLElement>('.h3d__stage')!;
		const pin = h3.querySelector<HTMLElement>('.h3d__pin')!;
		const heroCardEls = Array.from(h3.querySelectorAll<HTMLElement>('.h3d__card'));
		const progress = () => {
			const r = h3.getBoundingClientRect();
			const stick = parseFloat(getComputedStyle(pin).top) || 0;
			return clamp01((stick - r.top) / Math.max(1, r.height - pin.offsetHeight));
		};
		// metric cards slide in one by one as the animation plays (works with or without WebGL)
		const cardAt = [0.1, 0.36, 0.6, 0.8];
		const showCards = () => { const p = progress(); heroCardEls.forEach((c, i) => c.classList.toggle('in', p >= cardAt[i])); };
		addEventListener('scroll', () => requestAnimationFrame(showCards), { passive: true });
		addEventListener('resize', showCards);
		showCards();
		const hio = new IntersectionObserver(async (es) => {
			if (!es.some((e) => e.isIntersecting)) return;
			hio.disconnect();
			try {
				const probe = document.createElement('canvas');
				if (!(probe.getContext('webgl2') || probe.getContext('webgl'))) return;
				const heroUrl = '/work/dde/hero3d.js';
				const mod = await (new Function('u', 'return import(u)') as (u: string) => Promise<any>)(heroUrl);
				const hero = await mod.mountHero(stage, progress);
				stage.classList.add('is-3d');
				(window as any).__hero = hero;
			} catch (err) {
				console.warn('3D cover unavailable, keeping the video', err);
			}
		}, { rootMargin: '300px' });
		hio.observe(h3);
	}
</script>
