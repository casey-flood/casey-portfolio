---
import fs from 'node:fs';
import Base from '../../layouts/Base.astro';
import ScanToSmile from '../../components/ScanToSmile.astro';
import PrototypeEmbed from '../../components/PrototypeEmbed.astro';
import DdeViz from '../../components/DdeViz.astro';
import PvText from '../../components/PvText.astro';
import { ddeMedia } from '../../data/dde-media';
import { stages, groups } from '../../data/scan-to-smile';
import { stageImages } from '../../data/scan-to-smile-images';

// Save one still of the editor (scan in the mouth, crown seated) as public/work/dde-editor.png (or .webp, .jpg)
// and it appears in the hero. Until then the hero shows no image.
const stillName = ['dde-editor.webp', 'dde-editor.png', 'dde-editor.jpg'].find((f) => fs.existsSync(`./public/work/${f}`));
const still = stillName ? `/work/${stillName}` : null;

const heroCards: { dir: 'up' | 'down'; lead: string; word: string; note?: string }[] = [
	{ dir: 'up', lead: 'Share of crown orders designed in Dandy’s editor', word: '70% → 88%' },
	{ dir: 'down', lead: 'Order turnaround', word: '−20%', note: '7.4 to 5.9 days, Q1 2025 to Q2 2026, while crown volume grew 57%.' },
	{ dir: 'down', lead: 'Share of crown orders designed in 3Shape', word: '29% → 12%' },
	{ dir: 'up', lead: 'Orders with an ML-generated crown', word: '0% → 80%' },
];
const heroTitle = 'Reimagining how dental designers design restorations.';
const meta = [
	['Role', 'Sole product designer'],
	['Product', 'Fixed crowns and bridges'],
	['Team', 'Two engineering teams'],
	['Status', 'In production, still shipping'],
];

import { extra, icons, preview } from '../../data/journey-extra';
type Part = import('../../data/journey-extra').Part;

// Zooming in on the designer step: what happened to a case before the redesign (until summer 2025).
const subs: { tag: string; icon: string; who: string; title: string; text: Part[]; media?: { type: 'video' | 'image'; src: string; poster?: string; wide?: boolean } }[] = [
	{ tag: '4a', icon: 'portal', who: 'Dandy Ops portal', title: 'The case arrives', text: ['The order comes through the Dandy Ops portal.'], media: { type: 'video', src: '/work/dde/4a-ops-portal.mp4', poster: '/work/dde/4a-ops-portal.jpg' } },
	{ tag: '4b', icon: 'prep', who: 'Prepper', title: 'Prepped first', text: ['A “prepper” prepares the scans for the designer, in software called “Prep in Browser”.'], media: { type: 'video', src: '/work/dde/4b-prep.mp4', poster: '/work/dde/4b-prep.jpg' } },
	{
		tag: '4c', icon: 'designer', who: 'Dental designer', title: 'Download, upload, design',
		text: [
			'The order goes to a specific designer through a queue. They download the files, upload them to ',
			{ t: '3Shape', href: 'https://www.3shape.com', title: '3Shape', desc: 'Dental CAD design software from 3Shape.', slug: '3shape' },
			' or ',
			{ t: 'exocad', href: 'https://exocad.com', title: 'exocad', desc: 'Dental CAD software from exocad.', slug: 'exocad' },
			', and start designing.',
		],
		media: { type: 'image', src: '/work/dde/4c-3shape.webp' },
	},
	{ tag: '4d', icon: 'designer', who: 'Dental designer', title: 'Back to the portal', text: ['When the design is done, the designer uploads it back to the Dandy Ops portal and the order goes to QA.'], media: { type: 'image', src: '/work/dde/4d-review.webp' } },
	{ tag: '4e', icon: 'audit', who: 'Auditor', title: 'Audited, by hand', text: ['An auditor reviews the design in the auditor portal, separate software from Prep in Browser and the Design Editor. Their notes, observations, and scores go into spreadsheets they keep by hand, so it meant constant switching between tools and a lot of manual tracking.'], media: { type: 'image', src: '/work/dde/4e-audit-sheet.webp', wide: true } },
];

// One short sentence per designer stop, for the phone journey.
const jmSubText: Record<string, string> = {
	'4a': 'The order arrives through the Dandy Ops portal.',
	'4b': 'A prepper readies the scans in Prep in Browser.',
	'4c': 'The dental designer downloads the files, uploads them to 3Shape or exocad, and designs.',
	'4d': 'They upload the design back to the portal, and the order goes to QA.',
	'4e': 'An auditor reviews it in a separate portal and tracks scores in spreadsheets.',
};

// Shorter copy for phones only (same facts and the same "I", fewer words). Desktop keeps the full text.
const mtexts: Record<string, string> = {
	handoff: 'Prep, design and audit each happened in a different tool, so the file moved more than the tooth did.',
	scatter: 'Nested menus meant dental designers hunted for the next click instead of designing. Tools were grouped by category, not by how they work. Other top complaints: too many clicks, and hotkeys that didn’t match 3Shape.',
	system: 'The editor had none, so I built one in Storybook from production components and tested every control, down to the sliders, as it would ship.',
	feedback: 'I built interactive prototypes from the system, from single components to full workflows. Dental designers tested them weekly, and I measured success with user testing and task analysis.',
	northstar: 'With no scope limits, I pulled the best ideas from that feedback into one flow: automated prep, ML crowns and navigation. The team measured every feature against it.',
	release: 'With no scope limits, I designed the ideal flow as the benchmark. Then, with PMs and engineers, I sliced it into releases: a coded prototype per sprint, every change tied to a Jira ticket.',
	goal1: 'From Q1 2025 to Q2 2026, hands-on designer time per order fell 11.5% while crown volume grew 57%. Order to shipped fell 20%, and refab held at 6.3–6.5%. Quality held; I can’t yet show it improved.',
	adoption: 'Share of crown orders designed in Dandy’s editor: 70% to 88% (+18 pts). 3Shape: 29% to 12%. What’s left in 3Shape is mostly model design, which the editor doesn’t cover.',
	speed: 'Most of it is less waiting: design process time per order (hands-on plus waits) fell from 14.5 to 11.8 minutes.',
	scale: 'Crown volume grew 57%, but total dental designer hours rose only about 39%.',
	quality: 'Refab held at 6.3–6.5% every quarter. Crowns that started from the ML crown: 5.8%, against 6.6% for the rest. Quality held; I can’t yet show it improved.',
	m1result: 'The model touched about 80% of crown orders by Q2 2026. Model-started crowns had a 5.8% refab rate, against 6.6% for the rest, which isn’t a controlled comparison.',
	challenges: 'Shipping ML crowns, prep and navigation together makes it hard to credit any one change. Trust in automation has to be earned: dental designers kept the generated crown about 35% of the time and redid it about 45%. Hard stops are only for Rx and doctor-note violations; everything else stays advisory.',
	watching: 'Quality: the refab rate held at 6.3–6.5% every quarter as volume grew, so speed hasn’t cost quality, but I can’t yet show it improved. I’m re-running the dental designer survey and timing each step as releases roll out. Several changes shipped at once, so isolating each is the hard part.',
	next: 'I’ll keep releasing the ideal version in chunks, then bring the same architecture to bridges, implants and other case types.',
};
const subM: Record<string, string> = {
	'4e': 'An auditor reviews the design in a separate portal and keeps notes and scores by hand in spreadsheets, switching tools constantly.',
};

// Each scene scrolls one small beat at a time. `viz` picks the built-in illustration; media from dde-media.ts replaces it.
const scenes = [
	{
		id: 'before',
		label: '02 · The problem and the reframe',
		beats: [
			{ id: 'handoff', title: 'Passing each crown between people and programs made design take longer.', text: 'Prep, design and audit were done by different people, each in a different program, and the file had to be downloaded, uploaded and wait for the next person every time. The waste wasn’t the tools. It was the forced transfers between them.', metric: { text: '14.5 min', unit: 'design process time per crown order, hands-on plus waits between steps (Q1 2025)', src: 'Hex' } },
			{ id: 'baseline', title: 'Designers rated it below 3Shape, and fewer than half of them used it.', text: 'Dental designers scored our editor 6.9 out of 10, against 9.1 for 3Shape. About 46% of dental designers did their crown design in it (43% in Q4 2024, 49% in Q1 2025), though those designers handled most orders. The goal was every designer.',
				imp: { src: 'Amplitude (adoption) · designer survey (satisfaction)', big: '46%', sub: 'of dental designers used our editor, Q4 2024 to Q1 2025 (goal: 100%)', rows: [{ label: 'Satisfaction, Dandy’s editor', vals: '6.9 / 10', v: 6.9, w: 6.9, max: 10 }, { label: 'Satisfaction, 3Shape', vals: '9.1 / 10', v: 9.1, w: 9.1, max: 10, hi: true }] } },
		],
	},
	{
		id: 'research',
		label: '03 · How I found it: field research',
		beats: [
			{ id: 'miles', title: 'I went to where the work happens.', text: 'San Diego to Cairo, to learn from hundreds of dental designers at their own desks and to talk one-on-one with the design leads running the labs. I set up the research sessions myself.', metric: { to: 7600, prefix: '', suffix: '+', unit: 'miles, San Diego to Cairo, one way' } },
			{ id: 'reviews', title: 'I shadowed dental designers, then reviewed the work with them every week.', text: 'I watched dental designers finish real cases, from newer designers to the most experienced. Then I led weekly design reviews of the UX improvements with the people who would use them.', metric: { to: 20, prefix: '', suffix: '+', unit: 'virtual shadow sessions' } },
			{ id: 'competitors', title: 'I studied the competition and the data.', text: 'I studied 3Shape and exocad closely, along with the editor’s own metrics in dashboards and Sentry replays.', metric: { to: 10, prefix: '', suffix: '+ hrs', unit: 'of competitor research and data analysis' } },
		],
	},
	{
		id: 'moment1',
		label: '04 · Moment 1: Starting a crown',
		beats: [
			{ id: 'focus', title: 'I framed three hypotheses to bring design time down and quality up.', titleHtml: 'I framed three hypotheses to bring design time <span class="hl hl--dn">down</span> and quality <span class="hl hl--up">up</span>.', text: 'Each is testable, and I proposed how to measure it. First: how a dental designer starts a crown.' },
			{ id: 'crown', title: 'If ML generates a bio-mimetic starting crown, time drops and quality rises.', titleHtml: '<small class="hyp">Moment 1 · Starting a crown</small>If ML generates a bio-mimetic starting crown, time drops and quality rises.', text: 'The bet: a head start on every crown.', measures: ['Design time', 'Refab rate', 'Review rejections'], mnote: 'ML-touched vs. untouched crowns' },
			{ id: 'choosecrown', title: 'Designers wanted control, and didn’t always trust the shape.', text: 'So I designed three ways to start (the ML crown, the tooth library, or a mimic tooth) and a way to regenerate from a different reference tooth.' },
			{ id: 'm1result', title: 'The model is in most orders, and trust is still being earned.', titleHtml: '<small class="hyp">Moment 1 · Result and friction</small>The model is in most orders, and trust is still being earned.', text: 'The share of crown orders started from the ML crown went from about 2% in Q3 2025 to about 80% in Q2 2026.', friction: 'Of those crowns, designers kept the ML shape about 35% of the time and redid it about 45%.',
				imp: { src: 'Amplitude (usage) · TextQL (refab cohorts)', big: '~80%', sub: 'of crown orders started from the ML crown, Q2 2026 (from ~2% in Q3 2025)', rows: [{ label: 'Started from the ML crown (refab rate)', vals: '5.8%', v: 5.8, w: 5.8, max: 8, hi: true }, { label: 'Everything else (refab rate)', vals: '6.6%', v: 6.6, w: 6.6, max: 8 }], chips: ['Kept ~35%', 'Redone ~45%', 'Not a controlled comparison'] } },
		],
	},
	{
		id: 'moment2',
		label: '05 · Moment 2: One flow, not three tools',
		beats: [
			{ id: 'm2flow', title: 'If prep lives in the editor and runs itself, transfers and waits drop.', titleHtml: '<small class="hyp">Moment 2 · One flow, not three tools</small>If prep lives in the editor and runs itself, transfers and waits drop.', text: 'I moved prep into the editor so Dandy could automate it and designers could audit instead. One ecosystem, fewer transfers.',
				imp: { swim: { beforeLabel: 'Before · 3 people, 3 programs', afterLabel: 'After · 1 designer, 1 software', before: [{ t: 'Prep', tool: 'Browser', img: '/work/dde/persona-prep.webp' }, { t: 'Design', tool: '3Shape or exocad', img: '/work/dde/persona-design.webp' }, { t: 'Audit', tool: 'Separate portal', img: '/work/dde/persona-audit.webp' }], gap: 'download · upload · wait', after: { t: 'Designer', tool: 'Dandy Design Editor', img: '/work/dde/persona-design.webp', steps: [{ t: 'Prep', note: 'automated' }, { t: 'Design' }, { t: 'Audit', note: 'built in' }] } } } },
			{ id: 'autoprep', title: 'I made automated prep visible, and overridable.', text: 'Trim, bite, margin and path of insertion run on their own. I designed each step to show what Dandy’s model did and why, and to let dental designers revert or edit it themselves.', measures: ['Scan-to-submit time', 'Programs and people per case'] },
			{ id: 'm2result', title: 'Automated prep is growing fast.', titleHtml: '<small class="hyp">Moment 2 · Result and friction</small>Automated prep is growing fast.', text: 'The share of crown orders using automated prep went from about 4% at launch in Q2 2026 to about 34% in Q3 2026.', friction: 'Designers had to trust prep they didn’t do, so every step explains itself. The build was big, so I worked with engineers to slice it into releases.',
				imp: { src: 'Amplitude', big: '~34%', sub: 'of crown orders used automated prep, Q3 2026', rows: [{ label: 'Q2 2026, at launch', vals: '~4%', v: 4, w: 4, max: 100 }, { label: 'Q3 2026', vals: '~34%', v: 34, w: 34, max: 100, hi: true }] } },
		],
	},
	{
		id: 'moment3',
		label: '06 · Moment 3: A guided editor',
		beats: [
			{ id: 'scatter', title: 'The tools were buried, grouped by category, not by how dental designers work.', titleHtml: '<small class="hyp">Moment 3 · A guided editor</small>The tools were buried, grouped by category, not by how dental designers work.', text: 'Nested menus meant dental designers hunted for the next click instead of designing. ML and automated prep wouldn’t fix that.', quote: ['“I wish it could be, like, going stages or maybe have it on the top… group related tools together.”', 'Dental designer, DDE designer interviews'] },
			{ id: 'stages', title: 'If navigation follows how designers think, cognitive load drops.', titleHtml: '<small class="hyp">Moment 3 · The change</small>If navigation follows how designers think, cognitive load drops.', text: 'Navigation follows the stages designers work through: Prep, Front, Crown, Design, Submit. I prototyped it and tested it with dental designers weekly. They wanted familiar tools and hotkeys, so I designed around that.', measures: ['Satisfaction (6.9 vs. 3Shape’s 9.1)', 'Time hunting for tools', 'Dental designer adoption (~46% at baseline)'] },
			{ id: 'tagging', title: 'I designed a tagging system: detect, flag, fix.', text: 'Nothing used to warn a dental designer when a design broke the Rx. Now the system detects a problem, flags it as they work, and helps fix it.' },
			{ id: 'm3result', title: 'Guidance that stays out of the way. Results are still coming in.', titleHtml: '<small class="hyp">Moment 3 · Where it stands</small>Guidance that stays out of the way. Results are still coming in.', text: 'Hard stops are only for Rx and doctor-note violations, and everything else is advisory. There are no results to claim yet: I’m re-running the satisfaction survey (6.9 at baseline, against 3Shape’s 9.1) and timing each step, to see whether guidance cuts the hunt for tools.', friction: 'In testing, designers feared intrusive blockers.',
				imp: { shots: [{ src: '/work/dde/flag-blocking.webp', label: 'Hard stop', tone: 'stop' }, { src: '/work/dde/flag-automated.webp', label: 'Automated, with revert', tone: 'auto' }, { src: '/work/dde/flag-advisory.webp', label: 'Advisory', tone: 'adv' }] } },
		],
	},
	{
		id: 'process',
		label: '07 · How I led it',
		beats: [
			{ id: 'system', title: 'First, I built a branded design system.', text: 'The editor had no design system. I built one in Storybook from the production components, so every control, down to the sliders, was tested as it would ship.', link: { href: '/work/dandy-design-system', label: 'Read the design system case study →' }, quote: ['“The old sliders were too short and super sensitive. The new ones are fantastic.”', 'Tom, dental designer'] },
			{ id: 'feedback', title: 'Then I prototyped with it and tested weekly with dental designers.', text: 'I built interactive prototypes from the system, from single components to whole workflows. Each week the dental designers played with them, I iterated with them, and I measured success with user testing and task analysis.' },
			{ id: 'release', title: 'Then I designed the ideal version, and scaled it into releasable chunks.', text: 'With no scope limits, I pulled the best ideas from that feedback into one flow, the benchmark for every feature. Then, with PMs and engineers, I sliced it into releases. I set how the cycle runs: a coded prototype for each sprint, and every change tied to a Jira ticket.', link: { id: 'proto', label: 'Try the ideal-version prototype ↓' } },
			{ id: 'hub', title: 'I built a hub to share my process.', text: 'A customized Product Design Hub where teammates learn how to work the way I do on the editor.', mlabel: 'Inside the hub', measures: ['Set up Cursor and GitHub', 'Prototype in code', 'See DDE sprint cycles and each sprint’s prototypes', 'Access the DDE design system'], link: { href: '/work/dandy-product-design-hub', label: 'See the Product Design Hub →' } },
		],
	},
	{
		id: 'impact',
		label: '08 · The impact',
		beats: [
			{ id: 'goal1', title: 'Less dental designer time, and quality held.', titleHtml: '<small class="hyp">Goal 1 · Less design time, same quality</small>Less dental designer time, and quality held.', text: 'From Q1 2025 to Q2 2026, hands-on designer time per order fell 11.5% while crown volume grew 57%. Design process time per order, including waits, fell 19%, and order to shipped fell 20%. The refab rate stayed at 6.3–6.5% every quarter, so I can show quality held, not yet that it improved.',
				imp: { src: 'Hex', big: '−11.5%', sub: 'hands-on designer time per order, Q1 2025 → Q2 2026, as crown volume grew 57%', rows: [{ label: 'Hands-on designer time per order', vals: '6.4 → 5.6 min', v: 5.6, w: 6.4, max: 7, hi: true }, { label: 'Order to shipped', vals: '7.4 → 5.9 days', v: 5.9, w: 7.4, max: 8, hi: true }, { label: 'Design process time per order, incl. waits', vals: '14.5 → 11.8 min', v: 11.8, w: 14.5, max: 16, hi: true }], chips: ['Refab steady at 6.3–6.5%', 'Crown volume +57%'] } },
			{ id: 'adoption', title: 'Dental designers chose our editor over 3Shape.', titleHtml: '<small class="hyp">Goal 2 · Designers choose our editor over 3Shape</small>Dental designers chose our editor over 3Shape.', text: 'Fewer than half of dental designers used the editor at the start, but they handled most orders: 70% of crown orders in Q1 2025. By Q2 2026, 88% of crown orders ran through it (+18 pts), 3Shape’s share fell from 29% to 12%, and the old editor was retired by Q4 2025. What’s left in 3Shape is model design, which the editor doesn’t cover.',
				imp: { src: 'Amplitude', big: '+18 pts', sub: 'share of crown orders designed in Dandy’s editor, Q1 2025 → Q2 2026', rows: [{ label: 'Dandy’s editor', vals: '70% → 88%', v: 88, w: 70, max: 100, hi: true }, { label: '3Shape', vals: '29% → 12%', v: 12, w: 29, max: 100, bad: true }] } },
		],
	},
	{
		id: 'reflections',
		label: '09 · Reflections',
		beats: [
			{ id: 'challenges', title: 'What was hard.', text: 'Shipping ML crowns, prep and the new navigation at the same time makes it hard to attribute a result to any one change. Dental designers kept the generated crown about 35% of the time and redid it about 45%, so trust in automation has to be earned. And guidance has to stay out of the way: designers worried about intrusive blockers, so hard stops are for Rx and doctor-note violations, and everything else is advisory.' },
			{ id: 'wrong', title: 'Where I was wrong.', text: 'I assumed ML and prep alone would fix speed, but navigation needed its own redesign. I assumed more automation was always better, but designers needed visibility and control. And I assumed the old tools were the problem, when the waste was the forced transfers between them.' },
			{ id: 'differently', title: 'What I’d do differently.', text: 'I’d instrument each release on its own from the start, so I could credit results to one change instead of several shipped together. And I’d set up review-rejection tracking and a baseline survey earlier, so the quality story isn’t built after the fact.' },
			{ id: 'next', title: 'What’s next.', text: 'I’ll keep releasing the ideal version in chunks: more of the guided flow and navigation, then the same architecture for bridges, implants and other case types.' },
		],
	},
];
// The journey scrolls in phases; the intro phase is short so the first card shows up quickly.
const jrCount = 1 + stages.length + 1 + subs.length;
const jrWeights = Array.from({ length: jrCount }, (_, i) => (i === 0 ? 0.3 : 0.55));
const jrTotal = jrWeights.reduce((a, b) => a + b, 0);

// Page navigator: sections and their sub-sections.
const sceneLabel: Record<string, string> = { before: 'The problem', research: 'How I found it', moment1: 'Moment 1: Starting a crown', moment2: 'Moment 2: One flow', moment3: 'Moment 3: A guided editor', process: 'How I led it', impact: 'The impact', reflections: 'Reflections' };
const toc: { id: string; label: string; subs?: { label: string; from: number; to: number }[] }[] = [
	{ id: 'cx-top', label: 'Overview' },
	{ id: 'cx-short', label: 'The short version' },
	{
		id: 'journey',
		label: 'The journey',
		subs: [
			{ label: 'From scan to smile', from: 0, to: stages.length },
			{ label: 'Zooming in on the designer', from: stages.length + 1, to: jrCount - 1 },
		],
	},
	...scenes.flatMap((sc) => [
		{ id: `sc-${sc.id}`, label: sceneLabel[sc.id] },
		...(sc.id === 'reflections' ? [{ id: 'proto', label: 'Try the prototype' }] : []),
	]),
	{ id: 'phone', label: 'Forward thinking' },
	{ id: 'end', label: 'Closing' },
];
// Short names shown when hovering a progress dash under each scene.
const shortNames: Record<string, string> = {
	handoff: 'The transfers', scatter: 'The old editor', survey: 'Survey', usage: 'Usage',
	miles: 'Cairo', leads: 'Team leads', shadow: 'Shadowing', reviews: 'Design reviews', competitors: 'Competitors', finding: 'Navigation',
	focus: 'Focus', crown: 'ML crown', autoprep: 'Automated prep', stages: 'Stages',
	system: 'Design system', feedback: 'Prototype and test', northstar: 'Ideal version', tagging: 'Tagging', release: 'Releases', hub: 'Design hub',
	baseline: 'The baseline', choosecrown: 'Starting options', m2flow: 'Before and after', goal1: 'Goal 1', m1result: 'Result', m2result: 'Result', m3result: 'Result', adoption: 'Adoption', speed: 'Speed', scale: 'Designer time', quality: 'Quality',
	challenges: 'Challenges', differently: 'Differently', wrong: 'Where I was wrong', watching: 'Still tracking', next: 'What’s next',
};
const ICONS: Record<string, string> = { Prep: 'M4 9V5a1 1 0 0 1 1-1h4M15 4h4a1 1 0 0 1 1 1v4M20 15v4a1 1 0 0 1-1 1h-4M9 20H5a1 1 0 0 1-1-1v-4M9 9l6 6M15 9l-6 6', Front: 'M7 4c-2 0-3.5 1.6-3.5 4 0 2 1 3 1.5 5s.7 7 2.2 7c1.2 0 1.3-3 2.3-3s1.1 3 2.3 3c1.5 0 1.7-5 2.2-7s1.5-3 1.5-5c0-2.4-1.5-4-3.5-4-1.2 0-1.7.8-3 .8S8.2 4 7 4z', Crown: 'M5 17l-1-9 4.5 3L12 5l3.5 6L20 8l-1 9zM5 20h14', Design: 'M4 20l1-4L16 5l3 3L8 19zM14 7l3 3', Submit: 'M21 3L3 10l7 3 3 7zM10 13L21 3', Audit: 'M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6zM9 12l2 2 4-4' };
const vizFor: Record<string, string> = {
	scatter: 'scatter', focus: 'focus', survey: 'survey', usage: 'usage', stages: 'stages', system: 'sliders', release: 'releases', northstar: 'compare',
	finding: 'lost', prep: 'prep', frontview: 'frontview', crown: 'crown', autoprep: 'autoprep',
};
---

<Base
	title="Dandy Design Editor"
	description="How I designed one place for dental designers to design the crown: Dandy's Design Editor, from prep to send."
>
	<div class="hv cx" data-cx>
		<nav class="toc" data-toc aria-label="Page contents">
			<ul class="toc__rail" aria-hidden="true">{toc.map((s) => <li data-rail={s.id}></li>)}</ul>
			<div class="toc__panel">
				<p class="toc__title">On this page</p>
				<ol class="toc__list">
					{toc.map((s) => (
						<li class="toc__item" data-sec={s.id} data-prev={`/toc/dde/${s.id}.webp`}>
							<a href={`#${s.id}`} data-go={s.id}>{s.label}</a>
							{s.subs && (
								<ol class="toc__sub">
									{s.subs.map((u) => <li><a href={`#${s.id}`} data-go={s.id} data-i={u.from} data-to={u.to}>{u.label}</a></li>)}
								</ol>
							)}
						</li>
					))}
				</ol>
			</div>
		</nav>

		<header class="cx__hero" id="cx-top" aria-labelledby="cx-h">
			<div class="cx__top">
				<a class="cx__brand" href="/work/dandy" aria-label="Dandy overview"><img class="hv__logo" src="/brand/dandy-wordmark.svg" alt="Dandy" width="96" height="34" /><span class="cx__peek" aria-hidden="true"><img src="/work/ov-dandy.jpg" alt="" loading="lazy" /><b>Dandy overview →</b></span></a>
