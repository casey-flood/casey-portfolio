---
import DandyScroll from '../../layouts/DandyScroll.astro';
import type { Beat } from '../../data/dandy-scroll-types';
import { tools } from '../../data/tools';

const scenes: { id: string; label: string; nav: string; beats: Beat[] }[] = [
	{
		id: 'why',
		label: '01 · Why',
		nav: 'Why',
		beats: [
			{
				title: 'A practice only one person uses doesn’t scale.',
				text: 'I had set up a faster way to design, in code, with Storybook and Cursor. The next step was making sure other designers could use it without needing me.',
			},
		],
	},
	{
		id: 'what',
		label: '02 · What I built',
		nav: 'What I built',
		beats: [
			{
				title: 'The Product Design Hub.',
				text: 'A hub personalized to your role and goal, with design-engineering resources, how-tos, the design system and more.',
				media: { kind: 'clip', src: '/work/hub/personal.mp4', poster: '/work/hub/personal.jpg', alt: 'Choosing a role and goals, then the personalized hub loading with cards to explore' },
			},
			{
				title: 'A Cursor learning hub.',
				text: 'A step-by-step e-learning I made, recorded with Screen Studio, that walks through setting up Cursor with GitHub, pulling the repos, and more.',
				media: { kind: 'clip', src: '/work/hub/cursor.mp4', poster: '/work/hub/cursor.jpg', alt: 'The Cursor e-learning inside the hub: signing in to GitHub, downloading Cursor, and getting the code' },
			},
			{
				title: 'Onboarding docs and 1:1s.',
				text: 'Docs like the engineering handoff, plus 1:1s to help teammates set up their own automations.',
				media: { kind: 'image', src: '/work/hub/handoff.webp', alt: 'The Engineering handoff page: how Storybook and CAD share one implementation' },
			},
			{
				title: 'Weekly design jams.',
				text: 'A running record of the UI and UX changes I made to my coded prototypes: a prototype for each sprint, with a breakdown of what changed and which components were used.',
				media: { kind: 'image', src: '/work/hub/jams.webp', alt: 'Storybook with a Prototypes folder and a Current Sprint prototype of the Design Editor' },
			},
		],
	},
	{
		id: 'impact',
		label: '03 · The impact',
		nav: 'The impact',
		beats: [
			{
				title: 'Over 30 people.',
				text: 'Across DDE, over 30 people now work in the Cursor and Storybook setup.',
				metric: { to: 30, prefix: '', suffix: '+', unit: 'people working in the setup across DDE' },
			},
			{
				title: 'The team picked it up.',
				text: 'Every stakeholder in my performance review called out the Cursor work.',
				quote: ['“I saw her create an entire design system using Cursor that she basically taught herself. She was an inspiration to the design team.”', 'Liz, Senior Product Designer'],
			},
		],
	},
];
---

<DandyScroll
	title="Teaching it: the Product Design Hub · Dandy"
	description="How I turned a personal workflow into a team practice at Dandy: onboarding docs, design jams, and the Product Design Hub."
	eyebrow="Product Design Hub · 2025 – now"
	heroTitle="I taught it to everyone else, so it’s a team practice, not a personal hack."
	lede="Design-in-code only matters if more people can do it. I built the Product Design Hub and the supporting habits to spread it."
	tools="For product designers and PMs at Dandy"
	hero={{ src: '/work/behind/hub.mp4', poster: '/work/behind/hub.jpg' }}
	scenes={scenes}
	toolsScene={{ after: 'what', tools: tools.filter((x) => x.hub), title: 'What I used to build it.', lede: 'The hub and the learning path were made with these.' }}
	endTitle="From a personal workflow to a team practice."
	endText="The hub, the learning path and the weekly rhythm mean new teammates can get set up without needing me."
	endLinks={[{ href: '/work/dandy', label: '← Dandy overview' }, { href: '/work/dandy-prototype', label: 'Clickable prototypes →', ghost: true }]}
/>
