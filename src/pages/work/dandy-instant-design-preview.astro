---
import DandyScroll from '../../layouts/DandyScroll.astro';
import type { Beat } from '../../data/dandy-scroll-types';

const I = '/work/idp';
const clip = { kind: 'clip' as const, src: '/work/behind/proto.mp4', poster: '/work/behind/proto.jpg' };
const story = [
	{ src: '/scan-to-smile/02-scan.webp', alt: 'A dentist scanning a patient’s teeth', who: 'Day 0 · Dentist', label: 'Preps and scans the tooth' },
	{ src: '/scan-to-smile/04-design.webp', alt: 'Dental designers reviewing a crown design on screen', who: 'The lab', label: 'Designs and makes the crown' },
	{ src: '/scan-to-smile/06-place.webp', alt: 'A dentist placing a crown in a patient’s mouth', who: 'Days later · Dentist', label: 'Sees it for the first time' },
];
const img = (f: string, alt: string) => ({ kind: 'image' as const, src: `${I}/${f}`, alt });

const scenes: { id: string; label: string; nav: string; beats: Beat[] }[] = [
	{
		id: 'context',
		label: '01 · Context',
		nav: 'Context',
		beats: [
			{
				title: 'Day 0: the dentist preps the tooth and scans it.',
				text: 'The patient is in the chair. The dentist shapes the tooth for a crown, scans it chairside and places the order. This is the only moment the prep can still change.',
				cards: { items: story, on: 0 },
			},
			{
				title: 'Then the lab designs and makes the crown.',
				text: 'A growing share of crowns are generated by ML and skip our dental designers entirely. The dentist doesn’t see the design, unless they ask for a preview later, after the patient has gone home.',
				cards: { items: story, on: 1 },
			},
			{
				title: 'Days later, the dentist sees it for the first time.',
				text: 'At the seating appointment. If it doesn’t fit, it’s adjusted in the mouth or remade, and the patient comes back.',
				cards: { items: story, on: 2 },
			},
			{
				title: 'The goal: the patient leaves the chair with the crown decided.',
				text: 'That was our north star. For Q4 we set out to grow the share of crowns that go straight to the lab, with no designer in between, by 10 percentage points.',
				metric: { text: '+10 pts', unit: 'crowns going straight to the lab, the Q4 goal' },
			},
			{
				title: 'I lead the design.',
				text: 'I own the prototyping, the MVP and the future vision for Instant Design Preview, working with a PM, a clinical lead, chairside and ML engineers, and a design partner on scan review.',
			},
		],
	},
	{
		id: 'chair',
		label: '02 · At the chair',
		nav: 'At the chair',
		beats: [
			{
				title: 'Two people, one appointment.',
				text: 'A crown visit is a team sport. The dental assistant sets up and often scans. The dentist preps the tooth. Both touch the chairside software, and they don’t always overlap.',
				media: img('team.webp', 'A dentist and a dental assistant working on a patient together'),
			},
			{
				title: 'Who does what.',
				text: 'Only the dentist can prep a tooth. That makes prep the one step where we know the dentist is in the room, and it shaped every placement decision that followed.',
				media: img('roles.webp', 'Six chairside steps and who usually does each: setup, scans, prep (dentist only), prep scan, review, order'),
			},
			{
				title: '1. Set up the case.',
				text: 'The assistant adds the patient and the teeth, picks material and shade, and starts scanning. Usually before the dentist walks in.',
				media: img('cs-setup.webp', 'Chairside: crowns 8 and 9 added, with start scanning'),
			},
			{
				title: '2. Scan the arches.',
				text: 'Guided scans walk through the lower arch, then the upper, with a path to follow on screen.',
				media: img('cs-lower.webp', 'Chairside guided scan of the lower arch'),
			},
			{
				title: '3. Scan the bite.',
				text: 'Then the bite, so the lab knows how the teeth meet. Assistants often do all of this.',
				media: img('cs-bite.webp', 'Chairside guided bite scan'),
			},
			{
				title: '4. The dentist preps the tooth.',
				text: 'The dentist shapes the tooth for the crown, then scans the prep. This is the moment the dentist is guaranteed to be there, and the last moment the prep can easily change.',
				media: img('cs-prep.webp', 'Chairside prep patient step with margin examples'),
			},
			{
				title: '5. Review the scans.',
				text: 'AI scan review checks the scans and flags issues. By now the dentist has often moved on, and about 88% of clicks here come from assistants.',
				media: img('cs-review.webp', 'Chairside review page with AI scan review findings: potential undercut and occlusal clearance issues'),
			},
			{
				title: '6. Place the order.',
				text: 'The order goes in under the dentist’s name. A design preview, if they asked for one, comes later in a different app. Approve within 24 hours or delivery slips.',
				media: img('cs-order.webp', 'Chairside place order page: a design preview will be ready for approval by a later date'),
			},
		],
	},
	{
		id: 'problem',
		label: '03 · The problem',
		nav: 'The problem',
		beats: [
			{
				title: 'Feedback arrives after it can still help.',
				text: 'The only chance to change the prep is while the patient is in the chair. Today the dentist first holds the crown days later, at the seat appointment. Most crowns get adjusted in the mouth, and about 6 in 100 are remade, with a new crown and another visit for the patient.',
				media: img('timeline.webp', 'Timeline from scan to seat: the prep can only change on day 0, the preview comes hours later, and the dentist first holds the crown at the seat appointment. About 60% are adjusted and about 6.5% remade.'),
			},
			{
				title: 'Today, AI scan review checks the prep.',
				text: 'Before this project, Dandy shipped AI scan review: while the patient is still in the chair, it checks the scan and flags problems like an overhanging margin, so the dentist can rescan. It’s the page dentists already stop on.',
				media: img('aisr-today.webp', 'AI scan review, from Dandy’s 2025 launch campaign: scanning, an issue detected on the margin, and the scan approved'),
			},
			{
				title: 'But warnings don’t change behavior.',
				text: 'Most reviews are clean, and when something is flagged, nearly every dentist orders anyway. A flag isn’t a crown. Dentists judge the prep off a warning instead of the result.',
				media: img('flags.webp', '84% of reviews find no issues, 16% are flagged, and about 95% of flagged cases still place the order'),
			},
		],
	},
	{
		id: 'bet',
		label: '04 · The bet',
		nav: 'The bet',
		beats: [
			{
				title: 'Show the crown where they already stop.',
				text: 'If a generated crown appears on the review page while the dentist is still with the patient, they can re-prep or leave a note now, instead of rejecting a design after the patient leaves.',
				media: img('ready.webp', 'The review page with the generated crown, a clearance heatmap and approve, request a change, or send to lab'),
			},
			{
				title: 'Three questions, in order.',
				text: 'Will they wait for it? Do they value seeing it? Will they mark it up or edit it? I kept editing out of the first version. If dentists won’t wait, editing tools don’t matter.',
			},
			{
				title: 'I pushed for the north star, not a stripped-down editor.',
				text: 'The first plan put our designers’ 3D editor in front of dentists. I prototyped the end state instead and argued for it at standup: a wall of CAD tools would hide whether dentists wanted the preview at all.',
				media: img('early.webp', 'An early version of the prototype: the crown generating on the arch while the dentist checks the scan'),
			},
		],
	},
	{
		id: 'decide',
		label: '05 · Decisions and tradeoffs',
		nav: 'Decisions',
		beats: [
			{
				title: 'Four kinds of checks, four different questions.',
				text: 'With engineering, I mapped every check a case runs through. Each one answers a different question, on a different scan, at a different time. Only one belongs in front of the dentist.',
				media: img('buckets.webp', 'Four buckets of checks: AI scan review, auto-prep, design quality and manufacturability'),
			},
			{
				title: 'Two scans, two answers.',
				text: 'Scan review runs on a fast, low-resolution scan. The crown needs the HD scan. The same tooth can pass on one and fail on the other, so stacking both on one screen means showing a dentist two truths.',
			},
			{
				title: 'Re-prep has a clock.',
				text: 'The crown took about 4 minutes to generate. Once the dentist starts making a temporary crown, they won’t go back. So “just wait for the crown” was a bet for the pilot, not a free win.',
				metric: { text: '~4 min', unit: 'to generate a crown at the start, aiming for 2–3' },
			},
			{
				title: 'We chose one story.',
				text: 'For the pilot, the dentist waits for the crown and sees any issues on it, as heatmaps and the margin line. Most reviews are clean, flags don’t stop orders, and stacking both was the expensive path. We didn’t cut scan review because flags are useless. We cut it on review so we don’t ship two scanners and two UIs before we know if dentists will even wait.',
				media: img('options.webp', 'Option A stacks scan flags and the crown; option B, chosen for the pilot, waits for the crown and shows issues on it'),
			},
			{
				title: 'Scoped in three releases, each with one question.',
				text: 'This was net new: dentists had never seen a generated crown chairside. So with our PM I scoped it to learn fast. V0 asks if dentists will wait, look and act. V0+ asks which edits they want. V1 merges three preview experiences into one. Editing waits until we know they’ll wait.',
				media: img('roadmap.webp', 'Three releases: V0 testable MVP with about 20 practices, V0+ faster with more editing, V1 one preview experience'),
			},
			{
				title: 'Then every path ends somewhere useful.',
				text: 'If we can’t build a preview, a designer takes it from here. If the margin is unsure, redraw or rescan. If clearance is tight, show the heatmap. If nothing’s wrong, approve.',
				media: img('tree.webp', 'Decision tree: preview built or not, then which issue, then what the dentist can do'),
			},
			{
				title: 'And the copy adds up.',
				text: '“This is our best guess at the crown from your scan. Fix what’s flagged and we’ll rebuild a more accurate one, eligible to go straight to the lab.” One message, instead of two systems the dentist has to reconcile.',
			},
		],
	},
	{
		id: 'iterate',
		label: '06 · Iterations',
		nav: 'Iterations',
		beats: [
			{
				title: 'More than 50 screens on one wall.',
				text: 'I iterated in the open, in FigJam, with notes to myself on every pass: clean this up, make “add a note” more visible, does the margin line belong here?',
				media: img('wall.webp', 'An iteration wall of dozens of crown preview screens with sticky notes'),
			},
			{
				title: 'Review only, or editing too?',
				text: 'At the first design jam I showed two versions: one where the dentist only reviews and notes, and one that adds simple embrasure editing. We shipped review first and kept editing behind the research.',
			},
			{
				title: 'Approve, reject, skip: the words mattered.',
				text: 'At the 30% review the team debated every button. “Ignore and start ordering” became approve, request a change, or send to lab instead. Duplicate options merged, and the fix for each flag became the primary action.',
			},
			{
				title: 'Every state, mapped end to end.',
				text: 'Generating, margin good or bad, rebuilding, tight clearance, couldn’t build, skipped, and what each one means on the order page later.',
				media: img('flowwall.webp', 'The updated user flow with every preview state laid out'),
			},
			{
				title: 'About fifteen states, each marked build, debate or cut.',
				text: 'I color-coded my confidence in each so the team knew what was settled, and handed it off before I flew to Cairo to work with our designers.',
				media: img('states.webp', 'Grid of preview states marked build, still debating, or don’t build'),
			},
			{
				title: 'Then the steps became a timeline.',
				text: 'With engineering we moved the steps into the sidebar: confirm margin, preview crown, check clearance. The dentist always sees what the system is doing and what it needs from them.',
				media: img('generating.webp', 'A crown preview generating on the dentist’s scan, with six progress steps and send to lab instead'),
			},
		],
	},
	{
		id: 'craft',
		label: '07 · The details',
		nav: 'The details',
		beats: [
			{
				title: 'Where they first hear about it matters.',
				text: 'I mapped five moments to introduce the preview, each with a hypothesis and what failure would look like. Too early and they forget. Mid-scan and you interrupt whoever holds the wand.',
				media: img('visibility.webp', 'Five places to introduce the preview, from the start of scanning to the review page; the end of prep was chosen'),
			},
			{
				title: 'Tell them while the dentist is still in the room.',
				text: 'During prep, a small card says what’s coming: a preview in a few minutes, a chance to re-prep or leave a note. Skip anytime, and it’s not an approval.',
				media: img('prep-card.webp', 'A card on the prep step: see the crown before the patient leaves'),
			},
			{
				title: 'Then one clear choice.',
				text: 'Before review, the dentist chooses: see the crown, about two minutes to generate and about two days sooner, or continue as usual. The first time is a full page. After that, it’s remembered.',
				media: img('optin.webp', 'Review your crown before it’s made? Yes, show me the crown, or no, continue as usual'),
			},
			{
				title: 'Problems show up on the crown.',
				text: 'When we’re less sure of the margin, the preview pauses and points to the exact stretch. The fix comes first: edit the margin. Keeping it or rescanning are one click away.',
				media: img('margin.webp', 'Margin needs a look: the margin line with one uncertain point flagged, and edit, keep, or rescan'),
			},
			{
				title: 'Heatmaps in plain words.',
				text: 'Red means under 0.5 mm from the opposing tooth. The recommended action leads, and nothing blocks the order: a dentist may plan to adjust at seating.',
				media: img('clearance.webp', 'Not enough room to opposing: a red, yellow and green heatmap on the crown with continue as shown or rescan'),
			},
			{
				title: 'Skipping is fine. We just ask why.',
				text: 'Anyone can skip at any point. A short prompt tells “I didn’t want to wait” apart from “I don’t need this,” the difference between a speed problem and a value problem.',
				media: img('skip.webp', 'Skip this preview modal with reasons: don’t want to wait, patient’s leaving, I’ll look later'),
			},
			{
				title: 'Error copy that doesn’t blame the dentist.',
				text: 'When we can’t generate a preview, the message is “our designers will take it from here,” not “we couldn’t build a crown from this prep.” The crown still gets made.',
				media: img('couldnt.webp', 'The state when no preview can be built: we’ll take it from here, a Dandy designer will finish this crown'),
			},
		],
	},
	{
		id: 'testing',
		label: '08 · Testing plan',
		nav: 'Testing plan',
		beats: [
			{
				title: 'I planned research around the riskiest question.',
				text: 'Moderated 45-minute sessions with chairside dentists who place posterior crowns: some who reject designs often, some who don’t. First the review flow, then an editing prototype, with a $50 lab credit for their time.',
			},
			{
				title: 'Three groups, pulled from the data.',
				text: 'Dentists whose notes were about margin and prep, dentists whose notes were about design, and repeat rejectors over food-trap embrasures. Plus dentists who never reject, so we don’t only hear from the pickiest.',
				metric: { text: '3 + 1', unit: 'recruiting groups from rejection data, plus non-rejectors' },
			},
			{
				title: 'Win and kill criteria, written down first.',
				text: 'Each question has a metric, what a win looks like, and what would kill it, so the pilot can answer it even if sessions run late.',
				media: img('testing.webp', 'Testing plan table: did they look, did they act in the chair, did the later preview change, and a guardrail'),
			},
		],
	},
	{
		id: 'build',
		label: '09 · Building it',
		nav: 'Building it',
		beats: [
			{
				title: 'The prototype became the spec.',
				text: 'I built it in Claude Design on our chairside components. Engineers edited the same prototype instead of rebuilding it, which kept one version of the truth while I was in Cairo with our designers.',
				quote: ['“If we stick with the prototype that Casey’s built … we just have one source of truth.”', 'David Siglin, design lead'],
				media: { ...clip, alt: 'Clicking through the working prototype: the crown generating, then the skip flow' },
			},
			{
				title: 'Three steps, three clicks.',
				text: 'Together we cut the flow to confirm the margin, preview the crown and check clearance. The happy path is three clicks, and most of the time is the crown generating.',
				metric: { text: '3 clicks', unit: 'about 2.5 minutes, 2 of them generating' },
			},
			{
				title: 'Built so we can learn from it.',
				text: 'I asked for tracking on the moments that answer our questions: skip and why, time on the preview, notes, re-preps, and leaving after the crown loaded.',
			},
		],
	},
	{
		id: 'status',
		label: '10 · Where it stands',
		nav: 'Where it stands',
		beats: [
			{
				title: 'Running in real chairside software.',
				text: 'As of November 2026, the flow works end to end in the real chairside app, up to submission: flagged issues, margin editing that rebuilds the crown, heatmaps, approve or reject with feedback. Here’s the team reviewing a build at our daily standup. Next is a pilot with about 20 hand-picked practices.',
				media: img('standup.webp', 'A daily standup reviewing the working build in Dandy Chairside: crown is ready, flagged margin and clearance issues, approve crown or reject with feedback. Coworker names are blurred.'),
			},
			{
				title: 'How we’ll know it worked.',
				text: 'The target is 5–10% more crowns going straight to the lab, with guardrails: near-zero remakes caused by dentist-approved designs, no rise in manufacturing exceptions, and no drop in orders. I’ll be watching how many dentists wait, approve without edits, add a note, or reject.',
				metric: { text: '+5–10%', unit: 'crowns going straight to the lab, the pilot target' },
			},
			{
				title: 'What I’d do differently.',
				text: 'Recruiting dentists for moderated sessions was slow, so the pilot became the study. Next time I’d line up participants before the first prototype, not after.',
			},
		],
	},
];
---

<DandyScroll
	title="Instant Design Preview · Dandy"
	description="How I designed a chairside crown preview so dentists see and approve their crown while the patient is still in the chair."
	eyebrow="Instant Design Preview · 0 → 1 · 2026, in build"
	heroTitle="Showing dentists the crown while the patient is still in the chair."
	lede="I lead the design of a chairside preview: an ML-generated crown appears on the scan, so the dentist can approve it, fix the prep or leave a note before the patient leaves."
	tools="Claude Design · Figma · FigJam · Hex and Amplitude data"
	hero={{ src: '/work/behind/proto.mp4', poster: '/work/behind/proto.jpg' }}
	brand={{ logo: '/brand/dandy-wordmark.svg', alt: 'Dandy', backHref: '/work/dandy', backLabel: '← Dandy overview', cls: 'idp' }}
	short={{
		title: 'Showing dentists the ML crown while the patient is still in the chair.',
		rows: [
			{ k: 'The problem', v: 'A crown is designed after the patient leaves. The dentist first sees it days later, at seating. About 60% get adjusted in the mouth and about 6 in 100 are remade, yet the prep can only change while the patient is in the chair.' },
			{ k: 'What I proposed', v: 'For eligible orders, show the ML-generated crown on the review page right after the prep scan, so the dentist can approve it, re-prep or leave a note before it’s made, instead of rejecting it later.' },
			{ k: 'What I owned', v: 'Lead designer, with a PM, a clinical lead and chairside and ML engineers. I set the direction, mapped the tradeoffs with engineering, designed every state, planned the research, and built the prototype that became the spec.' },
		],
		img: { src: '/work/idp/ready.webp', alt: 'The review page with the generated crown, a clearance heatmap and approve, request a change, or send to lab' },
		stats: [
			{ v: '+10 pts', l: 'Q4 goal: crowns going straight to the lab' },
			{ v: '3 clicks', l: 'to approve a crown', s: ' · about 2.5 min' },
			{ v: '~20', l: 'practices in the pilot, next' },
		],
		src: 'Status: in build, November 2026. Pilot results to come.',
		more: { href: '#sc-context', label: 'Read how I did it' },
	}}
	scenes={scenes}
	endTitle="Decide the crown in the chair."
	endText="The bet is simple: show the result while it can still change, and fewer crowns loop back through a designer."
	endLinks={[{ href: '/work/dandy', label: '← Dandy overview' }, { href: '/work/dandy-design-editor', label: 'The Design Editor case study →', ghost: true }]}
/>

<style is:global>
	/* Diagrams are drawn on the same green, so show them whole instead of cropping. */
	.idp .sc__viz--shots { background: #13251d; }
	.idp .sc__viz--shots > img { object-fit: contain !important; background: #13251d !important; }
	/* Photos fill the frame edge to edge. */
	.idp .sc__viz--shots > img:is([src$='scan-to-seat.webp'], [src$='team.webp']) { object-fit: cover !important; }
	.dsx__short { padding-inline: inherit; }
	.dsx__shortimg { width: 100%; border-radius: 1rem; display: block; }
</style>
