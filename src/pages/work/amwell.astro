---
import Base from '../../layouts/Base.astro';
import { companies } from '../../data/companies';
import { amwell } from '../../data/journey';

const heroTitle = 'Virtual urgent care, used by millions.';
const statement =
	'Amwell is an enterprise telehealth platform that health systems and health plans use to deliver virtual care under their own brand. Over five years I grew from UX Designer to Senior Product Designer, shaping the patient experience and the admin tools that power it.';
const words = statement.split(' ');


const projects = [
	{
		kicker: 'Admin platform',
		title: 'Admin portal redesign',
		metric: { v: '45% → 82%', l: 'admin task completion' },
		text: 'One role-based system replaced a fragmented portal, with a navigation framework that scales from support views to multi-tenant setups.',
		img: { src: '/amwell/cs/hero.webp', alt: 'The redesigned Amwell admin dashboard' },
		link: { label: 'Read the case study', href: '/work/amwell-admin-portal' },
	},
	{
		kicker: 'Patient experience',
		title: 'AI While You Wait',
		metric: { v: '45%', l: 'lower perceived wait time' },
		text: 'An ML-assisted pre-visit triage flow that gives patients something useful to do before their visit starts.',
		img: { src: '/amwell/triage.webp', alt: 'A patient on a video visit from her couch' },
		link: { label: 'Case study coming soon' },
	},
	{
		kicker: 'Patient experience',
		title: 'Patient onboarding and intake',
		metric: { v: '+20%', l: 'onboarding conversion' },
		text: 'A streamlined enrollment and intake journey across mobile and web, reused across white-label clients.',
		img: { src: '/amwell/onboarding.webp', alt: 'Amwell mobile app screens' },
		link: { label: 'Case study coming soon' },
	},
];

const impact = [
	{ v: '45% → 82%', l: 'admin task completion' },
	{ v: '+20%', l: 'onboarding conversion' },
	{ v: '−25%', l: 'inbound inquiries' },
	{ v: '+18%', l: 'bookings from streamlined intake' },
	{ v: '#1', l: 'J.D. Power satisfaction ranking' },
	{ v: '86%', l: 'of user research led' },
];

const hl = [
	{ t: 'Team photo', h: 'Asset: the Amwell design team, an offsite, or a launch day' },
	{ t: 'Research session', h: 'Asset: a photo of a workshop or shadowing session' },
	{ t: 'Talk or workshop', h: 'Asset: a slide or photo from something you led' },
];

const toc = [
	{ id: 'aw-top', label: 'Overview' },
	{ id: 'aw-what', label: 'The journey' },
	{ id: 'aw-fit', label: 'Where I fit in' },
	{ id: 'aw-projects', label: 'My projects' },
	{ id: 'aw-impact', label: 'My impact' },
	{ id: 'aw-highlights', label: 'Other highlights' },
];
const more = companies.filter((c) => c.id !== 'amwell' && c.cta);
---

<Base
	title="Amwell"
	description="Five years designing white-label virtual urgent care, from patient onboarding to the admin tools that run it."
>
	<div class="hv amw aw" data-hv>
		<nav class="toc" data-toc aria-label="Page contents">
			<ul class="toc__rail" aria-hidden="true">{toc.map((s) => <li data-rail={s.id}></li>)}</ul>
			<div class="toc__panel">
				<p class="toc__title">On this page</p>
				<ol class="toc__list">
					{toc.map((s) => (
						<li class="toc__item" data-sec={s.id} data-prev={`/toc/amwell/${s.id}.webp`}>
							<a href={`#${s.id}`} data-go={s.id}>{s.label}</a>
						</li>
					))}
				</ol>
			</div>
		</nav>

		<section class="hv__cover aw__cover" id="aw-top" aria-labelledby="amwell-h">
			<img class="hv__logo aw__logo" src="/brand/amwell-white.svg" alt="Amwell" width="120" height="34" />
			<div class="hv__cover-text">
				<p class="hv__eyebrow">Work · Amwell · 2019 – 2024</p>
				<h1 id="amwell-h" aria-label={heroTitle}>
					{heroTitle.split(' ').map((w, i) => (<><span class="hv-w" aria-hidden="true" style={`--i:${i}`}>{w}</span>{' '}</>))}
				</h1>
			</div>
			<figure class="aw__art" aria-hidden="true"><img src="/amwell/hero-platform.webp" alt="" /></figure>
		</section>

		<section class="hv__reveal" data-reveal aria-label="About my work at Amwell">
			<div class="hv__pin">
				<p class="hv__statement">{words.map((w) => <span class="hv-rw">{w} </span>)}</p>
			</div>
		</section>

		<section class="jr" id="aw-what" aria-labelledby="aw-what-h" data-journey>
			<div class="jr__head">
				<h2 id="aw-what-h" class="hv__big hv__big--md">The journey.</h2>
				<p class="jr__sub">Three people meet in every visit. I designed for all of them.</p>
			</div>
			<div class="jr__body">
				<ol class="jr__steps" role="tablist" aria-label="The three roles in a visit">
					{[
						{ role: 'Patient', t: 'Starts a visit.', d: 'Chooses care, answers intake and waits for a provider, on web or in the app.', img: '/amwell/cs/pat-persona.webp' },
						{ role: 'Provider', t: 'Treats the patient.', d: 'Reviews intake, runs the video visit, prescribes and follows up.', img: '/amwell/cs/prov-persona.webp' },
						{ role: 'Health admin', t: 'Connects the two.', d: 'Sets up services, providers and rules for their health system, so each patient reaches the right provider.', img: '/amwell/cs/admin-persona.webp' },
					].map((x, i) => (
						<li>
							<button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`jr-p${i}`} data-i={i}>
								<img src={x.img} alt="" />
								<span class="jr__txt"><small>{String(i + 1).padStart(2, '0')} · {x.role}</small><b>{x.t}</b><span>{x.d}</span></span>
								<i class="jr__bar" aria-hidden="true"></i>
							</button>
						</li>
					))}
				</ol>
				<div class="jr__view">
					{[
						{ src: '/amwell/cs/pat-portal.webp', alt: 'The Amwell patient portal' },
						{ src: '/amwell/cs/prov-portal.webp', alt: 'The Amwell provider portal' },
						{ src: '/amwell/cs/admin-portal.webp', alt: 'The Amwell admin console' },
					].map((x, i) => (
						<button type="button" class:list={['jr__shot', { on: i === 0 }]} id={`jr-p${i}`} role="tabpanel" data-zoom={x.src} aria-label={`Expand: ${x.alt}`}>
							<img src={x.src} alt={x.alt} loading={i === 0 ? 'eager' : 'lazy'} />
							<span class="jr__zoom" aria-hidden="true">⤢</span>
						</button>
					))}
				</div>
			</div>
			<dialog class="jr__lb" aria-label="Enlarged screen"><button type="button" class="jr__x" aria-label="Close">×</button><img alt="" /></dialog>
		</section>

		<section class="aw__sec" id="aw-fit" aria-labelledby="aw-fit-h">
			<h2 id="aw-fit-h" class="hv__big hv__big--md">Where I fit in.</h2>
			<p class="hv__lede">{amwell.title}</p>
			<ol class="aw__ranks">
				{amwell.ranks.map((r) => (
					<li class="aw__rank" data-fade>
						<span class="aw__yr">{r.year}</span>
						<h3>{r.title}</h3>
						<p class="aw__scope">{r.scope}</p>
						<p>{r.summary}</p>
					</li>
				))}
			</ol>
		</section>

		<section class="hv__work hv__work--cards aw__sec" id="aw-projects" aria-labelledby="aw-proj-h">
			<h2 id="aw-proj-h" class="hv__big hv__big--md">My projects.</h2>
			<p class="hv__lede">Led with the result.</p>
			<ul class="hv__cards">
				{projects.map((p) => (
					<li class="hv__card" data-fade>
						{p.link.href ? <a class="hv__card-link" href={p.link.href} aria-label={`${p.title}: ${p.link.label}`}></a> : null}
						<figure class="hv__card-art">
							{p.img ? <img src={p.img.src} alt={p.img.alt} loading="lazy" decoding="async" /> : <span class="aw__ph" role="img" aria-label={`Placeholder. ${p.ph}`}><small>{p.ph}</small></span>}
						</figure>
						<div class="hv__card-body">
							<p class="hv__persona">{p.kicker}</p>
							<p class="aw__metric"><b>{p.metric.v}</b> {p.metric.l}</p>
							<h3>{p.title}</h3>
							<p>{p.text}</p>
							<div class="hv__card-foot">
								{p.link.href ? <span class="hv__cta">{p.link.label} →</span> : <span class="hv__soon">Coming soon</span>}
							</div>
						</div>
					</li>
				))}
			</ul>
		</section>

		<section class="aw__sec" id="aw-impact" aria-labelledby="aw-imp-h">
			<h2 id="aw-imp-h" class="hv__big hv__big--md">My impact.</h2>
			<p class="hv__lede">Across five years of patient and admin work.</p>
			<ul class="aw__stats">
				{impact.map((m) => <li data-fade><b>{m.v}</b><span>{m.l}</span></li>)}
			</ul>
		</section>

		<section class="aw__sec" id="aw-highlights" aria-labelledby="aw-hl-h">
			<h2 id="aw-hl-h" class="hv__big hv__big--md">Other highlights.</h2>
			<p class="hv__lede">The people and moments behind the work.</p>
			<ul class="aw__hl">
				{hl.map((h) => (
					<li data-fade><span class="aw__ph" role="img" aria-label={`Placeholder. ${h.h}`}><b>{h.t}</b><small>{h.h}</small></span></li>
				))}
			</ul>
		</section>

		<section class="hv__more cx__end" aria-labelledby="more-h">
			<div class="cx__endtop">
				<h2 id="more-h" class="cx__endh">Keep exploring.</h2>
				<p class="cx__endp">More of my product design work.</p>
			</div>
			<ul class="cx__cards cx__cards--2">
				{more.map((c) => (
					<li>
						<a class="cx__card" href={c.cta!.href}>
							<span class="cx__cardm">{c.visual?.src && <img src={c.visual.src} alt="" loading="lazy" decoding="async" />}</span>
							<span class="cx__cardt"><small>{c.role} · {c.when}</small><b>{c.name}</b><em>{c.blurb}</em></span>
							<span class="cx__cardgo" aria-hidden="true">→</span>
						</a>
					</li>
				))}
			</ul>
			<a class="cx__endall" href="/work">← All work</a>
		</section>
	</div>
</Base>

<script>
	import { stackSections, wireDots, natTop, railLabels, tocPreview } from '../../scripts/takeover';
	const root = document.querySelector<HTMLElement>('[data-hv]');
	const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const clamp = (n: number) => Math.max(0, Math.min(1, n));
	if (root && !calm) {
		root.classList.add('is-live', 'cx--live');
		if (matchMedia('(max-width: 899px)').matches) root.classList.add('cx--mob');
		const reveal = root.querySelector<HTMLElement>('[data-reveal]');
		const rws = reveal ? Array.from(reveal.querySelectorAll<HTMLElement>('.hv-rw')) : [];
		const tick = () => {
			if (!reveal) return;
			const r = reveal.getBoundingClientRect();
			const p = clamp(-r.top / Math.max(1, r.height - innerHeight));
			const lit = Math.round(p * 1.25 * rws.length);
			rws.forEach((w, i) => w.classList.toggle('lit', i < lit));
		};
		let raf = 0;
		addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(tick); }, { passive: true });
		addEventListener('resize', tick);
		tick();
		const story = root.querySelector<HTMLElement>('[data-story]');
		const stage = story?.querySelector<HTMLElement>('[data-stage]');
		const caps = story ? Array.from(story.querySelectorAll<HTMLElement>('[data-cap]')) : [];
		let lastPh = -1;
		const phase = () => {
			if (!story || !stage) return;
			if (root.classList.contains('cx--mob')) return;
			const r = story.getBoundingClientRect();
			const p = clamp(-r.top / Math.max(1, r.height - innerHeight));
			const ph = Math.min(3, Math.floor(p * 4));
			if (ph === lastPh) return;
			lastPh = ph;
			stage.dataset.ph = String(ph);
			caps.forEach((c) => c.classList.toggle('on', Number(c.dataset.cap) === ph));
		};
		if (story && !root.classList.contains('cx--mob')) { story.classList.add('is-pinned'); if (stage) stage.dataset.ph = '0'; caps[0]?.classList.add('on'); }
		addEventListener('scroll', () => requestAnimationFrame(phase), { passive: true });
		addEventListener('resize', phase);
		phase();
		const io = new IntersectionObserver(
			(es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
			{ rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
		);
		root.querySelectorAll('[data-fade]').forEach((el) => io.observe(el));
		if (!root.classList.contains('cx--mob')) {
			const secs = ['#aw-what', '#aw-fit', '#aw-projects', '#aw-impact', '#aw-highlights', '.hv__more']
				.map((s) => root.querySelector<HTMLElement>(s)).filter(Boolean) as HTMLElement[];
			stackSections(root, secs);
			wireDots(root);
			const t = location.hash ? document.getElementById(location.hash.slice(1)) : null;
			if (t) {
				const go = () => scrollTo({ top: natTop(t) + scrollY - 70, behavior: 'instant' as ScrollBehavior });
				if (document.readyState === 'complete') setTimeout(go, 150); else addEventListener('load', () => setTimeout(go, 150));
				setTimeout(go, 1000);
			}
		}
	}

	// The journey: three roles, auto-advancing, click a step to jump, click a screen to expand.
	document.querySelectorAll<HTMLElement>('[data-journey]').forEach((jr) => {
		const tabs = Array.from(jr.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
		const shots = Array.from(jr.querySelectorAll<HTMLElement>('.jr__shot'));
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let cur = 0, timer: number | undefined, playing = false;
		const DUR = 5200;
		const show = (i: number) => {
			cur = i;
			tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.classList.toggle('done', k < i); });
			shots.forEach((s, k) => s.classList.toggle('on', k === i));
			jr.style.setProperty('--dur', playing ? `${DUR}ms` : '0ms');
		};
		const stop = () => { playing = false; clearInterval(timer); jr.classList.remove('is-playing'); };
		const play = () => {
			if (reduce) return;
			playing = true; jr.classList.add('is-playing'); show(cur);
			timer = window.setInterval(() => { if (cur === tabs.length - 1) return stop(); show(cur + 1); }, DUR);
		};
		tabs.forEach((t, i) => t.addEventListener('click', () => { stop(); show(i); }));
		const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); play(); } }, { threshold: 0.5 });
		io.observe(jr);
		const lb = jr.querySelector<HTMLDialogElement>('.jr__lb')!;
		shots.forEach((s) => s.addEventListener('click', () => { stop(); lb.querySelector('img')!.src = s.dataset.zoom!; lb.showModal(); }));
		lb.addEventListener('click', () => lb.close());
	});

	const toc = document.querySelector<HTMLElement>('[data-toc]');
	if (toc) {
		const items = Array.from(toc.querySelectorAll<HTMLElement>('.toc__item'));
		const rail = Array.from(toc.querySelectorAll<HTMLElement>('[data-rail]'));
		railLabels(items, rail);
		tocPreview(toc);
		const secOf = (id: string) => document.getElementById(id)!;
		toc.querySelectorAll<HTMLAnchorElement>('a[data-go]').forEach((a) =>
			a.addEventListener('click', (e) => {
				e.preventDefault();
				const id = a.dataset.go!;
				scrollTo({ top: id === 'aw-top' ? 0 : natTop(secOf(id)) + scrollY - 70, behavior: 'smooth' });
			}),
		);
		let raf2 = 0;
		const tick2 = () => {
			let cur = 0;
			items.forEach((it, k) => { if (natTop(secOf(it.dataset.sec!)) <= innerHeight * 0.35) cur = k; });
			items.forEach((it, k) => it.classList.toggle('on', k === cur));
			rail.forEach((r, k) => r.classList.toggle('on', k === cur));
		};
		addEventListener('scroll', () => { cancelAnimationFrame(raf2); raf2 = requestAnimationFrame(tick2); }, { passive: true });
		addEventListener('resize', tick2);
		tick2();
	}
</script>

<style>
	.jr { padding: clamp(4rem, 10vh, 7rem) clamp(1.25rem, 5vw, 4rem); max-width: 72rem; margin: 0 auto; }
	.jr__head :global(h2) { float: none !important; display: block; margin: 0; }
	.jr__sub { display: block !important; max-width: 36rem; clear: both; margin: 0.75rem 0 0; color: var(--muted); font-size: 1.1rem; }
	.jr__body { display: grid; grid-template-columns: minmax(0, 22rem) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; margin-top: 2.5rem; }
	.jr__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
	.jr__steps button { position: relative; display: grid; grid-template-columns: 3rem 1fr; gap: 0.9rem; align-items: start; width: 100%; padding: 0.9rem 1rem 1.1rem; border: 1px solid transparent; border-radius: 1rem; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; overflow: hidden; transition: background 0.35s ease, border-color 0.35s ease, opacity 0.35s ease; opacity: 0.55; }
	.jr__steps button:hover { opacity: 0.85; }
	.jr__steps button[aria-selected='true'] { opacity: 1; background: color-mix(in srgb, var(--ink) 5%, transparent); border-color: var(--line); }
	.jr__steps img { width: 3rem; height: 3rem; border-radius: 50%; object-fit: cover; background: var(--paper); }
	.jr__txt { display: flex; flex-direction: column; gap: 0.2rem; }
	.jr__txt small { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
	.jr__txt b { font-size: 1.05rem; }
	.jr__txt > span { display: grid; grid-template-rows: 0fr; overflow: hidden; color: var(--muted); font-size: 0.9rem; line-height: 1.45; transition: grid-template-rows 0.45s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.35s; opacity: 0; max-height: 0; }
	.jr__steps button[aria-selected='true'] .jr__txt > span { opacity: 1; max-height: 6rem; margin-top: 0.2rem; }
	.jr__bar { position: absolute; left: 1rem; right: 1rem; bottom: 0.45rem; height: 2px; border-radius: 2px; background: var(--line); transform-origin: left; transform: scaleX(0); }
	.jr__steps button[aria-selected='true'] .jr__bar { background: var(--accent); }
	:global(.is-playing) .jr__steps button[aria-selected='true'] .jr__bar { animation: jrfill var(--dur, 0ms) linear forwards; }
	@keyframes jrfill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
	.jr__view { position: relative; aspect-ratio: 16 / 10.5; }
	.jr__shot { position: absolute; inset: 0; padding: 0; border: 1px solid var(--line); border-radius: 1rem; overflow: hidden; background: #fff; cursor: zoom-in; opacity: 0; transform: translateY(12px) scale(0.985); transition: opacity 0.55s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); pointer-events: none; box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.55); }
	.jr__shot.on { opacity: 1; transform: none; pointer-events: auto; }
	.jr__shot img { width: 100%; height: 100%; object-fit: cover; object-position: top left; display: block; }
	.jr__zoom { position: absolute; right: 0.75rem; top: 0.75rem; width: 2.1rem; height: 2.1rem; border-radius: 50%; display: grid; place-items: center; background: rgba(0, 0, 0, 0.55); color: #fff; font-size: 1rem; opacity: 0; transition: opacity 0.2s; }
	.jr__shot:hover .jr__zoom, .jr__shot:focus-visible .jr__zoom { opacity: 1; }
	.jr__lb { border: 0; padding: 0; background: transparent; max-width: 96vw; max-height: 94vh; }
	.jr__lb::backdrop { background: rgba(10, 12, 20, 0.88); }
	.jr__lb img { max-width: 96vw; max-height: 92vh; display: block; border-radius: 0.6rem; }
	.jr__x { position: fixed; top: 1rem; right: 1rem; width: 2.5rem; height: 2.5rem; border-radius: 50%; border: 0; background: #fff; font-size: 1.4rem; cursor: pointer; }
	@media (max-width: 860px) {
		.jr__body { grid-template-columns: 1fr; }
		.jr__view { order: -1; }
	}
	@media (prefers-reduced-motion: reduce) { .jr__shot, .jr__steps button, .jr__txt > span { transition: none; } }
</style>
