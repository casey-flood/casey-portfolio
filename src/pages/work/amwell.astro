---
import Base from '../../layouts/Base.astro';
import CompanyBanner from '../../components/CompanyBanner.astro';
import { companies } from '../../data/companies';
const company = companies.find((c) => c.id === 'amwell')!;
---

<Base
	title="Amwell"
	description="Five years designing white-label virtual urgent care, from patient onboarding to the admin tools that run it."
>
	<section class="page-intro">
		<div class="shell">
			<a class="back" href="/work">← All work</a>
			<p class="eyebrow eyebrow--sky">Work · Amwell</p>
			<h1>Amwell</h1>
			<p class="lede">Five years designing white-label virtual urgent care, from patient onboarding to the admin tools that run it.</p>
		</div>
	</section>

	<section class="section" style="padding-top: 1.5rem" aria-label="Overview">
		<div class="shell">
			<CompanyBanner company={company} mode="hub" />
		</div>
	</section>
</Base>
