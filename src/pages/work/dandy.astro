---
import Base from '../../layouts/Base.astro';
import { testimonials } from '../../data/testimonials';
import { highlights } from '../../data/highlights';
import { companies } from '../../data/companies';
import { tools } from '../../data/tools';
import ToolsScene from '../../components/ToolsScene.astro';
import JourneyLite from '../../components/JourneyLite.astro';
import { stages } from '../../data/scan-to-smile';
import { stageImages } from '../../data/scan-to-smile-images';

const heroTitle = 'Designing both sides of a digital dental lab.';
const statement =
	"Dandy connects dentists, dental designers, and manufacturing through software. I've designed the dentist-facing ordering flows and the designer-facing Design Editor.";
const words = statement.split(' ');

const persona: Record<string, string> = {
	patient: 'Patient',
	dentist: 'Dentist',
	designer: 'Dental designer',
	ops: 'Manufacturing',
	both: 'Dentist and patient',
};

// One block per project. `on` lights the journey steps the project touches.
const projects = [
	{
		kicker: 'For dental designers',
		title: 'Dandy Design Editor',
		text: "One end-to-end system for designing the whole restoration in house: faster turnaround for customers, lower costs for Dandy.",
		on: [4],
		img: { src: '/scan-to-smile/04-design.webp', alt: 'A dental designer working on a 3D restoration' },
		link: { label: 'Read the case study', href: '/work/dandy-design-editor' },
	},
	{
		kicker: 'For dentists',
		title: 'Instant Design Preview',
		text: 'Dentists see the ML-generated crown chairside and approve it while the patient is still in the chair.',
		on: [3, 4],
		img: { src: '/scan-to-smile/extra-ml-crown.webp', alt: 'A machine-learning generated crown' },
		link: { label: 'Read the case study', href: '/work/dandy-instant-design-preview' },
	},
	{
		kicker: 'For dentists and patients',
		title: 'Perfect Fit (Goldilocks)',
		text: 'Three crown fits in one order: quicker turnaround, fewer seating appointments, happier patients.',
		on: [3, 6],
		img: { src: '/story/dandy/pf-final.webp', alt: 'The Perfect Fit step in the order flow' },
		link: { label: 'Case study coming soon' },
	},
];

const toc: { id: string; label: string; subs?: { label: string; from: number; to: number }[] }[] = [
	{ id: 'dv-top', label: 'Overview' },
	{ id: 'journey', label: 'From scan to smile', subs: stages.map((s, i) => ({ label: s.title, from: i + 1, to: i + 1 })) },
	{ id: 'dv-fit', label: 'Where I fit in' },
	{ id: 'dv-sys', label: 'Behind the work' },
	{ id: 'dv-tools', label: 'Tools I use' },
	...(testimonials.length > 0 ? [{ id: 'dv-praise', label: 'What coworkers say' }] : []),
	...(highlights.length > 0 ? [{ id: 'dv-highlights', label: 'Other highlights' }] : []),
];

const more = companies.filter((c) => c.id !== 'dandy' && c.cta);

const systems = [
	{ t: 'Built a design system with AI (Cursor)', m: 'Designs match what ships.', href: '/work/dandy-design-system', vid: '/work/behind/ds' },
	{ t: 'Prototype in code, for every project', m: 'Real flows, ready for early feedback.', href: '/work/dandy-prototype', vid: '/work/behind/proto' },
	{ t: 'Built a hub that teaches the team to prototype in code', m: 'A guided path for the whole company.', href: '/work/dandy-product-design-hub', vid: '/work/behind/hub' },
];
---

<Base
	title="Dandy"
	description="Casey Flood's work at Dandy, a digital dental lab: Chairside ordering, the Design Editor, and the systems around them."
>
	<div class="hv" data-hv>
		<nav class="toc" data-toc aria-label="Page contents">
			<ul class="toc__rail" aria-hidden="true">{toc.map((s) => <li data-rail={s.id}></li>)}</ul>
			<div class="toc__panel">
				<p class="toc__title">On this page</p>
				<ol class="toc__list">
					{toc.map((s) => (
						<li class="toc__item" data-sec={s.id} data-prev={`/toc/dandy/${s.id}.webp`}>
							<a href={`#${s.id}`} data-go={s.id}>{s.label}</a>
							{s.subs && (
								<ol class="toc__sub">
									{s.subs.map((u) => <li><a href={`#${s.id}`} data-go={s.id} data-i={u.from} data-to={u.to}>{u.label}</a></li>)}
								</ol>
							)}
						</li>
					))}
				</ol>
			</div>
		</nav>
		<!-- 1. Cover -->
		<section class="hv__cover" id="dv-top" aria-labelledby="dandy-h">
			<div class="cx__top" style="margin-bottom:0">
				<img class="hv__logo" src="/brand/dandy-wordmark.svg" alt="Dandy" width="96" height="34" />
				<a class="cx__back" href="/work">← All work</a>
			</div>
			<div class="hv__cover-text">
				<p class="hv__eyebrow">Work · Dandy · 2025 – now</p>
				<h1 id="dandy-h" aria-label={heroTitle}>
					{heroTitle.split(' ').map((w, i) => (<><span class="hv-w" aria-hidden="true" style={`--i:${i}`}>{w}</span>{' '}</>))}
				</h1>
			</div>
			<div class="hv__cover-art" aria-hidden="true" data-parallax>
				<video data-scan src="/work/vision-scan.mp4" muted playsinline preload="auto" disablepictureinpicture></video>
				<canvas data-scancv></canvas>
			</div>
		</section>

		<!-- 2. One statement that lights up word by word as you scroll -->
		<section class="hv__reveal" data-reveal aria-label="About my work at Dandy">
			<div class="hv__pin">
				<p class="hv__statement">
					{words.map((w) => <span class="hv-rw">{w} </span>)}
				</p>
			</div>
		</section>

		<!-- 3. The journey: same scroll story as the Design Editor case study -->
		<JourneyLite />

		<!-- 4. Product changes, as cards -->
		<section class="hv__work hv__work--cards" id="dv-fit" aria-labelledby="work-h">
			<h2 id="work-h" class="hv__big hv__big--md">Where I fit in.</h2>
			<p class="hv__lede">What changed in the product, for the people using it.</p>
			<ul class="hv__cards">
				{
					projects.map((p) => (
						<li class="hv__card" data-fade>
							{p.link.href ? <a class="hv__card-link" href={p.link.href} aria-label={`${p.title}: ${p.link.label}`}></a> : null}
							<figure class="hv__card-art">
								<img src={p.img.src} alt={p.img.alt} loading="lazy" decoding="async" />
							</figure>
							<div class="hv__card-body">
								<p class="hv__persona">{p.kicker}</p>
								<h3>{p.title}</h3>
								<p>{p.text}</p>
								<div class="hv__card-foot">
									{p.link.href ? <span class="hv__cta">{p.link.label} →</span> : <span class="hv__soon">Coming soon</span>}
								</div>
							</div>
						</li>
					))
				}
			</ul>
		</section>

		<!-- 5. Systems, with one number -->
		<section class="hv__sys hv__sys--cards" id="dv-sys" aria-labelledby="sys-h" data-fade>
			<h2 id="sys-h" class="hv__big hv__big--md">Behind the work.</h2>
			<p class="hv__sysstat"><b>5–10 min</b> per product design iteration in code, down from 30–45 minutes in Figma.</p>
			<ul class="hv__rowlist">
				{
					systems.map((r) => (
						<li class="hv__rowitem">
							<a class="hv__rowlink" href={r.href}>
								<video class="hv__rowvid" src={`${r.vid}.mp4`} poster={`${r.vid}.jpg`} muted loop playsinline preload="none" data-hovervid></video>
								<span class="hv__rowtext"><b>{r.t}</b><small>{r.m}</small></span>
								<span class="hv__rowgo" aria-hidden="true">→</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<!-- Tools: its own scroll scene -->
		<ToolsScene id="dv-tools" tools={tools} title="Design in code, with AI in the loop." lede="Most of my day happens in these." />

		<!-- 6. What coworkers say: its own pinned scene, one quote at a time -->
		{
			testimonials.length > 0 && (
				<section class="hv__praise" id="dv-praise" data-praise style={`--n:${testimonials.length}`} aria-labelledby="praise-h">
					<div class="hv__pin hv__praise-pin">
						<div class="hv__praise-head">
							<h2 id="praise-h" class="hv__big hv__big--md">What coworkers say.</h2>
							<ol class="hv__praise-dots" aria-hidden="true">{testimonials.map(() => <li></li>)}</ol>
						</div>
						<div class="hv__praise-stage">
							{testimonials.map((q) => (
								<figure class="hv__q">
									{q.context && <span class="hv__stepno">{q.context}</span>}
									<blockquote>“{q.quote}”</blockquote>
									<figcaption class="hv__who"><b>{q.name}</b><span>{q.role}</span></figcaption>
								</figure>
							))}
						</div>
					</div>
				</section>
			)
		}
		<!-- 7. Other highlights: a tilted photo wall -->
		{
			highlights.length > 0 && (
				<section class="hv__hl" id="dv-highlights" aria-labelledby="hl-h">
					<div class="hv__hl-head" data-fade>
						<h2 id="hl-h" class="hv__big hv__big--md">Other highlights.</h2>
						<p class="hv__lede">The people I get to build with.</p>
					</div>
					<ul class="hv__wall">
						{highlights.map((h, i) => (
							<li class="hv__shot" data-fade style={`--r:${h.rot}deg;--y:${h.y}rem;--w:${h.w}rem;--d:${i * 70}ms`}>
								<figure>
									<img src={h.src} alt={h.alt} loading="lazy" decoding="async" />
									{h.caption && <figcaption>{h.caption}</figcaption>}
								</figure>
							</li>
						))}
					</ul>
				</section>
			)
		}
		<!-- 8. Closer: keep exploring -->
		<section class="hv__more cx__end" aria-labelledby="more-h">
			<div class="cx__endtop">
				<h2 id="more-h" class="cx__endh">Keep exploring.</h2>
				<p class="cx__endp">More of my product design work, before Dandy.</p>
			</div>
			<ul class="cx__cards cx__cards--2">
				{more.map((c) => (
					<li>
						<a class="cx__card" href={c.cta!.href}>
							<span class="cx__cardm">{c.visual?.src && <img src={c.visual.src} alt="" loading="lazy" decoding="async" />}</span>
							<span class="cx__cardt"><small>{c.role} · {c.when}</small><b>{c.name}</b><em>{c.blurb}</em></span>
							<span class="cx__cardgo" aria-hidden="true">→</span>
						</a>
					</li>
				))}
			</ul>
			<a class="cx__endall" href="/work">← All work</a>
		</section>
	</div>
</Base>

<script>
	import { stackSections, wireDots, natTop } from '../../scripts/takeover';
	const root = document.querySelector<HTMLElement>('[data-hv]');
	const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (root && !calm) {
		root.classList.add('is-live', 'cx--live');
		const mob = window.matchMedia('(max-width: 899px)').matches;
		if (mob) root.classList.add('cx--mob');
		// the journey: one pinned section, a phase per step (desktop only; phones read it as a vertical list)
		const jr = root.querySelector<HTMLElement>('[data-journey]');
		if (jr && !mob) {
			const items = Array.from(jr.querySelectorAll<HTMLElement>('[data-p]'));
			const w: number[] = JSON.parse(jr.dataset.w || '[1]');
			const total = w.reduce((a, b) => a + b, 0);
			let lastP = -1;
			const jtick = () => {
				const r = jr.getBoundingClientRect();
				const q = Math.max(0, Math.min(0.9999, -r.top / Math.max(1, r.height - window.innerHeight))) * total;
				let acc = 0, p = w.length - 1;
				for (let i = 0; i < w.length; i++) { acc += w[i]; if (q < acc) { p = i; break; } }
				if (p === lastP) return;
				lastP = p;
				items.forEach((e) => { const k = Number(e.dataset.p); e.classList.toggle('on', k === p); e.classList.toggle('seen', k <= p); });
			};
			addEventListener('scroll', () => requestAnimationFrame(jtick), { passive: true });
			addEventListener('resize', jtick);
			jtick();
		}
		const clamp = (n: number) => Math.max(0, Math.min(1, n));
		// progress through a tall section: 0 when its top reaches the viewport top, 1 when its bottom reaches the viewport bottom
		const progress = (el: HTMLElement) => {
			const r = el.getBoundingClientRect();
			return clamp(-r.top / Math.max(1, r.height - window.innerHeight));
		};

		const reveal = root.querySelector<HTMLElement>('[data-reveal]');
		const rws = reveal ? Array.from(reveal.querySelectorAll<HTMLElement>('.hv-rw')) : [];
		const story = root.querySelector<HTMLElement>('[data-story]');
		const idx = (sel: string) => (story ? Array.from(story.querySelectorAll<HTMLElement>(sel)) : []);
		const steps = idx('.hv__step');
		const frames = idx('.hv__frame');
		const rail = idx('.hv__rail li');
		const par = root.querySelector<HTMLElement>('[data-parallax]');
		const praise = root.querySelector<HTMLElement>('[data-praise]');
		const pq = praise ? Array.from(praise.querySelectorAll<HTMLElement>('.hv__q')) : [];
		const pd = praise ? Array.from(praise.querySelectorAll<HTMLElement>('.hv__praise-dots li')) : [];
		let lastQ = -1;
		// the scanner sweeps the arch as the cover scrolls: video time follows scroll position
		const scan = root.querySelector<HTMLVideoElement>('[data-scan]');
		let scanT = -1;
		const scrub = () => {
			if (!scan || !scan.duration) return;
			const r = scan.getBoundingClientRect();
			const vh = window.innerHeight;
			const p = clamp((vh * 0.95 - r.top) / (vh * 0.95 - vh * 0.05 + r.height * 0.3));
			const t = p * (scan.duration - 0.05);
			if (Math.abs(t - scanT) > 0.015) { scanT = t; scan.currentTime = t; }
		};
		// black becomes transparent: alpha = brightest channel, colour un-multiplied, so it sits on the page green
		const cv = root.querySelector<HTMLCanvasElement>('[data-scancv]');
		const cx2 = cv?.getContext('2d', { willReadFrequently: true });
		const paint = () => {
			if (!scan || !cv || !cx2 || !scan.videoWidth) return;
			if (cv.width !== scan.videoWidth) { cv.width = scan.videoWidth; cv.height = scan.videoHeight; }
			cx2.drawImage(scan, 0, 0, cv.width, cv.height);
			const img = cx2.getImageData(0, 0, cv.width, cv.height);
			const d = img.data;
			for (let i = 0; i < d.length; i += 4) {
				const m = Math.max(d[i], d[i + 1], d[i + 2]);
				if (m < 14) { d[i + 3] = 0; continue; }
				const k = 255 / m;
				d[i] = d[i] * k; d[i + 1] = d[i + 1] * k; d[i + 2] = d[i + 2] * k;
				d[i + 3] = Math.min(255, (m - 14) * 2.2);
			}
			cx2.putImageData(img, 0, 0);
			cv.classList.add('ready');
		};
		scan?.addEventListener('seeked', paint);
		scan?.addEventListener('loadeddata', () => { scrub(); paint(); });
		scan?.addEventListener('loadedmetadata', scrub);
		let last = -1;

		const tick = () => {
			if (reveal) {
				const p = progress(reveal);
				const lit = Math.round(p * 1.25 * rws.length);
				rws.forEach((w, i) => w.classList.toggle('lit', i < lit));
			}
			if (story) {
				const n = steps.length;
				const i = Math.min(n - 1, Math.floor(progress(story) * n));
				if (i !== last) {
					last = i;
					[steps, frames, rail].forEach((list) => list.forEach((el, k) => el.classList.toggle('on', k === i)));
				}
			}
			if (praise) {
				const k = Math.min(pq.length - 1, Math.floor(progress(praise) * pq.length));
				if (k !== lastQ) {
					lastQ = k;
					pq.forEach((el, i) => { el.classList.toggle('on', i === k); el.classList.toggle('past', i < k); });
					pd.forEach((el, i) => el.classList.toggle('on', i === k));
				}
			}
			scrub();
			if (par) par.style.setProperty('--py', `${Math.min(scrollY, 900) * -0.08}px`);
		};
		let raf = 0;
		addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(tick); }, { passive: true });
		addEventListener('resize', tick);
		tick();

		// short loops play only while on screen
		const vio = new IntersectionObserver((es) => es.forEach((e) => { const v = e.target as HTMLVideoElement; if (e.isIntersecting) v.play().catch(() => {}); else v.pause(); }), { threshold: 0.25 });
		root.querySelectorAll<HTMLVideoElement>('[data-hovervid]').forEach((v) => {
			const a = v.closest('a')!;
			const go = () => v.play().catch(() => {});
			const stop = () => { v.pause(); v.currentTime = 0; };
			a.addEventListener('mouseenter', go); a.addEventListener('mouseleave', stop);
			a.addEventListener('focus', go); a.addEventListener('blur', stop);
			if (matchMedia('(hover: none)').matches) vio.observe(v);
		});

		// everything else fades up once as it enters
		const io = new IntersectionObserver(
			(es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
			{ rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
		);
		root.querySelectorAll('[data-fade]').forEach((el) => io.observe(el));

		// each section takes over the screen and replaces the previous one
		if (!root.classList.contains('cx--mob')) {
			const secs = ['#dv-fit', '#dv-sys', '#dv-tools', '#dv-praise', '#dv-highlights', '.hv__more']
				.map((s) => root.querySelector<HTMLElement>(s)).filter(Boolean) as HTMLElement[];
			stackSections(root, secs);
			wireDots(root);
				// arriving with a #section link (e.g. from a case study): land on that section once the stack is set
				const hashTarget = location.hash ? document.getElementById(location.hash.slice(1)) : null;
				if (hashTarget) {
					const goHash = () => scrollTo({ top: natTop(hashTarget) + scrollY - 70, behavior: 'instant' as ScrollBehavior });
					if (document.readyState === 'complete') setTimeout(goHash, 150);
					else addEventListener('load', () => setTimeout(goHash, 150));
					setTimeout(goHash, 1000); // after the browser's own jump to the anchor, if it runs late
				}
		}
	}
</script>

<script>
	import { natTop, railLabels, tocPreview } from '../../scripts/takeover';
	// Page navigator for the overview: dots at the left, a panel on hover with the journey steps.
	const toc = document.querySelector<HTMLElement>('[data-toc]');
	if (toc) {
		const pinned = !!document.querySelector('.cx--live') && !document.querySelector('.cx--mob');
		const items = Array.from(toc.querySelectorAll<HTMLElement>('.toc__item'));
		const rail = Array.from(toc.querySelectorAll<HTMLElement>('[data-rail]'));
		railLabels(items, rail);
		tocPreview(toc);
		const secOf = (id: string) => document.getElementById(id)!;
		const phase = (sec: HTMLElement) => {
			const w: number[] = JSON.parse(sec.dataset.w || '[1]');
			const total = w.reduce((a, b) => a + b, 0);
			const r = sec.getBoundingClientRect();
			const q = Math.max(0, Math.min(0.9999, -r.top / Math.max(1, r.height - innerHeight))) * total;
			let acc = 0;
			for (let i = 0; i < w.length; i++) { acc += w[i]; if (q < acc) return i; }
			return w.length - 1;
		};
		const goTo = (id: string, i?: number) => {
			const sec = secOf(id);
			if (!sec) return;
			const top = natTop(sec) + scrollY;
			if (i == null || !sec.hasAttribute('data-journey')) { scrollTo({ top: id === 'dv-top' ? 0 : top - 70, behavior: 'smooth' }); return; }
			if (pinned) {
				const w: number[] = JSON.parse(sec.dataset.w || '[1]');
				const total = w.reduce((a, b) => a + b, 0);
				const start = w.slice(0, i).reduce((a, b) => a + b, 0) + w[i] * 0.5;
				scrollTo({ top: top + (start / total) * (sec.offsetHeight - innerHeight), behavior: 'smooth' });
			} else {
				(sec.querySelector(`.lc__t[data-p="${i}"]`) as HTMLElement | null)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		};
		toc.querySelectorAll<HTMLAnchorElement>('a[data-go]').forEach((a) =>
			a.addEventListener('click', (e) => { e.preventDefault(); goTo(a.dataset.go!, a.dataset.i != null ? Number(a.dataset.i) : undefined); }),
		);
		let raf = 0;
		const tick = () => {
			let cur = 0;
			items.forEach((it, k) => { if (natTop(secOf(it.dataset.sec!)) <= innerHeight * 0.35) cur = k; });
			items.forEach((it, k) => it.classList.toggle('on', k === cur));
			rail.forEach((r, k) => r.classList.toggle('on', k === cur));
			const sec = secOf(items[cur].dataset.sec!);
			if (sec.hasAttribute('data-journey')) {
				const pi = phase(sec);
				items[cur].querySelectorAll<HTMLElement>('.toc__sub a').forEach((a) => a.classList.toggle('on', pi >= Number(a.dataset.i) && pi <= Number(a.dataset.to)));
			}
		};
		addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(tick); }, { passive: true });
		addEventListener('resize', tick);
		tick();
	}
</script>
