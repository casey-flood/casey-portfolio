---
import Base from '../layouts/Base.astro';

const values = [
	{
		color: 'coral',
		title: 'Design in the real material',
		body: 'I prototype in the production codebase with Storybook, Cursor, and Claude, so what we test is what ships and the design system grows in code.',
	},
	{
		color: 'sun',
		title: 'Alignment is a deliverable',
		body: 'A great design nobody agrees on never ships. I align PM, clinical, engineering, and ops as carefully as I design the screen.',
	},
	{
		color: 'mint',
		title: 'Curiosity before opinions',
		body: 'I shadow people doing the work before I draw anything. In dental manufacturing, healthcare, and enterprise tools, the best ideas hide in the workarounds.',
	},
	{
		color: 'sky',
		title: 'Measure what matters',
		body: 'Every project starts with how we\'ll know it worked, and ends by checking.',
	},
];

const proof = [
	{ v: '~86%', l: 'of user research I led at Amwell, on work behind a J.D. Power #1 patient satisfaction rating' },
	{ v: '+18%', l: 'engagement from a redesigned onboarding flow' },
	{ v: '5 yrs', l: 'designing white-label virtual urgent care used by millions' },
	{ v: '30+', l: 'Jira tickets managed across parallel workstreams, while mentoring 2 designers' },
];

const path = [
	{
		when: 'Mar 2025 – Present',
		t: 'Senior Product Designer, Dandy',
		d: 'Operator-facing software for dental manufacturing. First dentist-facing ordering and chairside flows for posterior crowns and bridges, then sole product designer on the Design Editor, where lab designers prep scans, design restorations, and check quality across fixed, removable, and implant workflows. I design in code: Storybook prototypes built from real React components, tested with internal users, and shipped as production UI.',
	},
	{
		when: '2018 – Present',
		t: 'Product Design Leader, freelance and consulting',
		d: 'Independent product design and research alongside full-time roles.',
	},
	{
		when: 'Jan 2023 – Feb 2024',
		t: 'Senior Product Designer, Amwell',
		d: 'Promoted to own design direction for virtual urgent care across patients, providers, and admin on web and white-label mobile. Mentored 2 junior designers, built 5 analytics dashboards for admins and ops, streamlined patient intake, and redesigned the admin platform with a scalable multi-tier framework so enterprise clients could configure roles and workflows without one-off builds.',
	},
	{
		when: 'Apr 2021 – Jan 2023',
		t: 'Senior UX Designer, Amwell',
		d: 'Led UX strategy for patient experiences: accessibility, workflow clarity, and vendor-integrated journeys. Designed the AI-assisted "While You Wait" triage flow, improved mental health service selection, and set information architecture standards reused across client configurations.',
	},
	{
		when: 'Jan 2019 – Apr 2021',
		t: 'UX Designer, Amwell',
		d: 'Owned end-to-end UX and research for patient-facing urgent care on web and mobile: onboarding, enrollment, payment, and the waiting room.',
	},
	{
		when: 'May 2017 – May 2018',
		t: 'UX Designer, Paper Airplane',
		d: 'Early-stage dating app startup. Part of a seven-person team shaping the interface and marketing strategy.',
	},
];
---

<Base
	title="About"
	description="Casey Flood is a senior product designer with a design-engineering practice, working across healthcare and dental manufacturing."
>
	<section class="page-intro">
		<div class="shell">
			<p class="eyebrow eyebrow--lilac">About</p>
			<h1>Design that ships, because it's built in code.</h1>
		</div>
	</section>

	<section class="section" style="padding-top: 2rem">
		<div class="shell about-grid">
			<p class="statement" data-reveal>
				I'm a senior product designer with a <mark>design-engineering practice</mark>: I prototype in
				the production codebase so we iterate faster and hand off less guesswork.
			</p>
			<div data-reveal>
				<p style="font-size: 1.2rem; margin-bottom: 1rem">
					At Dandy I've worked both sides of the dental journey, from dentist-facing ordering to the
					lab designers' Design Editor. Before that, five years at Amwell designing virtual urgent
					care for health systems and consumer brands.
				</p>
				<p style="font-size: 1.2rem; color: var(--muted)">
					Design engineering · Production-code prototyping · AI · Healthcare to manufacturing
				</p>
			</div>
		</div>
	</section>

	<section class="section band" aria-labelledby="proof-heading">
		<div class="shell">
			<p class="eyebrow eyebrow--coral">Track record</p>
			<h2 id="proof-heading" class="h2">A few numbers.</h2>
			<ul class="metrics metrics--5" style="grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr))">
				{
					proof.map((p) => (
						<li data-reveal>
							<strong data-count>{p.v}</strong>
							<span>{p.l}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section" aria-labelledby="values-heading">
		<div class="shell">
			<p class="eyebrow eyebrow--sky">Values</p>
			<h2 id="values-heading" class="h2">How I work.</h2>
			<div class="cards3" style="margin-top: 2.5rem">
				{
					values.map((v) => (
						<div class={`tile tile--${v.color}`} data-reveal>
							<h3>{v.title}</h3>
							<p>{v.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="section band" aria-labelledby="path-heading">
		<div class="shell">
			<p class="eyebrow eyebrow--mint">Path</p>
			<h2 id="path-heading" class="h2">Where I've worked.</h2>
			<ol class="timeline">
				{
					path.map((p) => (
						<li data-reveal>
							<p class="card__kicker">{p.when}</p>
							<h3>{p.t}</h3>
							<p>{p.d}</p>
						</li>
					))
				}
			</ol>
			<p style="margin-top: 1rem; font-weight: 600">
				Education: University of Massachusetts Lowell, Information Technology, HCI Design &amp;
				Development · Massachusetts College of Art and Design, Graphic Design
			</p>
			<div class="actions">
				<a class="button" href="/work">See the work</a>
				<a class="button button--ghost" href="/#contact">Say hi</a>
			</div>
		</div>
	</section>
</Base>
