---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/projects';

const projects = (await getProjects()).filter(
	(p) => p.data.featured && p.data.status === 'published',
);

// Story teaser: newest first, each year jumps into that moment on /journey
const years = [
	{ y: '2025', l: 'Dandy', id: 'dandy' },
	{ y: '2023', l: 'Freelance', id: 'freelance' },
	{ y: '2019', l: 'Amwell', id: 'amwell' },
	{ y: '2018', l: 'Pratt', id: 'pratt' },
	{ y: '2017', l: 'Paper Airplane', id: 'paper' },
	{ y: '2016', l: 'JMU', id: 'jmu' },
	{ y: '1990s', l: 'Origins', id: 'start' },
];
---

<Base
	title="Casey Flood"
	description="Casey Flood is a product leader and design engineer who prototypes in production code."
>
	<section class="hero">
		<div class="shell hero__grid">
			<div>
				<p class="eyebrow">Product leader · Design engineer</p>
				<h1>I design in code, so great ideas <em>actually ship</em>.</h1>
				<p class="hero__lede">
					I'm Casey Flood. I lead product design across healthcare and dental manufacturing, taking
					ideas from research to production UI with Storybook, Cursor, and Claude.
				</p>
				<div class="actions">
					<a class="button button--lg" href="/work">See my work →</a>
					<a class="button button--ghost button--lg" href="/journey">My story</a>
				</div>
			</div>
			<div class="hero__stage">
				<span class="pointer" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="26" height="26"><path d="M4 2.5l15 8.4-6.6 1.6-2.9 6.5z" fill="currentColor" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path></svg>
					<b>Casey</b>
				</span>
				<figure class="portrait">
					<span class="portrait__tape" aria-hidden="true"></span>
					<img src="/casey.jpg" alt="Portrait of Casey Flood" width="600" height="800" loading="eager" />
				</figure>
				<div class="term" aria-hidden="true">
					<div class="term__bar"><i></i><i></i><i></i><span>design-workflow</span></div>
					<div class="term__body">
						<span class="term__line"><span class="p">$</span> storybook dev</span>
						<span class="term__line"><span class="ok">✓</span> prototype built from real components</span>
						<span class="term__line"><span class="p">$</span> cursor . <span class="c"># iterate with AI</span></span>
						<span class="term__line"><span class="ok">✓</span> validated with real users</span>
						<span class="term__line"><span class="p">$</span> ship <span class="c"># production UI</span></span>
						<span class="term__line"><span class="ok">✓</span> design system lives in code<span class="cursor"></span></span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="work-heading" style="padding-top: 1rem">
		<div class="shell">
			<div class="section__head">
				<h2 id="work-heading">Selected work</h2>
				<a class="section__link" href="/work">All work →</a>
			</div>
			<div class="grid">
				{
					projects.map((p) => (
						<ProjectCard
							title={p.data.title}
							summary={p.data.summary}
							kicker={p.data.industry}
							tags={p.data.tags}
							href={`/work/${p.id}`}
							metric={p.data.metrics[0]}
							accent={p.data.accent}
						/>
					))
				}
			</div>
		</div>
	</section>

	<section class="section band" aria-labelledby="story-heading">
		<div class="shell">
			<div class="section__head">
				<h2 id="story-heading">Rewind my story</h2>
				<a class="section__link" href="/journey">Take the scroll →</a>
			</div>
			<ol class="rewind" aria-label="Jump into my story">
				{
					years.map((e) => (
						<li>
							<a href={`/journey#${e.id}`}>
								<i aria-hidden="true"></i>
								<b>{e.y}</b>
								<span>{e.l}</span>
							</a>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="section" id="contact" aria-label="Contact">
		<div class="shell">
			<p class="closing">
				<a href="/resume">Resume</a>
				<span aria-hidden="true">·</span>
				<a href="mailto:caseylflood@gmail.com">caseylflood@gmail.com</a>
			</p>
		</div>
	</section>
</Base>
