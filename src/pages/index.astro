---
import Base from '../layouts/Base.astro';

const values = [
	{
		color: 'coral',
		title: 'Design in the real material',
		body: 'Storybook prototypes built from the same React components we ship, so a prototype is a first draft of production, not a picture of it.',
	},
	{
		color: 'sun',
		title: 'Alignment is a deliverable',
		body: 'A great design nobody agrees on never ships. I align PM, clinical, engineering, and ops as carefully as I design the screen.',
	},
	{
		color: 'mint',
		title: 'Curiosity before opinions',
		body: 'I shadow people doing the work before I draw anything. The best ideas hide in the workarounds.',
	},
	{
		color: 'sky',
		title: 'Measure what matters',
		body: "Every project starts with how we'll know it worked, and ends by checking.",
	},
];

const path = [
	{
		when: 'Mar 2025 – Present',
		t: 'Senior Product Designer, Dandy',
		d: 'First the dentist-facing ordering and chairside flows, then sole product designer on the Design Editor, where lab designers prep scans and design restorations. I prototype in Storybook with real React components and built the Design Editor design system from scratch.',
	},
	{
		when: 'Jan 2019 – Feb 2024',
		t: 'UX Designer to Senior Product Designer, Amwell',
		d: 'Five years on white-label virtual urgent care across patients, providers, and admin. I led patient UX strategy, redesigned the admin platform with a multi-tier framework, and mentored two junior designers.',
	},
	{
		when: 'May 2017 – May 2018',
		t: 'UX Designer, Paper Airplane',
		d: 'Early-stage dating app startup. Part of a seven-person team shaping the interface and marketing strategy.',
	},
	{
		when: '2018 – Present',
		t: 'Product design, freelance and consulting',
		d: 'Independent product design and research alongside full-time roles.',
	},
];
---

<Base
	title="Casey Flood"
	description="Casey Flood is a product leader and design engineer who prototypes in production code."
>
	<section class="hero">
		<div class="shell hero__grid">
			<div>
				<p class="eyebrow">Product leader · Design engineer</p>
				<h1>I design in code, so great ideas <em>actually ship</em>.</h1>
				<p class="hero__lede">
					I'm Casey Flood. I lead product design across healthcare and dental manufacturing, and I
					prototype in production codebases with Storybook, Cursor, and Claude.
				</p>
				<div class="actions">
					<a class="button" href="/work">See the work</a>
					<a class="button button--ghost" href="/journey">My story</a>
				</div>
			</div>
			<div class="hero__stage">
				<span class="pointer" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="26" height="26"><path d="M4 2.5l15 8.4-6.6 1.6-2.9 6.5z" fill="currentColor" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path></svg>
					<b>Casey</b>
				</span>
				<figure class="portrait">
					<span class="portrait__tape" aria-hidden="true"></span>
					<img src="/casey.jpg" alt="Portrait of Casey Flood" width="600" height="800" loading="eager" />
				</figure>
				<div class="term" aria-hidden="true">
					<div class="term__bar"><i></i><i></i><i></i><span>design-workflow</span></div>
					<div class="term__body">
						<span class="term__line"><span class="p">$</span> storybook dev</span>
						<span class="term__line"><span class="ok">✓</span> prototype built from real components</span>
						<span class="term__line"><span class="p">$</span> cursor . <span class="c"># iterate with AI</span></span>
						<span class="term__line"><span class="ok">✓</span> validated with real users</span>
						<span class="term__line"><span class="p">$</span> ship <span class="c"># production UI</span></span>
						<span class="term__line"><span class="ok">✓</span> design system lives in code<span class="cursor"></span></span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section" style="padding-top: 1rem" aria-label="Intro">
		<div class="shell about-grid">
			<p class="statement" data-reveal>
				A senior product designer with a <mark>design-engineering practice</mark>: I prototype in the
				production codebase so we iterate faster and hand off less guesswork.
			</p>
			<div data-reveal>
				<p style="font-size: 1.2rem; margin-bottom: 1.25rem">
					At Dandy I've worked both sides of the dental journey, from dentist-facing ordering to the
					lab designers' Design Editor. Before that, five years at Amwell designing virtual urgent care
					for health systems and consumer brands.
				</p>
				<div class="actions">
					<a class="button button--lg" href="/work">See my work →</a>
					<a class="button button--ghost" href="/journey">My story</a>
				</div>
			</div>
		</div>
	</section>

	<section class="section band" id="how" aria-labelledby="how-heading">
		<div class="shell">
			<p class="eyebrow eyebrow--sky">Values</p>
			<h2 id="how-heading" class="h2">How I work.</h2>
			<div class="cards3 cards3--4" style="margin-top: 2.5rem">
				{
					values.map((v) => (
						<div class={`tile tile--${v.color}`} data-reveal>
							<h3>{v.title}</h3>
							<p>{v.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="path-heading">
		<div class="shell">
			<p class="eyebrow eyebrow--mint">Path</p>
			<h2 id="path-heading" class="h2">Where I've worked.</h2>
			<ol class="timeline">
				{
					path.map((p) => (
						<li data-reveal>
							<p class="card__kicker">{p.when}</p>
							<h3>{p.t}</h3>
							<p>{p.d}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="section" id="contact" aria-labelledby="contact-heading">
		<div class="shell">
			<div class="cta" data-reveal>
				<h2 id="contact-heading">Let's build something hard.</h2>
				<div class="actions">
					<a class="button" href="mailto:caseylflood@gmail.com">caseylflood@gmail.com</a>
					<a class="button button--ghost" href="/work">See my work</a>
				</div>
			</div>
		</div>
	</section>
</Base>
