---
import Base from '../layouts/Base.astro';
import { testimonials } from '../data/testimonials';

const featured = [
	{ n: '01', k: 'Impact', co: 'Dandy', name: 'Dandy Design Editor', line: 'The in-house tool where dental designers design every crown. As its sole product designer, I led field research, the redesign, and a design system built in code.', stats: [{ v: '−11.5%', l: 'hands-on designer time per order' }, { v: '−20%', l: 'days from order to shipped' }, { v: '+18 pts', l: 'crown orders in our editor' }], img: '/scan-to-smile/04-design.webp', pos: '50% 40%', alt: 'A dental designer and a teammate working on a 3D restoration', href: '/work/dandy-design-editor', cta: 'Read the Design Editor case study' },
	{ n: '02', k: 'Craft', co: 'Amwell', name: 'Amwell admin portal', line: 'A fragmented portal rebuilt around each role, from sketches to a tested system. Designed by hand, before AI design tools.', stats: [{ v: '45% → 82%', l: 'admin task completion' }], img: '/amwell/cs/hero.webp', pos: '0% 0%', alt: 'The redesigned Amwell admin dashboard', href: '/work/amwell-admin-portal', cta: 'Read the admin portal case study' },
];

const more = [
	{ name: 'Design Editor design system', line: 'Built in code from production components', img: '/work/behind/ds.jpg', href: '/work/dandy-design-system' },
	{ name: 'Clickable prototypes', line: 'Real flows, real components, early feedback', img: '/work/behind/proto.jpg', href: '/work/dandy-prototype' },
	{ name: 'MyTrips', line: 'My first app, from my Pratt capstone', img: '/mytrips/hero-phones.webp', href: '/work/mytrips' },
	{ name: 'Paper Airplane', line: 'First design job, early-stage startup', img: '/paper-airplane/story-trio.webp', href: '/work/paper-airplane' },
];

const beyond = [
	{ k: 'Systems', t: 'Built the Design Editor’s design system in Storybook, from production components.', href: '/work/dandy-design-system' },
	{ k: 'Field research', t: 'Sat with dental designers in Cairo and ran roundtables with their leads.', href: '/work/dandy-design-editor' },
	{ k: 'Sharing', t: 'Presented how I prototype in code with AI to Dandy’s team in New York.', href: '/journey#dandy' },
	{ k: 'Mentoring', t: 'Mentored two designers and led critiques at Amwell. Spoke on a General Assembly panel.', href: '/journey#amwell' },
];

// My story teaser: one highlight per chapter, newest first. Ids match /journey chapters.
const years = [
	{ y: '2025', l: 'Dandy', id: 'dandy', img: '/story/nyc-2026-presenting.webp', alt: 'Casey presenting the Design Editor work in New York', h: 'Sole product designer on the Design Editor.' },
	{ y: '2019', l: 'Amwell', id: 'amwell', img: '/story/ga-panel.webp', alt: 'Casey speaking on a General Assembly panel', h: 'Five years and two promotions in telehealth.' },
	{ y: '2018', l: 'Pratt', id: 'pratt', img: '/mytrips/empathy-wall.webp', alt: 'Building an empathy map at Pratt', h: 'Trained in UX on purpose, and built my first app.' },
	{ y: '2017', l: 'Paper Airplane', id: 'paper', img: '/paper-airplane/story-trio.webp', alt: 'Paper Airplane app screens', h: 'My first design job confirmed it: UX was the work.' },
	{ y: '2015', l: 'JMU', id: 'jmu', img: '/story/jmu-essay-2017.webp', alt: 'An excerpt of my 2017 design school essay', h: 'Design and code, from day one.' },
	{ y: 'Early', l: 'Origins', id: 'origins', img: '/story/young-laughing.webp', alt: 'Casey as a toddler, laughing', h: 'I’ve always seen the world a little differently.' },
];

const quotes = testimonials;
---

<Base
	title="Casey Flood"
	description="Casey Flood is a product designer who thinks in systems and prototypes in code, leading design for complex healthcare and dental products."
>
	<section class="i2">
		<div class="shell"><div class="i2__in">
			<p class="i2__who"><img class="i2__me" src="/casey.jpg" alt="" width="600" height="800" /><span><b>Casey Flood</b> Senior Product Designer at <a class="lk" href="/work/dandy-design-editor" data-peek="/work/dde/hero.mp4" data-poster="/work/dde/hero.jpg" data-cap="The Design Editor"><img class="lk__logo" src="/brand/dandy-wordmark.svg" alt="Dandy" /></a></span></p>
			<h1 class="i2__h1">I design in code, so great ideas <em>actually ship</em>.</h1>
			<p class="i2__lede">
				I design complex healthcare tools end to end: I
				<a class="lk" href="/work/dandy-design-editor" data-peek="/work/dde/cairo-team.webp" data-cap="Field research in Cairo">research in the field</a>,
				<a class="lk" href="/work/dandy-design-system" data-peek="/journey/storybook-ds-preview.mp4" data-poster="/journey/storybook-ds-cover.jpg" data-cap="The design system, in Storybook">prototype in code</a>,
				and ship with engineering. Five years at
				<a class="lk" href="/work/amwell-admin-portal" data-peek="/amwell/cs/hero.webp" data-cap="Amwell admin portal"><img class="lk__logo lk__logo--amwell" src="/brand/amwell-white.svg" alt="Amwell" /></a>
				before Dandy.
			</p>
			<nav class="guide" aria-label="Start here">
				<span class="guide__k">Start here</span>
				<ol>
					<li><a href="#impact"><i>01</i>Impact</a></li>
					<li><a href="#craft"><i>02</i>Craft</a></li>
					<li><a href="#how"><i>03</i>How I work</a></li>
					<li><a href="#story"><i>04</i>How I got here</a></li>
				</ol>
			</nav>
			<p class="i2__keys" aria-label="Keyboard shortcuts">
				<span><kbd>C</kbd> copy email</span>
				<span><kbd>W</kbd> work</span>
				<span><kbd>S</kbd> story</span>
			</p>
		</div></div>
		<div class="peek" aria-hidden="true"><div class="peek__media"></div><span class="peek__cap"></span></div>
		<p class="toast" role="status" aria-live="polite"></p>
	</section>

	{featured.map((w) => (
		<section class="gs" id={w.k.toLowerCase()} aria-labelledby={`h-${w.n}`}>
			<div class="shell">
				<p class="step__k"><i>{w.n}</i>{w.k}</p>
				<a class="feat" href={w.href}>
					<span class="feat__img"><img src={w.img} alt={w.alt} style={`object-position:${w.pos}`} loading="lazy" decoding="async" /></span>
					<span class="feat__txt">
						<img class={`hp__logo hp__logo--${w.co.toLowerCase()}`} src={w.co === 'Dandy' ? '/brand/dandy-wordmark.svg' : '/brand/amwell-white.svg'} alt={w.co} height="18" />
						<span class="feat__name" id={`h-${w.n}`}>{w.name}</span>
						<span class="feat__line">{w.line}</span>
						<span class="feat__stats">{w.stats.map((x) => (<span><b>{x.v}</b>{x.l}</span>))}</span>
						<span class="feat__cta">{w.cta} →</span>
					</span>
				</a>
			</div>
		</section>
	))}

	<section class="gs gs--tight" id="work-heading" aria-label="More work">
		<div class="shell">
			<p class="step__k step__k--plain">More work <a class="hp__all" href="/work">All work <span aria-hidden="true">→</span></a></p>
			<ul class="hp__more" aria-label="More work">
				{more.map((m) => (
					<li>
						<a href={m.href}>
							<img src={m.img} alt="" loading="lazy" decoding="async" />
							<span><b>{m.name}</b><small>{m.line}</small></span>
							<i aria-hidden="true">→</i>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="gs" id="how" aria-labelledby="beyond-heading">
		<div class="shell">
			<p class="step__k"><i>03</i>How I work</p>
			<h2 id="beyond-heading" class="step__h">Beyond my own screens.</h2>
			<ul class="hp__beyond">
				{beyond.map((x) => (<li><a href={x.href}><small>{x.k}</small><span>{x.t}</span></a></li>))}
			</ul>
		</div>
	</section>

	<section class="gs hp__about" data-focus id="story" aria-labelledby="about-heading">
		<div class="shell">
			<div class="hp__aboutgrid" data-story>
				<div class="hp__abouttext">
					<p class="step__k"><i>04</i>How I got here</p>
					<h2 id="about-heading" class="step__h">From research to design engineering.</h2>
					<ol class="rewind rewind--anim" aria-label="My story, newest first">
						{years.map((e, i) => (
							<li>
								<button type="button" class="rw__b" data-i={i} aria-pressed={i === 0 ? 'true' : 'false'}><i aria-hidden="true"></i><b>{e.y}</b><span>{e.l}</span></button>
							</li>
						))}
					</ol>
					<p class="hp__hl" aria-live="polite" data-hl>{years[0].h}</p>
					<a class="hp__all" href={`/journey#${years[0].id}`} data-more>Read this part of my story <span aria-hidden="true">→</span></a>
				</div>
				<div class="hp__photo" data-photos>
					{years.map((e, i) => (
						<figure class:list={['hp__pic', { on: i === 0 }]} data-i={i}>
							<img src={e.img} alt={e.alt} loading="lazy" decoding="async" />
						</figure>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="hp__sec hp__praise" data-focus aria-labelledby="praise-heading">
		<div class="shell">
			<header class="hp__head"><h2 id="praise-heading">What my coworkers have said</h2></header>
		</div>
		<ul class="hq" tabindex="0" aria-label="Coworker quotes, scroll sideways">
			{quotes.map((q) => (<li><blockquote>“{q.quote}”</blockquote><p><b>{q.name}</b> · {q.role}</p></li>))}
		</ul>
	</section>

	<section class="hp__contact" data-focus id="contact" aria-labelledby="contact-heading">
		<div class="shell hp__contactrow">
			<div>
				<h2 id="contact-heading">Have a complex problem worth solving?</h2>
				<p>I love connecting with people who care about thoughtful products, ambitious ideas, and making things better.</p>
			</div>
			<div class="actions">
				<a class="button" href="mailto:caseylflood@gmail.com">Get in touch</a>
				<a class="button button--ghost" href="/resume">Resume</a>
			</div>
		</div>
	</section>
</Base>


<script>
	// Intro: hover previews, keyboard shortcuts, and a soft click sound.
	const root = document.querySelector<HTMLElement>('.i2');
	if (root) {
		const peek = root.querySelector<HTMLElement>('.peek')!;
		const media = peek.querySelector<HTMLElement>('.peek__media')!;
		const cap = peek.querySelector<HTMLElement>('.peek__cap')!;
		const toast = root.querySelector<HTMLElement>('.toast')!;
		const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
		const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let ctx: AudioContext | null = null;
		const tick = (f = 660) => {
			if (calm) return;
			try {
				ctx ??= new AudioContext();
				const o = ctx.createOscillator(), g = ctx.createGain();
				o.type = 'sine'; o.frequency.value = f;
				g.gain.setValueAtTime(0.0001, ctx.currentTime);
				g.gain.exponentialRampToValueAtTime(0.04, ctx.currentTime + 0.01);
				g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.12);
				o.connect(g).connect(ctx.destination); o.start(); o.stop(ctx.currentTime + 0.13);
			} catch {}
		};
		// Preload the preview images so they appear instantly.
		root.querySelectorAll<HTMLElement>('[data-peek]').forEach((c) => { if (!c.dataset.peek!.endsWith('.mp4')) new Image().src = c.dataset.peek!; });
		const show = (c: HTMLElement) => {
			const src = c.dataset.peek!;
			media.innerHTML = src.endsWith('.mp4')
				? `<video src="${src}" poster="${c.dataset.poster || ''}" muted autoplay loop playsinline></video>`
				: `<img src="${src}" alt="">`;
			cap.textContent = c.dataset.cap || '';
			const r = c.getBoundingClientRect(), pr = root.getBoundingClientRect();
			const w = peek.offsetWidth || 288;
			const x = Math.min(Math.max(r.left + r.width / 2 - pr.left - w / 2, 8), pr.width - w - 8);
			peek.style.left = x + 'px';
			peek.style.top = r.top - pr.top + 'px';
			peek.classList.add('on');
		};
		const hide = () => { peek.classList.remove('on'); };
		addEventListener('scroll', hide, { passive: true });
		root.addEventListener('pointerleave', hide);
		if (canHover) {
			root.querySelectorAll<HTMLElement>('[data-peek]').forEach((c) => {
				c.addEventListener('mouseenter', () => { show(c); tick(720); });
				c.addEventListener('mouseleave', hide);
				c.addEventListener('focus', () => show(c));
				c.addEventListener('blur', hide);
			});
		}
		const say = (t: string) => {
			toast.textContent = t; toast.classList.add('on');
			clearTimeout((toast as any)._t); (toast as any)._t = setTimeout(() => toast.classList.remove('on'), 1600);
		};
		const press = (k: string) => {
			const el = root.querySelector<HTMLElement>(`kbd[data-k="${k}"]`);
			el?.classList.add('down'); setTimeout(() => el?.classList.remove('down'), 160);
		};
		root.querySelectorAll('kbd').forEach((k) => (k.dataset.k = k.textContent!.toLowerCase()));
		addEventListener('keydown', (e) => {
			if (e.metaKey || e.ctrlKey || e.altKey || (e.target as HTMLElement).closest('input, textarea, [contenteditable]')) return;
			const k = e.key.toLowerCase();
			if (k === 'c') { navigator.clipboard?.writeText('caseylflood@gmail.com'); press(k); tick(880); say('Email copied'); }
			if (k === 'w') { press(k); tick(560); document.querySelector('#impact')?.scrollIntoView({ behavior: calm ? 'auto' : 'smooth', block: 'start' }); }
			if (k === 's') { press(k); tick(560); location.href = '/journey'; }
		});
	}
</script>

<script is:inline define:vars={{ years }}>
	document.querySelectorAll('[data-story]').forEach((root) => {
		const btns = Array.from(root.querySelectorAll('.rw__b'));
		const hl = root.querySelector('[data-hl]');
		const more = root.querySelector('[data-more]');
		const pick = (i) => {
			btns.forEach((b, k) => b.setAttribute('aria-pressed', String(k === i)));
			hl.classList.remove('hp__hl--in'); void hl.offsetWidth;
			hl.textContent = years[i].h; hl.classList.add('hp__hl--in');
			more.setAttribute('href', '/journey#' + years[i].id);
			root.querySelectorAll('.hp__pic').forEach((f, k) => f.classList.toggle('on', k === i));
		};
		btns.forEach((b, i) => b.addEventListener('click', () => pick(i)));
	});
</script>

<script>
	// one thing at a time: the section nearest the middle of the screen is in focus, the rest recede
	const secs = Array.from(document.querySelectorAll<HTMLElement>('[data-focus]'));
	if (secs.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		document.documentElement.classList.add('hp-focus');
		let cur: HTMLElement | null = null;
		const tick = () => {
			const mid = innerHeight * 0.5;
			let best = secs[0], d = Infinity;
			secs.forEach((el) => {
				const r = el.getBoundingClientRect();
				const dist = r.top < mid && r.bottom > mid ? 0 : Math.min(Math.abs(r.top - mid), Math.abs(r.bottom - mid));
				if (dist < d) { d = dist; best = el; }
			});
			if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) best = secs[secs.length - 1];
			if (best === cur) return;
			cur = best;
			secs.forEach((el) => el.classList.toggle('is-focus', el === best));
		};
		addEventListener('scroll', () => requestAnimationFrame(tick), { passive: true });
		addEventListener('resize', tick);
		tick();
	}
</script>

<style>
	.i2 { position: relative; padding: clamp(2.5rem, 7vw, 5.5rem) 0 clamp(2.5rem, 6vw, 4.5rem); }
	.i2__in { max-width: 48rem; }
	.i2__who { display: flex; align-items: center; gap: 0.75rem; margin: 0 0 1.5rem; font-size: 0.95rem; color: var(--muted); }
	.i2__who b { color: var(--ink); font-weight: 600; margin-right: 0.35rem; }
	.i2__me { width: 2.5rem; height: 2.5rem; border-radius: 50%; object-fit: cover; object-position: center 22%; filter: grayscale(1); flex: none; }
	.i2__h1 { font-size: clamp(2.3rem, 5.2vw, 3.9rem); line-height: 1.02; letter-spacing: -0.035em; margin: 0; max-width: 15ch; }
	.i2__h1 em { font-style: normal; color: var(--accent); }
	.i2__lede { font-size: clamp(1.05rem, 1.6vw, 1.2rem); line-height: 1.6; color: var(--muted); margin: 1.25rem 0 0; max-width: 38rem; }
	.guide { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1rem; margin-top: 2.25rem; }
	.guide__k { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
	.guide ol { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; }
	.guide a { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.45rem 0.8rem; border: 1px solid var(--line); border-radius: 99px; color: var(--ink); text-decoration: none; font-size: 0.88rem; transition: border-color 0.2s, background 0.2s; }
	.guide a:hover { border-color: var(--accent); }
	.guide i { font-style: normal; font-family: var(--mono); font-size: 0.7rem; color: var(--accent); }
	.guide li:first-child a { background: var(--ink); color: var(--bg); border-color: var(--ink); }
	.guide li:first-child i { color: inherit; opacity: 0.7; }
	.lk { color: var(--ink); text-decoration: none; background-image: linear-gradient(90deg, currentColor 40%, transparent 0); background-size: 5px 1.5px; background-repeat: repeat-x; background-position: 0 100%; padding-bottom: 2px; white-space: nowrap; transition: color 0.2s; }
	.lk:hover, .lk:focus-visible { color: var(--accent); }
	.lk__logo { display: inline-block; height: 1.05em; width: auto; vertical-align: -0.12em; filter: brightness(0); }
	.lk__logo--amwell { height: 0.95em; vertical-align: -0.08em; }
	:global([data-theme='dark']) .lk__logo { filter: brightness(0) invert(1); }
	.i2 .i2__keys { display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; margin: 1.25rem 0 0; font-size: 0.8rem; color: var(--muted); opacity: 0.7; transition: opacity 0.2s; }
	.i2 .i2__keys:hover { opacity: 1; }
	kbd { display: inline-grid; place-items: center; min-width: 1.15rem; height: 1.15rem; margin-right: 0.35rem; padding: 0 0.25rem; border-radius: 0.3rem; border: 1px solid var(--line-strong); font-family: var(--mono); font-size: 0.66rem; color: var(--ink); transition: background 0.12s, color 0.12s; }
	kbd:global(.down) { background: var(--ink); color: var(--bg); }
	@media (hover: none), (max-width: 760px) {
		.i2 .i2__keys { display: none; }
	}
	/* Guided steps */
	.gs { padding: clamp(2.5rem, 6vw, 4.5rem) 0; border-top: 1px solid var(--line); scroll-margin-top: 4rem; }
	.gs--tight { padding-top: 1.5rem; border-top: 0; }
	.step__k { display: flex; align-items: center; gap: 0.6rem; margin: 0 0 1.25rem; font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
	.step__k i { font-style: normal; color: var(--accent); }
	.step__k--plain { justify-content: space-between; }
	.step__k--plain .hp__all { font-family: var(--sans); text-transform: none; letter-spacing: 0; font-size: 0.88rem; }
	.step__h { font-size: clamp(1.5rem, 2.6vw, 2rem); letter-spacing: -0.03em; line-height: 1.1; margin: 0 0 1.5rem; }
	.feat { display: grid; grid-template-columns: 1.35fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; color: inherit; text-decoration: none; }
	.feat__img { display: block; aspect-ratio: 16 / 11; border-radius: 1.1rem; overflow: hidden; background: var(--line); }
	.feat__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); }
	.feat:hover .feat__img img { transform: scale(1.03); }
	.feat__txt { display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem; }
	.feat__stats { align-self: stretch; }
	.feat__name { font-family: var(--display); font-size: clamp(1.6rem, 2.8vw, 2.2rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; }
	.feat__line { color: var(--muted); font-size: 1rem; line-height: 1.55; }
	.feat__stats { display: grid; gap: 0.6rem; margin: 0.4rem 0; padding: 0.9rem 0; border-block: 1px solid var(--line); }
	.feat__stats span { display: flex; align-items: baseline; gap: 0.6rem; font-size: 0.88rem; color: var(--muted); }
	.feat__stats b { font-family: var(--display); font-size: 1.35rem; color: var(--ink); min-width: 5.5rem; letter-spacing: -0.02em; }
	.feat__cta { font-weight: 600; font-size: 0.95rem; }
	.feat:hover .feat__cta { color: var(--accent); }
	@media (max-width: 800px) { .feat { grid-template-columns: 1fr; } }
	.peek { position: absolute; z-index: 20; width: 18rem; pointer-events: none; transform: translateY(calc(-100% - 0.6rem)) scale(0.94); transform-origin: 50% 100%; opacity: 0; filter: blur(6px); transition: opacity 0.22s ease, transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.2), filter 0.22s; }
	.peek:global(.on) { opacity: 1; transform: translateY(calc(-100% - 0.6rem)); filter: none; }
	.peek__media { aspect-ratio: 16 / 10; border-radius: 0.9rem; overflow: hidden; background: var(--paper); border: 1px solid var(--line-strong); box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.5); }
	.peek__media :global(img), .peek__media :global(video) { width: 100%; height: 100%; object-fit: cover; display: block; }
	.peek__cap { display: block; margin-top: 0.4rem; font-size: 0.75rem; color: var(--muted); text-align: center; }
	.toast { position: fixed; left: 50%; bottom: 1.5rem; translate: -50% 0; z-index: 50; margin: 0 !important; padding: 0.55rem 0.9rem !important; border-radius: 99px; background: var(--ink); color: var(--bg) !important; font-size: 0.88rem !important; opacity: 0; transform: translateY(8px); transition: opacity 0.2s, transform 0.2s; pointer-events: none; }
	.toast:global(.on) { opacity: 1; transform: none; }
	@media (prefers-reduced-motion: reduce) { .peek, .toast, kbd { transition: none; } }
</style>
