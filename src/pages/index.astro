---
import Base from '../layouts/Base.astro';

// One idea per screen, in order. Each chapter: a label, one big thing, one sentence, one image, one link.
const chapters = [
	{
		id: 'impact',
		n: '01',
		k: 'Impact',
		big: '−11.5%',
		line: 'hands-on designer time per order on Dandy’s Design Editor, while crown volume grew 57%. As its sole product designer, I led field research, the redesign, and a design system in code.',
		img: '/scan-to-smile/04-design.webp',
		pos: '50% 40%',
		alt: 'A dental designer and a teammate working on a 3D crown in the Design Editor',
		href: '/work/dandy-design-editor',
		cta: 'Read the Design Editor story',
	},
	{
		id: 'craft',
		n: '02',
		k: 'Craft',
		big: '45% → 82%',
		line: 'admin task completion after I rebuilt Amwell’s fragmented admin portal around each role, from paper sketches to a tested system.',
		img: '/amwell/cs/hero.webp',
		pos: '0% 0%',
		alt: 'The redesigned Amwell admin dashboard',
		href: '/work/amwell-admin-portal',
		cta: 'Read the admin portal story',
	},
];
// 03 All other projects: grouped, one row opens at a time.
const N = 'https://caseyflood.notion.site/';
const groups = [
	{ id: 'dandy', label: 'Dandy', items: [
		{ t: 'Design Editor design system', tag: 'Design engineering', d: 'A design system built in code from production components, in Storybook.', c: 'Each design iteration went from 30–45 to 5–10 minutes.', href: '/work/dandy-design-system' },
		{ t: 'Clickable prototypes', tag: 'Prototyping', d: 'Real flows built from production components, so people react to the real thing early.', c: 'Feedback before engineering time is spent.', href: '/work/dandy-prototype' },
		{ t: 'Product design hub', tag: 'Team systems', d: 'One home for how the design team works: files, process and standards.', href: '/work/dandy-product-design-hub' },
	] },
	{ id: 'research', label: 'Amwell research', all: '/work/amwell-research', items: [
		{ t: 'The experience of choosing care', tag: 'Needs assessment', d: 'How patients browse and pick a service in telehealth.', c: 'Led to a re-architected service selection: +12% patient satisfaction, −18% cancellations.', href: '/work/amwell-research/choosing-care' },
		{ t: 'Dependent care', tag: 'Interviews', d: 'Why visits for children were getting cancelled.', c: 'Pediatric onboarding content, provider pre-visit training, no pre-selected answers.', href: '/work/amwell-research/dependent-care' },
		{ t: 'How patients search for care', tag: 'Needs assessment', d: '90% of patients look for coverage first.', c: 'Coverage shown during onboarding, simpler insurance checks.', href: '/work/amwell-research/patient-search' },
		{ t: 'In person vs. Amwell', tag: 'Interviews', d: 'An in-person doctor visit, mapped against our service selection.', c: 'Dependent selection moved earlier, a shorter scheduled-visit flow.', href: '/work/amwell-research/in-person-vs-amwell' },
		{ t: 'AI While You Wait chatbot', tag: 'Usability study', d: 'Three groups of patients testing a chatbot in the virtual waiting room.', c: 'Better question logic, free-text answers, clearer provider messages.', href: '/work/amwell-research/ai-chatbot' },
		{ t: 'AI While You Wait: COVID-19 script', tag: 'Usability study', d: 'How the COVID-19 chatbot script made patients feel.', c: 'More waiting room content, faster responses, editable answers.', href: '/work/amwell-research/ai-covid' },
		{ t: 'Symptom checker', tag: 'Usability study', d: 'A chatbot-style symptom checker inside the intake flow.', c: 'Replaced with a symptom-focused, multi-page intake.', href: '/work/amwell-research/symptom-checker' },
		{ t: 'Top usability issues', tag: 'Usability study', d: 'The top three issues in the white-label patient app.', c: 'A new care-selection IA and no defaulted answers.', href: '/work/amwell-research/top-usability-issues' },
		{ t: 'iOS onboarding', tag: 'Usability study', d: 'Pain points in sync and intake on iOS.', c: 'Sync removed, answers auto-saved.', href: '/work/amwell-research/ios-onboarding' },
		{ t: 'iOS enrollment', tag: 'Competitor analysis', d: 'What people expect when they sign up for a health app.', c: 'A stepper, reasons for each question, the confusing “service key” field removed.', href: '/work/amwell-research/ios-enrollment' },
		{ t: 'Gender and sex fields', tag: 'Usability study', d: 'Documenting gender and sex for non-binary patients.', c: 'Editable by patient and provider, with an explanation on each field.', href: '/work/amwell-research/gender-and-sex-fields' },
		{ t: 'Virtual primary care: location', tag: 'Usability study', d: 'Whether patients understood why we asked for their location.', c: 'More accurate geolocation and clearer copy.', href: '/work/amwell-research/vpc-location' },
		{ t: 'Password reset', tag: 'Competitor analysis', d: 'Friction in resetting a password on web and mobile.', c: 'Visible requirements, then a move to Auth0.', href: '/work/amwell-research/password-reset' },
		{ t: 'Phone number field', tag: 'Competitor analysis', d: 'Why people mistyped and abandoned one field.', c: 'Prefilled country code and auto-formatting.', href: '/work/amwell-research/phone-number-field' },
		{ t: 'Sound effects', tag: 'Usability study', d: 'Notification sounds that get noticed without startling anyone.', c: 'A new provider notification sound. (It’s why this site clicks softly.)', href: '/work/amwell-research/sound-effects' },
	] },
	{ id: 'lead', label: 'Leadership', items: [
		{ t: 'Admin portal', tag: 'Amwell', d: 'The craft case study: one role-based portal.', c: 'Task completion 45% → 82%.', href: '/work/amwell-admin-portal' },
		{ t: 'Presenting to the C-suite', tag: 'Amwell', d: 'Research readouts for executives.', href: N + 'Presenting-to-CEOs-1276f464642d81669afbc26a61b5a438' },
		{ t: 'Design-a-thon lead', tag: 'Amwell', d: 'Ran a design-a-thon on longitudinal, automated care.', href: N + 'Design-a-Thon-Leader-1276f464642d8199aa7adf483d30baa2' },
		{ t: 'Team lead and mentor', tag: 'Amwell', d: 'Mentored two designers, led sprints and critiques.', href: N + 'Team-Lead-Mentor-1276f464642d81fba475c9cd6f024c49' },
		{ t: 'Design system upkeep', tag: 'Amwell', d: 'Kept the Figma and Zeroheight design system current.', href: N + 'Design-System-Maintenance-1276f464642d812490addc3242a2695a' },
	] },
	{ id: 'earlier', label: 'Earlier', items: [
		{ t: 'MyTrips', tag: 'Pratt, 2018', d: 'My first app, built from scratch as my capstone, later redesigned.', c: '−94% time to share a trip, in testing.', href: '/work/mytrips' },
		{ t: 'Paper Airplane', tag: 'Startup, 2017', d: 'My first design job: a dating app for meeting in person.', c: 'From 41 survey responses to a tested 13-screen prototype.', href: '/work/paper-airplane' },
	] },
];

const stops = [
	{ y: 'Early', l: 'Origins', id: 'origins', img: '/story/young-laughing.webp', h: 'Redesigning my own class notes until they clicked.' },
	{ y: '2015', l: 'JMU', id: 'jmu', img: '/story/jmu-essay-2017.webp', h: 'Design and code, from day one.' },
	{ y: '2017', l: 'Paper Airplane', id: 'paper', img: '/paper-airplane/story-trio.webp', h: 'My first design job confirmed it: UX was the work.' },
	{ y: '2018', l: 'Pratt', id: 'pratt', img: '/mytrips/empathy-wall.webp', h: 'Trained on purpose, and built my first app.' },
	{ y: '2019', l: 'Amwell', id: 'amwell', img: '/story/ga-panel.webp', h: 'Research, then ownership, then leadership.' },
	{ y: '2025', l: 'Dandy', id: 'dandy', img: '/story/nyc-2026-presenting.webp', h: 'Designing in the real material: code.' },
];

const quotes = [
	{ q: 'Exceeding expectations for this stage in her tenure, with a strong trajectory toward broader leadership.', who: 'Mid-year review', where: 'Dandy, 2025' },
	{ q: 'I saw her create an entire design system using Cursor that she basically taught herself. She was an inspiration to the design team.', who: 'Liz', where: 'Senior Product Designer, Dandy' },
	{ q: 'She’s thinking ahead about scalable systems … a bias for action and strategic thinking.', who: 'Performance review', where: 'Dandy' },
	{ q: 'You’re doing great work … Thank you for making us better.', who: 'Tom', where: 'VP, Operations, Dandy' },
	{ q: 'The first person I turn to when I’m seeking input on my designs.', who: 'Kate Murdoch', where: 'Principal Product Designer, Amwell' },
	{ q: 'She understands the bones of good design.', who: 'Missy Roode', where: 'Amwell' },
	{ q: 'A fantastic mentor and leader.', who: 'Claudiane Philippe', where: 'Amwell' },
];
---

<Base
	title="Casey Flood"
	description="Casey Flood designs complex healthcare tools end to end: research in the field, prototypes in code, and shipping with engineering."
>
	<div class="hp">
		<!-- 0. Who I am -->
		<section class="ch ch--intro">
			<div class="shell ch__in">
				<p class="who rv"><img src="/casey.jpg" alt="" width="600" height="800" /><span><b>Casey Flood</b> · Senior Product Designer at Dandy</span></p>
				<h1 class="rv">I design in code, so great ideas <em>actually ship</em>.</h1>
				<p class="lede rv">I design for every side of complex healthcare systems.</p>
				<p class="lede lede--tight rv">
					At
					<a class="lk lk--logo" href="/work/dandy" data-peek="/work/vision-scan.mp4" data-cap="Dandy overview"><img class="lk__logo" src="/brand/dandy-wordmark.svg" alt="Dandy" /></a>,
					that’s the whole life of a crown: the dentists who order it, the dental designers who shape it in 3D, and the lab that makes it.
				</p>
				<p class="lede lede--tight rv">
					At
					<a class="lk lk--logo" href="/work/amwell" data-peek="/amwell/hero-platform.webp" data-cap="Amwell overview"><img class="lk__logo lk__logo--amwell" src="/brand/amwell-white.svg" alt="Amwell" /></a>,
					it was telehealth for patients, providers and admins. I led 86% of our research, work that fed a #1 J.D. Power ranking.
				</p>
				<a class="next rv" href="#impact"><span>Start with the impact</span><i aria-hidden="true">↓</i></a>
			</div>
		</section>

		<!-- 1 & 2. Impact, then craft -->
		{chapters.map((c, i) => (
			<section class="ch" id={c.id} aria-labelledby={`k-${c.id}`}>
				<div class="shell ch__in">
					<p class="label rv" id={`k-${c.id}`}><i>{c.n}</i> {c.k}</p>
					<p class="big rv">{c.big}</p>
					<p class="line rv">{c.line}</p>
					<a class="shot rv" href={c.href} tabindex="-1" aria-hidden="true">
						<img src={c.img} alt={c.alt} style={`object-position:${c.pos}`} loading="lazy" decoding="async" />
					</a>
					<p class="rv"><a class="go" href={c.href}>{c.cta} <span aria-hidden="true">→</span></a></p>
					<a class="next rv" href={i === 0 ? '#craft' : '#more'}><span>{i === 0 ? 'Next: the craft' : 'Next: everything else'}</span><i aria-hidden="true">↓</i></a>
				</div>
			</section>
		))}

		<!-- 3. Everything else -->
		<section class="ch" id="more" aria-labelledby="k-more">
			<div class="shell ch__in">
				<p class="label rv" id="k-more"><i>03</i> Everything else</p>
				<p class="big big--sm rv">All other projects.</p>
				<div class="pj rv" data-pj>
					<div class="pj__tabs" role="tablist" aria-label="Project groups">
						{groups.map((g, i) => (
							<button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-g={g.id}>{g.label} <small>{g.items.length}</small></button>
						))}
					</div>
					{groups.map((g, i) => (
						<ul class="pj__list" data-g={g.id} hidden={i !== 0}>
							{g.items.map((x) => (
								<li>
									<a href={x.href} target={x.href.startsWith('http') ? '_blank' : undefined} rel={x.href.startsWith('http') ? 'noopener' : undefined}>
										<span class="pj__row"><b>{x.t}</b><small>{x.tag}</small><i aria-hidden="true">{x.href.startsWith('http') ? '↗' : '→'}</i></span>
										<span class="pj__more"><span>{x.d}{x.c && <em> {x.c}</em>}</span></span>
									</a>
								</li>
							))}
							{g.all && <li class="pj__alli"><a href={g.all}><span class="pj__row"><b>See all {g.items.length} studies on one page</b><small></small><i aria-hidden="true">→</i></span></a></li>}
						</ul>
					))}
				</div>
				<a class="next rv" href="#how"><span>Next: how I work</span><i aria-hidden="true">↓</i></a>
			</div>
		</section>

		<!-- 4. How I work -->
		<section class="ch" id="how" aria-labelledby="k-how">
			<div class="shell ch__in">
				<p class="label rv" id="k-how"><i>04</i> How I work</p>
				<p class="trio rv">
					<a class="lk" href="/work/dandy-design-editor" data-peek="/work/dde/cairo-team.webp" data-cap="Field research with dental designers in Cairo">Research in the field.</a>
					<a class="lk" href="/work/dandy-design-system" data-peek="/journey/storybook-ds-preview.mp4" data-poster="/journey/storybook-ds-cover.jpg" data-cap="The design system, built in Storybook">Prototype in code.</a>
					<a class="lk" href="/work/dandy-prototype" data-peek="/work/dde/design-review.mp4" data-poster="/work/dde/design-review.jpg" data-cap="Shipping with engineering">Ship with engineering.</a>
				</p>
				<p class="line rv">And bring people along: I mentored designers at Amwell, spoke on a General Assembly panel, and taught Dandy’s team how I prototype with AI.</p>
				<a class="next rv" href="#story"><span>Next: how I got here</span><i aria-hidden="true">↓</i></a>
			</div>
		</section>

		<!-- 4. How I got here -->
		<section class="ch" id="story" aria-labelledby="k-story">
			<div class="shell ch__in">
				<p class="label rv" id="k-story"><i>05</i> How I got here</p>
				<p class="big big--sm rv">From user research to design engineering.</p>
				<div class="cl rv" data-tl data-stops={JSON.stringify(stops.map(({ h, id }) => ({ h, id })))}>
					<ol class="tl__rail" aria-label="Career path" style={`--n:${stops.length}`}>
						<span class="tl__fill" aria-hidden="true"></span>
						{stops.map((x, i) => (
							<li><button type="button" data-i={i} aria-pressed={i === stops.length - 1 ? 'true' : 'false'}><i aria-hidden="true"></i><b>{x.y}</b><span>{x.l}</span></button></li>
						))}
					</ol>
					<div class="tl__card">
						<div class="tl__pics">
							{stops.map((x, i) => (<img src={x.img} alt="" loading="lazy" decoding="async" class={i === stops.length - 1 ? 'on' : ''} data-i={i} />))}
						</div>
						<div class="tl__txt">
							<p class="tl__h" aria-live="polite">{stops[stops.length - 1].h}</p>
							<a class="go tl__go" href={`/journey#${stops[stops.length - 1].id}`}>Read this chapter <span aria-hidden="true">→</span></a>
						</div>
					</div>
				</div>
				<p class="rv"><a class="go" href="/journey">Read my whole story <span aria-hidden="true">→</span></a></p>
			</div>
		</section>

		<!-- 5. In their words, then say hi -->
		<section class="ch ch--end" id="contact" aria-label="In their words and contact">
			<div class="shell ch__in">
				<p class="label rv">In their words</p>
				<div class="qs rv" data-qs>
					{quotes.map((x, i) => (
						<figure class="qs__item" hidden={i !== 0}>
							<blockquote class="quote">“{x.q}”</blockquote>
							<figcaption class="cite"><b>{x.who}</b> · {x.where}</figcaption>
						</figure>
					))}
					<div class="qs__nav">
						<button type="button" class="qs__btn" data-dir="-1" aria-label="Previous quote">←</button>
						<span class="qs__dots">{quotes.map((_, i) => <i class={i === 0 ? 'on' : ''}></i>)}</span>
						<button type="button" class="qs__btn" data-dir="1" aria-label="Next quote">→</button>
					</div>
				</div>
				<p class="rv end-actions">
					<a class="button" href="mailto:caseylflood@gmail.com">Say hi</a>
					<a class="button button--ghost" href="/work">All work</a>
					<a class="button button--ghost" href="/resume">Resume</a>
				</p>
				<p class="keys rv" aria-label="Keyboard shortcuts"><span><kbd>C</kbd> copy email</span><span><kbd>W</kbd> work</span><span><kbd>S</kbd> story</span></p>
			</div>
		</section>

		<div class="peek" aria-hidden="true"><div class="peek__media"></div><span class="peek__cap"></span></div>
		<p class="toast" role="status" aria-live="polite"></p>
	</div>
</Base>

<script>
	const root = document.querySelector<HTMLElement>('.hp');
	if (root) {
		const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

		// Reveal each chapter as it arrives, one thing at a time.
		const rv = Array.from(root.querySelectorAll<HTMLElement>('.rv'));
		if (calm || !('IntersectionObserver' in window)) rv.forEach((el) => el.classList.add('in'));
		else {
			root.querySelectorAll('.ch').forEach((ch) => ch.querySelectorAll<HTMLElement>('.rv').forEach((el, i) => el.style.setProperty('--d', `${i * 90}ms`)));
			const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
			rv.forEach((el) => io.observe(el));
		}

		// Hover previews, a soft click, and keyboard shortcuts.
		const peek = root.querySelector<HTMLElement>('.peek')!;
		const media = peek.querySelector<HTMLElement>('.peek__media')!;
		const cap = peek.querySelector<HTMLElement>('.peek__cap')!;
		const toast = root.querySelector<HTMLElement>('.toast')!;
		let ctx: AudioContext | null = null;
		const tick = (f = 660) => {
			if (calm) return;
			try {
				ctx ??= new AudioContext();
				const o = ctx.createOscillator(), g = ctx.createGain();
				o.type = 'sine'; o.frequency.value = f;
				g.gain.setValueAtTime(0.0001, ctx.currentTime);
				g.gain.exponentialRampToValueAtTime(0.035, ctx.currentTime + 0.01);
				g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.12);
				o.connect(g).connect(ctx.destination); o.start(); o.stop(ctx.currentTime + 0.13);
			} catch {}
		};
		const hide = () => peek.classList.remove('on');
		if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
			root.querySelectorAll<HTMLElement>('[data-peek]').forEach((c) => {
				if (!c.dataset.peek!.endsWith('.mp4')) new Image().src = c.dataset.peek!;
				c.addEventListener('mouseenter', () => {
					const src = c.dataset.peek!;
					media.innerHTML = src.endsWith('.mp4')
						? `<video src="${src}" poster="${c.dataset.poster || ''}" muted autoplay loop playsinline></video>`
						: `<img src="${src}" alt="">`;
					cap.textContent = c.dataset.cap || '';
					const r = c.getBoundingClientRect(), pr = root.getBoundingClientRect();
					const w = peek.offsetWidth || 288;
					peek.style.left = Math.min(Math.max(r.left + r.width / 2 - pr.left - w / 2, 8), pr.width - w - 8) + 'px';
					peek.style.top = r.top - pr.top + 'px';
					peek.classList.add('on');
					tick(720);
				});
				c.addEventListener('mouseleave', hide);
			});
			addEventListener('scroll', hide, { passive: true });
		}

		// 03: tabs, and one project row open at a time
		root.querySelectorAll<HTMLElement>('[data-pj]').forEach((pj) => {
			const tabs = Array.from(pj.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
			tabs.forEach((t) => t.addEventListener('click', () => {
				tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
				pj.querySelectorAll<HTMLElement>('.pj__list').forEach((l) => (l.hidden = l.dataset.g !== t.dataset.g));
				tick(600);
			}));
			pj.querySelectorAll<HTMLElement>('.pj__list li').forEach((li) => {
				const open = () => { li.parentElement!.querySelectorAll('li').forEach((x) => x.classList.toggle('open', x === li)); };
				li.addEventListener('mouseenter', open);
				li.addEventListener('focusin', open);
			});
			pj.querySelectorAll('.pj__list').forEach((l) => l.querySelector('li')?.classList.add('open'));
		});


		// 05: a timeline you can scrub; it plays through once when it arrives
		root.querySelectorAll<HTMLElement>('[data-tl]').forEach((tl) => {
			const data = JSON.parse(tl.dataset.stops || '[]');
			const btns = Array.from(tl.querySelectorAll<HTMLButtonElement>('.tl__rail button'));
			const pics = Array.from(tl.querySelectorAll<HTMLImageElement>('.tl__pics img'));
			const h = tl.querySelector<HTMLElement>('.tl__h')!;
			const go = tl.querySelector<HTMLAnchorElement>('.tl__go')!;
			const n = btns.length;
			let cur = n - 1, auto: number | undefined;
			const pick = (i: number, sound = true) => {
				if (i === cur && h.textContent === data[i].h) return;
				cur = i;
				btns.forEach((b, k) => { b.setAttribute('aria-pressed', String(k === i)); b.classList.toggle('past', k < i); });
				pics.forEach((p, k) => p.classList.toggle('on', k === i));
				tl.style.setProperty('--p', String(n > 1 ? i / (n - 1) : 1));
				h.classList.remove('in'); void h.offsetWidth; h.textContent = data[i].h; h.classList.add('in');
				go.href = '/journey#' + data[i].id;
				if (sound) tick(480 + i * 70);
			};
			const stop = () => clearInterval(auto);
			btns.forEach((b, i) => {
				b.addEventListener('click', () => { stop(); pick(i); });
				b.addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse' && cur !== i) { stop(); pick(i); } });
				b.addEventListener('focus', () => { stop(); pick(i, false); });
			});
			tl.style.setProperty('--p', '1');
			if (!calm && 'IntersectionObserver' in window) {
				const io = new IntersectionObserver(([e]) => {
					if (!e.isIntersecting) return;
					io.disconnect();
					let i = 0; pick(0, false);
					auto = window.setInterval(() => { i++; if (i >= n) return stop(); pick(i, false); }, 650);
				}, { threshold: 0.6 });
				io.observe(tl);
			}
		});

		// In their words: one quote at a time
		root.querySelectorAll<HTMLElement>('[data-qs]').forEach((qs) => {
			const items = Array.from(qs.querySelectorAll<HTMLElement>('.qs__item'));
			const dots = Array.from(qs.querySelectorAll<HTMLElement>('.qs__dots i'));
			let k = 0, timer: number | undefined;
			const go = (n: number) => {
				k = (n + items.length) % items.length;
				items.forEach((it, j) => (it.hidden = j !== k));
				dots.forEach((d, j) => d.classList.toggle('on', j === k));
			};
			qs.querySelectorAll<HTMLButtonElement>('.qs__btn').forEach((b) => b.addEventListener('click', () => { go(k + Number(b.dataset.dir)); tick(640); clearInterval(timer); }));
			if (!calm) timer = window.setInterval(() => go(k + 1), 6500);
			qs.addEventListener('mouseenter', () => clearInterval(timer));
		});
		const say = (t: string) => {
			toast.textContent = t; toast.classList.add('on');
			clearTimeout((toast as any)._t); (toast as any)._t = setTimeout(() => toast.classList.remove('on'), 1600);
		};
		root.querySelectorAll('kbd').forEach((k) => ((k as HTMLElement).dataset.k = k.textContent!.toLowerCase()));
		const press = (k: string) => {
			const el = root.querySelector<HTMLElement>(`kbd[data-k="${k}"]`);
			el?.classList.add('down'); setTimeout(() => el?.classList.remove('down'), 160);
		};
		addEventListener('keydown', (e) => {
			if (e.metaKey || e.ctrlKey || e.altKey || (e.target as HTMLElement).closest('input, textarea, [contenteditable]')) return;
			const k = e.key.toLowerCase();
			if (k === 'c') { navigator.clipboard?.writeText('caseylflood@gmail.com'); press(k); tick(880); say('Email copied'); }
			if (k === 'w') { press(k); tick(560); document.querySelector('#impact')?.scrollIntoView({ behavior: calm ? 'auto' : 'smooth' }); }
			if (k === 's') { press(k); tick(560); location.href = '/journey'; }
		});
	}
</script>

