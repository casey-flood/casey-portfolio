---
import Base from '../layouts/Base.astro';

// One idea per screen, in order. Each chapter: a label, one big thing, one sentence, one image, one link.
const chapters = [
	{
		id: 'impact',
		n: '01',
		k: 'Impact',
		big: '−11.5%',
		line: 'hands-on designer time per order on Dandy’s Design Editor, while crown volume grew 57%. As its sole product designer, I led field research, the redesign, and a design system in code.',
		img: '/scan-to-smile/04-design.webp',
		pos: '50% 40%',
		alt: 'A dental designer and a teammate working on a 3D crown in the Design Editor',
		href: '/work/dandy-design-editor',
		cta: 'Read the Design Editor story',
	},
	{
		id: 'craft',
		n: '02',
		k: 'Craft',
		big: '45% → 82%',
		line: 'admin task completion after I rebuilt Amwell’s fragmented admin portal around each role, from paper sketches to a tested system.',
		img: '/amwell/cs/hero.webp',
		pos: '0% 0%',
		alt: 'The redesigned Amwell admin dashboard',
		href: '/work/amwell-admin-portal',
		cta: 'Read the admin portal story',
	},
];
---

<Base
	title="Casey Flood"
	description="Casey Flood designs complex healthcare tools end to end: research in the field, prototypes in code, and shipping with engineering."
>
	<div class="hp">
		<!-- 0. Who I am -->
		<section class="ch ch--intro">
			<div class="shell ch__in">
				<p class="who rv"><img src="/casey.jpg" alt="" width="600" height="800" /><span><b>Casey Flood</b> · Senior Product Designer at Dandy</span></p>
				<h1 class="rv">I design in code, so great ideas <em>actually ship</em>.</h1>
				<p class="lede rv">I design for every side of complex healthcare systems.</p>
				<p class="lede lede--tight rv">
					At
					<a class="lk lk--logo" href="/work/dandy" data-peek="/work/vision-scan.mp4" data-cap="Dandy overview"><img class="lk__logo" src="/brand/dandy-wordmark.svg" alt="Dandy" /></a>,
					that’s the whole life of a crown: the dentists who order it, the dental designers who shape it in 3D, and the lab that makes it.
				</p>
				<p class="lede lede--tight rv">
					At
					<a class="lk lk--logo" href="/work/amwell" data-peek="/amwell/hero-platform.webp" data-cap="Amwell overview"><img class="lk__logo lk__logo--amwell" src="/brand/amwell-white.svg" alt="Amwell" /></a>,
					it was telehealth for patients, providers and admins. I led 86% of our research, work that fed a #1 J.D. Power ranking.
				</p>
				<a class="next rv" href="#impact"><span>Start with the impact</span><i aria-hidden="true">↓</i></a>
			</div>
		</section>

		<!-- 1 & 2. Impact, then craft -->
		{chapters.map((c, i) => (
			<section class="ch" id={c.id} aria-labelledby={`k-${c.id}`}>
				<div class="shell ch__in">
					<p class="label rv" id={`k-${c.id}`}><i>{c.n}</i> {c.k}</p>
					<p class="big rv">{c.big}</p>
					<p class="line rv">{c.line}</p>
					<a class="shot rv" href={c.href} tabindex="-1" aria-hidden="true">
						<img src={c.img} alt={c.alt} style={`object-position:${c.pos}`} loading="lazy" decoding="async" />
					</a>
					<p class="rv"><a class="go" href={c.href}>{c.cta} <span aria-hidden="true">→</span></a></p>
					<a class="next rv" href={i === 0 ? '#craft' : '#how'}><span>{i === 0 ? 'Next: the craft' : 'Next: how I work'}</span><i aria-hidden="true">↓</i></a>
				</div>
			</section>
		))}

		<!-- 3. How I work -->
		<section class="ch" id="how" aria-labelledby="k-how">
			<div class="shell ch__in">
				<p class="label rv" id="k-how"><i>03</i> How I work</p>
				<p class="trio rv">
					<a class="lk" href="/work/dandy-design-editor" data-peek="/work/dde/cairo-team.webp" data-cap="Field research with dental designers in Cairo">Research in the field.</a>
					<a class="lk" href="/work/dandy-design-system" data-peek="/journey/storybook-ds-preview.mp4" data-poster="/journey/storybook-ds-cover.jpg" data-cap="The design system, built in Storybook">Prototype in code.</a>
					<a class="lk" href="/work/dandy-prototype" data-peek="/work/dde/design-review.mp4" data-poster="/work/dde/design-review.jpg" data-cap="Shipping with engineering">Ship with engineering.</a>
				</p>
				<p class="line rv">And bring people along: I mentored designers at Amwell, spoke on a General Assembly panel, and taught Dandy’s team how I prototype with AI.</p>
				<a class="next rv" href="#story"><span>Next: how I got here</span><i aria-hidden="true">↓</i></a>
			</div>
		</section>

		<!-- 4. How I got here -->
		<section class="ch" id="story" aria-labelledby="k-story">
			<div class="shell ch__in">
				<p class="label rv" id="k-story"><i>04</i> How I got here</p>
				<p class="big big--sm rv">From user research to design engineering.</p>
				<ol class="path rv" aria-label="Career path">
					<li><b>2017</b>Paper Airplane</li>
					<li><b>2018</b>Pratt</li>
					<li><b>2019</b>Amwell</li>
					<li><b>2025</b>Dandy</li>
				</ol>
				<p class="rv"><a class="go" href="/journey">Read my story <span aria-hidden="true">→</span></a></p>
			</div>
		</section>

		<!-- 5. In their words, then say hi -->
		<section class="ch ch--end" id="contact" aria-label="In their words and contact">
			<div class="shell ch__in">
				<blockquote class="quote rv">“Exceeding expectations for this stage in her tenure, with a strong trajectory toward broader leadership.”</blockquote>
				<p class="cite rv">Mid-year review, Dandy, 2025</p>
				<p class="rv end-actions">
					<a class="button" href="mailto:caseylflood@gmail.com">Say hi</a>
					<a class="button button--ghost" href="/work">All work</a>
					<a class="button button--ghost" href="/resume">Resume</a>
				</p>
				<p class="keys rv" aria-label="Keyboard shortcuts"><span><kbd>C</kbd> copy email</span><span><kbd>W</kbd> work</span><span><kbd>S</kbd> story</span></p>
			</div>
		</section>

		<div class="peek" aria-hidden="true"><div class="peek__media"></div><span class="peek__cap"></span></div>
		<p class="toast" role="status" aria-live="polite"></p>
	</div>
</Base>

<script>
	const root = document.querySelector<HTMLElement>('.hp');
	if (root) {
		const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

		// Reveal each chapter as it arrives, one thing at a time.
		const rv = Array.from(root.querySelectorAll<HTMLElement>('.rv'));
		if (calm || !('IntersectionObserver' in window)) rv.forEach((el) => el.classList.add('in'));
		else {
			root.querySelectorAll('.ch').forEach((ch) => ch.querySelectorAll<HTMLElement>('.rv').forEach((el, i) => el.style.setProperty('--d', `${i * 90}ms`)));
			const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
			rv.forEach((el) => io.observe(el));
		}

		// Hover previews, a soft click, and keyboard shortcuts.
		const peek = root.querySelector<HTMLElement>('.peek')!;
		const media = peek.querySelector<HTMLElement>('.peek__media')!;
		const cap = peek.querySelector<HTMLElement>('.peek__cap')!;
		const toast = root.querySelector<HTMLElement>('.toast')!;
		let ctx: AudioContext | null = null;
		const tick = (f = 660) => {
			if (calm) return;
			try {
				ctx ??= new AudioContext();
				const o = ctx.createOscillator(), g = ctx.createGain();
				o.type = 'sine'; o.frequency.value = f;
				g.gain.setValueAtTime(0.0001, ctx.currentTime);
				g.gain.exponentialRampToValueAtTime(0.035, ctx.currentTime + 0.01);
				g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.12);
				o.connect(g).connect(ctx.destination); o.start(); o.stop(ctx.currentTime + 0.13);
			} catch {}
		};
		const hide = () => peek.classList.remove('on');
		if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
			root.querySelectorAll<HTMLElement>('[data-peek]').forEach((c) => {
				if (!c.dataset.peek!.endsWith('.mp4')) new Image().src = c.dataset.peek!;
				c.addEventListener('mouseenter', () => {
					const src = c.dataset.peek!;
					media.innerHTML = src.endsWith('.mp4')
						? `<video src="${src}" poster="${c.dataset.poster || ''}" muted autoplay loop playsinline></video>`
						: `<img src="${src}" alt="">`;
					cap.textContent = c.dataset.cap || '';
					const r = c.getBoundingClientRect(), pr = root.getBoundingClientRect();
					const w = peek.offsetWidth || 288;
					peek.style.left = Math.min(Math.max(r.left + r.width / 2 - pr.left - w / 2, 8), pr.width - w - 8) + 'px';
					peek.style.top = r.top - pr.top + 'px';
					peek.classList.add('on');
					tick(720);
				});
				c.addEventListener('mouseleave', hide);
			});
			addEventListener('scroll', hide, { passive: true });
		}
		const say = (t: string) => {
			toast.textContent = t; toast.classList.add('on');
			clearTimeout((toast as any)._t); (toast as any)._t = setTimeout(() => toast.classList.remove('on'), 1600);
		};
		root.querySelectorAll('kbd').forEach((k) => ((k as HTMLElement).dataset.k = k.textContent!.toLowerCase()));
		const press = (k: string) => {
			const el = root.querySelector<HTMLElement>(`kbd[data-k="${k}"]`);
			el?.classList.add('down'); setTimeout(() => el?.classList.remove('down'), 160);
		};
		addEventListener('keydown', (e) => {
			if (e.metaKey || e.ctrlKey || e.altKey || (e.target as HTMLElement).closest('input, textarea, [contenteditable]')) return;
			const k = e.key.toLowerCase();
			if (k === 'c') { navigator.clipboard?.writeText('caseylflood@gmail.com'); press(k); tick(880); say('Email copied'); }
			if (k === 'w') { press(k); tick(560); document.querySelector('#impact')?.scrollIntoView({ behavior: calm ? 'auto' : 'smooth' }); }
			if (k === 's') { press(k); tick(560); location.href = '/journey'; }
		});
	}
</script>

<style>
	.hp { position: relative; }

	/* A chapter: one screen, one idea, centered column */
	.ch { min-height: 88svh; display: grid; align-items: center; padding: clamp(4rem, 10vh, 7rem) 0; scroll-margin-top: 3rem; }
	.ch--intro { min-height: calc(100svh - var(--header, 4.5rem)); padding-top: 2rem; }
	.ch--end { min-height: 70svh; }
	.ch__in { max-width: 40rem; }

	.who { display: flex; align-items: center; gap: 0.7rem; margin: 0 0 1.75rem; font-size: 0.92rem; color: var(--muted); }
	.who img { width: 2.25rem; height: 2.25rem; border-radius: 50%; object-fit: cover; object-position: center 22%; filter: grayscale(1); }
	.who b { color: var(--ink); font-weight: 600; }
	.hp h1 { font-size: clamp(2.4rem, 6vw, 4.2rem); line-height: 1.02; letter-spacing: -0.035em; margin: 0; max-width: 14ch; }
	.hp h1 em { font-style: normal; color: var(--accent); }
	.lede--tight { margin-top: 0.9rem !important; }
	.lk__logo { display: inline-block; height: 1em; width: auto; vertical-align: -0.12em; filter: brightness(0); }
	.lk__logo--amwell { height: 0.92em; vertical-align: -0.06em; }
	:global([data-theme='dark']) .lk__logo { filter: brightness(0) invert(1); }
	.lk--logo:hover .lk__logo { opacity: 0.75; }
	.lede { margin: 1.5rem 0 0; font-size: clamp(1.05rem, 1.6vw, 1.2rem); line-height: 1.6; color: var(--muted); max-width: 36rem; }

	.label { margin: 0 0 1.25rem; font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
	.label i { font-style: normal; color: var(--accent); margin-right: 0.35rem; }
	.big { margin: 0; font-family: var(--display); font-size: clamp(3.2rem, 9vw, 6rem); font-weight: 700; letter-spacing: -0.045em; line-height: 0.95; color: var(--ink); }
	.big--sm { font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.05; letter-spacing: -0.035em; max-width: 16ch; }
	.line { margin: 1.1rem 0 0; font-size: clamp(1.02rem, 1.5vw, 1.15rem); line-height: 1.6; color: var(--muted); max-width: 34rem; }
	.shot { display: block; margin: 2rem 0 1.25rem; aspect-ratio: 16 / 9; max-width: 34rem; border-radius: 1rem; overflow: hidden; border: 1px solid var(--line); background: var(--line); }
	.shot img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1); }
	.shot:hover img { transform: scale(1.03); }
	.go { font-weight: 600; color: var(--ink); text-decoration: none; }
	.go span { display: inline-block; transition: transform 0.2s; }
	.go:hover { color: var(--accent); }
	.go:hover span { transform: translateX(4px); }

	.next { display: inline-flex; align-items: center; gap: 0.6rem; margin-top: 3rem; color: var(--muted); text-decoration: none; font-size: 0.85rem; }
	.next i { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; border: 1px solid var(--line-strong); font-style: normal; transition: transform 0.25s, border-color 0.25s, color 0.25s; }
	.next:hover { color: var(--ink); }
	.next:hover i { transform: translateY(3px); border-color: var(--accent); color: var(--accent); }

	.trio { margin: 0; display: grid; gap: 0.2rem; font-family: var(--display); font-size: clamp(1.9rem, 4.5vw, 3rem); font-weight: 700; letter-spacing: -0.035em; line-height: 1.12; }
	.trio .lk { justify-self: start; }

	.path { list-style: none; margin: 2rem 0 1.5rem; padding: 0; display: flex; gap: 0; max-width: 34rem; }
	.path li { flex: 1; position: relative; padding-top: 1.1rem; font-size: 0.88rem; color: var(--muted); }
	.path li::before { content: ''; position: absolute; top: 0.3rem; left: 0; right: 0; height: 1px; background: var(--line-strong); }
	.path li::after { content: ''; position: absolute; top: 0; left: 0; width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--accent); }
	.path li:last-child::after { background: var(--accent); }
	.path b { display: block; color: var(--ink); font-family: var(--mono); font-size: 0.78rem; font-weight: 500; }

	.quote { margin: 0; font-family: var(--display); font-size: clamp(1.5rem, 3.2vw, 2.2rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.2; }
	.cite { margin: 1rem 0 0; color: var(--muted); font-size: 0.9rem; }
	.end-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 2.5rem; }

	/* Inline links with a dotted underline */
	.lk { color: var(--ink); text-decoration: none; background-image: linear-gradient(90deg, currentColor 40%, transparent 0); background-size: 5px 1.5px; background-repeat: repeat-x; background-position: 0 100%; padding-bottom: 2px; transition: color 0.2s; }
	.lk:hover, .lk:focus-visible { color: var(--accent); }
	.trio .lk { background-size: 6px 2px; }

	.keys { display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; margin-top: 2rem; font-size: 0.78rem; color: var(--muted); opacity: 0.6; }
	kbd { display: inline-grid; place-items: center; min-width: 1.15rem; height: 1.15rem; margin-right: 0.35rem; padding: 0 0.25rem; border-radius: 0.3rem; border: 1px solid var(--line-strong); font-family: var(--mono); font-size: 0.66rem; color: var(--ink); transition: background 0.12s, color 0.12s; }
	kbd:global(.down) { background: var(--ink); color: var(--bg); }
	@media (hover: none), (max-width: 760px) { .keys { display: none; } }

	/* Reveal */
	.rv { opacity: 0; transform: translateY(14px); transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1); transition-delay: var(--d, 0ms); }
	.rv:global(.in) { opacity: 1; transform: none; }

	/* Hover preview */
	.peek { position: absolute; z-index: 20; width: 18rem; pointer-events: none; transform: translateY(calc(-100% - 0.6rem)) scale(0.94); transform-origin: 50% 100%; opacity: 0; filter: blur(6px); transition: opacity 0.22s ease, transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.2), filter 0.22s; }
	.peek:global(.on) { opacity: 1; transform: translateY(calc(-100% - 0.6rem)); filter: none; }
	.peek__media { aspect-ratio: 16 / 10; border-radius: 0.9rem; overflow: hidden; background: var(--paper); border: 1px solid var(--line-strong); box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.5); }
	.peek__media :global(img), .peek__media :global(video) { width: 100%; height: 100%; object-fit: cover; display: block; }
	.peek__media :global(img[src*='hero-platform']) { object-fit: contain; padding: 0.5rem; }
	.peek__cap { position: absolute; left: 0.6rem; bottom: 0.5rem; padding: 0.2rem 0.5rem; border-radius: 99px; background: rgba(0, 0, 0, 0.6); color: #fff; font-size: 0.72rem; backdrop-filter: blur(6px); }
	.peek__cap:empty { display: none; }
	.toast { position: fixed; left: 50%; bottom: 1.5rem; translate: -50% 0; z-index: 50; margin: 0; padding: 0.55rem 0.9rem; border-radius: 99px; background: var(--ink); color: var(--bg); font-size: 0.88rem; opacity: 0; transform: translateY(8px); transition: opacity 0.2s, transform 0.2s; pointer-events: none; }
	.toast:global(.on) { opacity: 1; transform: none; }

	@media (max-width: 760px) {
		.ch { min-height: auto; padding: 4.5rem 0; }
		.ch--intro { min-height: 80svh; }
		.next { margin-top: 2rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.rv { opacity: 1; transform: none; transition: none; }
		.peek, .toast { transition: none; }
	}
</style>
