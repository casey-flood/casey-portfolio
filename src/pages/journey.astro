						<p class="bigyear sx" style="--a: -0.4">{pratt.year}</p>
						<p class="card__kicker sx" style="--a: -0.4">{pratt.kicker}</p>
						<h2 class="sx" style="--a: -0.4">{pratt.title}</h2>
