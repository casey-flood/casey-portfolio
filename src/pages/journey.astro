					<div class="scene__media sx sx--scrap" style="--a: -0.4">
						<img class="scrap" src={pratt.scrapbook.src} alt={pratt.scrapbook.alt} loading="lazy" />
					</div>
				</div>
				<a class="nextcue" href="#paper"><span>Next · 2017 · Paper Airplane</span><i aria-hidden="true">→</i></a>
