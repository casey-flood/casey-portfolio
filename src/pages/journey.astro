---
import Base from '../layouts/Base.astro';
import StoryBook from '../components/StoryBook.astro';
---

<Base title="My story" description="How Casey Flood went from user research to design engineering, one chapter at a time.">
	<section class="intro intro--compact">
		<div class="shell">
			<p class="eyebrow">My story</p>
			<h1>From research to <em>design engineering</em>.</h1>
			<p class="story-lede">One moment at a time. Swipe, use the arrows, or jump to a year below.</p>
		</div>
	</section>

	<StoryBook />

	<section class="story-end">
		<div class="shell">
			<p class="eyebrow">Full circle</p>
			<h2>From guerrilla marketing to design engineering.</h2>
			<p class="lede">Each stop widened what I own: the product, the journey, the system, the team, and now the code itself.</p>
			<div class="story-end__act">
				<a class="button" href="/work">See the work</a>
				<a class="button button--ghost" href="mailto:caseylflood@gmail.com">Say hi</a>
			</div>
		</div>
	</section>
</Base>

<style>
	.story-end { padding: clamp(4rem, 9vw, 7rem) 0 clamp(4rem, 8vw, 6rem); }
	.story-end h2 { font-family: var(--display); font-size: clamp(1.6rem, 3.2vw, 2.4rem); letter-spacing: -0.02em; margin: 0.4rem 0 0; max-width: 32rem; }
	.story-end .lede { max-width: 34rem; }
	.story-lede { color: var(--muted); margin: 0.75rem 0 0; max-width: 36rem; }
	.intro--compact { padding-bottom: clamp(1.5rem, 4vw, 2.5rem); }
	.story-end__act { display: flex; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap; }
</style>
