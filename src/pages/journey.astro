						<p class="bigyear sx" style="--a: -0.4">{paper.year}</p>
						<p class="card__kicker sx" style="--a: -0.4">{paper.kicker}</p>
						<h2 class="sx" style="--a: -0.4">{paper.title}</h2>
						<p class="sx body" style="--a: 0.13">{paper.body}</p>
						<div class="methods sx" style="--a: 0.18">
							<p class="mini">The hats I wore</p>
							<ul class="chips" id="hat-chips">
								{
									paper.hats.map((h, i) => (
										<li>
											<button type="button" class="chipbtn hatbtn" data-line={h.line} data-name={h.name} aria-pressed={i === 0}>
												{h.name}
											</button>
										</li>
									))
								}
							</ul>
							<div class="methodbox" aria-live="polite">
								<b id="hat-name"></b>
								<p id="hat-line"></p>
							</div>
						</div>
						<p class="sx" style="--a: 0.26; margin-top: 1rem">
							<a class="button" href={paper.link.href}>{paper.link.label} →</a>
						</p>
					</div>
					<div class="scene__media sx sx--media" style="--a: -0.4">
						<Frame media={paper.media} label="Paper Airplane" hint={paper.hint} />
					</div>
				</div>
				<a class="nextcue" href="#close"><span>Next · Where it led</span><i aria-hidden="true">→</i></a>
				<span class="scrollhint" aria-hidden="true"><i>↓</i></span>
			</div>
		</section>


			</div>
		</div>

		<div class="closewrap">
		<!-- CLOSE -->
		<section class="closer" id="close">
			<div class="shell">
				<p class="eyebrow">Full circle</p>
				<h2>From guerrilla marketing to design engineering.</h2>
				<p class="lede">
					Each stop widened what I own: the product, the journey, the system, the team, and now the
					code itself. I'd like to bring that range to a team with hard problems.
				</p>
				<div class="actions">
					<a class="button" href="/work">See the work</a>
					<a class="button button--ghost" href="/#contact">Say hi</a>
				</div>
			</div>
		</section>
		</div>
	</div>
</Base>

<script>
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// ---- steppers (tabs) ----
	type Stepper = { el: HTMLElement; tabs: HTMLElement[]; panels: HTMLElement[]; manual: boolean; set: (i: number) => void };
	const steppers = new Map<HTMLElement, Stepper>();
	document.querySelectorAll<HTMLElement>('[data-stepper]').forEach((el) => {
		const tabs = Array.from(el.querySelectorAll<HTMLElement>('[role="tab"]'));
		const panels = Array.from(el.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
		const bar = el.querySelector<HTMLElement>('.stepper2__bar span');
		const s: Stepper = {
			el,
			tabs,
			panels,
			manual: false,
			set(i) {
				tabs.forEach((t, j) => t.setAttribute('aria-selected', String(i === j)));
				panels.forEach((p, j) => (p.hidden = i !== j));
				if (bar) bar.style.width = `${((i + 1) / tabs.length) * 100}%`;
			},
		};
		tabs.forEach((t, i) =>
			t.addEventListener('click', () => {
				s.manual = true;
				s.set(i);
			}),
		);
		s.set(0);
		const wrap = el.closest<HTMLElement>('.scene-wrap');
		if (wrap) steppers.set(wrap, s);
	});

	// ---- hats (Paper Airplane) ----
	const hatBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.hatbtn'));
	const hName = document.getElementById('hat-name');
	const hLine = document.getElementById('hat-line');
	const showHat = (b: HTMLButtonElement) => {
		hatBtns.forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
		if (hName) hName.textContent = b.dataset.name ?? '';
		if (hLine) hLine.textContent = b.dataset.line ?? '';
	};
	hatBtns.forEach((b) => b.addEventListener('click', () => showHat(b)));
	if (hatBtns[0]) showHat(hatBtns[0]);

	// ---- research methods ----
	const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('#method-chips .chipbtn'));
	const mName = document.getElementById('method-name');
	const mWhat = document.getElementById('method-what');
	const mTrip = document.getElementById('method-trip');
	const showMethod = (b: HTMLButtonElement) => {
		chips.forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
		if (mName) mName.textContent = b.dataset.name ?? '';
		if (mWhat) mWhat.textContent = b.dataset.what ?? '';
		if (mTrip) {
			mTrip.textContent = b.dataset.trip ? `In My Trips: ${b.dataset.trip}` : '';
			mTrip.hidden = !b.dataset.trip;
		}
	};
	chips.forEach((b) => b.addEventListener('click', () => showMethod(b)));
	if (chips[0]) showMethod(chips[0]);

	// ---- autoplay videos only while visible ----
	document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => {
		if (reduce) {
			v.controls = true;
			return;
		}
		if (!('IntersectionObserver' in window)) return;
		new IntersectionObserver(
			(entries) =>
				entries.forEach((e) => {
					if (e.isIntersecting) v.play().catch(() => {});
					else v.pause();
				}),
			{ threshold: 0.35 },
		).observe(v);
	});

	// ---- timeline: year pills + stage ----
	const pillsEl = document.getElementById('ll-scroll');
	const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.lm'));
	const llFill = document.getElementById('ll-fill');
	const llBox = document.getElementById('ll');
	const panels = Array.from(document.querySelectorAll<HTMLElement>('.stp'));
	const deep = document.getElementById('deep');
	const allSlides = Array.from(document.querySelectorAll<HTMLElement>('[data-slide]'));
	let cur = -1;

	// small fireworks when the line reaches today
	const burst = (el: HTMLElement) => {
		const host = el.parentElement;
		if (!host) return;
		const colors = ['#2b59ff', '#ff6a3d', '#ffc531', '#21c18d', '#a78bfa'];
		for (let k = 0; k < 28; k++) {
			const d = document.createElement('i');
			d.className = 'spark';
			const a = (k / 28) * Math.PI * 2 + Math.random() * 0.4;
			const r = 40 + Math.random() * 50;
			d.style.left = `${el.offsetLeft}px`;
			d.style.setProperty('--dx', `${Math.cos(a) * r}px`);
			d.style.setProperty('--dy', `${Math.sin(a) * r}px`);
			d.style.background = colors[k % colors.length];
			host.appendChild(d);
			setTimeout(() => d.remove(), 1100);
		}
	};
	if (llBox && 'IntersectionObserver' in window) {
		const io = new IntersectionObserver((en) => {
			if (en[0].isIntersecting) {
				llBox.classList.add('is-drawn');
				io.disconnect();
			}
		}, { threshold: 0.3 });
		io.observe(llBox);
	} else llBox?.classList.add('is-drawn');

	const closeDeep = () => {
		if (deep) deep.hidden = true;
		document.querySelectorAll<HTMLButtonElement>('.js-deeper').forEach((b) => {
			b.setAttribute('aria-expanded', 'false');
			b.textContent = b.dataset.label ?? 'Explore ↓';
		});
	};

	const feed = () => window.matchMedia('(max-width: 900px)').matches;

	const select = (i: number, userAction = true) => {
		const n = Math.max(0, Math.min(panels.length - 1, i));
		if (n === cur) return;
		const first = cur === -1;
		const prev = cur;
		cur = n;
		const stEl = document.querySelector<HTMLElement>('.scrolly .st');
		if (stEl) stEl.dataset.year = (panels[n].querySelector('.stp__year')?.textContent ?? '').trim();
		document.documentElement.style.setProperty('--age', String(panels.length > 1 ? n / (panels.length - 1) : 0));
		if (!first && !reduce && !feed()) {
			const yEl = panels[n].querySelector<HTMLElement>('.stp__year');
			const from = parseInt(panels[prev]?.querySelector('.stp__year')?.textContent ?? '', 10);
			const to = parseInt(yEl?.textContent ?? '', 10);
			const suffix = (yEl?.textContent ?? '').replace(/^\d+/, '');
			if (yEl && from && to && from !== to) {
				const t0 = performance.now();
				const tick = (t: number) => {
					const k = Math.min(1, (t - t0) / 650);
					const e = 1 - Math.pow(1 - k, 3);
					yEl.textContent = k < 1 ? String(Math.round(from + (to - from) * e)) : `${to}${suffix}`;
					if (k < 1) requestAnimationFrame(tick);
				};
				requestAnimationFrame(tick);
			}
		}
		pills.forEach((p, k) => p.setAttribute('aria-selected', String(k === n)));
		panels.forEach((p, k) => {
			if (feed()) {
				p.hidden = false;
				return;
			}
			p.hidden = k !== n;
			if (k === n && !first) {
				p.dataset.dir = n > prev ? 'back' : 'fwd';
				p.classList.remove('is-in');
				void p.offsetWidth;
				p.classList.add('is-in');
			}
		});
		const ids = (panels[n].dataset.slides ?? '').split(',');
		allSlides.forEach((sl) => sl.classList.toggle('is-active', ids.includes(sl.id)));
		closeDeep();
		if (pillsEl && pills[n]) {
			const pl = pills[n];
			pillsEl.scrollTo({ left: pl.offsetLeft - pillsEl.clientWidth / 2, behavior: reduce ? 'auto' : 'smooth' });
			if (llFill) llFill.style.width = `${pl.offsetLeft}px`;
			if (n === 0 && !first && !reduce) burst(pl);
		}
		if (userAction && navigator.vibrate) navigator.vibrate(10);
		history.replaceState(null, '', `#${panels[n].dataset.id}`);
	};

	// ---- scroll-driven: one event at a time ----
	const scrolly = document.getElementById('st');
	const progEl = document.getElementById('st-prog');
	const hintEl = document.getElementById('st-hint');
	const OFFSET = 72; // sticky header height
	const stepPx = () => window.innerHeight * 0.7;
	const scrollyTop = () => (scrolly ? scrolly.getBoundingClientRect().top + window.scrollY : 0);
	const scrollToEvent = (i: number) => {
		if (feed()) {
			panels[i]?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
			return;
		}
		window.scrollTo({ top: scrollyTop() - OFFSET + i * stepPx() + 2, behavior: reduce ? 'auto' : 'smooth' });
	};
	const onScroll = () => {
		if (!scrolly || feed()) return;
		const total = (panels.length - 1) * stepPx();
		const px = Math.max(0, Math.min(total, OFFSET - scrolly.getBoundingClientRect().top));
		select(Math.round(px / stepPx()));
		if (progEl) progEl.style.height = `${total ? (px / total) * 100 : 0}%`;
		if (hintEl) hintEl.classList.toggle('is-hidden', px > 30);
		const r = scrolly.getBoundingClientRect();
		document.querySelector('.scrolly .st')?.toggleAttribute('data-live', r.top < window.innerHeight * 0.55 && r.bottom > window.innerHeight * 0.45);
	};
	let ticking = false;
	window.addEventListener('scroll', () => {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			ticking = false;
			onScroll();
		});
	}, { passive: true });
	window.addEventListener('resize', onScroll);
	pills.forEach((p, i) => p.addEventListener('click', () => scrollToEvent(i)));
	document.getElementById('deep-back')?.addEventListener('click', () => {
		closeDeep();
		scrollToEvent(cur);
	});
	pillsEl?.addEventListener('keydown', (e) => {
		if (['ArrowDown', 'ArrowRight'].includes(e.key)) { e.preventDefault(); scrollToEvent(Math.min(panels.length - 1, cur + 1)); }
		else if (['ArrowUp', 'ArrowLeft'].includes(e.key)) { e.preventDefault(); scrollToEvent(Math.max(0, cur - 1)); }
	});

	document.querySelectorAll<HTMLButtonElement>('.js-deeper').forEach((b) =>
		b.addEventListener('click', () => {
			if (feed()) {
				openSheetAt(b.closest<HTMLElement>('.stp')?.dataset.id ?? '', 0);
				return;
			}
			if (!deep) return;
			const open = deep.hidden;
			deep.hidden = !open;
			b.setAttribute('aria-expanded', String(open));
			b.textContent = open ? 'Hide the details ↑' : (b.dataset.label ?? 'Explore ↓');
			if (open) {
				deep.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => v.play().catch(() => {}));
				deep.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
			}
		}),
	);

	// ---- media mosaic + lightbox ----
	const lb = document.getElementById('lb');
	const lbBody = document.getElementById('lb-body');
	const lbCap = document.getElementById('lb-cap');
	const lbLink = document.getElementById('lb-link') as HTMLAnchorElement | null;
	let lbX = 0;
	let lbItems: HTMLElement[] = [];
	let lbIdx = 0;
	const lbShow = (k: number) => {
		if (!lbBody) return;
		lbIdx = (k + lbItems.length) % lbItems.length;
		const it = lbItems[lbIdx];
		lbBody.innerHTML = '';
		const src = it.querySelector('img,video');
		if (!src) return;
		const c = src.cloneNode(true) as HTMLElement;
		c.style.filter = 'none';
		if (c instanceof HTMLVideoElement) {
			c.controls = true;
			c.autoplay = true;
			c.muted = true;
			c.loop = true;
			c.removeAttribute('data-autoplay');
		}
		lbBody.appendChild(c);
		if (lbCap) lbCap.textContent = it.dataset.cap ?? '';
		if (lbLink) {
			lbLink.hidden = !it.dataset.href;
			lbLink.href = it.dataset.href ?? '#';
		}
		lb?.classList.toggle('lb--single', lbItems.length < 2);
	};
	const lbClose = () => {
		if (lb) lb.hidden = true;
		if (lbBody) lbBody.innerHTML = '';
		document.body.style.overflow = document.getElementById('hsheet')?.hidden === false ? 'hidden' : '';
	};
	document.addEventListener('click', (e) => {
		const f = (e.target as HTMLElement).closest<HTMLElement>('.mi[data-zoom]');
		if (!f || !lb) return;
		const g = f.closest('.mosaic');
		lbItems = Array.from(g?.querySelectorAll<HTMLElement>('.mi[data-zoom]') ?? [f]);
		lb.hidden = false;
		document.body.style.overflow = 'hidden';
		lbShow(lbItems.indexOf(f));
	});

	// ---- keyword <-> polaroid linking ----
	panels.forEach((panel) => {
		const pola = panel.querySelector('.pola');
		const link = (k: string | undefined, on: boolean) => {
			panel.querySelectorAll(`[data-k="${k}"]`).forEach((el) => el.classList.toggle('is-hl', on));
			pola?.classList.toggle('has-hl', on);
		};
		panel.querySelectorAll<HTMLElement>('.kw, .tile[data-k]').forEach((el) => {
			el.addEventListener('mouseenter', () => link(el.dataset.k, true));
			el.addEventListener('mouseleave', () => link(el.dataset.k, false));
			el.addEventListener('focus', () => link(el.dataset.k, true));
			el.addEventListener('blur', () => link(el.dataset.k, false));
		});
	});

	// ---- hover (or in-view on phones) plays a short preview clip ----
	document.querySelectorAll<HTMLElement>('.tile').forEach((t) => {
		const pv = t.querySelector<HTMLVideoElement>('.tile__preview');
		if (!pv) return;
		const play = () => { pv.play().catch(() => {}); t.classList.add('is-playing'); };
		const stop = () => { pv.pause(); t.classList.remove('is-playing'); };
		t.addEventListener('mouseenter', () => !feed() && play());
		t.addEventListener('mouseleave', () => !feed() && stop());
		t.addEventListener('focus', () => !feed() && play());
		t.addEventListener('blur', () => !feed() && stop());
		if ('IntersectionObserver' in window)
			new IntersectionObserver((en) => {
				if (!feed()) return;
				en[0].isIntersecting ? play() : stop();
			}, { threshold: 0.7 }).observe(t);
	});

	// ---- highlight sheet ----
	const sheet = document.getElementById('hsheet');
	const hsBody = document.getElementById('hs-body');
	const hsLink = document.getElementById('hs-link') as HTMLAnchorElement | null;
	const sheetClose = () => {
		if (sheet) sheet.hidden = true;
		if (hsBody) hsBody.innerHTML = '';
		document.body.style.overflow = '';
	};
	document.addEventListener('click', (e) => {
		const chip = (e.target as HTMLElement).closest<HTMLElement>('.hchip, .tile[data-tpl], .kw[data-tpl]');
		if (!chip || !sheet || !hsBody) return;
		// on touch screens, the first tap on a keyword highlights its photo; a second tap opens it
		if (chip.classList.contains('kw') && (window.matchMedia('(hover: none)').matches || feed()) && !chip.classList.contains('is-hl')) {
			chip.closest('.stp')?.querySelectorAll('.is-hl').forEach((x) => x.classList.remove('is-hl'));
			chip.closest('.stp')?.querySelectorAll(`[data-k="${chip.dataset.k}"]`).forEach((x) => x.classList.add('is-hl'));
			const pl = chip.closest('.stp')?.querySelector<HTMLElement>('.pola');
			pl?.classList.add('has-hl');
			const tl = pl?.querySelector<HTMLElement>(`.tile[data-k="${chip.dataset.k}"]`);
			if (pl && tl && feed()) pl.scrollTo({ left: tl.offsetLeft - (pl.clientWidth - tl.offsetWidth) / 2, behavior: 'smooth' });
			return;
		}
		const m = (chip.dataset.tpl ?? '').match(/^tpl-(.+)-(\d+)$/);
		if (m) openSheetAt(m[1], Number(m[2]));
	});
	let shEvt = '';
	let shK = 0;
	function openSheetAt(evt: string, k: number) {
		const tpls = Array.from(document.querySelectorAll<HTMLTemplateElement>(`template[id^="tpl-${evt}-"]`));
		if (!tpls.length || !sheet || !hsBody) return;
		shEvt = evt;
		shK = (k + tpls.length) % tpls.length;
		const tpl = tpls[shK];
		document.getElementById('hs-kick')!.textContent = tpl.dataset.kick ?? '';
		document.getElementById('hs-title')!.textContent = tpl.dataset.title ?? '';
		document.getElementById('hs-text')!.textContent = tpl.dataset.text ?? '';
		if (hsLink) {
			hsLink.hidden = !tpl.dataset.href;
			hsLink.href = tpl.dataset.href ?? '#';
			hsLink.textContent = `${tpl.dataset.link || 'Open the project'} →`;
		}
		hsBody.replaceChildren(tpl.content.cloneNode(true));
		hsBody.querySelectorAll('video').forEach((v) => {
			v.muted = true;
			v.play().catch(() => {});
		});
		const nav = document.getElementById('hs-nav');
		if (nav) nav.hidden = tpls.length < 2;
		const cnt = document.getElementById('hs-count');
		if (cnt) cnt.textContent = `${shK + 1} of ${tpls.length}`;
		sheet.hidden = false;
		sheet.scrollTop = 0;
		sheet.querySelector('.hsheet__card')?.scrollTo({ top: 0 });
		document.body.style.overflow = 'hidden';
	}
	document.getElementById('hs-prev')?.addEventListener('click', () => openSheetAt(shEvt, shK - 1));
	document.getElementById('hs-next')?.addEventListener('click', () => openSheetAt(shEvt, shK + 1));
	document.getElementById('hs-close')?.addEventListener('click', sheetClose);
	sheet?.addEventListener('click', (e) => { if (e.target === sheet) sheetClose(); });
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && sheet && !sheet.hidden && lb?.hidden !== false) sheetClose();
	});
	lb?.querySelector('.lb__x')?.addEventListener('click', lbClose);
	lb?.addEventListener('click', (e) => { if (e.target === lb || e.target === lbBody) lbClose(); });
	lb?.querySelector('.lb__nav--prev')?.addEventListener('click', () => lbShow(lbIdx - 1));
	lb?.querySelector('.lb__nav--next')?.addEventListener('click', () => lbShow(lbIdx + 1));
	lb?.addEventListener('touchstart', (e) => (lbX = e.touches[0].clientX), { passive: true });
	lb?.addEventListener('touchend', (e) => {
		const dx = e.changedTouches[0].clientX - lbX;
		if (Math.abs(dx) > 50 && lbItems.length > 1) lbShow(lbIdx + (dx < 0 ? 1 : -1));
	}, { passive: true });
	document.addEventListener('keydown', (e) => {
		if (lb && !lb.hidden) {
			if (e.key === 'Escape') lbClose();
			else if (e.key === 'ArrowRight') lbShow(lbIdx + 1);
			else if (e.key === 'ArrowLeft') lbShow(lbIdx - 1);
		}
	});

	const fromHash = panels.findIndex((p) => (p.dataset.slides ?? '').split(',').includes(location.hash.replace('#', '')) || p.dataset.id === location.hash.replace('#', ''));
	select(fromHash >= 0 ? fromHash : 0, false);
	if (fromHash > 0) setTimeout(() => scrollToEvent(fromHash), 50);
	onScroll();

	// ---- phone: a normal vertical feed, with the rail pinned and following along ----
	const stRoot = document.querySelector<HTMLElement>('.scrolly .st');
	let feedIO: IntersectionObserver | null = null;
	const applyMode = () => {
		feedIO?.disconnect();
		if (feed()) {
			panels.forEach((p) => (p.hidden = false));
			stRoot?.setAttribute('data-live', '');
			feedIO = new IntersectionObserver(
				(en) => en.forEach((x) => x.isIntersecting && select(panels.indexOf(x.target as HTMLElement), false)),
				{ rootMargin: '-28% 0px -62% 0px' },
			);
			panels.forEach((p) => feedIO!.observe(p));
		} else {
			panels.forEach((p, k) => (p.hidden = k !== cur));
			onScroll();
		}
	};
	window.matchMedia('(max-width: 900px)').addEventListener('change', applyMode);

	// carousel dots under each row of photos
	document.querySelectorAll<HTMLElement>('.pola').forEach((pl) => {
		const tiles = Array.from(pl.querySelectorAll<HTMLElement>('.tile'));
		if (tiles.length < 2) return;
		const dots = document.createElement('div');
		dots.className = 'pdots';
		dots.setAttribute('aria-hidden', 'true');
		tiles.forEach(() => dots.appendChild(document.createElement('i')));
		pl.after(dots);
		const upd = () => {
			const mid = pl.scrollLeft + pl.clientWidth / 2;
			let best = 0;
			let bd = Infinity;
			tiles.forEach((t, k) => {
				const d = Math.abs(t.offsetLeft + t.offsetWidth / 2 - mid);
				if (d < bd) {
					bd = d;
					best = k;
				}
			});
			Array.from(dots.children).forEach((d, k) => d.classList.toggle('is-on', k === best));
		};
		pl.addEventListener('scroll', upd, { passive: true });
		upd();
	});
	applyMode();
</script>
