---
// My story as a storybook: one moment at a time, neighbors peeking, and a scrubber below with a tick per
// moment, grouped by year. Swipe on phones; arrows, keys or the ticks on desktop. /journey#amwell opens a chapter.
import { chapters } from '../data/story';

type M = { src: string; alt: string; poster?: string; video?: boolean; fit?: 'contain'; pos?: string; bare?: boolean };
const list = (m: any): M[] | undefined => (m ? (Array.isArray(m) ? m : [m]) : undefined);
type P = {
	ch: (typeof chapters)[number];
	cover: boolean;
	kicker: string;
	head: string;
	date: string;
	title: string;
	text: string;
	nums?: { v: string; l: string }[];
	ladder?: { t: string; when: string }[];
	quote?: { q: string; who: string };
	media?: M[];
	link?: { href: string; label: string; external?: boolean };
	tip: string;
};
const pages: P[] = chapters.flatMap((c) => [
	{ ch: c, cover: true, kicker: `${c.name} · ${c.role}`, head: c.place, date: c.dates, title: c.title, text: c.text, nums: c.nums, ladder: c.ladder, quote: c.quote, media: list(c.media), link: c.link, tip: c.name },
	...c.moments.map((m) => ({ ch: c, cover: false, kicker: m.kicker, head: c.name, date: m.date, title: m.title, text: m.text, nums: m.num ? [m.num] : undefined, media: list(m.media), link: m.link, tip: m.kicker })),
]);
---

<section class="sb" data-sb aria-roledescription="carousel" aria-label="My story, one moment at a time">
	<div class="sb__stage">
		<button type="button" class="sb__side sb__side--l" data-step="-1" aria-label="Previous moment">←</button>
		<div class="sb__track" tabindex="0" aria-label="Story moments. Use the arrow keys to move.">
			{pages.map((p, i) => (
				<article class:list={['sb__page', { 'has-media': p.media, 'is-cover': p.cover }]} data-i={i} data-ch={p.ch.id} aria-roledescription="slide" aria-label={`${i + 1} of ${pages.length}`}>
					<header class="sb__head"><b>{p.head}</b><span>{p.date}</span></header>
					<div class="sb__body">
						<div class="sb__txt">
							<p class="sb__kick">{p.kicker}</p>
							<h2>{p.title}</h2>
							<p class="sb__text">{p.text}</p>
							{p.ladder && <ol class="sb__ladder">{p.ladder.map((s) => <li><b>{s.t}</b><span>{s.when}</span></li>)}</ol>}
							{p.nums && <ul class="sb__nums">{p.nums.map((n) => <li><b>{n.v}</b><span>{n.l}</span></li>)}</ul>}
							{p.quote && <blockquote class="sb__quote"><p>“{p.quote.q}”</p><cite>{p.quote.who}</cite></blockquote>}
							{p.link && <a class="sb__link" href={p.link.href} target={p.link.external ? '_blank' : undefined} rel={p.link.external ? 'noopener' : undefined}>{p.link.label} {p.link.external ? '↗' : '→'}</a>}
						</div>
						{p.media && (
							<div class:list={['sb__deck', { 'is-multi': p.media.length > 1 }]} data-n={p.media.length}>
								{p.media.map((m, k) => (
									<figure class:list={['sb__fig', { 'is-contain': m.fit === 'contain', 'is-bare': m.bare }]} style={`--o:${k}`} data-o={k} data-cap={m.alt}>
										{m.video ? <video src={m.src} poster={m.poster} muted loop playsinline preload="none" aria-label={m.alt}></video> : <img src={m.src} alt={m.alt} loading="lazy" decoding="async" style={m.pos ? `object-position:${m.pos}` : undefined} />}
									</figure>
								))}
								<button type="button" class="sb__expand" aria-label="View larger"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M9.5 2H14v4.5M6.5 14H2V9.5M14 2 9 7M2 14l5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
								{p.media.length > 1 && (
									<div class="sb__dots">
										{p.media.map((m, k) => <button type="button" data-k={k} aria-label={`Show photo ${k + 1}: ${m.alt}`} class:list={{ 'is-on': k === 0 }}></button>)}
										<span>Tap to flip</span>
									</div>
								)}
							</div>
						)}
					</div>
				</article>
			))}
		</div>
		<button type="button" class="sb__side sb__side--r" data-step="1" aria-label="Next moment">→</button>
	</div>

	<nav class="sb__scrub" aria-label="Jump to a moment">
		<div class="sb__groups">
			{chapters.map((c) => (
				<div class="sb__group" data-ch={c.id}>
					<ol class="sb__ticks">
						{pages.map((p, i) => p.ch.id === c.id && (
							<li><button type="button" data-go={i} data-tip={`${p.date} · ${p.tip}`} aria-label={`${p.date}: ${p.title}`} class:list={{ 'is-cover': p.cover }}><i></i></button></li>
						))}
					</ol>
					<button type="button" class="sb__year" data-go={pages.findIndex((p) => p.ch.id === c.id)}><b>{c.year}</b><span>{c.name}</span></button>
				</div>
			))}
		</div>
		<p class="sb__now" aria-live="polite"><span data-now-date></span><b data-now-title></b><em><span data-counter>1</span> / {pages.length}</em></p>
	</nav>
	<dialog class="sb__lb" aria-label="Photo viewer">
		<button type="button" class="sb__lbx" data-lb="close" aria-label="Close">×</button>
		<button type="button" class="sb__lbnav sb__lbnav--l" data-lb="-1" aria-label="Previous photo">←</button>
		<figure class="sb__lbfig"><div class="sb__lbmedia"></div><figcaption><span class="sb__lbcap"></span><span class="sb__lbcount"></span></figcaption></figure>
		<button type="button" class="sb__lbnav sb__lbnav--r" data-lb="1" aria-label="Next photo">→</button>
	</dialog>
</section>

<style>
	.sb { --acc: var(--accent, #3b5bff); --cw: min(54rem, calc(100vw - 8rem)); color: var(--ink); }

	/* Stage */
	.sb__stage { position: relative; }
	.sb__track { display: flex; align-items: stretch; gap: clamp(1rem, 3vw, 2.25rem); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding: 0.5rem calc((100% - var(--cw)) / 2) 1.75rem; outline: none; overscroll-behavior-x: contain; }
	.sb__track::-webkit-scrollbar { display: none; }
	.sb__page { flex: 0 0 var(--cw); scroll-snap-align: center; display: flex; flex-direction: column; min-height: clamp(18rem, 40vh, 24rem); padding: clamp(1.25rem, 2.6vw, 2rem) clamp(1.25rem, 3vw, 2.5rem); border-radius: 1.5rem; border: 1px solid var(--line);
		background: color-mix(in srgb, var(--ink) 3.5%, var(--sb-bg, transparent)); box-shadow: 0 30px 60px -44px rgba(0, 0, 0, 0.5);
		opacity: 0.3; filter: blur(2px) saturate(0.7); transform: scale(0.93); transition: opacity 0.5s, filter 0.5s, transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1); cursor: pointer; }
	.sb__page.is-on { opacity: 1; filter: none; transform: none; cursor: auto; }
	.sb__head { display: flex; flex-direction: column; align-items: center; gap: 0.1rem; margin-bottom: clamp(0.75rem, 2.5vw, 1.5rem); text-align: center; }
	.sb__head b { font-size: 0.8rem; font-weight: 600; }
	.sb__head span { font-size: 0.72rem; color: var(--muted); }
	.sb__body { flex: 1; display: grid; gap: clamp(1.25rem, 4vw, 2.75rem); align-items: center; }
	.sb__page.has-media .sb__body { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
	.sb__page:not(.has-media) .sb__txt { max-width: 34rem; margin: 0 auto; text-align: center; }
	.sb__page:not(.has-media) :is(.sb__ladder, .sb__nums) { justify-content: center; }
	.sb__kick { margin: 0 0 0.5rem; font-family: var(--mono, monospace); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--acc); }
	.sb__txt h2 { font-family: var(--display); font-size: clamp(1.4rem, 2.6vw, 2.05rem); letter-spacing: -0.025em; line-height: 1.08; margin: 0; text-wrap: balance; }
	.sb__text { margin: 0.7rem 0 0; color: var(--muted); line-height: 1.55; font-size: 0.95rem; text-wrap: pretty; }
	.sb__ladder { list-style: none; display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 0.9rem 0 0; padding: 0; }
	.sb__ladder li { display: flex; gap: 0.4rem; align-items: baseline; padding: 0.25rem 0.6rem; border-radius: 999px; border: 1px solid var(--line); font-size: 0.75rem; }
	.sb__ladder li span { font-family: var(--mono, monospace); font-size: 0.65rem; color: var(--muted); }
	.sb__nums { list-style: none; display: flex; flex-wrap: wrap; gap: 1rem 1.75rem; margin: 1.1rem 0 0; padding: 0; }
	.sb__nums li { max-width: 10rem; }
	.sb__nums b { display: block; white-space: nowrap; font-family: var(--display); font-size: clamp(1.35rem, 2.3vw, 1.8rem); letter-spacing: -0.03em; line-height: 1; }
	.sb__nums span { display: block; margin-top: 0.3rem; font-size: 0.74rem; line-height: 1.3; color: var(--muted); }
	.sb__quote { margin: 1rem 0 0; padding-left: 0.85rem; border-left: 2px solid var(--acc); text-align: left; }
	.sb__quote p { margin: 0; font-size: 0.88rem; }
	.sb__quote cite { display: block; margin-top: 0.25rem; font-style: normal; font-size: 0.7rem; color: var(--muted); }
	.sb__link { display: inline-block; margin-top: 1rem; color: var(--acc); font-weight: 600; font-size: 0.88rem; text-decoration: none; }
	.sb__link:hover { text-decoration: underline; }
	.sb__fig { margin: 0; aspect-ratio: 4 / 3; border-radius: 1rem; overflow: hidden; border: 1px solid var(--line); background: color-mix(in srgb, var(--ink) 6%, transparent); box-shadow: 0 20px 40px -26px rgba(0, 0, 0, 0.55); transform: rotate(1.2deg); transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); }
	.sb__page.is-on .sb__fig { transform: rotate(0.6deg); }
	.sb__fig img, .sb__fig video { width: 100%; height: 100%; object-fit: cover; display: block; }
	.sb__fig.is-contain { background: #fff; }
	.sb__fig.is-bare { background: none; border: 0; box-shadow: none; border-radius: 0; overflow: visible; transform: none !important; }
	.sb__fig.is-bare img { object-fit: contain; filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.35)); }
	.sb__fig.is-contain img { object-fit: contain; }


	/* Photo deck: several photos stacked; tap to send the front one to the back */
	.sb__deck { position: relative; aspect-ratio: 4 / 3; }
	.sb__deck .sb__fig { position: absolute; inset: 0; }
	.sb__deck.is-multi { cursor: pointer; margin-bottom: 1.6rem; }
	.sb__deck.is-multi .sb__fig { transform: rotate(calc(0.6deg + var(--o) * -3.5deg)) translate(calc(var(--o) * -3.5%), calc(var(--o) * 2.5%)) scale(calc(1 - var(--o) * 0.035)); z-index: calc(10 - var(--o)); transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.4s; }
	.sb__deck.is-multi .sb__fig:is([data-o='3'], [data-o='4'], [data-o='5']) { opacity: 0; }
	.sb__deck.is-multi:hover .sb__fig[data-o='0'] { transform: rotate(0deg) translateY(-4px); }
	.sb__dots { position: absolute; left: 0; right: 0; bottom: -1.7rem; display: flex; align-items: center; justify-content: center; gap: 0.4rem; }
	.sb__dots button { width: 0.45rem; height: 0.45rem; padding: 0; border-radius: 999px; border: 0; background: color-mix(in srgb, var(--ink) 25%, transparent); cursor: pointer; transition: width 0.25s, background 0.25s; }
	.sb__dots button.is-on { width: 1.2rem; background: var(--acc); }
	.sb__dots span { margin-left: 0.4rem; font-family: var(--mono, monospace); font-size: 0.6rem; color: var(--muted); }

	/* Expand + lightbox */
	.sb__expand { position: absolute; top: 0.6rem; right: 0.6rem; z-index: 20; display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 999px; border: 0; background: rgba(0, 0, 0, 0.55); color: #fff; cursor: zoom-in; opacity: 0; transform: scale(0.9); transition: opacity 0.2s, transform 0.2s; backdrop-filter: blur(6px); }
	.sb__page.is-on .sb__deck:hover .sb__expand, .sb__expand:focus-visible { opacity: 1; transform: none; }
	@media (hover: none) { .sb__page.is-on .sb__expand { opacity: 1; transform: none; } }
	.sb__deck:not(.is-multi) { cursor: zoom-in; }
	.sb__lb { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; color: #fff; }
	.sb__lb[open] { display: grid; grid-template-columns: auto 1fr auto; align-items: center; animation: sb-fade 0.25s ease both; }
	.sb__lb::backdrop { background: rgba(8, 8, 12, 0.88); backdrop-filter: blur(6px); }
	.sb__lbfig { grid-column: 2; margin: 0; display: flex; flex-direction: column; align-items: center; gap: 0.75rem; min-width: 0; padding: 3.5rem 0 2rem; height: 100%; justify-content: center; }
	.sb__lbmedia { display: flex; align-items: center; justify-content: center; max-width: 100%; max-height: calc(100dvh - 8rem); }
	.sb__lbmedia :global(img), .sb__lbmedia :global(video) { max-width: min(92vw, 1400px); max-height: calc(100dvh - 8rem); object-fit: contain; border-radius: 0.75rem; box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8); animation: sb-zoom 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
	.sb__lbfig figcaption { display: flex; gap: 0.75rem; align-items: baseline; font-size: 0.85rem; color: rgba(255, 255, 255, 0.85); text-align: center; padding: 0 1rem; }
	.sb__lbcount { font-family: var(--mono, monospace); font-size: 0.72rem; color: rgba(255, 255, 255, 0.5); }
	.sb__lbx { position: fixed; top: 1rem; right: 1rem; width: 2.5rem; height: 2.5rem; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.25); background: rgba(255, 255, 255, 0.08); color: #fff; font-size: 1.4rem; line-height: 1; cursor: pointer; }
	.sb__lbnav { margin: 0 1rem; width: 2.75rem; height: 2.75rem; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.25); background: rgba(255, 255, 255, 0.08); color: #fff; font-size: 1.1rem; cursor: pointer; }
	.sb__lbnav--l { grid-column: 1; } .sb__lbnav--r { grid-column: 3; }
	.sb__lbnav[hidden] { display: block; visibility: hidden; }
	.sb__lbx:hover, .sb__lbnav:hover { background: rgba(255, 255, 255, 0.18); }
	@keyframes sb-fade { from { opacity: 0; } }
	@keyframes sb-zoom { from { opacity: 0; transform: scale(0.96); } }
	@media (max-width: 760px) { .sb__lb[open] { grid-template-columns: 1fr; } .sb__lbnav { position: fixed; bottom: 1.25rem; margin: 0; } .sb__lbnav--l { left: calc(50% - 3.5rem); } .sb__lbnav--r { left: calc(50% + 0.75rem); } .sb__lbfig { grid-column: 1; padding-bottom: 5rem; } }
	.sb__side { position: absolute; top: calc(50% - 1.25rem); z-index: 2; width: 2.75rem; height: 2.75rem; border-radius: 999px; border: 1px solid var(--line); background: var(--sb-bg, #fff); color: var(--ink); font-size: 1.05rem; cursor: pointer; box-shadow: 0 8px 20px -12px rgba(0, 0, 0, 0.4); transition: opacity 0.2s, background 0.2s, transform 0.2s; }
	.sb__side--l { left: calc((100% - var(--cw)) / 2 - 1.375rem); }
	.sb__side--r { right: calc((100% - var(--cw)) / 2 - 1.375rem); }
	.sb__side:hover { transform: scale(1.06); }
	.sb__side:disabled { opacity: 0; pointer-events: none; }

	/* Scrubber: ticks grouped by year */
	.sb__scrub { max-width: var(--cw); margin: 0 auto; }
	.sb__groups { display: flex; justify-content: center; align-items: flex-start; gap: clamp(0.9rem, 2.5vw, 2rem); overflow-x: auto; scrollbar-width: none; padding: 2.1rem 0.25rem 0.25rem; }
	.sb__groups::-webkit-scrollbar { display: none; }
	.sb__group { display: flex; flex-direction: column; align-items: flex-start; flex: none; }
	.sb__ticks { list-style: none; display: flex; align-items: flex-end; gap: 0; margin: 0; padding: 0; height: 1.6rem; }
	.sb__ticks button { position: relative; display: flex; align-items: flex-end; justify-content: center; width: 0.85rem; height: 1.6rem; padding: 0; border: 0; background: none; cursor: pointer; }
	.sb__ticks i { width: 1.5px; height: 0.65rem; border-radius: 1px; background: color-mix(in srgb, var(--ink) 25%, transparent); transition: height 0.3s, background 0.3s, width 0.3s; }
	.sb__ticks button.is-cover i { height: 0.95rem; background: color-mix(in srgb, var(--ink) 40%, transparent); }
	.sb__ticks button:hover i { background: var(--ink); height: 1.1rem; }
	.sb__ticks button.is-on i { width: 2px; height: 1.6rem; background: var(--acc); }
	.sb__ticks button::after { content: attr(data-tip); position: absolute; bottom: calc(100% + 0.45rem); left: 50%; transform: translate(-50%, 4px); padding: 0.25rem 0.5rem; border-radius: 0.4rem; background: var(--ink); color: var(--sb-bg, #fff); font-size: 0.68rem; white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity 0.15s, transform 0.15s; }
	.sb__ticks button:hover::after { opacity: 1; transform: translate(-50%, 0); }
	.sb__year { display: flex; flex-direction: column; align-items: flex-start; gap: 0.05rem; margin-top: 0.45rem; padding: 0 0.15rem; border: 0; background: none; cursor: pointer; color: var(--muted); font: inherit; text-align: left; transition: color 0.2s; }
	.sb__year b { font-family: var(--mono, monospace); font-size: 0.68rem; font-weight: 500; }
	.sb__year span { font-size: 0.72rem; white-space: nowrap; }
	.sb__year:hover, .sb__group.is-on .sb__year { color: var(--ink); }
	.sb__group.is-on .sb__year b { color: var(--acc); }
	.sb__now { display: flex; align-items: baseline; justify-content: center; gap: 0.6rem; margin: 1.1rem 0 0; font-size: 0.82rem; text-align: center; }
	.sb__now span { font-family: var(--mono, monospace); font-size: 0.7rem; color: var(--acc); }
	.sb__now b { font-weight: 600; }
	.sb__now em { font-style: normal; font-family: var(--mono, monospace); font-size: 0.7rem; color: var(--muted); }

	@media (max-width: 760px) {
		.sb { --cw: calc(100vw - 2.5rem); }
		.sb__track { gap: 0.75rem; }
		.sb__page { min-height: 0; opacity: 0.45; filter: none; transform: scale(0.97); }
		.sb__page.has-media .sb__body { grid-template-columns: 1fr; }
		.sb__fig { order: -1; aspect-ratio: 16 / 10; }
		.sb__side { display: none; }
		.sb__groups { justify-content: flex-start; }
		.sb__ticks button { width: 1.15rem; }
		.sb__ticks button::after { display: none; }
		.sb__now b { display: none; }
	}
	@media (prefers-reduced-motion: reduce) { .sb *, .sb__page { transition: none !important; } }
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-sb]').forEach((root) => {
		const track = root.querySelector<HTMLElement>('.sb__track')!;
		const pages = Array.from(root.querySelectorAll<HTMLElement>('.sb__page'));
		const ticks = Array.from(root.querySelectorAll<HTMLButtonElement>('.sb__ticks button'));
		const groups = Array.from(root.querySelectorAll<HTMLElement>('.sb__group'));
		const groupsWrap = root.querySelector<HTMLElement>('.sb__groups')!;
		const [left, right] = Array.from(root.querySelectorAll<HTMLButtonElement>('.sb__side'));
		const counter = root.querySelector<HTMLElement>('[data-counter]')!;
		const nowDate = root.querySelector<HTMLElement>('[data-now-date]')!;
		const nowTitle = root.querySelector<HTMLElement>('[data-now-title]')!;
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const paintBg = () => root.style.setProperty('--sb-bg', getComputedStyle(document.body).backgroundColor);
		paintBg();
		new MutationObserver(paintBg).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'class'] });
		let cur = -1;

		const go = (i: number, smooth = !reduce) => {
			const p = pages[Math.max(0, Math.min(pages.length - 1, i))];
			track.scrollTo({ left: p.offsetLeft - (track.clientWidth - p.offsetWidth) / 2, behavior: smooth ? 'smooth' : 'auto' });
		};
		const set = (i: number) => {
			if (i === cur || i < 0) return;
			cur = i;
			const p = pages[i];
			const ch = p.dataset.ch;
			pages.forEach((q, k) => {
				q.classList.toggle('is-on', k === i);
				q.querySelectorAll('video').forEach((v) => (k === i ? v.play().catch(() => {}) : v.pause()));
			});
			ticks.forEach((t, k) => t.classList.toggle('is-on', k === i));
			groups.forEach((g) => g.classList.toggle('is-on', g.dataset.ch === ch));
			counter.textContent = String(i + 1);
			nowDate.textContent = p.querySelector('.sb__head span')?.textContent ?? '';
			nowTitle.textContent = p.querySelector('h2')?.textContent ?? '';
			left.disabled = i === 0;
			right.disabled = i === pages.length - 1;
			const g = groups.find((x) => x.dataset.ch === ch);
			if (g && groupsWrap.scrollWidth > groupsWrap.clientWidth) groupsWrap.scrollTo({ left: g.offsetLeft - groupsWrap.clientWidth / 2 + g.offsetWidth / 2, behavior: reduce ? 'auto' : 'smooth' });
			if (ch) history.replaceState(null, '', `#${ch}`);
		};

		const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && set(pages.indexOf(e.target as HTMLElement))), { root: track, threshold: 0.6 });

		root.querySelectorAll<HTMLElement>('[data-go]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.go))));
		root.querySelectorAll<HTMLElement>('[data-step]').forEach((b) => b.addEventListener('click', () => go(cur + Number(b.dataset.step))));
		pages.forEach((p, k) => p.addEventListener('click', (e) => { if (k !== cur && !(e.target as HTMLElement).closest('a')) go(k); }));
		root.querySelectorAll<HTMLElement>('.sb__deck.is-multi').forEach((deck) => {
			const figs = Array.from(deck.querySelectorAll<HTMLElement>('.sb__fig'));
			const dots = Array.from(deck.querySelectorAll<HTMLButtonElement>('.sb__dots button'));
			const n = figs.length;
			let front = 0;
			const show = (k: number) => {
				front = (k + n) % n;
				deck.dataset.front = String(front);
				figs.forEach((f, i) => { const o = String((i - front + n) % n); f.style.setProperty('--o', o); f.dataset.o = o; });
				dots.forEach((d, i) => d.classList.toggle('is-on', i === front));
				figs.forEach((f, i) => f.querySelectorAll('video').forEach((v) => (i === front ? v.play().catch(() => {}) : v.pause())));
			};
			deck.addEventListener('click', (e) => {
				if (!deck.closest('.sb__page')?.classList.contains('is-on')) return;
				e.stopPropagation();
				if ((e.target as HTMLElement).closest('.sb__expand')) return;
				const dot = (e.target as HTMLElement).closest<HTMLButtonElement>('.sb__dots button');
				show(dot ? Number(dot.dataset.k) : front + 1);
			});
		});
		// Lightbox: the expand button (or a tap on a single photo) opens the deck full size.
		const lb = root.querySelector<HTMLDialogElement>('.sb__lb')!;
		const lbMedia = lb.querySelector<HTMLElement>('.sb__lbmedia')!;
		const lbCap = lb.querySelector<HTMLElement>('.sb__lbcap')!;
		const lbCount = lb.querySelector<HTMLElement>('.sb__lbcount')!;
		const [lbPrev, lbNext] = Array.from(lb.querySelectorAll<HTMLButtonElement>('.sb__lbnav'));
		let items: { src: string; alt: string; poster?: string; video: boolean }[] = [];
		let at = 0;
		const render = () => {
			const it = items[at];
			lbMedia.innerHTML = '';
			const el = it.video ? Object.assign(document.createElement('video'), { src: it.src, poster: it.poster ?? '', muted: true, loop: true, autoplay: true, playsInline: true, controls: true }) : Object.assign(document.createElement('img'), { src: it.src, alt: it.alt });
			lbMedia.append(el);
			lbCap.textContent = it.alt;
			lbCount.textContent = items.length > 1 ? `${at + 1} / ${items.length}` : '';
			lbPrev.hidden = lbNext.hidden = items.length < 2;
		};
		const open = (deck: HTMLElement) => {
			items = Array.from(deck.querySelectorAll<HTMLElement>('.sb__fig')).map((f) => {
				const v = f.querySelector('video');
				const i = f.querySelector('img');
				return v ? { src: v.getAttribute('src')!, poster: v.getAttribute('poster') ?? undefined, alt: v.getAttribute('aria-label') ?? '', video: true } : { src: i!.getAttribute('src')!, alt: i!.alt, video: false };
			});
			at = Number(deck.dataset.front ?? 0);
			render();
			lb.showModal();
		};
		const step = (d: number) => { if (items.length > 1) { at = (at + d + items.length) % items.length; render(); } };
		root.querySelectorAll<HTMLElement>('.sb__deck').forEach((deck) => {
			deck.querySelector('.sb__expand')?.addEventListener('click', (e) => { e.stopPropagation(); open(deck); });
			if (!deck.classList.contains('is-multi')) deck.addEventListener('click', (e) => {
				if (!deck.closest('.sb__page')?.classList.contains('is-on')) return;
				e.stopPropagation(); open(deck);
			});
		});
		lb.addEventListener('click', (e) => {
			const t = e.target as HTMLElement;
			const b = t.closest<HTMLElement>('[data-lb]');
			if (b) { b.dataset.lb === 'close' ? lb.close() : step(Number(b.dataset.lb)); return; }
			if (t === lb || t.classList.contains('sb__lbfig') || t.classList.contains('sb__lbmedia')) lb.close();
		});
		lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') step(1); if (e.key === 'ArrowLeft') step(-1); });
		lb.addEventListener('close', () => { lbMedia.innerHTML = ''; });
		let tx = 0;
		lb.addEventListener('touchstart', (e) => { tx = e.touches[0].clientX; }, { passive: true });
		lb.addEventListener('touchend', (e) => { const d = e.changedTouches[0].clientX - tx; if (Math.abs(d) > 50) step(d < 0 ? 1 : -1); });
		track.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') { e.preventDefault(); go(cur + 1); }
			if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur - 1); }
		});

		const fromHash = pages.findIndex((p) => `#${p.dataset.ch}` === location.hash);
		const start = fromHash >= 0 ? fromHash : 0;
		requestAnimationFrame(() => { go(start, false); set(start); requestAnimationFrame(() => pages.forEach((p) => io.observe(p))); });
	});
</script>
