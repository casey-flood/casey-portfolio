---
// Small animated illustrations for the Design Editor story. Final state is the default;
// the page script plays them in when their beat becomes active.
interface Props { kind: string }
const { kind } = Astro.props;
const tools = ['Transform', 'Deform', 'Angles', 'CEJ', 'Margin', 'Sculpt', 'Fill', 'Cut plane', 'Oppose', 'Mirror', 'Min thickness'];
const spots = [[4,10,-6],[34,4,5],[62,12,-3],[10,34,4],[42,30,-5],[72,36,6],[6,60,-4],[36,56,3],[66,62,-6],[22,80,5],[56,84,-3]];
const front = [['Apr',134],['May',25],['Jun',20],['Jul',19],['Aug',20]];
---

{kind === 'handoff' && (
	<ol class="dz dz-handoff" aria-label="One crown, three stops">
		<li style="--i:0">Prep in Browser</li>
		<li style="--i:1">Upload</li>
		<li style="--i:2">3Shape or the editor</li>
	</ol>
)}

{kind === 'scatter' && (
	<div class="dz dz-scatter" aria-hidden="true">
		{tools.map((t, i) => <span style={`left:${spots[i][0]}%;top:${spots[i][1]}%;--r:${spots[i][2]}deg;--i:${i}`}>{t}</span>)}
	</div>
)}

{kind === 'survey' && (
	<div class="dz dz-vs" role="img" aria-label="Satisfaction out of 10: Dandy Design Editor 6.9, 3Shape 9.1">
		<figure class="vs vs--lo">
			<img src="/work/dde/old-dde-shot.webp" alt="" loading="lazy" decoding="async" />
			<figcaption><b>6.9</b><span>Dandy Design Editor</span></figcaption>
		</figure>
		<figure class="vs vs--hi">
			<img src="/work/dde/3shape-shot.webp" alt="" loading="lazy" decoding="async" />
			<figcaption><b>9.1</b><span>3Shape</span></figcaption>
		</figure>
	</div>
)}

{kind === 'usage' && (
	<div class="dz dz-usage dz-usage--gap" role="img" aria-label="46 percent of designers were designing in the Dandy Design Editor, against a goal of 100 percent: a 54 point gap">
		<div class="dz-nums">
			<div class="dz-bignum">46<small>%</small></div>
			<div class="dz-vs100"><span>vs. goal of</span><b>100%</b></div>
		</div>
		<div class="dz-gaptrack">
			<i class="g-fill" style="--w:46%"><em>46%</em></i>
			<i class="g-gap" style="--w:54%"><em>54% gap</em></i>
			<s class="g-goal"><span>Goal</span></s>
		</div>
		<p class="dz-bigcap">of designers were designing in the Dandy Design Editor</p>
	</div>
)}

{kind === 'focus' && (
	<div class="dz dz-focus3" role="img" aria-label="Three hypotheses, in order: ML-generated crowns; prep in the editor, then automated; and, in parallel, better navigation and information architecture.">
		<ol>
			<li style="--i:0">
				<span class="f3__m"><video src="/work/dde/ml-crown.mp4" poster="/work/dde/ml-crown.jpg" muted loop playsinline autoplay preload="metadata"></video><em>1</em></span>
				<b>ML-generated crowns</b>
			</li>
			<li style="--i:1">
				<span class="f3__m"><video src="/work/dde/prep-in-dde.mp4" poster="/work/dde/prep-in-dde.jpg" muted loop playsinline autoplay preload="metadata"></video><em>2</em></span>
				<b>Prep in the editor, then automated</b>
			</li>
			<li style="--i:2">
				<span class="f3__m"><img src="/work/dde/stage-crown.webp" alt="" loading="lazy" decoding="async" /><em>3</em></span>
				<b>Navigation and IA <small>in parallel</small></b>
			</li>
		</ol>
	</div>
)}

{kind === 'releases' && (
	<div class="dz dz-focus3" role="img" aria-label="Release order: ML crowns first, then prep in the editor and automated, with navigation and information architecture shipping in parallel, in chunks.">
		<ol>
			<li style="--i:0">
				<span class="f3__m"><video src="/work/dde/choose-crown.mp4" poster="/work/dde/choose-crown.jpg" muted loop playsinline autoplay preload="metadata"></video><em>1</em></span>
				<b>ML crowns <small>release 1</small></b>
			</li>
			<li style="--i:1">
				<span class="f3__m"><video src="/work/dde/prep-in-dde.mp4" poster="/work/dde/prep-in-dde.jpg" muted loop playsinline autoplay preload="metadata"></video><em>2</em></span>
				<b>Prep in the editor, then automated <small>release 2</small></b>
			</li>
			<li style="--i:2">
				<span class="f3__m"><img src="/work/dde/stage-design.webp" alt="" loading="lazy" decoding="async" /><em>3</em></span>
				<b>Navigation and IA <small>in parallel, in chunks</small></b>
			</li>
		</ol>
	</div>
)}

{kind === 'compare' && (
	<div class="dz cmp" data-cmp role="group" aria-label="Compare the original Design Editor with the north star prototype">
		<div class="cmp__frame">
			<img class="cmp__img" src="/work/dde/cmp-old.webp" alt="The original Dandy Design Editor" loading="lazy" decoding="async" />
			<img class="cmp__img cmp__img--new" src="/work/dde/cmp-new.webp" alt="The north star prototype of the Design Editor" loading="lazy" decoding="async" />
			<span class="cmp__tag cmp__tag--l">Before · Design Editor</span>
			<span class="cmp__tag cmp__tag--r">After · north star</span>
			<i class="cmp__bar"><b></b></i>
			<input class="cmp__in" type="range" min="0" max="100" value="50" aria-label="Drag to compare before and after" />
			<button class="cmp__exp" type="button" aria-label="Expand to full screen" data-cmp-exp><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M9.5 2H14v4.5M6.5 14H2V9.5M14 2 9 7M2 14l5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Expand</span></button>
			<button class="cmp__x" type="button" aria-label="Close full screen" data-cmp-x>&times;</button>
		</div>
	</div>
)}

{kind === 'shift' && (
	<div class="dz shf" role="img" aria-label="Share of crown orders by tool, Q1 2025 to Q2 2026: Dandy's own editor rose from 70 to 88 percent, up 18 points; 3Shape fell from 29 to 12 percent, down 18 points.">
		<p class="shf__cap">Share of crown orders finished in each tool</p>
		<div class="shf__row shf__row--up" style="--lo:70.4;--hi:88.2">
			<div class="shf__head"><b>Dandy’s own editor</b><strong>+18 <small>pts</small></strong></div>
			<div class="shf__trk"><i class="shf__base"></i><i class="shf__d"></i></div>
			<p class="shf__leg"><span>Q1 2025 · 70%</span><span>Q2 2026 · 88%</span></p>
		</div>
		<div class="shf__row shf__row--down" style="--lo:11.7;--hi:29.3">
			<div class="shf__head"><b>3Shape</b><strong>−18 <small>pts</small></strong></div>
			<div class="shf__trk"><i class="shf__base"></i><i class="shf__d"></i></div>
			<p class="shf__leg"><span>Q1 2025 · 29%</span><span>Q2 2026 · 12%</span></p>
		</div>
	</div>
)}

{kind === 'stages' && (
	<div class="dz dz-st5" role="img" aria-label="The five stages of the redesigned editor: Prep, Front, Crown, Design, Submit">
		<ol>
			{[['prep', 'Prep'], ['front', 'Front'], ['crown', 'Crown'], ['design', 'Design'], ['submit', 'Submit']].map(([k, label], i) => (
				<li style={`--i:${i}`}>
					<span class="st5__img"><img src={`/work/dde/stage-${k}.webp`} alt="" loading="lazy" decoding="async" /></span>
					<b><i>{i + 1}</i>{label}</b>
				</li>
			))}
		</ol>
	</div>
)}

{kind === 'sliders' && (
	<div class="dz slx" aria-hidden="true">
		<p class="slx__cap">Slider and step-control explorations</p>
		<div class="slx__grid">
			<div class="slx__col">
				<p class="slx__h">Tools</p>
				<div class="slx__seg"><b>Morph</b><b>Sculpt</b></div>
				<p class="slx__sub">Sculpting modes</p>
				<div class="slx__modes"><b>+</b><b>−</b><b>≈</b></div>
				<div class="slx__row slx__row--tri" data-sl data-min="5" data-max="30" data-dec="2" data-speed="0.9" data-phase="0">
					<span class="slx__lab">Radius</span><i class="slx__trk"><u></u></i><em><b data-val>1.04</b><s>mm</s></em>
				</div>
				<div class="slx__row slx__row--tri" data-sl data-min="10" data-max="90" data-dec="1" data-speed="0.7" data-phase="2">
					<span class="slx__lab">Strength</span><i class="slx__trk"><u></u></i><em><b data-val>5.0</b><s>µm</s></em>
				</div>
			</div>
			<div class="slx__col">
				<div class="slx__row slx__row--prox" data-sl data-min="0" data-max="100" data-speed="0.6" data-phase="1" data-words>
					<p class="slx__head"><b>Proximal Contact</b><span data-word>Light</span></p>
					<i class="slx__trk"><u></u></i>
					<p class="slx__ends"><span>Very light</span><span>Very tight</span></p>
				</div>
				<div class="slx__panel">
					<div class="slx__row slx__row--pill" data-sl data-min="5" data-max="95" data-dec="0" data-suf="%" data-speed="0.8" data-phase="0.5">
						<p class="slx__head"><span>Opacity</span><em data-val>26%</em></p><i class="slx__trk"><u></u></i>
					</div>
					<div class="slx__row slx__row--pill" data-sl data-min="10" data-max="95" data-dec="0" data-suf="%" data-speed="1.05" data-phase="3">
						<p class="slx__head"><span>Blend/softness</span><em data-val>83%</em></p><i class="slx__trk"><u></u></i>
					</div>
					<div class="slx__row slx__row--pill" data-sl data-min="5" data-max="90" data-dec="0" data-suf="%" data-speed="0.65" data-phase="4.5">
						<p class="slx__head"><span>Spread</span><em data-val>49%</em></p><i class="slx__trk"><u></u></i>
					</div>
				</div>
			</div>
		</div>
	</div>
)}

{kind === 'prep' && (
	<div class="dz dz-prep" aria-label="Choosing the base tooth in prep">
		<p>Base the crown on</p>
		<ul>
			<li>A copy of the pre-op</li>
			<li class="pick">A mirror of the other side</li>
			<li>A neighbor</li>
		</ul>
		<span class="dz-note">The designer can override</span>
	</div>
)}

{kind === 'frontview' && (
	<div class="dz dz-cols" role="img" aria-label="Front view, mean active seconds per visit: April 134, May 25, June 20, July 19, August 20">
		{front.map(([m, v], i) => (
			<div style={`--h:${(Number(v) / 134) * 100}%;--i:${i}`}><b>{v}</b><i></i><span>{m}</span></div>
		))}
		<p>seconds per visit</p>
	</div>
)}

{kind === 'crown' && (
	<div class="dz dz-crown" aria-hidden="true">
		<svg viewBox="0 0 200 160"><path pathLength="1" d="M30 110 C28 60 50 28 80 30 C95 31 100 40 100 40 C100 40 105 31 120 30 C150 28 172 60 170 110 C168 135 150 140 140 120 C132 105 118 105 100 105 C82 105 68 105 60 120 C50 140 32 135 30 110Z"/></svg>
		<span class="dz-chip dz-chip--a">Proposed by the model</span>
		<span class="dz-chip dz-chip--b">The designer can replace it</span>
	</div>
)}

{kind === 'autoprep' && (
	<ul class="dz dz-checks" aria-label="Prep that runs ahead">
		<li style="--i:0">Scan cleaned up</li>
		<li style="--i:1">Margin suggested</li>
		<li style="--i:2" class="last">Designer reviews and can redo</li>
	</ul>
)}

{kind === 'methods' && (
	<ul class="dz dz-methods" aria-label="How I did the research">
		{['Field study in Cairo','Shadowing on real cases','Card sorts','Short task tests'].map((m, i) => <li style={`--i:${i}`}>{m}</li>)}
	</ul>
)}

{kind === 'loop' && (
	<ol class="dz dz-loop" aria-label="The weekly cycle">
		<li style="--i:0">Bring a flow</li>
		<li style="--i:1">Watch where they click</li>
		<li style="--i:2">Cut the tickets</li>
	</ol>
)}

{kind === 'lost' && (
	<div class="dz dz-sort" aria-hidden="true">
		<div class="dz-sort__cols">
			{[
				['Set view', [['Front view', -190, 90, -9], ['Orientation', 120, 150, 7]]],
				['Choose crown', [['Tooth library', 260, -40, 6], ['Tooth number', -90, 170, -5]]],
				['Sculpt', [['Brush', -330, 20, 8], ['Contacts', 210, 120, -8]]],
				['Check', [['Occlusion', -250, 160, 5], ['Margin line', 90, -60, -7]]],
				['Send', [['Notes', -400, 80, -6]]],
			].map(([name, cards], ci) => (
				<div class="dz-sort__col" style={`--c:${ci}`}>
					<b>{name}</b>
					{(cards as any[]).map(([label, dx, dy, r], k) => (
						<span class="dz-sort__card" style={`--dx:${dx}px;--dy:${dy}px;--r:${r}deg;--k:${ci * 2 + k}`}>{label}</span>
					))}
				</div>
			))}
		</div>
		<p class="dz-sort__note">Illustration: sorting the tools into stages.</p>
	</div>
)}

<script>
	// Slider explorations: each control glides back and forth on its own rhythm.
	const rows = Array.from(document.querySelectorAll<HTMLElement>('.slx [data-sl]'));
	if (rows.length) {
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const words = ['Very light', 'Light', 'Tight', 'Very tight'];
		const paint = (row: HTMLElement, t: number) => {
			const min = +(row.dataset.min ?? 0), max = +(row.dataset.max ?? 100);
			const f = 0.5 + 0.5 * Math.sin(t * +(row.dataset.speed ?? 1) + +(row.dataset.phase ?? 0));
			const v = min + (max - min) * f;
			row.style.setProperty('--v', String(((v - min) / (max - min)) * 100));
			const out = row.querySelector<HTMLElement>('[data-val]');
			if (out) {
				const shown = row.dataset.dec === '0' ? String(Math.round(v)) : row.dataset.dec ? (v / (row.dataset.dec === '2' ? 10 : 10)).toFixed(+row.dataset.dec) : String(Math.round(v));
				out.textContent = shown + (row.dataset.suf ?? '');
			}
			const w = row.querySelector<HTMLElement>('[data-word]');
			if (w) w.textContent = words[Math.min(3, Math.floor(f * 4))];
		};
		if (reduce) rows.forEach((r) => paint(r, 1));
		else {
			const t0 = performance.now();
			const tick = (now: number) => {
				const t = (now - t0) / 1000;
				rows.forEach((r) => {
					const live = document.querySelector('.cx--live');
					if (!live || r.closest('.sc__row.on')) paint(r, t);
				});
				requestAnimationFrame(tick);
			};
			requestAnimationFrame(tick);
		}
	}
</script>

<script>
	// Before/after comparison: drag (or use arrow keys) to reveal the north star prototype.
	// "Expand" lifts it into a full-screen overlay (moved to <body> so scroll-scene transforms can't clip it).
	document.querySelectorAll<HTMLElement>('[data-cmp]').forEach((el) => {
		const input = el.querySelector<HTMLInputElement>('.cmp__in');
		if (!input) return;
		const touch = () => {
			if (!el.classList.contains('is-touched')) {
				const cur = parseFloat(getComputedStyle(el).getPropertyValue('--p')) || 50;
				input.value = String(cur);
				el.classList.add('is-touched');
				el.style.setProperty('--p', String(cur));
			}
		};
		input.addEventListener('input', () => { touch(); el.style.setProperty('--p', input.value); });
		let holder: HTMLElement | null = null;
		const close = () => {
			if (!holder) return;
			el.classList.remove('is-full');
			holder.replaceWith(el);
			holder = null;
			document.documentElement.classList.remove('cmp-lock');
			document.removeEventListener('keydown', onKey);
			el.querySelector<HTMLElement>('[data-cmp-exp]')?.focus();
		};
		const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape') close(); };
		const open = () => {
			if (holder) return;
			touch();
			holder = document.createElement('div');
			holder.style.height = el.getBoundingClientRect().height + 'px';
			el.replaceWith(holder);
			document.body.appendChild(el);
			el.classList.add('is-full');
			document.documentElement.classList.add('cmp-lock');
			document.addEventListener('keydown', onKey);
			el.querySelector<HTMLElement>('[data-cmp-x]')?.focus();
		};
		el.querySelector('[data-cmp-exp]')?.addEventListener('click', open);
		el.querySelector('[data-cmp-x]')?.addEventListener('click', close);
		el.addEventListener('click', (e) => { if (e.target === el) close(); });
	});
</script>
