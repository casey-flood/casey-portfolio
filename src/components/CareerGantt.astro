---
// Career at a glance: roles as bars on a year axis, overlapping roles in their own lanes.
// Click (or arrow through) a bar to open its card: the story in a line, the numbers, a fanned stack of media.
import { career, lanes, NOW } from '../data/career';

const first = Math.floor(Math.min(...career.map((c) => c.start)));
const last = Math.ceil(NOW);
const span = last - first;
const years = Array.from({ length: span + 1 }, (_, i) => first + i);
const pct = (y: number) => ((y - first) / span) * 100;
const order = [...career].sort((a, b) => a.start - b.start);
---

<section class="cg" id="career" aria-labelledby="cg-h" data-cg>
	<div class="cg__head">
		<p class="cg__eyebrow">At a glance</p>
		<h2 id="cg-h">{order.length} chapters, {last - first} years.</h2>
		<p class="cg__lede">Click a chapter for the story and the numbers behind it.</p>
	</div>

	<div class="cg__scroll">
		<div class="cg__chart">
			<ol class="cg__years" aria-hidden="true">
				{years.map((y) => <li style={`--x:${pct(y)}%`}>{y}</li>)}
			</ol>
			<div class="cg__lanes" role="tablist" aria-label="Career chapters, oldest first">
				{lanes.map((lane) => (
					<div class="cg__lane">
						<span class="cg__lname">{lane.label}</span>
						<div class="cg__track">
							{career.filter((c) => c.lane === lane.id).map((c) => (
								<button
									type="button"
									role="tab"
									class:list={['cg__bar', `cg__bar--${c.lane}`, { 'is-approx': c.approx, 'is-now': c.now }]}
									data-id={c.id}
									data-n={order.indexOf(c)}
									aria-selected={order[order.length - 1].id === c.id}
									aria-controls={`cg-p-${c.id}`}
									style={`--l:${pct(c.start)}%;--w:${pct(c.end) - pct(c.start)}%;--d:${order.indexOf(c) * 0.09}s`}
								>
									{c.steps ? (
										<span class="cg__steps">
											{c.steps.map((s) => <i style={`--sw:${((s.end - s.start) / (c.end - c.start)) * 100}%`} title={s.t}></i>)}
										</span>
									) : null}
									<span class="cg__label"><b>{c.org}</b><span>{c.role}</span></span>
								</button>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</div>

	<div class="cg__panels">
		{order.map((c, i) => (
			<article class="cg__card" id={`cg-p-${c.id}`} role="tabpanel" data-id={c.id} hidden={i !== order.length - 1}>
				<div class="cg__txt">
					<p class="cg__kick"><span>{c.dates}</span>{c.place && <span>{c.place}</span>}</p>
					<h3>{c.title}</h3>
					<p class="cg__body">{c.text}</p>
					{c.steps && (
						<ol class="cg__ladder">
							{c.steps.map((s, k) => <li style={`--k:${k}`}><b>{s.t}</b><span>{Math.floor(s.start)}{Math.floor(s.end) !== Math.floor(s.start) ? `–${Math.floor(s.end)}` : ''}</span></li>)}
						</ol>
					)}
					{c.nums.length > 0 && (
						<ul class="cg__nums">
							{c.nums.map((n, k) => <li style={`--k:${k}`}><b>{n.v}</b><span>{n.l}</span></li>)}
						</ul>
					)}
					{c.link && <a class="cg__link" href={c.link.href}>{c.link.label} →</a>}
				</div>
				{c.media && c.media.length > 0 && (
					<div class="cg__fan" data-count={c.media.length}>
						{c.media.slice(0, 3).map((m, k) => <img src={m.src} alt={m.alt} loading="lazy" decoding="async" style={`--k:${k}`} />)}
					</div>
				)}
			</article>
		))}
	</div>
</section>

<style>
	.cg { --cg-acc: var(--accent, #7b95ff); max-width: 72rem; margin: 0 auto; padding: clamp(2rem, 5vw, 4rem) 1rem clamp(3rem, 6vw, 5rem); color: var(--ink); }
	.cg__eyebrow { font-family: var(--mono, ui-monospace, monospace); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cg-acc); margin: 0 0 0.6rem; }
	.cg__head h2 { font-family: var(--display); font-size: clamp(1.8rem, 3.6vw, 2.6rem); letter-spacing: -0.02em; line-height: 1.05; margin: 0; }
	.cg__lede { color: var(--muted); margin: 0.6rem 0 0; }

	.cg__scroll { margin-top: clamp(1.5rem, 3vw, 2.5rem); overflow-x: auto; scrollbar-width: thin; padding-bottom: 0.5rem; }
	.cg__chart { position: relative; min-width: 46rem; padding-left: 7rem; }
	.cg__years { list-style: none; margin: 0 0 0.75rem; padding: 0; position: relative; height: 1.25rem; border-bottom: 1px solid var(--line); }
	.cg__years li { position: absolute; left: var(--x); transform: translateX(-50%); font-family: var(--mono, monospace); font-size: 0.7rem; color: var(--muted); }
	.cg__years li::after { content: ''; position: absolute; left: 50%; top: 1.25rem; height: calc(var(--lanes-h, 11rem)); border-left: 1px dashed var(--line); }
	.cg__lanes { position: relative; display: grid; gap: 0.6rem; }
	.cg__lane { display: grid; grid-template-columns: 7rem 1fr; margin-left: -7rem; align-items: center; min-height: 3.1rem; }
	.cg__lname { font-family: var(--mono, monospace); font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
	.cg__track { position: relative; height: 3.1rem; }

	.cg__bar {
		position: absolute; top: 0; bottom: 0; left: var(--l); width: var(--w); min-width: 4.5rem;
		display: flex; align-items: center; padding: 0 0.7rem; overflow: hidden; text-align: left; cursor: pointer;
		border-radius: 0.7rem; border: 1px solid var(--line); color: var(--ink); font: inherit;
		background: color-mix(in srgb, var(--ink) 5%, transparent);
		transform-origin: left center; animation: cg-grow 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d) both;
		transition: background 0.2s, border-color 0.2s, box-shadow 0.2s, opacity 0.2s;
	}
	.cg__bar--school { background: color-mix(in srgb, #ffc933 9%, transparent); }
	.cg__bar--side { top: 0.65rem; bottom: 0.65rem; background: color-mix(in srgb, #3fdca8 8%, transparent); }
	.cg__bar.is-approx { -webkit-mask-image: linear-gradient(90deg, transparent, #000 1.4rem); mask-image: linear-gradient(90deg, transparent, #000 1.4rem); padding-left: 1.4rem; }
	.cg__bar.is-now { border-right-style: dashed; border-top-right-radius: 0.2rem; border-bottom-right-radius: 0.2rem; }
	.cg__bar:hover { border-color: color-mix(in srgb, var(--cg-acc) 55%, transparent); }
	.cg__bar[aria-selected='true'] { border-color: var(--cg-acc); background: color-mix(in srgb, var(--cg-acc) 18%, transparent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--cg-acc) 18%, transparent); }
	.cg__lanes:has(.cg__bar[aria-selected='true']) .cg__bar:not([aria-selected='true']):not(:hover) { opacity: 0.62; }
	.cg__bar:focus-visible { outline: 2px solid var(--cg-acc); outline-offset: 2px; }
	.cg__label { position: relative; display: flex; flex-direction: column; min-width: 0; line-height: 1.15; }
	.cg__label b { font-size: 0.85rem; font-weight: 650; white-space: nowrap; }
	.cg__label span { font-size: 0.7rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.cg__steps { position: absolute; inset: 0; display: flex; }
	.cg__steps i { width: var(--sw); border-right: 1px solid color-mix(in srgb, var(--ink) 22%, transparent); }
	.cg__steps i:nth-child(2) { background: color-mix(in srgb, var(--ink) 4%, transparent); }
	.cg__steps i:nth-child(3) { background: color-mix(in srgb, var(--ink) 8%, transparent); }
	.cg__steps i:last-child { border-right: 0; }

	.cg__panels { margin-top: clamp(1.5rem, 3vw, 2.25rem); }
	.cg__card { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; padding: clamp(1.25rem, 3vw, 2rem); border: 1px solid var(--line); border-radius: 1.25rem; background: color-mix(in srgb, var(--ink) 3%, transparent); animation: cg-in 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
	.cg__card[hidden] { display: none; }
	.cg__card:not(:has(.cg__fan)) { grid-template-columns: 1fr; }
	.cg__kick { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin: 0 0 0.6rem; font-family: var(--mono, monospace); font-size: 0.72rem; color: var(--cg-acc); text-transform: uppercase; letter-spacing: 0.06em; }
	.cg__kick span + span { color: var(--muted); }
	.cg__card h3 { font-family: var(--display); font-size: clamp(1.4rem, 2.6vw, 2rem); letter-spacing: -0.02em; line-height: 1.1; margin: 0; }
	.cg__body { color: var(--muted); margin: 0.7rem 0 0; max-width: 38rem; }
	.cg__ladder { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.cg__ladder li { display: flex; gap: 0.5rem; align-items: baseline; padding: 0.35rem 0.7rem; border-radius: 999px; border: 1px solid var(--line); font-size: 0.8rem; animation: cg-in 0.4s both calc(0.1s + var(--k) * 0.08s); }
	.cg__ladder li span { font-family: var(--mono, monospace); font-size: 0.7rem; color: var(--muted); }
	.cg__ladder li + li::before { content: '→'; color: var(--muted); margin-right: 0.1rem; }
	.cg__nums { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); gap: 0.6rem; }
	.cg__nums li { padding: 0.8rem 0.9rem; border-radius: 0.9rem; border: 1px solid var(--line); background: color-mix(in srgb, var(--ink) 3%, transparent); animation: cg-in 0.45s both calc(0.12s + var(--k) * 0.07s); }
	.cg__nums b { display: block; font-family: var(--display); font-size: clamp(1.25rem, 2.2vw, 1.6rem); letter-spacing: -0.02em; line-height: 1.1; color: var(--ink); }
	.cg__nums span { display: block; margin-top: 0.3rem; font-size: 0.78rem; line-height: 1.3; color: var(--muted); }
	.cg__link { display: inline-block; margin-top: 1.1rem; color: var(--cg-acc); font-weight: 600; text-decoration: none; }
	.cg__link:hover { text-decoration: underline; }

	.cg__fan { position: relative; aspect-ratio: 4 / 3; }
	.cg__fan img { position: absolute; inset: 8% 10%; width: 80%; height: 84%; object-fit: cover; border-radius: 0.9rem; border: 1px solid var(--line); box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.6); background: #111;
		transform: rotate(calc((var(--k) - 1) * 5deg)) translateX(calc((var(--k) - 1) * 9%)); z-index: calc(3 - var(--k));
		transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1); animation: cg-fan 0.6s both calc(0.08s + var(--k) * 0.08s); }
	.cg__fan[data-count='1'] img { transform: none; }
	.cg__fan:hover img { transform: rotate(calc((var(--k) - 1) * 9deg)) translateX(calc((var(--k) - 1) * 22%)); }

	@keyframes cg-grow { from { transform: scaleX(0.02); opacity: 0; } to { transform: none; opacity: 1; } }
	@keyframes cg-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
	@keyframes cg-fan { from { opacity: 0; transform: translateY(14px) rotate(0deg); } }
	@media (prefers-reduced-motion: reduce) { .cg *, .cg *::before { animation: none !important; transition: none !important; } }

	@media (max-width: 760px) {
		.cg__card { grid-template-columns: 1fr; }
		.cg__fan { max-width: 22rem; width: 100%; justify-self: center; }
		.cg__chart { min-width: 40rem; padding-left: 5.5rem; }
		.cg__lane { grid-template-columns: 5.5rem 1fr; margin-left: -5.5rem; }
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-cg]').forEach((root) => {
		const bars = Array.from(root.querySelectorAll<HTMLButtonElement>('.cg__bar')).sort((a, b) => Number(a.dataset.n) - Number(b.dataset.n));
		const cards = root.querySelectorAll<HTMLElement>('.cg__card');
		const lanes = root.querySelector<HTMLElement>('.cg__lanes');
		if (lanes) root.style.setProperty('--lanes-h', `${lanes.offsetHeight}px`);
		const pick = (id: string, focus = false) => {
			bars.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.id === id)));
			cards.forEach((c) => {
				const on = c.dataset.id === id;
				if (on && c.hidden) { c.hidden = false; c.style.animation = 'none'; void c.offsetWidth; c.style.animation = ''; }
				else c.hidden = !on;
			});
			if (focus) bars.find((b) => b.dataset.id === id)?.focus();
		};
		bars.forEach((b, i) => {
			b.addEventListener('click', () => pick(b.dataset.id!));
			b.addEventListener('keydown', (e) => {
				const k = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
				if (!k) return;
				e.preventDefault();
				pick(bars[(i + k + bars.length) % bars.length].dataset.id!, true);
			});
		});
	});
</script>
