---
import { stages, projects, groups, type ProjectId, type GroupId } from '../data/scan-to-smile';
import { stageImages } from '../data/scan-to-smile-images';

interface Props {
	project?: ProjectId | null; // highlight a project's steps and dim the rest
	compact?: boolean; // small "where this fits" strip
	listen?: boolean; // react to project cards elsewhere on the page (hover or tap)
	hubHref?: string;
	quiet?: boolean; // display only: no details panel, steps just light up from project cards
}
const { project = null, compact = false, listen = false, hubHref = '/work/dandy', quiet = false } = Astro.props;
const uid = `s2s-${Math.random().toString(36).slice(2, 8)}`;
const proj = project ? projects[project] : null;
const hl = proj?.stages ?? [];
const near = proj?.near ?? [];
const startStep = hl[0] ?? 1;

// Consecutive stages with the same group sit in one colored container.
const order: GroupId[] = [];
for (const s of stages) if (!order.includes(s.group)) order.push(s.group);
const dots: Record<GroupId, string[]> = {
	patient: ['#e3c34a'],
	dentist: ['#5b9bd5'],
	designer: ['#8a4fd0'],
	ops: ['#8a5a3a'],
	both: ['#e3c34a', '#5b9bd5'],
};
const chipLabel: Record<GroupId, string> = {
	patient: 'Patient',
	dentist: 'Dentist',
	designer: 'Dental designer',
	ops: 'Manufacturing',
	both: 'Dentist and patient',
};
---

{
	compact ? (
		<aside class="s2s s2s--compact" aria-label="Where this project fits in the journey">
			<p class="s2s__eyebrow">Where this fits</p>
			<ol class="s2s__mini">
				{stages.map((s) => (
					<li class:list={{ 'is-hl': hl.includes(s.n), 'is-near': near.includes(s.n) }}>
						<span class="s2s__mini-n">{s.n}</span>
						<span>{s.title}</span>
					</li>
				))}
			</ol>
			<p class="s2s__mini-note">
				{proj?.blurb} <a href={hubHref}>See the full journey →</a>
			</p>
		</aside>
	) : (
		<div class:list={['s2s', { 's2s--quiet': quiet }]} data-s2s data-quiet={quiet ? '' : undefined} data-start={startStep} data-listen={listen ? '' : undefined} data-hl={hl.join(',')} data-near={near.join(',')}>
			<div class="s2s__track" data-track>
				{order.map((g, gi) => {
					const gs = stages.filter((s) => s.group === g);
					return (
						<>
							<section class:list={['s2s__group', `s2s__group--${g}`, { 'has-hl': gs.some((s) => hl.includes(s.n)) }]} data-group={g} aria-label={groups[g].label} style={`--n:${gs.length}`}>
								<p class="s2s__glabel">
									{dots[g].map((c) => <i style={`background:${c}`} />)}
									{groups[g].label}
								</p>
								<ol class="s2s__gsteps">
									{gs.map((s) => {
										const img = stageImages[s.n];
										return (
											<li class:list={['s2s__step', { 'is-hl': hl.includes(s.n), 'is-near': near.includes(s.n) }]} data-stage={s.n}>
												<button type="button" class="s2s__card" aria-expanded="false" aria-controls={`${uid}-panel`} data-stage={s.n}>
													<span class="s2s__no">{s.n}</span>
														<span class="s2s__img">
														{img.src ? (
															<img src={img.src} alt={img.alt} width="400" height="300" loading="lazy" decoding="async" />
														) : (
															<span class="s2s__ph" role="img" aria-label={`Placeholder: ${img.hint}`}>
																<b>{img.label}</b>
																<small>{img.hint}</small>
															</span>
														)}
														
													</span>
													<span class="s2s__t">{s.title}</span>
													<span class="s2s__chip">
														{dots[g].map((c) => <i style={`background:${c}`} />)}
														{chipLabel[g]}
													</span>
												</button>
											</li>
										);
									})}
								</ol>
							</section>
							{gi < order.length - 1 && <span class="s2s__arrow" aria-hidden="true"></span>}
						</>
					);
				})}
			</div>

			<div class="s2s__panel" hidden={quiet} id={`${uid}-panel`} role="region" aria-live="polite" aria-label="About this step"></div>
			{proj && <p class="s2s__hint" data-hint>{proj.blurb}</p>}

			<script type="application/json" data-s2s-json set:html={JSON.stringify({ stages, projects })} />
		</div>
	)
}

<script>
	const roots = document.querySelectorAll<HTMLElement>('[data-s2s]');
	const isMobile = () => window.matchMedia('(max-width: 719px)').matches;
	const LINK = /\[\[([^|\]]+)\|([^\]]+)\]\]/g;

	// Turns "text [[label|url]] text" into text nodes and links. Only http(s) and site paths become links.
	const richText = (el: HTMLElement, text: string) => {
		let last = 0;
		for (const m of text.matchAll(LINK)) {
			el.append(document.createTextNode(text.slice(last, m.index)));
			const href = m[2];
			if (/^https?:\/\//.test(href) || href.startsWith('/')) {
				const a = document.createElement('a');
				a.href = href;
				a.textContent = m[1];
				if (href.startsWith('http')) {
					a.target = '_blank';
					a.rel = 'noopener';
				}
				el.append(a);
			} else el.append(document.createTextNode(m[1]));
			last = m.index! + m[0].length;
		}
		el.append(document.createTextNode(text.slice(last)));
	};

	roots.forEach((root) => {
		const data = JSON.parse(root.querySelector('[data-s2s-json]')!.textContent!);
		const track = root.querySelector<HTMLElement>('[data-track]')!;
		const steps = Array.from(root.querySelectorAll<HTMLElement>('.s2s__step'));
		const groupEls = Array.from(root.querySelectorAll<HTMLElement>('.s2s__group'));
		const panel = root.querySelector<HTMLElement>('.s2s__panel')!;
		const startHl = root.dataset.hl ?? '';
		const startNear = root.dataset.near ?? '';
		let open = 0;

		const nums = (s?: string | null) => (s ? s.split(',').filter(Boolean).map(Number) : []);
		const setHl = (hl: number[], near: number[]) => {
			root.dataset.hl = hl.join(',');
			steps.forEach((el) => {
				const n = Number(el.dataset.stage);
				el.classList.toggle('is-hl', hl.includes(n));
				el.classList.toggle('is-near', near.includes(n));
			});
			groupEls.forEach((g) =>
				g.classList.toggle(
					'has-hl',
					Array.from(g.querySelectorAll<HTMLElement>('.s2s__step')).some((el) => hl.includes(Number(el.dataset.stage))),
				),
			);
		};
		setHl(nums(startHl), nums(startNear));

		const placePanel = (n: number) => {
			const li = steps.find((el) => Number(el.dataset.stage) === n)!;
			void li;
			track.after(panel);
		};

		const show = (n: number, scroll = true) => {
			if (open === n) return;
			open = n;
			const s = data.stages.find((x: any) => x.n === n);
			panel.textContent = '';
			panel.dataset.g = s.group;
			const h = document.createElement('h3');
			h.textContent = `${s.n}. ${s.title}`;
			panel.append(h);
			for (const t of s.paras ?? []) {
				const p = document.createElement('p');
				richText(p, t);
				panel.append(p);
			}
			if (s.bullets?.length) {
				const ul = document.createElement('ul');
				ul.className = 's2s__bul';
				for (const t of s.bullets) {
					const li = document.createElement('li');
					richText(li, t);
					ul.append(li);
				}
				panel.append(ul);
			}
			if (s.validate) {
				const v = document.createElement('p');
				v.className = 's2s__validate';
				v.textContent = `To validate: ${s.validate}`;
				panel.append(v);
			}
			placePanel(n);
			steps.forEach((el) =>
				el.querySelector('.s2s__card')!.setAttribute('aria-expanded', String(Number(el.dataset.stage) === n)),
			);
			steps.forEach((el) => el.classList.toggle('is-open', Number(el.dataset.stage) === n));
			if (scroll && isMobile()) panel.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
		};
		if (!root.hasAttribute('data-quiet')) {
			root.querySelectorAll<HTMLButtonElement>('.s2s__card').forEach((b) =>
				b.addEventListener('click', () => show(Number(b.dataset.stage))),
			);
			show(Number(root.dataset.start) || 1, false); // first (or the project's) step open by default
		} else {
			close();
			root.querySelectorAll<HTMLButtonElement>('.s2s__card').forEach((b) => b.setAttribute('tabindex', '-1'));
		}

		// project cards elsewhere on the page light up the steps they affect
		if (root.hasAttribute('data-listen')) {
			window.addEventListener('s2s:highlight', (e) => {
				const d = (e as CustomEvent).detail as { stages: number[] };
				setHl(d.stages, []);
			});
			window.addEventListener('s2s:reset', () => setHl(nums(startHl), nums(startNear)));
		}
	});
</script>
