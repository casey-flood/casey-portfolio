---
// A scene of its own: heading on the left, all tool tiles visible by default.
import fs from 'node:fs';
import type { Tool } from '../data/tools';
interface Props { id: string; tools: Tool[]; eyebrow?: string; title: string; lede?: string }
const { id, tools, eyebrow = 'Tools I use', title, lede } = Astro.props;
const list = tools.map((x) => ({ ...x, logo: ['svg', 'webp', 'png'].map((e) => `/tools/${x.slug}.${e}`).find((f) => fs.existsSync(`./public${f}`)) ?? null }));
---
<section class="ts" id={id} data-toolscene style={`--n:${list.length}`} aria-labelledby={`${id}-h`}>
	<div class="ts__pin">
		<div class="ts__copy">
			<p class="hv__eyebrow">{eyebrow}</p>
			<h2 id={`${id}-h`} class="hv__big hv__big--md">{title}</h2>
			{lede && <p class="hv__lede">{lede}</p>}
		</div>
		<ul class="ts__tiles">
			{list.map((tl, i) => (
				<li class="ts__tile" style={`--i:${i}`} tabindex="0">
					{tl.logo ? <img src={tl.logo} alt={tl.name} loading="lazy" /> : <span>{tl.name}</span>}
					<span class="ts__tip" role="tooltip"><b>{tl.name}</b><small>{tl.desc}</small></span>
				</li>
			))}
		</ul>
	</div>
</section>

<script>
	// Tiles are visible by default; nothing is gated on scroll.
	document.querySelectorAll<HTMLElement>('[data-toolscene]').forEach((sec) => sec.querySelectorAll('.ts__tile').forEach((t) => t.classList.add('on')));
</script>